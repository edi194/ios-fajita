+/*
+ * Touch boost entry point, called by the touch driver for every touch-down and move report (bsd/dev/sweet_touch.c,
+ * touch_report(), on the touch thread). Cheap: with sweetinputboost=0 or before init one load; otherwise one clock read
+ * and a compare, and every ~10 ms a few stores. It takes no lock and sleeps nowhere: the CPU part is one MMIO store per
+ * cluster (the same store the governor makes) so the clocks move now, not at the governor's next 25 ms sample; the GPU part
+ * stores a deadline for the GPU PM thread, which votes with the GPU lock held (sweet_gpu_input_boost in sweet_a630.c).
+ * The governors then keep the floor for the hold. Only gov mode raises the CPU (fixed/off leave it).
+ */
+void
+sweet_input_boost(void)
+{
+	if (cf_in_hold_abs == 0) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (now - cf_in_last < cf_in_gap_abs) {
+		return;
+	}
+	cf_in_last = now;
+	cf_in_events++;
+	cf_in_until = now + cf_in_hold_abs;
+	sweet_gpu_input_boost(now);
+	if (cf_mode != MODE_GOV || !cf_in_khz) {
+		return;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		struct cf_domain *d = &cf_dom[i];
+		if (d->state == CF_APPLIED && cf_rd(d, CPUFREQ_PERF_STATE) < d->in_idx) {
+			cf_request(d, d->in_idx);
+		}
+	}
+}
