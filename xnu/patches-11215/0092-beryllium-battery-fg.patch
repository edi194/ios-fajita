+/*
+ * Poco F1: PMI8998 (SID 2) FG gen3 + SMB2 charger, read-only, as Linux
+ * qpnp-fg-gen3.c / smb-reg.h. The FG keeps its own calibrated monotonic
+ * SOC (0x4009, 0..255), so no voltage estimate is needed here.
+ */
+void
+SweetBattery::pollBeryllium(void)
+{
+	const unsigned sid = 2;
+	uint8_t msoc = 0, msoc2 = 1, usb = 0, charger = 0;
+	uint16_t rawVoltage = 0, rawCurrent = 0;
+	bool valid = fReal;
+	/* two equal reads of the monotonic SOC, like fg_get_msoc_raw */
+	for (unsigned i = 0; valid && i < 5; ++i) {
+		valid = !sweet_spmi_read(sid, 0x4009, &msoc) && !sweet_spmi_read(sid, 0x4009, &msoc2);
+		if (msoc == msoc2) {
+			break;
+		}
+	}
+	valid = valid && msoc == msoc2 &&
+	    readWord(0x41a0, &rawVoltage, sid) &&
+	    !sweet_spmi_read(sid, 0x1310, &usb) &&
+	    !sweet_spmi_read(sid, 0x1006, &charger);
+	unsigned mv = valid ? (unsigned)(((uint64_t)rawVoltage * 122070u) / 1000000u) : 0;
+	valid = valid && mv >= 2800 && mv <= 4600;
+	if (!valid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	unsigned percent = msoc == 255 ? 100 : msoc == 0 ? 0 :
+	    ((unsigned)(msoc - 1) * 98u + 252u) / 253u + 1u;
+	bool external = (usb & 0x10u) != 0;          /* USBIN_PLUGIN_RT_STS */
+	unsigned state = charger & 7u;
+	bool charging = external && state >= 1 && state <= 4;
+	bool full = external && state == 5;          /* TERMINATE_CHARGE */
+	int ma = 0;
+	bool currentValid = readWord(0x41a2, &rawCurrent, sid);
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
+		/* FG: positive = discharging, 488.281 uA/bit; IOPMPowerSource: positive = charging, mA */
+		ma = (int)(-((int64_t)signedRaw * 488281) / 1000000);
+	}
+	publish(full ? 100 : percent, mv, ma, external, external, charging, full, true, currentValid);
+}
