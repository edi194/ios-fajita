+/*
+ * sysctl kern.sweet_fb: display path statistics of the Poco F1 framebuffer
+ * (iokit/Kernel/arm/SweetFramebuffer.cpp, AppleCLCD).
+ *
+ * The framebuffer formats one line of space separated key=value words
+ * ("sweet_fb v1 mode=direct hz=60 ...", docs/DISPLAY_HW.md section 5) about
+ * once per second and hands it to sweet_fb_stats_publish(); the sysctl only
+ * returns the latest line (double buffered, one writer: the framebuffer's
+ * work loop). Before the framebuffer exists, or on another board, the line is
+ * "sweet_fb v1 mode=off". Keys may be added in later versions, readers must
+ * ignore unknown ones; an incompatible change bumps "v1".
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <string.h>
+
+#define SWEET_FB_TEXT_MAX 1024
+
+static char sweet_fb_text[2][SWEET_FB_TEXT_MAX];
+static volatile unsigned sweet_fb_cur;
+static volatile unsigned sweet_fb_have;
+
+void sweet_fb_stats_publish(const char *text);
+
+void
+sweet_fb_stats_publish(const char *text)
+{
+	unsigned next = sweet_fb_cur ^ 1u;
+	size_t n = strnlen(text, SWEET_FB_TEXT_MAX - 1);
+
+	memcpy(sweet_fb_text[next], text, n);
+	sweet_fb_text[next][n] = 0;
+	__atomic_store_n(&sweet_fb_cur, next, __ATOMIC_RELEASE);
+	__atomic_store_n(&sweet_fb_have, 1u, __ATOMIC_RELEASE);
+}
+
+static int sweet_fb_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	char buf[SWEET_FB_TEXT_MAX];
+
+	if (!__atomic_load_n(&sweet_fb_have, __ATOMIC_ACQUIRE)) {
+		snprintf(buf, sizeof(buf), "sweet_fb v1 mode=off\n");
+	} else {
+		unsigned cur = __atomic_load_n(&sweet_fb_cur, __ATOMIC_ACQUIRE);
+		memcpy(buf, sweet_fb_text[cur], sizeof(buf));
+		buf[sizeof(buf) - 1] = 0;
+	}
+	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_fb,
+    CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sweet_fb_sysctl, "A",
+    "Poco F1 display path statistics, key=value string (see bsd/dev/sweet_fb.c)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
