+/* x100 fixed point for rates and averages: no floating point in the kernel. */
+#define SW_F2(v) (unsigned)((v) / 100), (unsigned)((v) % 100)
+
+static uint64_t
+sweet_abs_us(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+/*
+ * Once per second (checked every vsync tick): the window since the previous
+ * publish becomes rates and averages, formatted as one key=value line for
+ * sysctl kern.sweet_fb (bsd/dev/sweet_fb.c) and, every sweetfb_statlog seconds
+ * (default 10, 0 = never), an IOLog line. Cheap: one snprintf per second.
+ */
+void
+AppleCLCD::statsTick(uint64_t now)
+{
+	uint64_t winAbs = now - fStPrevT;
+	if (fStPrevT == 0) {
+		fStPrevT = now;
+		return;
+	}
+	uint64_t winUS = sweet_abs_us(winAbs);
+	if (winUS < 1000000) {
+		return;
+	}
+	uint64_t swaps, coalesced;
+	IOLockLock(fLock);
+	swaps = fSt.swaps;
+	coalesced = fSt.coalesced;
+	IOLockUnlock(fLock);
+	const SwStats &c = fSt;
+	const SwStats &p = fStPrev;
+	uint64_t dSwaps = swaps - p.swaps, dCoal = coalesced - p.coalesced;
+	uint64_t dZc = c.zc - p.zc, dCopy = c.copy - p.copy, dTicks = c.ticks - p.ticks;
+	uint64_t dRepl = c.scanReplaced - p.scanReplaced;
+	uint64_t dLw = c.latchWaits - p.latchWaits, dCl = c.cleans - p.cleans;
+	#define PER_S(n) ((uint64_t)(n) * 100000000ull / winUS)
+	uint64_t copyAvg = dCopy ? sweet_abs_us(c.copyAbs - p.copyAbs) * 100 / dCopy : 0;
+	uint64_t zcAvg = dZc ? sweet_abs_us(c.zcAbs - p.zcAbs) * 100 / dZc : 0;
+	uint64_t clAvg = dCl ? sweet_abs_us(c.cleanAbs - p.cleanAbs) * 100 / dCl : 0;
+	uint64_t lwAvg = dLw ? sweet_abs_us(c.latchWaitAbs - p.latchWaitAbs) * 100 / dLw : 0;
+	const char *mode = fZc && fZcOK ? (fDirect ? "direct" : "zc") : "copy";
+	const char *smmu = fSmmuA == -2 ? "untested" : ((fSmmuA == 1 && fSmmuB == 1) ? "bypass" : "translate-or-unknown");
+	uint32_t used = 0, total = 0;
+	uint64_t pallocs = 0, pfails = 0;
+	sweet_lowpool_stats(&used, &total, &pallocs, &pfails);
+	uint32_t hz = fVsyncUS ? 1000000u / fVsyncUS : 0;
+	char line[SWEET_FB_STATS_MAX];
+	snprintf(line, sizeof(line),
+	    "sweet_fb v1 mode=%s hz=%u flushticks=%u hw=%d flip=%d smmu=%s clean=%s up_s=%llu win_ms=%llu "
+	    "swaps=%llu swaps_s=%u.%02u coalesced=%llu coalesced_s=%u.%02u "
+	    "zc_frames=%llu zc_s=%u.%02u copy_frames=%llu copy_s=%u.%02u scan_replaced=%llu scan_replaced_s=%u.%02u "
+	    "copy_us=%u.%02u copy_us_max=%llu zc_us=%u.%02u zc_us_max=%llu clean_us=%u.%02u cleans=%llu clean_skips=%llu "
+	    "latch_waits=%llu latch_wait_us=%u.%02u latch_timeouts=%llu vsync_s=%u.%02u "
+	    "pool_used=%u pool_total=%u pool_surfaces=%llu pool_fallbacks=%llu\n",
+	    mode, hz, fFlushTicks, fHw ? 1 : 0, fFlip ? 1 : 0, smmu, fZcCleanMode == 0 ? "never" : (fZcCleanMode == 1 ? "always" : "auto"),
+	    sweet_abs_us(now) / 1000000, winUS / 1000,
+	    swaps, SW_F2(PER_S(dSwaps)), coalesced, SW_F2(PER_S(dCoal)),
+	    c.zc, SW_F2(PER_S(dZc)), c.copy, SW_F2(PER_S(dCopy)), c.scanReplaced, SW_F2(PER_S(dRepl)),
+	    SW_F2(copyAvg), sweet_abs_us(c.copyMaxAbs), SW_F2(zcAvg), sweet_abs_us(c.zcMaxAbs), SW_F2(clAvg), c.cleans, c.cleanSkips,
+	    c.latchWaits, SW_F2(lwAvg), c.latchTimeouts, SW_F2(PER_S(dTicks)),
+	    used, total, pallocs, pfails);
+	#undef PER_S
+	sweet_fb_stats_publish(line);
+	if (fStLogSecs != 0 && (fStLogT == 0 || sweet_abs_us(now - fStLogT) >= (uint64_t)fStLogSecs * 1000000)) {
+		fStLogT = now;
+		IOLog("SWEET FB: stats %s", line);
+	}
+	fStPrev = fSt;
+	fStPrev.swaps = swaps;
+	fStPrev.coalesced = coalesced;
+	fSt.copyMaxAbs = 0;     /* maxima are per window */
+	fSt.zcMaxAbs = 0;
+	fStPrev.copyMaxAbs = 0;
+	fStPrev.zcMaxAbs = 0;
+	fStPrevT = now;
+}
