+
+/*
+ * 0235: copy the swapped canvas into a framebuffer-owned buffer and scan that (see fScanCopy). The first call allocates the
+ * three buffers from the low pool; if that fails the scan-out copy stays off for the rest of the boot (fScanFailed) and
+ * frames are scanned in place again. Work loop, like zcPresent. True: the frame is queued and its swap complete.
+ */
+bool
+AppleCLCD::scanCopyPresent(SweetSurface *s, uint32_t id)
+{
+	uint32_t rowBytes = fLogicalW * 4;
+	if (fScanMap[0] == NULL) {
+		fScanStride = (rowBytes + 63) & ~63u;
+		uint32_t bytes = (uint32_t)round_page_64((uint64_t)fScanStride * fLogicalH);
+		for (int i = 0; i < 3; i++) {
+			fScanPA[i] = sweet_lowpool_scanbuf(bytes, &fScanMap[i]);
+			if (fScanPA[i] == 0 || fScanPA[i] + bytes > (1ull << 32) || (fScanPA[i] & 63) != 0) {
+				IOLog("SWEET FB: scan-out copy off: buffer %d of %u bytes not available from the low pool (0x%llx)\n",
+				    i, bytes, fScanPA[i]);
+				fScanFailed = true;     /* the blocks we got stay allocated: three canvases at most, once per boot */
+				return false;
+			}
+		}
+		IOLog("SWEET FB: scan-out copy buffers 0x%llx 0x%llx 0x%llx, stride %u, %u bytes each\n",
+		    fScanPA[0], fScanPA[1], fScanPA[2], fScanStride, bytes);
 	}
+	uintptr_t kva = s->kernelAddress();
+	if (kva == 0) {
+		return false;
+	}
+	zcPoll();
+	if (fScanForeign) {
+		/* the panel shows (or is about to show) something that is not ours: once that latched, all three are free */
+		if (fLastFlush != 0 && !latchedNow()) {
+			waitLatch();
+		}
+		fScanPanel = fScanQueued = -1;
+		fScanForeign = false;
+	} else if (fScanQueued >= 0 && latchedNow()) {
+		fScanPanel = fScanQueued;       /* the queued frame reached the glass */
+		fScanQueued = -1;
+	}
+	int t = 0;
+	while (t == fScanPanel || t == fScanQueued) {
+		t++;
+	}
+	if (fScanQueued >= 0) {
+		fSt.coalesced++;        /* the queued copy is replaced before its vsync: never shown, now free */
+	}
+	uint64_t t0 = mach_absolute_time();
+	const uint8_t *src = (const uint8_t *)(kva + s->offset);
+	uint64_t span = (uint64_t)s->bytesPerRow * (fLogicalH - 1) + rowBytes;
+	if (sweet_lowpool_cacheable()) {
+		/* the GPU wrote DRAM behind this write-back mapping; a CPU draw may sit dirty in it (civac keeps that) */
+		sweet_dma_sync_va((const void *)src, (size_t)span);
+	}
+	uint8_t *dst = (uint8_t *)fScanMap[t]->getVirtualAddress();
+	if (s->bytesPerRow == fScanStride) {
+		memcpy(dst, src, (size_t)span);
+	} else {
+		for (uint32_t y = 0; y < fLogicalH; y++) {
+			memcpy(dst + (size_t)y * fScanStride, src + (size_t)y * s->bytesPerRow, rowBytes);
+		}
+	}
+	scanAddr((uint32_t)fScanPA[t], fScanStride, true);      /* dsb before the address write: the WC stores land first */
+	fScanForeign = false;
+	fScanQueued = t;
+	fScanFront = true;
+	__atomic_store_n(&fShotId, id, __ATOMIC_RELEASE);
+	/* CoreAnimation may reuse its surface now: the swap is complete */
+	if ((int32_t)(fCurSwapID - __atomic_load_n(&fSwapDone, __ATOMIC_ACQUIRE)) > 0) {
+		__atomic_store_n(&fSwapDone, fCurSwapID, __ATOMIC_RELEASE);
+		if (struct sweet_fb_trace_rec *tr = sweet_fb_trace_of(fCurSwapID)) {
+			tr->done = mach_absolute_time();
+		}
+	}
+	uint64_t d = mach_absolute_time() - t0;
+	fSt.scanCopies++;
+	fSt.scanCopyAbs += d;
+	if (d > fSt.scanCopyMaxAbs) {
+		fSt.scanCopyMaxAbs = d;
+	}
+	fSt.zc++;
+	if (fZcFrames++ == 0) {
+		IOLog("SWEET FB: first scan-out copy: surface %u -> buffer %d at 0x%llx (%ux%u canvas)\n",
+		    id, t, fScanPA[t], fLogicalW, fLogicalH);
+	}
 	return true;
 }
 
