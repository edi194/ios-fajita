--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -505,6 +505,36 @@
 	ok = sweet_surface_insert_locked(s);
 	IOLockUnlock(sweet_surface_lock);
 	return ok;
+}
+
+/*
+ * A scan-out buffer the framebuffer owns (patch 0235, sweetfb_scancopy): a low-pool block (contiguous, below 4 GiB,
+ * page aligned) mapped write-combined in the kernel only, zeroed. 0: the pool is not set up or is full.
+ */
+uint64_t
+sweet_lowpool_scanbuf(uint32_t bytes, IOMemoryMap **mapOut)
+{
+	*mapOut = NULL;
+	if (!sweet_lowpool.ready || bytes == 0) {
+		return 0;
+	}
+	uint32_t np = (bytes + PAGE_SIZE - 1) / PAGE_SIZE;
+	uint64_t pa = sweet_lowpool_alloc(bytes);
+	if (pa == 0) {
+		return 0;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(pa, (IOByteCount)np * PAGE_SIZE, kIODirectionInOut);
+	IOMemoryMap *map = md != NULL ? md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);         /* the map keeps the descriptor */
+	if (map == NULL || map->getVirtualAddress() == 0) {
+		OSSafeReleaseNULL(map);
+		sweet_lowpool_free(pa, np);
+		return 0;
+	}
+	bzero((void *)map->getVirtualAddress(), (size_t)np * PAGE_SIZE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*mapOut = map;
+	return pa;
 }
 
