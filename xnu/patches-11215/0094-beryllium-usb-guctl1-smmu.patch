 	printf("SWEET USB: GCTL before reset 0x%08x, after 0x%08x, now 0x%08x; GUSB3PIPECTL 0x%08x GUSB2PHYCFG 0x%08x GUCTL 0x%08x GSTS 0x%08x\n",
 	    gctl_abl, gctl_rst, dwc_rd(GCTL), dwc_rd(0xc2c0), dwc_rd(0xc200), dwc_rd(0xc12c), dwc_rd(0xc118));
 
+	if (sweet_board_beryllium()) {
+		/*
+		 * DWC3 >= 2.90a used at high speed only: Linux dwc3_core_init sets
+		 * GUCTL1.DEV_FORCE_20_CLK_FOR_30_CLK so the USB3 logic runs from the
+		 * USB2 clock. Without it (and without the QMP PHY's PIPE clock) the
+		 * endpoint commands never complete (boots 0084-0091).
+		 */
+		uint32_t guctl1 = dwc_rd(0xc11c);
+		dwc_wr(0xc11c, guctl1 | (1u << 26));
+		printf("SWEET USB: GUCTL1 0x%08x -> 0x%08x (force 2.0 clock for 3.0 logic)\n",
+		    guctl1, dwc_rd(0xc11c));
+		/* apps_smmu stream 0x740: the first DMA would fault and reset the SoC */
+		int se = sweet_smmu_map_sid(0x740);
+		printf("SWEET USB: apps_smmu sid 0x740 -> %d\n", se);
+	}
+
 	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
