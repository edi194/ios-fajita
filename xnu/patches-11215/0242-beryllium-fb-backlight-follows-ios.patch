+/*
+ * 0242: the WLED straight to off (0) or to the brightness it had (fBlRaw), on the vsync timer (the only caller, so no
+ * lock). Each write is read back; a mismatch or a failed SPMI access is retried up to 3 times (single reads have come
+ * back 0xffff or 0x0100 while the write had landed). Nothing here turns the backlight path off for good.
+ */
+bool
+AppleCLCD::blSet(bool on)
+{
+	if (!on) {
+		uint16_t now[SWEET_WLED_STRINGS];
+		if (sweet_wled_read16(0, &now[0]) == 0 && sweet_wled_read16(1, &now[1]) == 0 &&
+		    now[0] != 0xffff && now[1] != 0xffff && ((now[0] | now[1]) & 0xfff) != 0) {
+			fBlRaw[0] = now[0];     /* what the panel shows now is what "on" restores */
+			fBlRaw[1] = now[1];
+		}
+	}
+	for (int attempt = 0; attempt < 3; attempt++) {
+		bool ok = true;
+		uint16_t want[SWEET_WLED_STRINGS];
+		for (unsigned n = 0; n < SWEET_WLED_STRINGS && ok; n++) {
+			want[n] = on ? fBlRaw[n] : 0;
+			uint8_t d[2] = { (uint8_t)want[n], (uint8_t)(want[n] >> 8) };
+			ok = sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_BRIGHT(n), d, 2) == 0;
+		}
+		uint8_t clr = 0, set = SWEET_WLED_SYNC_MASK;
+		ok = ok && sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_SYNC, &clr, 1) == 0 &&
+		    sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_SYNC, &set, 1) == 0;
+		for (unsigned n = 0; n < SWEET_WLED_STRINGS && ok; n++) {
+			uint16_t got = 0xffff;
+			ok = sweet_wled_read16(n, &got) == 0 && got == want[n];
+		}
+		if (ok) {
+			fBlPos = on ? SWEET_FB_BL_STEPS : 0;
+			IOLog("SWEET FB: backlight %s (0x%04x/0x%04x)%s\n", on ? "on" : "off", want[0], want[1],
+			    attempt ? " after a retry" : "");
+			return true;
+		}
+		IODelay(200);
+	}
+	IOLog("SWEET FB: backlight %s did not take after 3 tries\n", on ? "on" : "off");
+	return false;
+}
