+static size_t
+cf_cat(char *buf, size_t size, size_t n, const char *fmt, ...) __printflike(4, 5);
+static size_t
+cf_cat(char *buf, size_t size, size_t n, const char *fmt, ...)
+{
+	va_list ap;
+	if (n >= size) {
+		return n;
+	}
+	va_start(ap, fmt);
+	int r = vsnprintf(buf + n, size - n, fmt, ap);
+	va_end(ap);
+	return r < 0 ? n : n + (size_t)r;
+}
+
+static int
+cf_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	char buf[1536];
+	size_t n = 0;
+	const char *modes[] = { "off", "gov", "fixed" };
+
+	n = cf_cat(buf, sizeof(buf), n, "sweet_cpufreq v1 mode=%s period_ms=%u\n", modes[cf_mode],
+	    cf_mode == MODE_GOV ? GOV_PERIOD_MS : FIXED_PERIOD_MS);
+	for (unsigned i = 0; i < 2; i++) {
+		const struct cf_domain *d = &cf_dom[i];
+		const char *st = d->state == CF_OFF ? "off" : d->state == CF_PENDING ? "pending" :
+		    d->state == CF_SKIPPED ? "skipped" : "applied";
+		bool ok = d->state == CF_APPLIED;
+		uint32_t cur = ok ? cf_rd(d, CPUFREQ_PERF_STATE) : 0;
+		n = cf_cat(buf, sizeof(buf), n,
+		    "cluster%u name=%s cpus=%s state=%s mode=%s idx=%u cur_khz=%u min_khz=%u max_khz=%u cap_khz=%u "
+		    "lut_n=%u load=%u changes=%u lut_khz=", i, d->name, d->cpus, st, modes[cf_mode], cur,
+		    ok ? cf_state_khz(d, cur) : 0, ok ? d->khz[0] : 0, ok ? d->khz[d->top] : 0,
+		    ok ? d->khz[d->cap] : 0, ok ? d->n : 0, d->load, d->changes);
+		for (uint32_t k = 0; ok && k < d->n; k++) {
+			n = cf_cat(buf, sizeof(buf), n, "%s%u", k ? "," : "", d->khz[k]);
+		}
+		n = cf_cat(buf, sizeof(buf), n, " tis_ms=");
+		for (uint32_t k = 0; ok && k < d->n; k++) {
+			n = cf_cat(buf, sizeof(buf), n, "%s%u:%llu", k ? "," : "", d->khz[k],
+			    d->tis_ns[k] / NSEC_PER_MSEC);
+		}
+		n = cf_cat(buf, sizeof(buf), n, "\n");
+	}
+	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
 }
