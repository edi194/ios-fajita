+/*
+ * Poco F1 cpufreq governor (bsd/dev/sweet_cpufreq.c): up-to-date idle time of a
+ * CPU in mach absolute time units, from the scheduler's idle accounting
+ * (processor_idle(), the WFI path). ~0 if the processor is not registered.
+ */
+uint64_t sweet_processor_idle_time(int cpu);
+uint64_t
+sweet_processor_idle_time(int cpu)
+{
+	processor_t processor = (cpu >= 0 && cpu < MAX_SCHED_CPUS) ? processor_array[cpu] : PROCESSOR_NULL;
+	struct recount_usage usage = { 0 };
+	uint64_t idle_time = 0;
+
+	if (processor == PROCESSOR_NULL) {
+		return ~0ULL;
+	}
+	recount_processor_usage(&processor->pr_recount, &usage, &idle_time);
+	return idle_time;
+}
