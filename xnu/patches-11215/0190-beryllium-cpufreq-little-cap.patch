+static void
+cf_readback(unsigned id, struct cf_domain *d, uint32_t idx)
+{
+	unsigned waited = 0;
+	uint32_t now = cf_rd(d, CPUFREQ_PERF_STATE);
+	while (now != idx && waited < 50) {
+		cf_sleep_ms(1);
+		waited++;
+		now = cf_rd(d, CPUFREQ_PERF_STATE);
+	}
+	printf("SWEET CPUFREQ: domain %u: readback perf state %u (%u kHz) after %u ms: %s\n",
+	    id, now, cf_state_khz(d, now), waited,
+	    now == idx ? "as requested" : "DIFFERS (firmware/LMh may limit it)");
+}
+
+static void
+cf_setup(unsigned id, struct cf_domain *d)
+{
+	d->state = CF_SKIPPED;
+	if (d->first_cpu >= cf_ncpus) {
+		printf("SWEET CPUFREQ: domain %u: CPU %u not online, skipped\n", id, d->first_cpu);
+		return;
+	}
+	d->base = ml_io_map(d->pa, CPUFREQ_WINDOW);
+	if (d->base == 0) {
+		printf("SWEET CPUFREQ: domain %u: map 0x%lx failed\n", id, (unsigned long)d->pa);
+		return;
+	}
+	if (!cf_read_lut(id, d)) {
+		printf("SWEET CPUFREQ: domain %u: LUT invalid, not touching the perf state\n", id);
+		return;
+	}
+	if (!(cf_rd(d, CPUFREQ_ENABLE) & 1u) && !cf_force) {
+		printf("SWEET CPUFREQ: domain %u: ENABLE bit 0 clear (firmware did not enable the domain), "
+		    "not touching it (sweetcpufreq_force=1 forces)\n", id);
+		return;
+	}
+	uint32_t old = cf_rd(d, CPUFREQ_PERF_STATE);
+	printf("SWEET CPUFREQ: domain %u: current perf state %u (%u kHz)\n", id, old, cf_state_khz(d, old));
+	d->cap = cf_pick(d, d->percent);
+	printf("SWEET CPUFREQ: domain %u: %s %d%% of max -> perf state %u (%u kHz)\n", id,
+	    cf_mode == MODE_GOV ? "cap" : "fixed target", d->percent, d->cap, d->khz[d->cap]);
+	/* gov starts at the cap and lets the first idle samples bring it down */
+	cf_request(d, d->cap);
+	d->changes = 0;
+	cf_readback(id, d, d->cap);
+	d->state = CF_APPLIED;
+}
+
+/* Busiest CPU of the cluster, % busy since the last call. */
+static uint32_t
+cf_cluster_load(struct cf_domain *d, uint64_t wall)
+{
+	uint32_t worst = 0;
+	for (unsigned k = 0; k < d->ncpu && d->first_cpu + k < cf_ncpus; k++) {
+		uint64_t idle = sweet_processor_idle_time((int)(d->first_cpu + k));
+		if (idle == ~0ULL) {
+			continue;
+		}
+		uint64_t didle = idle - d->prev_idle[k];
+		d->prev_idle[k] = idle;
+		if (wall == 0 || didle >= wall) {
+			continue;
+		}
+		uint32_t busy = (uint32_t)((wall - didle) * 100 / wall);
+		if (busy > worst) {
+			worst = busy;
+		}
+	}
+	return worst;
+}
+
+static void
+cf_gov_step(unsigned id, struct cf_domain *d, uint64_t wall)
+{
+	uint32_t cur = cf_rd(d, CPUFREQ_PERF_STATE);
+	if (cur >= d->n) {
+		cur = d->req;
+	}
+	uint32_t load = cf_cluster_load(d, wall);
+	d->load = load;
+	if (cf_mode != MODE_GOV) {
+		return;
+	}
+	uint32_t target;
+	if (load >= GOV_JUMP_PCT) {
+		target = d->cap;
+	} else {
+		uint64_t need = (uint64_t)d->khz[cur] * load / GOV_TARGET_PCT;
+		target = 0;
+		while (target < d->cap && d->khz[target] < need) {
+			target++;
+		}
+	}
+	if (target > d->cap) {
+		target = d->cap;
+	}
+	uint32_t next = cur;
+	if (target > cur) {
+		next = target;
+		d->down_cnt = 0;
+	} else if (target < cur) {
+		if (++d->down_cnt >= GOV_DOWN_SAMPLES) {
+			d->down_cnt = 0;
+			next = (cur - target > GOV_DOWN_STEP) ? cur - GOV_DOWN_STEP : target;
+		}
+	} else {
+		d->down_cnt = 0;
+	}
+	if (next != cur) {
+		cf_request(d, next);
+	}
+	(void)id;
+}
+
+static void
+cf_log_summary(unsigned id, struct cf_domain *d)
+{
+	char line[512];
+	size_t n = 0;
+	n += snprintf(line + n, sizeof(line) - n, "SWEET CPUFREQ: %s cluster%u load %u%% idx %u (%u kHz) changes %u tis_ms(%us):",
+	    cf_mode == MODE_GOV ? "gov" : "fixed", id, d->load, d->req, cf_state_khz(d, d->req), d->changes, cf_log_secs);
+	for (uint32_t i = 0; i < d->n && n < sizeof(line); i++) {
+		uint64_t ms = (d->tis_ns[i] - d->tis_snap[i]) / NSEC_PER_MSEC;
+		d->tis_snap[i] = d->tis_ns[i];
+		if (ms) {
+			n += snprintf(line + n, sizeof(line) - n, " %u:%llu", d->khz[i], ms);
+		}
+	}
+	printf("%s\n", line);
+}
+
+static void
+cf_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	/* After the SMP bring-up: every selected CPU must be alive (their OSM domains powered). */
+	cf_ncpus = ml_get_topology_info()->num_cpus;
+	if (cf_ncpus > 8) {
+		cf_ncpus = 8;
+	}
+	for (unsigned t = 0; t < CPUFREQ_UP_WAIT_S * 10; t++) {
+		unsigned up = 0;
+		for (unsigned c = 0; c < cf_ncpus; c++) {
+			up += sweet_cpu_signal_is_enabled(c) ? 1 : 0;
+		}
+		if (up == cf_ncpus && cf_ncpus > 0) {
+			break;
+		}
+		if (t == CPUFREQ_UP_WAIT_S * 10 - 1) {
+			printf("SWEET CPUFREQ: only %u/%u CPUs up after %d s, leaving the frequencies alone\n",
+			    up, cf_ncpus, CPUFREQ_UP_WAIT_S);
+			cf_dom[0].state = cf_dom[1].state = CF_SKIPPED;
+			goto out;
+		}
+		cf_sleep_ms(100);
+	}
+	printf("SWEET CPUFREQ: %u CPUs up; mode %s; A55 %d%%, A75 %d%% of max\n", cf_ncpus,
+	    cf_mode == MODE_GOV ? "gov" : "fixed", cf_dom[0].percent, cf_dom[1].percent);
+	for (unsigned i = 0; i < 2; i++) {
+		cf_setup(i, &cf_dom[i]);
+	}
+	if (cf_dom[0].state != CF_APPLIED && cf_dom[1].state != CF_APPLIED) {
+		goto out;
+	}
+
+	/* Accounting loop (also in fixed mode, slower): time-in-state, load, governor. */
+	unsigned period = cf_mode == MODE_GOV ? GOV_PERIOD_MS : FIXED_PERIOD_MS;
+	uint64_t last = mach_absolute_time(), last_log = last;
+	for (unsigned i = 0; i < 2; i++) {
+		(void)cf_cluster_load(&cf_dom[i], 1);   /* prime prev_idle */
+	}
+	for (;;) {
+		cf_sleep_ms(period);
+		uint64_t now = mach_absolute_time();
+		uint64_t wall = now - last, wall_ns;
+		last = now;
+		absolutetime_to_nanoseconds(wall, &wall_ns);
+		for (unsigned i = 0; i < 2; i++) {
+			struct cf_domain *d = &cf_dom[i];
+			if (d->state != CF_APPLIED) {
+				continue;
+			}
+			uint32_t cur = cf_rd(d, CPUFREQ_PERF_STATE);
+			if (cur < d->n) {
+				d->tis_ns[cur] += wall_ns;      /* the state held during this interval */
+			}
+			cf_gov_step(i, d, wall);
+		}
+		uint64_t since_log_ns;
+		absolutetime_to_nanoseconds(now - last_log, &since_log_ns);
+		if (cf_log_secs && since_log_ns >= (uint64_t)cf_log_secs * NSEC_PER_SEC) {
+			last_log = now;
+			for (unsigned i = 0; i < 2; i++) {
+				if (cf_dom[i].state == CF_APPLIED) {
+					cf_log_summary(i, &cf_dom[i]);
+				}
+			}
+		}
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+cf_percent_arg(const char *name, int dflt)
+{
+	int v = dflt;
+	if (PE_parse_boot_argn(name, &v, sizeof(v)) && (v < 10 || v > 100)) {
+		printf("SWEET CPUFREQ: %s=%d out of range 10..100, using %d\n", name, v, dflt);
+		v = dflt;
+	}
+	return v;
 }
 
