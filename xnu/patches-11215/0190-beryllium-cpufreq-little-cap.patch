+/* One MMIO store + barrier: cheap, lock-free. */
+static void
+cf_request(struct cf_domain *d, uint32_t idx)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(d->base + CPUFREQ_PERF_STATE) = idx;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	d->req = idx;
+	d->changes++;
+}
