+void sweet_exec_env_trace(const char *name, int pid, const char *strings, const char *end);
 void sweet_syserr_trace(struct proc *p, unsigned short code, int error, const uint64_t *arg);
+void sweet_machtrap_trace(struct proc *p, int call, int kr);
+
+/*
+ * At exec of a traced process print the launchd-provided XPC environment: XPC_FLAGS bit 0x4000 makes
+ * xpc_is_system_session() true (libxpc init, `tbz w20, #0xe` -> byte 0xd0 of the libxpc state), and
+ * ContainerManagerCommon's "Personas are supported (static)" is false when it is true.
+ */
+void
+sweet_exec_env_trace(const char *name, int pid, const char *strings, const char *end)
+{
+	if (strings == NULL || end == NULL || end <= strings || (size_t)(end - strings) > (1U << 20)) {
+		return;
+	}
+	if (sweet_syserr_state == 0) {
+		if (!PE_parse_boot_argn("sweetsyserr", sweet_syserr_names, sizeof(sweet_syserr_names))) {
+			strlcpy(sweet_syserr_names, SWEET_SYSERR_DEFAULT, sizeof(sweet_syserr_names));
+		}
+		sweet_syserr_state = (sweet_syserr_names[0] == '-') ? 1 : 2;
+	}
+	if (sweet_syserr_state != 2 || !sweet_syserr_match(name)) {
+		return;
+	}
+	for (const char *s = strings; s < end;) {
+		size_t l = strnlen(s, (size_t)(end - s));
+		if (strncmp(s, "XPC_FLAGS=", 10) == 0 || strncmp(s, "XPC_SERVICE_NAME=", 17) == 0) {
+			printf("SWEET EXEC: %s[%d] %.60s\n", name, pid, s);
+		}
+		s += l + 1;
+	}
+}
+
+/*
+ * Failed Mach traps of the same processes (mach_msg/mach_msg2 results, port operations, invalid trap numbers
+ * (call >= 1000: the number is 1000 + the raw one)). Once per distinct (process, trap, kr).
+ * MACH_RCV_TIMED_OUT / MACH_SEND_TIMED_OUT / MACH_RCV_INTERRUPTED / MACH_RCV_TOO_LARGE are normal and skipped.
+ */
+void
+sweet_machtrap_trace(struct proc *p, int call, int kr)
+{
+	if (kr == 0 || (uint32_t)kr == 0x10004003 || (uint32_t)kr == 0x10000004 || (uint32_t)kr == 0x10004005 ||
+	    (uint32_t)kr == 0x10004004 || (uint32_t)kr == 0x10000003) {
+		return;
+	}
+	if (sweet_syserr_state == 0) {
+		if (!PE_parse_boot_argn("sweetsyserr", sweet_syserr_names, sizeof(sweet_syserr_names))) {
+			strlcpy(sweet_syserr_names, SWEET_SYSERR_DEFAULT, sizeof(sweet_syserr_names));
+		}
+		sweet_syserr_state = (sweet_syserr_names[0] == '-') ? 1 : 2;
+	}
+	if (sweet_syserr_state != 2 || os_atomic_load(&sweet_syserr_count, relaxed) >= SWEET_SYSERR_MAX) {
+		return;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	if (!sweet_syserr_match(name)) {
+		return;
+	}
+	uint64_t key = sweet_syserr_hash(0x84222325cbf29ce4ULL, name);
+	key = (key ^ (uint32_t)call) * 0x100000001b3ULL;
+	key = (key ^ (uint32_t)kr) * 0x100000001b3ULL;
+	int seen = os_atomic_load(&sweet_syserr_count, relaxed);
+	if (seen > SWEET_SYSERR_MAX) {
+		seen = SWEET_SYSERR_MAX;
+	}
+	for (int i = 0; i < seen; i++) {
+		if (sweet_syserr_keys[i] == key) {
+			return;
+		}
+	}
+	int slot = os_atomic_inc_orig(&sweet_syserr_count, relaxed);
+	if (slot >= SWEET_SYSERR_MAX) {
+		return;
+	}
+	sweet_syserr_keys[slot] = key;
+	printf("SWEET ERR: %s[%d/p%u u%u] MACH trap %d kr=0x%x\n", name, proc_pid(p), current_persona_get_id(),
+	    kauth_getuid(), call, (uint32_t)kr);
+}
 
