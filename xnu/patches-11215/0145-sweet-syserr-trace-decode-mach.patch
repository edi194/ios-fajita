+		key = sweet_syserr_hash(sweet_syserr_hash(key, from), to);
 	} else if (code == 92) {
 		snprintf(detail, sizeof(detail), " cmd=%llu", arg[1]);
 		key = (key ^ (uint32_t)arg[1]) * 0x100000001b3ULL;
