+
+/*
+ * Screenshot of what the panel scans now (patch 0224): sysctl kern.sweet_fb_shot (bsd/dev/sweet_fb.c) asks for a
+ * copy, every scale-th pixel in both directions, BGRA, rows of *ow * 4 bytes. The source is the pooled surface of
+ * the newest zero-copy frame (held by a reference while it is read), else the page-flip frame on the panel (the
+ * canvas when the hardware scaler is on, the panel-sized frame otherwise; frame 0 is ABL's), else the boot
+ * framebuffer. Reads race the next frame: a screenshot may mix two frames, nothing worse.
+ */
+extern "C" int sweet_fb_shot_copy(uint8_t *dst, size_t cap, uint32_t scale, uint32_t *ow, uint32_t *oh);
+
+int
+sweet_fb_shot_copy(uint8_t *dst, size_t cap, uint32_t scale, uint32_t *ow, uint32_t *oh)
+{
+	AppleCLCD *fb = __atomic_load_n(&sweet_fb_shot_fb, __ATOMIC_ACQUIRE);
+	SweetSurface *s = NULL;
+	uintptr_t src = 0;
+	uint32_t w, h, stride;
 
+	if (fb == NULL || scale == 0) {
+		return ENODEV;
+	}
+	uint32_t id = __atomic_load_n(&fb->fShotId, __ATOMIC_ACQUIRE);
+	if (fb->fZcFront && id != 0 && (s = sweet_surface_copy(id)) != NULL && s != fb->fSurface &&
+	    s->kernelAddress() != 0 && s->width >= fb->fLogicalW && s->height >= fb->fLogicalH) {
+		src = s->kernelAddress() + s->offset;
+		w = fb->fLogicalW;
+		h = fb->fLogicalH;
+		stride = s->bytesPerRow;
+	} else {
+		OSSafeReleaseNULL(s);
+		uint32_t f = fb->fFlip ? fb->fFront : 0;
+		src = f < 3 && fb->fFlip ? fb->fBufVA[f] : fb->fPixels;
+		if (f != 0 && fb->fHw) {
+			w = fb->fLogicalW;
+			h = fb->fLogicalH;
+			stride = fb->fHwStride;
+		} else {
+			w = fb->fWidth;
+			h = fb->fHeight;
+			stride = fb->fRowBytes;
+		}
+	}
+	uint32_t dw = w / scale, dh = h / scale;
+	if (src == 0 || dw == 0 || dh == 0 || (uint64_t)dw * dh * 4 > cap) {
+		OSSafeReleaseNULL(s);
+		return src == 0 ? ENODEV : ENOSPC;
+	}
+	for (uint32_t y = 0; y < dh; y++) {
+		const uint32_t *in = (const uint32_t *)(src + (uintptr_t)y * scale * stride);
+		uint32_t *out = (uint32_t *)(dst + (size_t)y * dw * 4);
+		for (uint32_t x = 0; x < dw; x++) {
+			out[x] = in[x * scale];
+		}
+	}
+	OSSafeReleaseNULL(s);
+	*ow = dw;
+	*oh = dh;
+	return 0;
+}
