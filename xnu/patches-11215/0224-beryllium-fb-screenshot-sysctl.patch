     "Poco F1 on-screen performance HUD (0 off, 1 on); needs the copy scan-out path");
 
+/*
+ * sysctl kern.sweet_fb_shot (patch 0224): a screenshot of what the panel scans now, for testing over SSH
+ * (tools/sweetnet/sweetshot). Root only. 16-byte header, little endian: 'SHOT' (0x544f4853), width, height,
+ * bytes per row (width * 4); then BGRA rows. kern.sweet_fb_shot_scale (2..8, default 3) keeps every n-th pixel
+ * in both directions: 375x812 from the 1125x2436 canvas at 3.
+ */
+int sweet_fb_shot_copy(uint8_t *dst, size_t cap, uint32_t scale, uint32_t *ow, uint32_t *oh);
+
+static unsigned int sweet_fb_shot_scale = 3;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_fb_shot_scale, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_fb_shot_scale, 0,
+    "Poco F1 screenshot downscale (kern.sweet_fb_shot), 2..8");
+
+#define SWEET_FB_SHOT_MAXW 1280
+#define SWEET_FB_SHOT_MAXH 2560
+
+static int sweet_fb_shot_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint32_t scale = sweet_fb_shot_scale, w = 0, h = 0;
+	if (scale < 2 || scale > 8) {
+		scale = 3;
+	}
+	size_t cap = 16 + (size_t)(SWEET_FB_SHOT_MAXW / scale) * (SWEET_FB_SHOT_MAXH / scale) * 4;
+
+	if (req->oldptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, NULL, cap);      /* size query */
+	}
+	if (req->newptr != USER_ADDR_NULL) {
+		return EPERM;
+	}
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	uint8_t *buf = kalloc_data(cap, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int err = sweet_fb_shot_copy(buf + 16, cap - 16, scale, &w, &h);
+	if (err == 0) {
+		uint32_t hdr[4] = { 0x544f4853u, w, h, w * 4 };
+		memcpy(buf, hdr, sizeof(hdr));
+		err = SYSCTL_OUT(req, buf, 16 + (size_t)w * h * 4);
+	}
+	kfree_data(buf, cap);
+	return err;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_fb_shot,
+    CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sweet_fb_shot_sysctl, "S",
+    "Poco F1 screenshot of the scanned frame: 16-byte header + BGRA (see bsd/dev/sweet_fb.c)");
+
