 /* ---- DCVS ---- */
 
+/*
+ * Level changes as Linux a6xx_gmu_set_freq does for a legacy GMU (a630, firmware 1.6, HFI version 0). HFI message 30
+ * (H2F_MSG_GX_BW_PERF_VOTE) is the non-legacy protocol: this firmware refused every vote sent that way. The legacy path
+ * writes the DCVS registers in the GMU DTCM and pokes the GMU with the DCVS_SET OOB: ACK_OPTION 0, PERF_SETTING =
+ * (3 << 28) | perf index, BW_SETTING 0xff (an invalid index: the firmware picks the DDR vote itself, so no bandwidth
+ * table index is needed), OOB DCVS_SET (set bit 23, ack bit 31, clear bit 31), then DCVS_RETURN != 0 is an error. The
+ * perf index is the index into the PERF_TBL of gpu_hfi_tables(), i.e. our level (entry 0 is the 0 Hz level). Linux
+ * takes no GPU_SET OOB or keep-alive for this, only needs the GMU up with HFI started, which holds whenever we get here.
+ */
+static unsigned a630_level_sets, a630_dcvs_errors, dcvs_log_n;
+static uint64_t dcvs_log_t;
+static bool a630_dcvs_broken;           /* first failure: no more attempts, the level stays where it is */
+
 static bool
 gpu_set_level(unsigned lvl)
 {
-	uint32_t m[4] = { MSG_HDR(30 /* H2F_MSG_GX_BW_PERF_VOTE */, 4, 0), 1 /* blocking ack */, lvl, 0 }, ack[19];
+	int quiet = a630_quiet;                 /* called from inside a wake as well, whose own setting must survive */
+	uint32_t ret = 0;
 
 	a630_quiet = 1;
-	bool ok = hfi_cmd("GX_BW_PERF_VOTE", m, 4, ack, 19);
-	a630_quiet = 0;
-	if (ok) {
+	gpu_wr(gmu, GMU_DCVS_ACK_OPTION, 0);
+	gpu_wr(gmu, GMU_DCVS_PERF_SETTING, (3u << 28) | lvl);
+	gpu_wr(gmu, GMU_DCVS_BW_SETTING, 0xff);
+	bool ok = gmu_oob_set(OOB_DCVS, "dcvs");
+	gmu_oob_clear(OOB_DCVS);                /* Linux clears even when the ack timed out */
+	ret = gpu_rd(gmu, GMU_DCVS_RETURN);
+	a630_quiet = quiet;
+	if (ok && ret == 0) {
 		a630_level = lvl;
-	} else {
-		printf("SWEET GPU: GX level vote %u failed; governor off\n", lvl);
-		a630_gov = 0;
+		a630_level_sets++;
+		dcvs_log_n++;
+		if (dcvs_log_t == 0 || ns_since(dcvs_log_t) >= NSEC_PER_SEC) {  /* one line per second at most */
+			printf("SWEET GPU: GX level %u (%u MHz) via DCVS OOB (%u change%s since the last line)\n", lvl, gpu_levels[lvl].mhz,
+			    dcvs_log_n, dcvs_log_n == 1 ? "" : "s");
+			dcvs_log_t = mach_absolute_time();
+			dcvs_log_n = 0;
+		}
+		return true;
 	}
-	return ok;
+	a630_dcvs_errors++;
+	a630_dcvs_broken = true;
+	printf("SWEET GPU: GX level vote %u failed (OOB DCVS_SET %s, DCVS_RETURN 0x%08x); %sstaying at level %u\n", lvl,
+	    ok ? "acknowledged" : "TIMED OUT", ret, a630_gov ? "governor off, " : "", a630_level);
+	a630_gov = 0;
+	return false;
+}
+
+/*
+ * gpu_hfi_start(), then with GX up the GMU is told the current level like a6xx_gmu_set_initial_freq does in Linux's
+ * resume: a cold-booted GMU only knows the boot vote, and this is the one place every wake (resume, recovery) and the
+ * first bring-up pass through. A failed vote is not fatal to the start; it only turns the governor off.
+ */
+static bool
+gpu_hfi_start_dcvs(bool gx_on)
+{
+	if (!gpu_hfi_start()) {
+		return false;
+	}
+	if (gx_on && !a630_dcvs_broken) {
+		(void)gpu_set_level(a630_level);
+	}
+	return true;
 }
 
