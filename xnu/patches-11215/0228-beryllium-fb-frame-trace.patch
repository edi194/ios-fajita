+/*
+ * 0228: per-frame trace for frame pacing (sysctl kern.sweet_fb_trace). One record per swap id (ring of 128, index id & 127):
+ * when backboardd's swap arrived, when it was handed to the MDP (address + flush), when its latch was first seen, when it was
+ * released as done (SwapWait answers 0 from then on), and the first SwapWait call for it and that call's return. Times are
+ * mach absolute; written with relaxed stores from the swap path, the work loop and SwapWait, read racily by the sysctl.
+ */
+struct sweet_fb_trace_rec {
+	uint32_t id;
+	uint64_t swap, scan, latch, done, wcall, wret;
+};
+#define SWEET_FB_TRACE_N 128
+static uint64_t sweet_abs_us(uint64_t abs);
+static struct sweet_fb_trace_rec sweet_fb_trace[SWEET_FB_TRACE_N];
+static inline struct sweet_fb_trace_rec *
+sweet_fb_trace_of(uint32_t id)
+{
+	struct sweet_fb_trace_rec *r = &sweet_fb_trace[id & (SWEET_FB_TRACE_N - 1)];
+	return r->id == id ? r : NULL;
+}
+extern "C" size_t sweet_fb_trace_text(char *buf, size_t cap);
+size_t
+sweet_fb_trace_text(char *buf, size_t cap)
+{
+	uint64_t base = UINT64_MAX;
+	for (uint32_t i = 0; i < SWEET_FB_TRACE_N; i++) {
+		if (sweet_fb_trace[i].swap != 0 && sweet_fb_trace[i].swap < base) {
+			base = sweet_fb_trace[i].swap;
+		}
+	}
+	size_t n = (size_t)snprintf(buf, cap, "id swap_us scan_us latch_us done_us wcall_us wret_us (0 = not seen; relative to the oldest swap)\n");
+	if (base == UINT64_MAX) {
+		return n;
+	}
+	/* oldest first: walk the ring by swap time */
+	uint64_t last = 0;
+	for (uint32_t k = 0; k < SWEET_FB_TRACE_N && n < cap; k++) {
+		const struct sweet_fb_trace_rec *best = NULL;
+		for (uint32_t i = 0; i < SWEET_FB_TRACE_N; i++) {
+			const struct sweet_fb_trace_rec *r = &sweet_fb_trace[i];
+			if (r->swap != 0 && r->swap > last && (best == NULL || r->swap < best->swap)) {
+				best = r;
+			}
+		}
+		if (best == NULL) {
+			break;
+		}
+		last = best->swap;
+#define REL(t) ((t) ? sweet_abs_us((t) - base) : 0ull)
+		n += (size_t)snprintf(buf + n, cap - n, "%u %llu %llu %llu %llu %llu %llu\n", best->id, REL(best->swap), REL(best->scan),
+		    REL(best->latch), REL(best->done), REL(best->wcall), REL(best->wret));
+#undef REL
+	}
+	return n < cap ? n : cap;
+}
