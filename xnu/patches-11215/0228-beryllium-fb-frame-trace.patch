+static int sweet_fb_trace_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	const size_t cap = 16384;
+	if (req->oldptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, NULL, cap);
+	}
+	char *buf = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	size_t n = sweet_fb_trace_text(buf, cap - 1);
