+
+/*
+ * Start-up race between containermanagerd and usermanagerd (docs: NOTES.md 2026-10-21, logarchive pull 1021-1927).
+ * launchd starts both at once (RunAtLoad). containermanagerd's first action is to fetch the persona list from
+ * usermanagerd's XPC service; usermanagerd needs far longer than 1 s to get from exec to its check-in here, and
+ * launchd answers a lookup of a running-but-not-checked-in service with "failed activation ... error = 37"
+ * (launch_service: pid != 0 -> EALREADY), which the client sees as NSCocoaErrorDomain 4097 / XPC_INTERRUPTED.
+ * MCM retries for ~1 s (35 attempts between 775.80 and 776.71 in the archive), then serves with no personas:
+ * every client lookup ends in container error 52 (XPC_INTERRUPTED_REPLY; backboardd, lsd, mobileactivationd ...).
+ * Delay the FIRST exec of the processes named in boot-arg sweetexecdelay ("name:ms,name:ms", default
+ * "containermanagerd:6000", "-" = off) so usermanagerd is up first. Runs in the exec'ing thread before the image
+ * is activated; matched on the argv[0] leaf (containermanagerd_system is a different name).
+ */
+void sweet_exec_delay(const char *leaf);
+
+void
+sweet_exec_delay(const char *leaf)
+{
+	static char spec[128];
+	static int parsed;
+	static uint32_t done_mask;
+	if (!parsed) {
+		if (!PE_parse_boot_argn("sweetexecdelay", spec, sizeof(spec))) {
+			strlcpy(spec, "containermanagerd:6000", sizeof(spec));
+		}
+		parsed = 1;
+	}
+	if (spec[0] == '-' || leaf == NULL) {
+		return;
+	}
+	size_t n = strlen(leaf);
+	int idx = 0;
+	for (const char *t = spec; *t; idx++) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		const char *colon = memchr(t, ':', tl);
+		if (colon != NULL && (size_t)(colon - t) == n && strncmp(t, leaf, n) == 0 && idx < 32 &&
+		    !(done_mask & (1U << idx))) {
+			uint32_t ms = 0;
+			for (const char *d = colon + 1; d < t + tl && *d >= '0' && *d <= '9'; d++) {
+				ms = ms * 10 + (uint32_t)(*d - '0');
+			}
+			done_mask |= 1U << idx;
+			if (ms > 60000) {
+				ms = 60000;
+			}
+			printf("SWEET EXEC: delaying first exec of %s by %u ms (usermanagerd must check in first)\n", leaf, ms);
+			delay_for_interval(ms, 1000 * 1000);
+			printf("SWEET EXEC: %s continues\n", leaf);
+			return;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
