+	 * accepts arm64 slices for the process (GradedArchs keysOff).
+	 */
+	if (sweet_arm64e_enabled() &&
+	    (imgp->ip_origcpusubtype & ~CPU_SUBTYPE_MASK) == CPU_SUBTYPE_ARM64E) {
+		error = exec_add_user_string(imgp, CAST_USER_ADDR_T("ptrauth_disabled=1"), UIO_SYSSPACE, FALSE);
