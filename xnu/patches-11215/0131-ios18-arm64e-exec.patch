+/*
+ * Op 0x5a = amfi_check_dyld_policy_self(uint64_t input, uint64_t *output).
+ * libamfi (iOS 18 dyld) calls __sandbox_ms("AMFI", 0x5a, &req) with
+ * struct { uint64_t input_flags; uint64_t *output_flags; } (disassembled in
+ * dyld 22H352: stp output-slot,input to sp+8/sp+0x10, [sp+0x18] = &output).
+ * ENOPOLICY makes dyld treat the process as restricted: no DYLD_* env vars,
+ * no @-paths, no DYLD_PRINT_*. For arm64e processes (iOS 18 userland, only
+ * with sweetarm64e=1) every AMFI_DYLD_OUTPUT_ALLOW_* bit (0x3ff) is granted.
+ */
+#define SWEET_AMFI_OP_DYLD_POLICY       0x5a
+#define SWEET_AMFI_DYLD_ALLOW_ALL       0x3ffULL
+
+struct sweet_amfi_dyld_policy_req {
+	uint64_t        input_flags;
+	user_addr_t     output_flags;
+};
