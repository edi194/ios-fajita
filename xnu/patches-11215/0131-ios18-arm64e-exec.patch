+/*
+ * Boot-arg sweetarm64e=1: run iOS 18 arm64e userland on this CPU, which has no
+ * pointer authentication (docs/IOS18_PORT.md). Everything it enables is keyed
+ * on the Mach-O CPU subtype being arm64e, so arm64 (iOS 16) processes are
+ * unaffected: grade_binary() accepts arm64e (bsd/dev/arm/kern_machdep.c),
+ * exec tells dyld "ptrauth_disabled=1" (below) and the AMFI "AMFI" policy
+ * answers dyld's policy query (sweet_amfi.c). The binaries themselves are
+ * rewritten offline to contain no PAC instructions (tools/ios18/pacstrip.py).
+ */
+bool
+sweet_arm64e_enabled(void)
+{
+	static int state = -1;
+	if (state < 0) {
+		uint32_t v = 0;
+		state = PE_parse_boot_argn("sweetarm64e", &v, sizeof(v)) && v != 0;
+	}
+	return state > 0;
+}
+
+bool
+sweet_proc_is_arm64e(struct proc *p)
+{
+	return p != PROC_NULL && p->p_cputype == CPU_TYPE_ARM64 &&
+	       (p->p_cpusubtype & ~CPU_SUBTYPE_MASK) == CPU_SUBTYPE_ARM64E;
+}
+
