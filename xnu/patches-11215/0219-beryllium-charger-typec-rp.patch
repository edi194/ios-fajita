diff --git a/bsd/dev/sweet_charger.c b/bsd/dev/sweet_charger.c
--- a/bsd/dev/sweet_charger.c
+++ b/bsd/dev/sweet_charger.c
@@ -24,6 +24,12 @@
  *                    No QC / HVDCP 9 V negotiation, no JEITA or termination
  *                    changes, no watchdog, no type-C role: SWEET SPMI only lets the
  *                    seven registers of sweet_spmi.c sp_write_allowed through.
+ *                    Type-C Rp (patch 0219, after downstream smb-lib.c / mainline qcom_smbx.c): OCP is
+ *                    handled like DCP (a USB-C charger often classifies as OCP, downstream maps OCP to
+ *                    USB_DCP): Rp 3.0 A -> the ICL ceiling, otherwise 1800 mA (downstream DCP_CURRENT_UA;
+ *                    1500 mA with AICL off); FLOAT 1000 mA (downstream FLOAT_CHARGER_UA); SDP untouched.
+ *                    A Rp change (CC re-vote) is treated like a new APSD result. kern.sweet_charger
+ *                    shows typec_rp= (0 none/invalid, 1 default, 2 1.5 A, 3 3.0 A) and icl_sel_ma=.
  *   sweetcharger_icl=<mA>  lowers the ICL ceiling (100..2000), e.g. 1500 = mainline
  *   sweetcharger_fcc=<mA>  lowers the FCC (500..2000), e.g. 1000 = mainline
  *
@@ -43,7 +49,9 @@
  *          0x1090 JEITA_EN_CFG (log only)
  *   USBIN  0x1306 INPUT_STATUS (5 V / 9 V / 12 V bands)  0x1307 APSD_STATUS [0] done
  *          0x1308 APSD_RESULT [6] QC3 [5] QC2 [4] float [3] DCP [2] CDP [1] OCP [0] SDP
- *          0x130B TYPE_C_STATUS_1   0x130E TYPE_C_STATUS_4 (log only)
+ *          0x130B TYPE_C_STATUS_1 [7] UFP Rp default (USB 500/900) [6] Rp 1.5 A [5] Rp 3.0 A (smb-reg.h)
+ *          0x130E TYPE_C_STATUS_4 [7] DFP mode [6] VBUS [5] VBUS error [4] debounce done [3] audio adapter
+ *                 [0] CC attached
  *          0x1310 INT_RT_STS [4] USBIN plugged in
  *          0x1340 USBIN_CMD_IL [0] suspend   0x1362 USBIN_OPTIONS_1 [2] HVDCP_EN (log only)
  *          0x1365 USBIN_LOAD_CFG [4] ICL_OVERRIDE_AFTER_APSD
@@ -85,6 +93,8 @@ void sweet_charger_start(void);
 #define SC_ICL_DCP_MA           2000u
 #define SC_ICL_CDP_MA           1500u
 #define SC_ICL_HVDCP_MA         1500u
+#define SC_ICL_OCP_MA           1800u   /* OCP treated as DCP, Rp not 3.0 A (downstream DCP_CURRENT_UA) */
+#define SC_ICL_FLOAT_MA         1000u   /* downstream FLOAT_CHARGER_UA */
 #define SC_ICL_NO_AICL_MA       1500u   /* AICL off: no automatic back-off from a weak adapter */
 #define SC_FCC_MA               2000u
 #define SC_FV_RAW_MAX           121u    /* 3487.5 mV + 121 * 7.5 mV = 4395 mV <= 4400 mV */
@@ -167,7 +177,8 @@ static struct {
 	uint8_t applied_res;
 	uint8_t applied_icl_raw, applied_fcc_raw;
 	bool last_plug;
-	uint8_t last_res;
+	uint8_t last_res, last_rp, applied_rp;
+	unsigned icl_sel;               /* last ICL (mA) the policy chose, 0 = hardware */
 	unsigned stable, safe, bad;
 	unsigned writes, write_fails, applies, restores;
 	bool event;
@@ -289,11 +300,30 @@ sc_unsafe(const struct sc_snap *s)
 	return (s->st2 & 0x6fu) != 0 || (s->st7 & 0x0fu) != 0;
 }
 
-/* input current limit (mA) for an APSD result; 0 = leave the hardware alone */
+/*
+ * Rp the source advertises (TYPE_C_STATUS_1 [7:5]): 0 none / invalid, 1 default USB, 2 1.5 A, 3 3.0 A.
+ * Valid only for an attached UFP with VBUS, debounce done, no VBUS error, no audio adapter and exactly one Rp bit.
+ * There is no PD stack: the source stays at 5 V and Rp is the current it promises at 5 V.
+ */
+static uint8_t
+sc_typec_rp(const struct sc_snap *s)
+{
+	uint8_t t4 = s->typec4, t1 = s->typec1 & 0xe0u;
+
+	if (!sc_have(s, R_TYPEC1) || !sc_have(s, R_TYPEC4)) {
+		return 0;
+	}
+	if (!(t4 & 0x01u) || (t4 & 0x80u) || !(t4 & 0x40u) || !(t4 & 0x10u) || (t4 & 0x28u)) {
+		return 0;
+	}
+	return t1 == 0x80u ? 1 : t1 == 0x40u ? 2 : t1 == 0x20u ? 3 : 0;
+}
+
+/* input current limit (mA) for the source; 0 = leave the hardware alone (SDP, none) */
 static unsigned
-sc_icl_for(uint8_t res)
+sc_icl_for(const struct sc_snap *s)
 {
-	res &= 0x7fu;
+	uint8_t res = s->apsd_res & 0x7fu;
 	if (res & (APSD_QC3 | APSD_QC2)) {
 		return SC_ICL_HVDCP_MA;
 	}
@@ -303,6 +333,12 @@ sc_icl_for(uint8_t res)
 	if (res & APSD_CDP) {
 		return SC_ICL_CDP_MA;
 	}
+	if (res & APSD_OCP) {
+		return sc_typec_rp(s) == 3 ? SC_ICL_DCP_MA : SC_ICL_OCP_MA;
+	}
+	if (res & APSD_FLOAT) {
+		return SC_ICL_FLOAT_MA;
+	}
 	return 0;
 }
 
@@ -339,6 +375,7 @@ sc_format(char *buf, size_t size, const struct sc_snap *s)
 	} else {
 		n = sc_cat(buf, size, n, " apsd=n/a apsd_raw=n/a");
 	}
+	n = sc_cat(buf, size, n, " typec_rp=%u", sc_typec_rp(s));
 	n = sc_cat(buf, size, n, " apsd_done=%d", NA_U(s, R_APSD_STATUS, s->apsd_st & 1u));
 	if (sc_have(s, R_USBIN_STATUS)) {
 		n = sc_cat(buf, size, n, " usbin_band=%s", (s->usbin & 0x20u) ? "12v" : (s->usbin & 0x18u) ? "9v" :
@@ -383,7 +420,7 @@ sc_format(char *buf, size_t size, const struct sc_snap *s)
 	n = sc_cat_hex(buf, size, n, "jeita_en", sc_have(s, R_JEITA_EN), s->jeita);
 	n = sc_cat_hex(buf, size, n, "aicl_st", sc_have(s, R_AICL_STATUS), s->aicl_stat);
 	if (sc_mode == 2) {
-		n = sc_cat(buf, size, n, " applied=%s", cs.applied ? sc_apsd_name(cs.applied_res) : "none");
+		n = sc_cat(buf, size, n, " applied=%s icl_sel_ma=%u", cs.applied ? sc_apsd_name(cs.applied_res) : "none", cs.icl_sel);
 		n = sc_cat(buf, size, n, " cap_icl_ma=%u cap_fcc_ma=%u writes=%u write_fails=%u applies=%u restores=%u why=%s",
 		    sc_icl_cap_ma, sc_fcc_ma, cs.writes, cs.write_fails, cs.applies, cs.restores,
 		    cs.why ? cs.why : "-");
@@ -482,11 +519,12 @@ sc_control(struct sc_snap *s)
 	}
 	bool plug = (s->rt_sts & 0x10u) != 0;
 	uint8_t res = s->apsd_res & 0x7fu;
+	uint8_t rp = sc_typec_rp(s);
 	bool done = (s->apsd_st & 1u) != 0;
 
-	if (plug != cs.last_plug || res != cs.last_res || !done) {
+	if (plug != cs.last_plug || res != cs.last_res || rp != cs.last_rp || !done) {
 		cs.stable = 0;
-		if (plug != cs.last_plug || res != cs.last_res) {
+		if (plug != cs.last_plug || res != cs.last_res || rp != cs.last_rp) {
 			cs.event = true;
 		}
 	} else if (cs.stable < 255u) {
@@ -494,6 +532,7 @@ sc_control(struct sc_snap *s)
 	}
 	cs.last_plug = plug;
 	cs.last_res = res;
+	cs.last_rp = rp;
 
 	if (!plug) {
 		cs.safe = 0;
@@ -511,21 +550,22 @@ sc_control(struct sc_snap *s)
 	if (cs.safe < 255u) {
 		cs.safe++;
 	}
-	if (cs.applied && cs.applied_res != res) {
-		sc_restore(s, "apsd-changed");
+	if (cs.applied && (cs.applied_res != res || cs.applied_rp != rp)) {
+		sc_restore(s, "apsd-or-rp-changed");
 	}
 	if (cs.stable < 1 || cs.safe < 3) {
 		cs.why = "settling";
 		return 0;
 	}
 
-	unsigned icl = sc_icl_for(res);
+	unsigned icl = sc_icl_for(s);
 	if (icl > sc_icl_cap_ma) {
 		icl = sc_icl_cap_ma;
 	}
 	if (icl && !(s->aicl_opt & 4u) && icl > SC_ICL_NO_AICL_MA) {
 		icl = SC_ICL_NO_AICL_MA;
 	}
+	cs.icl_sel = icl;
 	unsigned fcc = sc_fcc_ma;
 	int wrote = 0, r;
 	uint8_t o_icl = s->icl_cfg, o_opt = s->icl_opt, o_load = s->load, o_fcc = s->fcc;
@@ -578,6 +618,7 @@ sc_control(struct sc_snap *s)
 	if (icl) {
 		cs.applied = true;
 		cs.applied_res = res;
+		cs.applied_rp = rp;
 	}
 	return wrote;
 }
