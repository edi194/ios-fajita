 #define RH_TRIGGER      (1u << 24)
 #define RH_ISSUED       (1u << 8)
 #define RH_COMPLETE     (1u << 16)
+
+/*
+ * The bases are board dependent: SM7150 (sweet) keeps the apps RSC at 0x18220000 with its TCS at
+ * 0x18220d00, while SDM845 (fajita) has them at 0x179e0000 and 0x179e0d00 (vendor dts
+ * mailbox@179e0000). Writing a TCS at the wrong base hangs the bus and freezes the SoC, so they can be
+ * overridden from the command line (rpmhrsc=, rpmhtcs=, hex) and otherwise keep the sweet values.
+ */
+static uint32_t rh_rsc_pa = RH_RSC_PA, rh_tcs_pa = RH_TCS_PA;
+static bool rh_bases_parsed;
+
+static void
+rh_parse_bases(void)
+{
+	uint32_t v;
+
+	if (rh_bases_parsed) {
+		return;
+	}
+	rh_bases_parsed = true;
+	if (PE_parse_boot_argn("rpmhrsc", &v, sizeof(v)) && v != 0) {
+		rh_rsc_pa = v;
+	}
+	if (PE_parse_boot_argn("rpmhtcs", &v, sizeof(v)) && v != 0) {
+		rh_tcs_pa = v;
+	}
+}
 #define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
 #define RH_DB_MAGIC     0x0c0330dbu
 #define RH_DB_HEADER    144u
