+/* Invalidate the context's TLB after a batch of map calls (walks may be cached for tables that were still empty). */
+void
+sweet_gpu_vm_flush(void)
+{
+	if (a630_dev.ready) {
+		gvm_tlb_flush();
+	}
+}
+
+/*
+ * A translation fault of the CP's context bank 1 (FSR fault bits; bit 10 is a status bit that read 0x400 from
+ * boot on hardware and is ignored). Logs it, clears it, and declares the GPU lost: the CP is wedged on the faulting
+ * access (the context terminates instead of stalling, but the CP does not recover) and nothing is reset here.
+ */
+bool
+sweet_gpu_check_fault(void)
+{
+	vm_offset_t b;
+	uint32_t fsr;
+
+	if (!a630_dev.ready || !smmu_base) {
+		return false;
+	}
+	b = smmu_base + SMMU_CB(CP_CB);
+	fsr = gpu_rd(b, SMMU_CB_FSR);
+	if (!(fsr & 0xc00001feu)) {
+		return false;
+	}
+	printf("SWEET GPU: SMMU CB%u FAULT: FSR %#x FAR %#x%08x FSYNR0 %#x\n", CP_CB, fsr,
+	    gpu_rd(b, SMMU_CB_FAR + 4), gpu_rd(b, SMMU_CB_FAR), gpu_rd(b, SMMU_CB_FSYNR0));
+	gpu_wr(b, SMMU_CB_FSR, fsr);
+	if (!a630_dev.lost) {
+		a630_dev.lost = true;
+		a630_dev.hangs++;
+		sweet_gpu_report("GPU LOST (SMMU fault)");
+	}
+	return true;
+}
