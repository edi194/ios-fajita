diff --git a/iokit/Kernel/arm/SweetNetwork.cpp b/iokit/Kernel/arm/SweetNetwork.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3c97872a5ae4caa0e27e671bce60d9897bba8c80
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNetwork.cpp
@@ -0,0 +1,260 @@
+/*
+ * SWEET: IOKit stand-ins so iOS configd adopts the kernel's USB Ethernet
+ * ifnet (bsd/dev/sweet_usb.c, "ue0") as a network service.
+ *
+ * Ported from anonbeat1/ios-sweet (Nothing Phone (1) / Spacewar) patches
+ * 0092 (commit 6ac39a4c1, plus the IOPlatformExpert.h include fix 2dd5af44f)
+ * and 0093 (commit 0a377a715, process-name trace of IONetworkStack opens)
+ * (https://github.com/anonbeat1/ios-sweet). The class layout, the property
+ * set and the publish sequence are theirs; changes here: a common base that
+ * logs every user-client open request (stack, controller, interface) with
+ * the calling process name, a return value / extra log lines, and the
+ * board guard.
+ *
+ * configd (configd-1241.140.6) builds its interface list from IOKit, not
+ * from BSD ifnets: SCNetworkInterface.c createInterface() walks an object
+ * that conforms to "IONetworkInterface" (IOInterfaceType, IOBuiltin, BSD
+ * Name, IOInterfaceNamePrefix, IOInterfaceUnit), its parent controller
+ * (IOMACAddress, SelfNamed) and the controller's parent (bus). Apple's
+ * IONetworkingFamily kext is not part of this kernel, so these classes
+ * carry the same names with only those properties.
+ *
+ * InterfaceNamer only processes interfaces once it can open the
+ * "IONetworkStack" service; the controller is SelfNamed, so the stack never
+ * receives naming commands and its user client does nothing.
+ *
+ * An interface that is built-in and has HiddenConfiguration counts as
+ * "Apple pre-configured" (_SCNetworkInterfaceIsApplePreconfigured):
+ * PreferencesMonitor creates its network service itself, with the
+ * template overrides from "NetworkConfigurationOverrides" (IPv4 manual
+ * address/router, DNS servers). No preferences.plist edit is needed.
+ *
+ * All log lines start with "SWEET NET:".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <sys/proc.h>
+#include <libkern/OSAtomic.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+
+/*
+ * Common base: log which process asks for a user client on any of our
+ * objects (the first 64 requests), then behave like IOService (the stack
+ * has kIOUserClientClassKey set so it succeeds; the others answer
+ * kIOReturnUnsupported, as an IOService without a user client does).
+ */
+class SweetNetService : public IOService {
+	OSDeclareDefaultStructors(SweetNetService);
+public:
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+	using IOService::newUserClient;
+};
+OSDefineMetaClassAndStructors(SweetNetService, IOService);
+
+IOReturn
+SweetNetService::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	static volatile SInt32 count;
+	IOReturn ret = IOService::newUserClient(owningTask, securityID, type, properties, handler);
+	if (OSIncrementAtomic(&count) < 64) {
+		char name[32] = "?";
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET NET: %s opened %s user client (type %u): 0x%x\n",
+		    name, getMetaClass()->getClassName(), (unsigned)type, (unsigned)ret);
+	}
+	return ret;
+}
+
+class IONetworkInterface : public SweetNetService {
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, SweetNetService);
+
+class IOEthernetInterface : public IONetworkInterface {
+	OSDeclareDefaultStructors(IOEthernetInterface);
+};
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+class SweetEthernetController : public SweetNetService {
+	OSDeclareDefaultStructors(SweetEthernetController);
+};
+OSDefineMetaClassAndStructors(SweetEthernetController, SweetNetService);
+
+class SweetNetworkBus : public IOService {
+	OSDeclareDefaultStructors(SweetNetworkBus);
+};
+OSDefineMetaClassAndStructors(SweetNetworkBus, IOService);
+
+class IONetworkStack : public SweetNetService {
+	OSDeclareDefaultStructors(IONetworkStack);
+};
+OSDefineMetaClassAndStructors(IONetworkStack, SweetNetService);
+
+class SweetNetworkStackUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetNetworkStackUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(SweetNetworkStackUserClient, IOUserClient);
+
+IOReturn
+SweetNetworkStackUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static OSArray *
+sweet_net_strings(const char *a, const char *b)
+{
+	OSArray *arr = OSArray::withCapacity(2);
+	if (arr == NULL) {
+		return NULL;
+	}
+	const char *v[2] = { a, b };
+	for (unsigned i = 0; i < 2; i++) {
+		if (v[i] == NULL) {
+			continue;
+		}
+		OSString *s = OSString::withCString(v[i]);
+		if (s != NULL) {
+			arr->setObject(s);
+			s->release();
+		}
+	}
+	return arr;
+}
+
+/* Attach obj under provider and publish it; drops the caller's reference. */
+static bool
+sweet_net_attach(IOService *obj, IOService *provider)
+{
+	bool ok = obj->attach(provider);
+	if (ok) {
+		obj->registerService();
+	}
+	obj->release();
+	return ok;
+}
+
+static void
+sweet_net_set_overrides(IOService *intf, const char *ip, const char *mask,
+    const char *router, const char *dns1, const char *dns2)
+{
+	OSDictionary *ov = OSDictionary::withCapacity(2);
+	OSDictionary *v4 = OSDictionary::withCapacity(4);
+	OSDictionary *dns = OSDictionary::withCapacity(1);
+	OSArray *addrs = sweet_net_strings(ip, NULL);
+	OSArray *masks = sweet_net_strings(mask, NULL);
+	OSArray *servers = sweet_net_strings(dns1, dns2);
+	OSString *method = OSString::withCString("Manual");
+	OSString *gw = OSString::withCString(router);
+
+	if (ov && v4 && dns && addrs && masks && servers && method && gw) {
+		v4->setObject("ConfigMethod", method);
+		v4->setObject("Addresses", addrs);
+		v4->setObject("SubnetMasks", masks);
+		v4->setObject("Router", gw);
+		dns->setObject("ServerAddresses", servers);
+		ov->setObject("IPv4", v4);
+		ov->setObject("DNS", dns);
+		intf->setProperty("NetworkConfigurationOverrides", ov);
+	}
+	OSSafeReleaseNULL(ov);
+	OSSafeReleaseNULL(v4);
+	OSSafeReleaseNULL(dns);
+	OSSafeReleaseNULL(addrs);
+	OSSafeReleaseNULL(masks);
+	OSSafeReleaseNULL(servers);
+	OSSafeReleaseNULL(method);
+	OSSafeReleaseNULL(gw);
+}
+
+/*
+ * Publish bus -> controller -> interface for one BSD ifnet, plus the
+ * IONetworkStack (once). Called by sweet_usb.c after creating its ifnet.
+ * Returns 1 when the interface object was published, else 0.
+ */
+extern "C" int
+sweet_net_publish(const char *bsd_name, const char *prefix, unsigned unit,
+    const uint8_t *mac, const char *ip, const char *mask, const char *router,
+    const char *dns1, const char *dns2)
+{
+	static bool stack_published;
+	IOService *platform = IOService::getPlatform();
+
+	if (platform == NULL) {
+		IOLog("SWEET NET: no platform expert; IOKit interface not published\n");
+		return 0;
+	}
+
+	if (!stack_published) {
+		IONetworkStack *stack = OSTypeAlloc(IONetworkStack);
+		if (stack != NULL && stack->init()) {
+			stack->setProperty(kIOUserClientClassKey, "SweetNetworkStackUserClient");
+			stack_published = sweet_net_attach(stack, platform);
+		} else {
+			OSSafeReleaseNULL(stack);
+		}
+	}
+
+	SweetNetworkBus *bus = OSTypeAlloc(SweetNetworkBus);
+	if (bus == NULL || !bus->init()) {
+		OSSafeReleaseNULL(bus);
+		return 0;
+	}
+	bus->setName("sweet-usb");
+	bus->retain();          /* keep it until the controller is attached */
+	if (!sweet_net_attach(bus, platform)) {
+		bus->release();
+		return 0;
+	}
+
+	SweetEthernetController *ctrl = OSTypeAlloc(SweetEthernetController);
+	if (ctrl == NULL || !ctrl->init()) {
+		OSSafeReleaseNULL(ctrl);
+		bus->release();
+		return 0;
+	}
+	ctrl->setProperty("IOMACAddress", (void *)mac, 6);
+	ctrl->setProperty("SelfNamed", kOSBooleanTrue);
+	ctrl->retain();
+	bool ctrl_ok = sweet_net_attach(ctrl, bus);
+	bus->release();
+	if (!ctrl_ok) {
+		ctrl->release();
+		return 0;
+	}
+
+	IOEthernetInterface *intf = OSTypeAlloc(IOEthernetInterface);
+	if (intf == NULL || !intf->init()) {
+		OSSafeReleaseNULL(intf);
+		ctrl->release();
+		return 0;
+	}
+	intf->setProperty("IOInterfaceType", 6ULL, 32);         /* IFT_ETHER */
+	intf->setProperty("IOBuiltin", kOSBooleanTrue);
+	intf->setProperty("IOPrimaryInterface", kOSBooleanFalse);
+	intf->setProperty("BSD Name", bsd_name);
+	intf->setProperty("IOInterfaceNamePrefix", prefix);
+	intf->setProperty("IOInterfaceUnit", (unsigned long long)unit, 32);
+	intf->setProperty("HiddenConfiguration", kOSBooleanTrue);
+	sweet_net_set_overrides(intf, ip, mask, router, dns1, dns2);
+	bool intf_ok = sweet_net_attach(intf, ctrl);
+	ctrl->release();
+
+	IOLog("SWEET NET: IOKit interface %s %s (built-in, pre-configured %s via %s, DNS %s %s, stack %s)\n",
+	    bsd_name, intf_ok ? "published" : "NOT published", ip, router, dns1, dns2,
+	    stack_published ? "up" : "missing");
+	return intf_ok ? 1 : 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
