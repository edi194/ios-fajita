+/*
+ * Boot-arg sweetnet: publish ue0 to IOKit (SweetNetwork.cpp) so configd
+ * adopts it as a built-in, pre-configured service (static address, router
+ * 192.168.7.1, DNS 1.1.1.1 / 8.8.8.8). Default on for the Poco F1 (this code
+ * only runs with sweetusb=2), off elsewhere; sweetnet=0 disables.
+ * sweetnetroute=1 additionally adds the default route from the kernel.
+ */
+static void
+ud_net_start(void)
+{
+	int net = sweet_board_beryllium() ? 1 : 0;
+	int route = 0;
+
+	PE_parse_boot_argn("sweetnet", &net, sizeof(net));
+	PE_parse_boot_argn("sweetnetroute", &route, sizeof(route));
+	if (ud.ifp == NULL) {
+		return;
+	}
+	ud.net_route = route;
+	if (!net) {
+		printf("SWEET NET: disabled (boot-arg sweetnet=0); IOKit interface not published%s\n",
+		    route ? ", kernel default route still enabled" : "");
+		return;
+	}
+	printf("SWEET NET: publishing ue0 to IOKit (sweetnet=%d, sweetnetroute=%d)\n", net, route);
+	int ok = sweet_net_publish("ue0", "ue", 0, ud_phone_mac, "192.168.7.2", "255.255.255.0",
+	    "192.168.7.1", "1.1.1.1", "8.8.8.8");
+	printf("SWEET NET: IOKit publish %s\n", ok ? "done" : "FAILED");
+}
+
+/*
+ * Fallback for configd ignoring ue0 (boot-arg sweetnetroute=1, off by
+ * default): add 0.0.0.0/0 via 192.168.7.1 with a PF_ROUTE RTM_ADD sent from
+ * the kernel (what route(8) does). Runs in its own short-lived thread at
+ * link-up, a moment after the ifnet is up, so the USB control path never
+ * waits on the routing locks. EEXIST (already routed, e.g. by configd) is fine.
+ */
+struct ud_rtmsg {
+	struct rt_msghdr        hdr;
+	struct sockaddr_in      dst, gw, mask;
+};
+
+static void
+ud_route_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	struct ud_rtmsg m;
+	socket_t so = NULL;
+	errno_t err;
+
+	ud_sleep_ms(500);
+	err = sock_socket(PF_ROUTE, SOCK_RAW, 0, NULL, NULL, &so);
+	if (err == 0) {
+		bzero(&m, sizeof(m));
+		m.hdr.rtm_msglen = sizeof(m);
+		m.hdr.rtm_version = RTM_VERSION;
+		m.hdr.rtm_type = RTM_ADD;
+		m.hdr.rtm_flags = RTF_UP | RTF_GATEWAY | RTF_STATIC;
+		m.hdr.rtm_addrs = RTA_DST | RTA_GATEWAY | RTA_NETMASK;
+		m.hdr.rtm_seq = 1;
+		m.dst.sin_len = sizeof(m.dst);
+		m.dst.sin_family = AF_INET;
+		m.gw.sin_len = sizeof(m.gw);
+		m.gw.sin_family = AF_INET;
+		m.gw.sin_addr.s_addr = htonl(0xc0a80701);       /* 192.168.7.1 */
+		m.mask.sin_len = sizeof(m.mask);
+		m.mask.sin_family = AF_INET;
+		struct iovec iov = { .iov_base = &m, .iov_len = sizeof(m) };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		err = sock_send(so, &msg, 0, &sent);
+		sock_close(so);
+	}
+	printf("SWEET NET: default route via 192.168.7.1 on ue0: %s (errno %d)\n",
+	    err == 0 ? "added" : (err == EEXIST ? "already present" : "FAILED"), (int)err);
+	ud.route_thread = 0;
+}
+
+static void
+ud_route_kick(void)
+{
+	thread_t thread;
+
+	if (!OSCompareAndSwap(0, 1, &ud.route_thread)) {
+		return;
+	}
+	if (kernel_thread_start(ud_route_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		ud.route_thread = 0;
+	}
+}
