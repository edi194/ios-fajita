@@ -2483,9 +2483,16 @@
 #define GVM_BASE                0x80000000ull
 #define GVM_END                 0x100000000ull
 #define GVM_GUARD               0x1000ull       /* unmapped page after every kernel-placed buffer */
-#define GVM_MAXFREE             512
+#define GVM_MAXFREE             4096            /* 0237: was 512; a full list drops freed ranges (address space lost) */
 #define PTP_TABLE               0x1000ull       /* a GPU table is 4 KiB; xnu's PAGE_SIZE is 16 KiB: never use PAGE_SIZE for GPU pages */
-#define PTP_PAGES               256             /* 1 MiB of tables: 2 L2 + up to 254 L3 (2 MiB each) */
+/*
+ * 0237: tables for the whole window. Table pages are taken on first touch of each 2 MiB and never given back, and
+ * first-fit placement walks upward through the 2 GiB as buffers come and go, so 256 (2 L2 + 254 L3 = 508 MiB ever
+ * touched) ran out a while into every boot: small buffers still fitted in regions that had tables, while every
+ * full-screen render target (10-24 MB) needed fresh ones and GEM_NEW failed (Control Center without its backdrop,
+ * a flat wallpaper). 2 L2 + 1024 L3 cover 0x80000000-0x100000000; 1028 keeps the pool a whole number of 16 KiB pages.
+ */
+#define PTP_PAGES               1028            /* 4 MiB of tables: 2 L2 + 1024 L3 (2 MiB each) + 2 spare */
 
