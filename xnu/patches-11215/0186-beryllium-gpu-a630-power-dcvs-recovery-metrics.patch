+/* ---- DCVS ---- */
+
+static bool
+gpu_set_level(unsigned lvl)
+{
+	uint32_t m[4] = { MSG_HDR(30 /* H2F_MSG_GX_BW_PERF_VOTE */, 4, 0), 1 /* blocking ack */, lvl, 0 }, ack[19];
+
+	a630_quiet = 1;
+	bool ok = hfi_cmd("GX_BW_PERF_VOTE", m, 4, ack, 19);
+	a630_quiet = 0;
+	if (ok) {
+		a630_level = lvl;
+	} else {
+		printf("SWEET GPU: GX level vote %u failed; governor off\n", lvl);
+		a630_gov = 0;
+	}
+	return ok;
+}
+
+static uint64_t gov_win_start, gov_busy_pct, res_ns[8];
+static unsigned gov_low_windows;
+
+/* Busy ticks (19.2 MHz) of the submissions completed since the last call, from the CP's own stamps. */
+static uint64_t
+gpu_busy_collect(void)
+{
+	volatile uint32_t *fw = (volatile uint32_t *)(cp_memory + SCRATCH_OFF + SCRATCH_FENCE);
+	volatile uint32_t *t = (volatile uint32_t *)(cp_memory + SCRATCH_OFF + SCRATCH_TIMES);
+	uint32_t done = *fw, from = a630_timed;
+	uint64_t busy = 0;
+
+	if (done - from > 64) {
+		from = done - 64;
+	}
+	while (from != done) {
+		from++;
+		uint32_t slot = from % 64;
+		uint64_t st = ((uint64_t)t[4 * slot + 1] << 32) | t[4 * slot], en = ((uint64_t)t[4 * slot + 3] << 32) | t[4 * slot + 2];
+		if (en > st && en - st < 19200000ull * 5) {
+			busy += en - st;
+		}
+	}
+	a630_timed = done;
+	return busy;
+}
+
+static void
+gpu_gov_tick(void)
+{
+	if (gov_win_start == 0) {
+		gov_win_start = mach_absolute_time();
+		(void)gpu_busy_collect();
+		return;
+	}
+	uint64_t ns = ns_since(gov_win_start);
+	if (ns < 60 * NSEC_PER_MSEC) {
+		return;
+	}
+	uint64_t ticks = ns * 192 / 10000, busy = gpu_busy_collect();
+	gov_busy_pct = MIN(100, busy * 100 / (ticks ? ticks : 1));
+	gov_win_start = mach_absolute_time();
+	unsigned lvl = a630_level;
+	if (gov_busy_pct >= 80) {
+		lvl = gov_busy_pct >= 95 ? a630_level_max : MIN(a630_level + 1, a630_level_max);
+		gov_low_windows = 0;
+	} else if (gov_busy_pct < 30) {
+		if (++gov_low_windows >= 2 && lvl > 1) {        /* hysteresis: two quiet windows per step down */
+			lvl--;
+			gov_low_windows = 0;
+		}
+	} else {
+		gov_low_windows = 0;
+	}
+	if (lvl != a630_level) {
+		(void)gpu_set_level(lvl);
+	}
+}
