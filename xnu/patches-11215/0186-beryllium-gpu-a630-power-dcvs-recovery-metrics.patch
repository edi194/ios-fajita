+
+/*
+ * Power management (idle slumber, governor) repeats the whole GMU/HFI/CP bring-up on every wake. While a630_quiet is
+ * set only lines that report a failure are printed and the UFS log sync is skipped; everything else of a wake is silent.
+ */
+static int a630_quiet;
+static void a630_printf(const char *fmt, ...) __printflike(1, 2);
+static void
+a630_printf(const char *fmt, ...)
+{
+	char buf[352];
+	va_list ap;
+	static const char *const keep[] = { "TIMED OUT", "FAIL", "fail", "LOST", "FAULT", "no reply", "NOT ", "error", "refused", "not " };
+
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (a630_quiet) {
+		bool wanted = false;
+		for (unsigned i = 0; i < sizeof(keep) / sizeof(keep[0]); i++) {
+			wanted |= strnstr(buf, keep[i], sizeof(buf)) != NULL;
+		}
+		if (!wanted) {
+			return;
+		}
+	}
+	printf("%s", buf);
+}
+#define printf a630_printf
+#define sweet_log_sync() (a630_quiet ? (void)0 : (sweet_log_sync)())
