+/* Stage 8 power: lock, slumber/wake, recovery, DCVS, metrics          */
+/* ------------------------------------------------------------------ */
+
+/*
+ * One lock for everything above (taken by the IOKit side around every call, and by the PM thread). Wake from slumber
+ * re-runs the stage-5/7 sequence that is known to work (GMU cold boot from the kept firmware, HFI, GX rail, SPTPRAC,
+ * OOB, CP hw_init + SQE + ME_INIT, CP_SET_SECURE_MODE 0; the zap stays authenticated in the secure world, as in Linux).
+ */
+static void gpu_gmu_reset(void);
+
+static LCK_GRP_DECLARE(a630_lck_grp, "sweetgpu");
+static LCK_MTX_DECLARE(a630_mtx, &a630_lck_grp);
+
+void
+sweet_gpu_lock(void)
+{
+	lck_mtx_lock(&a630_mtx);
+}
+
+void
+sweet_gpu_unlock(void)
+{
+	lck_mtx_unlock(&a630_mtx);
+}
