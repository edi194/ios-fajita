+static uint64_t
+ns_since(uint64_t t)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t, &ns);
+	return ns;
+}
+
+static bool
+gpu_cp_idle_now(void)
+{
+	return gpu_r(A6XX_CP_RB_RPTR) == ring_wptr && sweet_gpu_fence_done(a630_dev.seqno);
+}
+
+/* GX off through the GMU, then the GMU into reset (the stage-5 end, hardware verified). Lock held, GPU awake. */
+static bool
+gpu_suspend(bool quiet)
+{
+	a630_quiet = quiet;
+	gpu_wr(gmu, GMU_PWR_COL_KEEPALIVE, 0);
+	gmu_oob_clear(OOB_GPU);
+	gpu_gx_slumber();
+	uint32_t st = gpu_rd(gmu, GMU_RPMH_POWER_STATE);
+	gpu_gmu_reset();
+	a630_awake = false;
+	a630_suspends++;
+	a630_quiet = 0;
+	if (st != GPU_HW_SLUMBER) {
+		printf("SWEET GPU: suspend: RPMH_POWER_STATE %#x is NOT slumber\n", st);
+		return false;
+	}
+	return true;
+}
+
+static bool
+gpu_resume(void)
+{
+	bool ok = false;
+
+	a630_quiet = a630_resumes >= 2;
+	if (a630_resumes < 2) {
+		printf("SWEET GPU: waking from slumber (resume %u)\n", a630_resumes + 1);
+	}
+	if (gpu_rd(gmu, GMU_CM3_SYSRESET) != 1) {
+		gpu_wr(gmu, GMU_CM3_SYSRESET, 1);
+		delay(10);
+	}
+	gpu_hfi_table();
+	ok = gmu_fw && gpu_gmu_boot((const uint32_t *)gmu_fw, gmu_fw_size, false) && gpu_gx_rail_on() && gpu_sptprac(true) &&
+	    gpu_hfi_start() && gmu_oob_set(OOB_GPU, "gpu") && gpu_cp_hw_init() && gpu_cp_start();
+	if (ok) {
+		ring_emit(pkt7(CP_SET_SECURE_MODE, 1));
+		ring_emit(0);
+		ring_flush();
+		ok = ring_wait_idle("resume CP_SET_SECURE_MODE 0");
+	}
+	if (ok) {
+		gmu_oob_clear(OOB_BOOT_SLUMBER);
+		gpu_wr(gmu, GMU_PWR_COL_KEEPALIVE, 1);
+		a630_awake = true;
+		a630_resumes++;
+		a630_last_active = mach_absolute_time();
+	}
+	a630_quiet = 0;
+	if (!ok) {
+		printf("SWEET GPU: resume FAILED\n");
+		a630_dev.lost = true;
+		sweet_gpu_report("GPU LOST (resume failed)");
+	}
+	return ok;
+}
+
+/*
+ * Reset after a fault or hang: halt the CP, power GX down through the GMU, reset the GMU, wake again; every outstanding
+ * submission is reported complete (its results are garbage) and clients see the changed epoch. Lock held. A failed
+ * wake leaves the GPU lost.
+ */
+bool
+sweet_gpu_recover(const char *why)
+{
+	if (!a630_dev.ready || a630_recoveries >= a630_recover_max) {
+		return false;
+	}
+	a630_recoveries++;
+	printf("SWEET GPU: RECOVERY %u/%u (%s)\n", a630_recoveries, a630_recover_max, why);
+	if (a630_awake) {
+		uint32_t gx = gpu_rd(cc, GPUCC_GX_GDSCR);
+		if ((gx & GDSC_PWR_ON) && !(gpu_rd(cc, gpucc_cbcr[CC_GX_GFX3D].off) & CBCR_CLK_OFF)) {
+			gpu_w(A6XX_CP_SQE_CNTL, 3);     /* halt the SQE first (Linux a6xx_recover) */
+		}
+		gpu_wr(gmu, GMU_PWR_COL_KEEPALIVE, 0);
+		gmu_oob_clear(OOB_GPU);
+		gpu_gx_slumber();
+		gpu_gmu_reset();
+		a630_awake = false;
+	}
+	{
+		vm_offset_t b = smmu_base + SMMU_CB(CP_CB);
+		gpu_wr(b, SMMU_CB_FSR, gpu_rd(b, SMMU_CB_FSR));
+	}
+	*(volatile uint32_t *)(cp_memory + SCRATCH_OFF + SCRATCH_FENCE) = a630_dev.seqno;
+	a630_timed = a630_dev.seqno;
+	a630_dev.lost = false;
+	if (!gpu_resume()) {
+		return false;
+	}
+	printf("SWEET GPU: recovered; submissions up to %u are void\n", a630_dev.seqno);
+	return true;
+}
+
+uint32_t
+sweet_gpu_epoch(void)
+{
+	return a630_recoveries;
+}
