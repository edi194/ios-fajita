+static void
+gpu_hwcg(void)
+{
+	uint32_t sp = gpu_rd(gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL);
+
+	gpu_wr(gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL, sp & ~1u);    /* SP clock off while the gating tables are written */
+	for (unsigned i = 0; i < sizeof(a630_hwcg_tbl) / sizeof(a630_hwcg_tbl[0]); i++) {
+		gpu_w(a630_hwcg_tbl[i].reg, a630_hwcg_tbl[i].val);
+	}
+	gpu_wr(gmu, GMU_GX_SPTPRAC_CLOCK_CONTROL, sp | 1u);
+	gpu_w(0x00ae, 0x8aa8aa02);                              /* RBBM_CLOCK_CNTL, a630 */
+	gpu_wr(gmu, R(0x9309), 0x00020202);                     /* GPU_GMU_AO_GMU_CGC_MODE_CNTL */
+	gpu_wr(gmu, R(0x930a), 0x00010111);                     /* ..._DELAY_CNTL */
+	gpu_wr(gmu, R(0x930b), 0x00005555);                     /* ..._HYST_CNTL */
+	printf("SWEET GPU: hardware clock gating on (%u writes), RBBM_CLOCK_CNTL %#x\n",
+	    (unsigned)(sizeof(a630_hwcg_tbl) / sizeof(a630_hwcg_tbl[0])), gpu_r(0x00ae));
+}
