 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -109,6 +113,9 @@ void sweet_cpufreq_max(void);
 #define GOV_DOWN_SAMPLES        3u
 #define GOV_DOWN_STEP           2u
