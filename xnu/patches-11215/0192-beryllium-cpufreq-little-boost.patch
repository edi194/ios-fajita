@@ -329,18 +347,42 @@ cf_gov_step(unsigned id, struct cf_domain *d, uint64_t wall)
 	if (cf_mode != MODE_GOV) {
 		return;
 	}
+	/* A55 boost (sweetcpufreq_little_boost=1): saturated at its ceiling for 1 s -> raise it. */
+	if (id == 0 && cf_boost && d->boost_top > d->cap) {
+		if (load >= GOV_JUMP_PCT && cur >= d->eff_cap) {
+			d->calm_cnt = 0;
+			if (++d->sat_cnt >= BOOST_SAT_SAMPLES && d->eff_cap < d->boost_top) {
+				d->sat_cnt = 0;
+				d->eff_cap = (d->boost_top - d->eff_cap > BOOST_STEP) ? d->eff_cap + BOOST_STEP : d->boost_top;
+				printf("SWEET CPUFREQ: cluster%u saturated, ceiling raised to state %u (%u kHz)\n",
+				    id, d->eff_cap, d->khz[d->eff_cap]);
+			}
+		} else {
+			d->sat_cnt = 0;
+			if (load < BOOST_CALM_PCT && d->eff_cap > d->cap) {
+				if (++d->calm_cnt >= BOOST_SAT_SAMPLES) {
+					d->calm_cnt = 0;
+					d->eff_cap = d->cap;
+					printf("SWEET CPUFREQ: cluster%u calm, ceiling back to state %u (%u kHz)\n",
+					    id, d->cap, d->khz[d->cap]);
+				}
+			} else {
+				d->calm_cnt = 0;
+			}
+		}
+	}
 	uint32_t target;
 	if (load >= GOV_JUMP_PCT) {
-		target = d->cap;
+		target = d->eff_cap;
 	} else {
