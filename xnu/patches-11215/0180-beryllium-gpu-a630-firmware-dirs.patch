+static bool
+fw_from_file(const char *file, void **buf, size_t *len)
+{
+	if (!file || rootvnode == NULLVP) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(fw_dirs) / sizeof(fw_dirs[0]); i++) {
+		if (fw_from_file_in(fw_dirs[i], file, buf, len)) {
+			return true;
+		}
+	}
+	return false;
