 /*
+ * 0240: a linear copy on the 2D engine for the framebuffer's scan-out copy (SweetFramebuffer, sweetfb_scancopy=2).
+ * The CPU copy of 0235 took ~6.5 ms of every frame (11 MB through memcpy plus a clean of the source), which held the
+ * panel near 30 fps while the GPU sat 13-17 % busy. Here the copy is one CP_BLIT, the same sequence freedreno emits
+ * for a linear RGBA8 blit (fd6_blitter.cc: emit_blit_setup, emit_blit_fini), with register values from Mesa's
+ * a6xx.xml.h for chip 630: a 2D-engine copy needs no shader and no state but its own registers.
+ *
+ * Source and destination are both in the framebuffer's low pool (pooled IOSurfaces, the three scan-out buffers), so
+ * the pool is mapped into the GPU once (sweet_gpu_blit_window) and an address in it is a fixed offset. The command
+ * stream is written into a small kernel-owned buffer, one slot per call, and handed to sweet_gpu_submit like a
+ * client's; the caller waits for the returned fence before it scans the destination.
+ */
+#define A6XX_RB_2D_BLIT_CNTL            0x8c00u
+#define A6XX_GRAS_2D_BLIT_CNTL          0x8400u
+#define A6XX_SP_2D_DST_FORMAT           0xacc0u
+#define A6XX_RB_2D_UNKNOWN_8C01         0x8c01u
+#define A6XX_SP_PS_2D_SRC_INFO          0xb4c0u /* INFO, SIZE, SRC lo/hi, PITCH */
+#define A6XX_RB_2D_DST_INFO             0x8c17u /* INFO, DST lo/hi, PITCH */
+#define A6XX_GRAS_2D_SRC_TL_X           0x8401u /* TL_X, BR_X, TL_Y, BR_Y */
+#define A6XX_GRAS_2D_DST_TL             0x8405u /* TL, BR */
+#define A6XX_RB_DBG_ECO_CNTL            0x8e04u
+#define A6XX_RB_CCU_CNTL                0x8e07u
+#define BLIT_CNTL_RGBA8                 0x10f03000u     /* MASK 0xf, FMT6_8_8_8_8_UNORM, R2D_UNORM8, ROTATE_0 */
+#define SP_2D_DST_FORMAT_RGBA8          0xf180u
+#define SRC_INFO_RGBA8_LINEAR           0x500030u       /* FMT6_8_8_8_8_UNORM, TILE6_LINEAR, WZYX, UNK20, UNK22 */
+#define DST_INFO_RGBA8_LINEAR           0x30u
+#define RB_DBG_ECO_CNTL_BLIT_A630       0x05100000u     /* freedreno_devices.py, a630 magic_regs */
+#define RB_CCU_CNTL_SYSMEM_A630         0x10000000u     /* colour cache after 2 CCUs x 64 KiB of depth: bypass */
+#define CP_BLIT                         44
+#define CP_BLIT_OP_SCALE                3
+#define EVT_LABEL                       0x3f
+#define EVT_PC_CCU_FLUSH_COLOR_TS       0x1d
+#define BLIT_IB_BYTES                   0x4000u         /* one 16 KiB page: 16 slots of 1 KiB */
+#define BLIT_IB_SLOT                    0x400u
+
+void sweet_gpu_lock(void);
+void sweet_gpu_unlock(void);
+
+static vm_offset_t blit_ib;
+static uint64_t blit_ib_pa, blit_ib_iova;
+static unsigned blit_slot;
+static uint64_t blit_win_pa, blit_win_size, blit_win_iova;
+
+static uint32_t
+pkt4(unsigned reg, unsigned cnt)
+{
+	return 0x40000000u | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffffu) << 8) | (pm4_parity(reg) << 27);
+}
+
+/* Map [pa, pa+size) at a fresh GPU address; 0 on failure (nothing left mapped). */
+static uint64_t
+blit_map(uint64_t pa, uint64_t size)
+{
+	uint64_t iova = 0, taken = 0, done = 0;
+
+	if (!sweet_gpu_iova_alloc(size, &iova, &taken)) {
+		return 0;
+	}
+	for (; done < size; done += 0x1000) {
+		if (!sweet_gpu_vm_map(iova + done, pa + done, false)) {
+			sweet_gpu_vm_unmap(iova, done);
+			sweet_gpu_iova_free(iova, taken);
+			return 0;
+		}
+	}
+	sweet_gpu_vm_flush();
+	return iova;
+}
+
+/* The framebuffer's low pool, mapped for the GPU once per boot. False: no GPU copies this boot. */
+bool sweet_gpu_blit_window(uint64_t pa, uint64_t size);
+bool
+sweet_gpu_blit_window(uint64_t pa, uint64_t size)
+{
+	bool ok;
+
+	sweet_gpu_lock();
+	if (blit_win_iova == 0 && sweet_gpu_ready() && size != 0 && !(pa & 0xfff) && !(size & 0xfff)) {
+		if (!blit_ib && dma_alloc(BLIT_IB_BYTES, &blit_ib, &blit_ib_pa)) {
+			if ((blit_ib_iova = blit_map(blit_ib_pa, BLIT_IB_BYTES)) == 0) {
+				blit_ib = 0;    /* the pool page stays allocated: once per boot at most */
+			}
+		}
+		if (blit_ib && (blit_win_iova = blit_map(pa, size)) != 0) {
+			blit_win_pa = pa;
+			blit_win_size = size;
+			printf("SWEET GPU: scan-out blits on (0240): pool 0x%llx+%llu MiB at GPU 0x%llx, commands at 0x%llx\n",
+			    pa, size >> 20, blit_win_iova, blit_ib_iova);
+		}
+	}
+	ok = blit_win_iova != 0;
+	sweet_gpu_unlock();
+	return ok;
+}
+
+/*
+ * Copy w x h RGBA8 texels from src to dst (both linear, in the window, pitches multiples of 64 bytes, addresses
+ * 64-byte aligned). Returns the fence to wait for, 0 when nothing was submitted.
+ */
+uint32_t sweet_gpu_blit(uint64_t src_pa, uint32_t src_pitch, uint64_t dst_pa, uint32_t dst_pitch, uint32_t w, uint32_t h);
+uint32_t
+sweet_gpu_blit(uint64_t src_pa, uint32_t src_pitch, uint64_t dst_pa, uint32_t dst_pitch, uint32_t w, uint32_t h)
+{
+	uint32_t fence = 0;
+
+	if (w == 0 || h == 0 || w > 0x4000 || h > 0x4000 || ((src_pa | dst_pa | src_pitch | dst_pitch) & 63)) {
+		return 0;
+	}
+	sweet_gpu_lock();
+	if (blit_win_iova == 0 || a630_dev.lost ||
+	    src_pa < blit_win_pa || src_pa + (uint64_t)src_pitch * h > blit_win_pa + blit_win_size ||
+	    dst_pa < blit_win_pa || dst_pa + (uint64_t)dst_pitch * h > blit_win_pa + blit_win_size) {
+		sweet_gpu_unlock();
+		return 0;
+	}
+	uint64_t src = blit_win_iova + (src_pa - blit_win_pa), dst = blit_win_iova + (dst_pa - blit_win_pa);
+	unsigned slot = blit_slot++ % (BLIT_IB_BYTES / BLIT_IB_SLOT);
+	volatile uint32_t *ib = (volatile uint32_t *)(blit_ib + slot * BLIT_IB_SLOT);
+	uint64_t junk = blit_ib_iova + slot * BLIT_IB_SLOT + BLIT_IB_SLOT - 16;  /* the CCU flush's timestamp lands here */
+	unsigned n = 0;
+
+	ib[n++] = pkt7(CP_WAIT_FOR_IDLE, 0);
+	ib[n++] = pkt4(A6XX_RB_CCU_CNTL, 1);    /* a client batch may have left the CCU in GMEM layout */
+	ib[n++] = RB_CCU_CNTL_SYSMEM_A630;
+	ib[n++] = pkt4(A6XX_RB_2D_BLIT_CNTL, 1);
+	ib[n++] = BLIT_CNTL_RGBA8;
+	ib[n++] = pkt4(A6XX_GRAS_2D_BLIT_CNTL, 1);
+	ib[n++] = BLIT_CNTL_RGBA8;
+	ib[n++] = pkt4(A6XX_SP_2D_DST_FORMAT, 1);
+	ib[n++] = SP_2D_DST_FORMAT_RGBA8;
+	ib[n++] = pkt4(A6XX_RB_2D_UNKNOWN_8C01, 1);
+	ib[n++] = 0;
+	ib[n++] = pkt4(A6XX_SP_PS_2D_SRC_INFO, 5);
+	ib[n++] = SRC_INFO_RGBA8_LINEAR;
+	ib[n++] = w | (h << 15);                        /* SP_PS_2D_SRC_SIZE */
+	ib[n++] = (uint32_t)src;
+	ib[n++] = (uint32_t)(src >> 32);
+	ib[n++] = (src_pitch >> 6) << 9;                /* SP_PS_2D_SRC_PITCH */
+	ib[n++] = pkt4(A6XX_RB_2D_DST_INFO, 4);
+	ib[n++] = DST_INFO_RGBA8_LINEAR;
+	ib[n++] = (uint32_t)dst;
+	ib[n++] = (uint32_t)(dst >> 32);
+	ib[n++] = dst_pitch >> 6;                       /* RB_2D_DST_PITCH */
+	ib[n++] = pkt4(A6XX_GRAS_2D_SRC_TL_X, 4);       /* source rectangle, 8 fractional bits */
+	ib[n++] = 0;
+	ib[n++] = (w - 1) << 8;
+	ib[n++] = 0;
+	ib[n++] = (h - 1) << 8;
+	ib[n++] = pkt4(A6XX_GRAS_2D_DST_TL, 2);
+	ib[n++] = 0;
+	ib[n++] = (w - 1) | ((h - 1) << 16);
+	ib[n++] = pkt7(CP_EVENT_WRITE, 1);
+	ib[n++] = EVT_LABEL;
+	ib[n++] = pkt7(CP_WAIT_FOR_IDLE, 0);
+	ib[n++] = pkt4(A6XX_RB_DBG_ECO_CNTL, 1);
+	ib[n++] = RB_DBG_ECO_CNTL_BLIT_A630;
+	ib[n++] = pkt7(CP_BLIT, 1);
+	ib[n++] = CP_BLIT_OP_SCALE;
+	ib[n++] = pkt7(CP_WAIT_FOR_IDLE, 0);
+	ib[n++] = pkt4(A6XX_RB_DBG_ECO_CNTL, 1);
+	ib[n++] = 0;
+	ib[n++] = pkt7(CP_EVENT_WRITE, 4);              /* the copy out of the colour cache, before the fence */
+	ib[n++] = EVT_PC_CCU_FLUSH_COLOR_TS;
+	ib[n++] = (uint32_t)junk;
+	ib[n++] = (uint32_t)(junk >> 32);
+	ib[n++] = 0;
+	ib[n++] = pkt7(CP_WAIT_FOR_IDLE, 0);
+	__asm__ volatile ("dsb sy" ::: "memory");       /* the command words are in memory before the CP is told */
+	uint64_t ibva = blit_ib_iova + slot * BLIT_IB_SLOT;
+	uint32_t dw = n;
+	fence = sweet_gpu_submit(&ibva, &dw, 1);
+	sweet_gpu_unlock();
+	return fence;
+}
