+/* 0240: the pool's physical range (fixed for the boot), which SweetFramebuffer maps for the GPU once. */
+bool
+sweet_lowpool_window(uint64_t *base, uint64_t *bytes)
+{
+	if (!sweet_lowpool.ready) {
+		return false;
+	}
+	*base = sweet_lowpool.base;
+	*bytes = (uint64_t)sweet_lowpool.pages * PAGE_SIZE;
+	return true;
+}
