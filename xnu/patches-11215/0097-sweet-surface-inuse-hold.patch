@@ -390,13 +397,52 @@ static uint64_t sweet_fb_swap_count;
  * shows the latest frame every fFlushTicks ticks (boot-arg sweetfb_hz,
  * default 10 Hz).
  */
+/*
+ * After ios-topaz 0099: IOSurfaceClientIsInUse (iOS 16.7 IOSurface.framework)
+ * reads a u64 use count at +0x18 of the surface's shared state page. Holding
+ * it from SwapEnd until the vsync tick has copied the frame stops
+ * CoreAnimation from rendering into a surface we are still reading (torn,
+ * half-drawn frames).
+ */
+static void
+sweet_hold(SweetSurface *s, bool on)
+{
+	if (s->state == NULL) {
+		return;
+	}
+	OSAddAtomic64(on ? 1 : -1, (volatile SInt64 *)((uint8_t *)s->state->getBytesNoCopy() + 0x18));
+}
+
+static void
+sweet_hold_release(SweetSurface **set)
+{
+	for (uint32_t i = 0; i < 4; i++) {
+		if (set[i] != NULL) {
+			sweet_hold(set[i], false);
+			set[i]->release();
+			set[i] = NULL;
+		}
+	}
+}
+
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	SweetSurface *held[4] = {}, *dropped[4];
+	uint32_t mask = get32(rec, 0x104);
+	for (uint32_t i = 0; i < 4 && i < SWEET_FB_LAYERS; i++) {
+		uint32_t sid = get32(rec, 0x54 + 4 * i);
+		if ((mask & (1u << i)) && sid != 0 && (held[i] = sweet_surface_copy(sid)) != NULL) {
+			sweet_hold(held[i], true);
+		}
+	}
 	IOLockLock(fLock);
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
 	fDirty = true;
+	memcpy(dropped, fPendHold, sizeof(dropped));     /* replaced before it was copied */
+	memcpy(fPendHold, held, sizeof(held));
 	IOLockUnlock(fLock);
+	sweet_hold_release(dropped);
 	if ((++sweet_fb_swap_count % 1000) == 0) {
 		IOLog("SWEET FB: %llu swaps\n", sweet_fb_swap_count);
 	}
