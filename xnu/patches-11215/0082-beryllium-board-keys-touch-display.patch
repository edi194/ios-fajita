diff --git a/bsd/dev/sweet_board.h b/bsd/dev/sweet_board.h
new file mode 100644
index 0000000000000000000000000000000000000000..597256bd7c560dfcce2ce0f95e7834d147d55df2
--- /dev/null
+++ b/bsd/dev/sweet_board.h
@@ -0,0 +1,51 @@
+/*
+ * SWEET kernels run on two Xiaomi phones. The ADT root compatible
+ * (tools/mkadt.py --board) names the board; everything else is common.
+ *   xiaomi,sweet      Redmi Note 10 Pro, SM7150 (default)
+ *   xiaomi,beryllium  Poco F1, SDM845
+ */
+#ifndef _SWEET_BOARD_H_
+#define _SWEET_BOARD_H_
+
+#include <stdbool.h>
+#include <pexpert/device_tree.h>
+
+static inline bool
+sweet_board_is(const char *want)
+{
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", &prop, &size) != kSuccess) {
+		return false;
+	}
+	const char *s = (const char *)prop, *end = s + size;
+	while (s < end) {
+		const char *a = s, *b = want;
+		while (a < end && *a && *a == *b) {
+			a++, b++;
+		}
+		if (a < end && *a == 0 && *b == 0) {
+			return true;
+		}
+		while (s < end && *s) {
+			s++;
+		}
+		s++;
+	}
+	return false;
+}
+
+static inline bool
+sweet_board_beryllium(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		cached = sweet_board_is("xiaomi,beryllium") ? 1 : 0;
+	}
+	return cached == 1;
+}
+
+#endif /* _SWEET_BOARD_H_ */
