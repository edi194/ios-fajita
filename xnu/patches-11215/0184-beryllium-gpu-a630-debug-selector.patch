+	w[13] = gpu_rd(gmu, GMU_PWR_COL_KEEPALIVE);
+	w[14] = gpu_rd(gmu, GMU_AO_HOST_INTERRUPT_STATUS);
+	w[15] = a630_dev.seqno;
+	w[16] = ring_wptr;
+	w[17] = cp_memory ? *(volatile uint32_t *)(cp_memory + SCRATCH_OFF + SCRATCH_FENCE) : 0;
+	w[18] = gpu_rd(gmu, GMU_CM3_FW_INIT_RESULT);
+	if (smmu_base) {
+		vm_offset_t b = smmu_base + SMMU_CB(CP_CB);
+		w[19] = gpu_rd(b, SMMU_CB_FSR);
+		w[20] = gpu_rd(b, SMMU_CB_FAR);
+		w[21] = gpu_rd(b, SMMU_CB_FAR + 4);
+		w[22] = gpu_rd(b, SMMU_CB_FSYNR0);
+		w[23] = gpu_rd(smmu_base, SMMU_sGFSR);
+		w[24] = gpu_rd(smmu_base, SMMU_sGFSYNR0);
+		w[25] = gpu_rd(b, SMMU_CB_SCTLR);
