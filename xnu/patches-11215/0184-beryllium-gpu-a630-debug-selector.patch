+	w[2] = gpu_rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS);
+	w[3] = gpu_rd(gmu, GMU_AO_AHB_FENCE_CTRL);
+	w[4] = gpu_rd(gmu, GMU_AHB_FENCE_STATUS);
+	w[5] = gx;
+	w[6] = gpu_rd(cc, GPUCC_CX_GDSCR);
+	w[7] = gfx;
+	w[8] = gpu_rd(gmu, GMU_AO_COUNTER_L);
+	w[9] = gpu_rd(gmu, GMU_AO_COUNTER_H);
+	w[10] = gpu_rd(gmu, GMU_GMU2HOST_INTR_INFO);
