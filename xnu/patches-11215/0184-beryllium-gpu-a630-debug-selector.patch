+		w[27] = gpu_r(A6XX_CP_RB_WPTR);
+		w[28] = gpu_r(A6XX_CP_STATUS_1);
+		w[29] = gpu_r(A6XX_RBBM_STATUS);
+		w[30] = gpu_r(A6XX_CP_HW_FAULT);
+		w[31] = gpu_r(A6XX_CP_INTERRUPT_STATUS);
+		w[32] = gpu_r(A6XX_RBBM_INT_0_STATUS);
+		w[33] = gpu_r(A6XX_CP_SQE_CNTL);
+		w[34] = gpu_r(A6XX_CP_PROTECT_STATUS);
+		w[35] = gpu_r(0x0928);          /* CP_IB1_BASE lo */
+		w[36] = gpu_r(0x0929);          /* CP_IB1_BASE hi */
+		w[37] = gpu_r(0x092a);          /* CP_IB1_REM_SIZE */
+		w[38] = gpu_r(A6XX_CP_ALWAYS_ON_COUNTER);
+		w[39] = gpu_r(A6XX_CP_RB_BASE);
