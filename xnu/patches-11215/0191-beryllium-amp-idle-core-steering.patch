+/* Core-class steering of the scheduler's idle-CPU choice (osfmk/kern/sched_prim.c). */
+static void
+cf_amp_setup(void)
+{
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	uint64_t big = 0, little = 0;
+
+	for (unsigned i = 0; i < topo->num_cpus && i < 8; i++) {
+		if (topo->cpus[i].phys_id >= 0x400u) {  /* MPIDR Aff1 4-7: Cortex-A75 */
+			big |= 1ULL << topo->cpus[i].cpu_id;
+		} else {
+			little |= 1ULL << topo->cpus[i].cpu_id;
+		}
+	}
+	if (big == 0 || little == 0) {
+		printf("SWEET AMP: only one core class online (big 0x%llx little 0x%llx), steering off\n", big, little);
+		return;
+	}
+	sweet_amp_enable(big, little, cf_amp_pri);
+	cf_amp_big = big;
+	cf_amp_on = true;
+	printf("SWEET AMP: idle-core steering on: A75 mask 0x%llx, A55 mask 0x%llx, base_pri >= %d takes an A75 first\n",
+	    big, little, cf_amp_pri);
+}
