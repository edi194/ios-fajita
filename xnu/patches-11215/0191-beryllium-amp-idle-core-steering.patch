+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * Poco F1 (SDM845): CPU 0-3 are Cortex-A55, CPU 4-7 Cortex-A75, but the ADT/topology
+ * publishes one SMP cluster (MAX_CPU_CLUSTERS == 1, no __ARM_AMP__, so the Clutch SMP
+ * scheduler: the Edge/AMP scheduler is a compile-time choice). This steers the choice
+ * among IDLE processors in choose_processor(): user threads with base_pri >= sweet_amp_pri
+ * (default BASEPRI_DEFAULT: default QoS and above) take an idle A75 first, everything
+ * else (low QoS, kernel threads) an idle A55 first; the other class is still used when
+ * the preferred one has no idle core. Masks stay 0 (= stock behaviour) until
+ * bsd/dev/sweet_cpufreq.c enables them after the SMP bring-up (boot-arg sweetamp=0 keeps
+ * them off). Only idle-processor selection is affected; running threads are not moved.
+ */
+uint64_t sweet_amp_big_mask;
+uint64_t sweet_amp_little_mask;
+int sweet_amp_pri = BASEPRI_DEFAULT;
+
+void sweet_amp_enable(uint64_t big, uint64_t little, int pri);
+void
+sweet_amp_enable(uint64_t big, uint64_t little, int pri)
+{
+	sweet_amp_pri = pri;
+	os_atomic_store(&sweet_amp_little_mask, little, relaxed);
+	os_atomic_store(&sweet_amp_big_mask, big, release);
+}
+
+/* CPUs the thread should use first, 0 if the steering is off. */
+static inline uint64_t
+sweet_amp_wanted_map(thread_t thread)
+{
+	uint64_t big = os_atomic_load(&sweet_amp_big_mask, acquire);
+	if (big == 0) {
+		return 0;
+	}
+	if (thread->base_pri >= sweet_amp_pri && get_threadtask(thread) != kernel_task) {
+		return big;
+	}
+	return os_atomic_load(&sweet_amp_little_mask, relaxed);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
