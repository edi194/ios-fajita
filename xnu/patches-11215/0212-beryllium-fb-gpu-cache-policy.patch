 /* The pool maps cacheable (write-back): the CPU must clean a frame before the MDP reads it. */
 bool sweet_lowpool_cacheable(void);
 
+/*
+ * Cache policy of GPU-written pool surfaces (patch 0212, docs/DISPLAY_HW.md section 6). The GPU's SMMU
+ * context maps memory non-cacheable and the MDP fetches from DRAM, so a surface that only the GPU writes
+ * needs no CPU cache maintenance at all once its lines were cleaned+invalidated after the zero fill
+ * (done at allocation). With this on, a BO_SYNC of a pool surface that was already scanned in place is a no-op
+ * (it only counts the GPU write, sweet_surface_gpu_wrote) and the framebuffer skips its per-frame clean for
+ * frames the GPU produced. Off: BO_SYNC always does clean+invalidate (the 0182 behaviour).
+ */
+void sweet_lowpool_gpu_nosync(bool on);
+
+/* BO_SYNC on a surface BO: count the GPU write; true when the cache maintenance can be skipped. */
+bool sweet_surface_gpu_wrote(SweetSurface *s);
+
 /* Pool statistics: pages in use / total, allocations, failed allocations (fell back to normal memory). */
 void sweet_lowpool_stats(uint32_t *usedPages, uint32_t *totalPages, uint64_t *allocs, uint64_t *fails);
 
