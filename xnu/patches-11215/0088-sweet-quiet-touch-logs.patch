diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 96ae95573148f5f67ac1b8fdf26036218796623e..297a304ea2af91c2d49808a2f964e71ac474d37d 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -927,8 +927,19 @@ selected:
 			int err = st.kind == TOUCH_GOODIX ? touch_goodix() :
 			    st.kind == TOUCH_NVT ? touch_novatek() : touch_focaltech();
 			if (err) {
-				if ((errors++ % 100u) == 0) {
-					printf("SWEET TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+				/* At most one line a minute: bad frames are frequent and harmless */
+				static uint64_t last_log;
+				static unsigned suppressed;
+				uint64_t now = mach_absolute_time(), minute;
+				nanoseconds_to_absolutetime(60ull * NSEC_PER_SEC, &minute);
+				errors++;
+				if (last_log == 0 || now - last_log >= minute) {
+					printf("SWEET TOUCH: report err=%d irq=%#x (+%u since last line)\n",
+					    err, st.irq_status, suppressed);
+					last_log = now;
+					suppressed = 0;
+				} else {
+					suppressed++;
 				}
 				if (errors == 10) {
 					touch_report(0, st.x, st.y); /* release after persistent bad reads */
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
index 9963b9add0467a420b7a931336e0c1d293a9828b..a034bb6cf85ef2d40db4d50b2ece617aadf7bd51 100644
