@@ -536,7 +536,14 @@ SweetHIDTouch::touch(int finger, bool down, int x, int y)
 	collection->setIntegerValue(kIOHIDEventFieldDigitizerButtonMask, any ? 1 : 0);
 	IOLockUnlock(fLock);
 
-	if (was != down) {
+	/* Per-touch lines flood the screen console: boot-arg sweethidlog=1 */
+	static int touch_log = -1;
+	if (touch_log < 0) {
+		int on = 0;
+		PE_parse_boot_argn("sweethidlog", &on, sizeof(on));
+		touch_log = on ? 1 : 0;
