+/*
+ * Writable CPU alias of a client-memory (wrapped) surface BO (patch 0214; lock held).
+ *
+ * Why the surface is read-only to begin with: sweet_surface_use_task_memory() wraps the owner's range first as
+ * kIODirectionInOut and, if prepare() refuses (the owner's mapping has no write permission: max_prot is read-only, e.g. a
+ * read-only remap or file-backed page), again as kIODirectionOut. A kIODirectionOut descriptor makes a read-only memory
+ * entry and IOMemoryMap clamps every mapping to it (prot &= entry prot), so the mapping the render server gets from
+ * createMappingInTask() (SweetSurfaceRef) and our own kernelMap are VM_PROT_READ with max_prot READ: neither the CPU nor
+ * vm_protect can write them. Nothing to do with IOSurface lock flags or kIOSurfaceIsGlobal (not looked at anywhere).
+ *
+ * The alias is a SECOND descriptor over the same wired pages, built from their physical segments with kIODirectionInOut,
+ * mapped RW with the default (write-back) cache attribute into the calling task. It is as safe as the kernel's own
+ * CPU alias (SweetSurface::kernelMap) of the same range, whose lifetime rule it copies: it exists only while this BO exists,
+ * and this BO holds the surface, whose prepare() keeps the pages wired. releaseGem() unmaps it before it lets go of the
+ * surface, so no mapping can outlive the wiring. The GPU mapping of the BO stays read-only (never writable: an asynchronous
+ * writer cannot be stopped when the owner dies; the CPU writes only when its thread asks).
+ * Cache: the alias and kernelMap are both write-back, physically tagged caches see one line per address, so BO_SYNC
+ * (dc civac over g->kva) also cleans lines dirtied through the alias. kva is required for that, hence no alias without it.
+ */
+IOReturn
+SweetAdrenoUserClient::aliasGem(struct sweet_gem *g, struct sweet_gpu_surface_bo *r)
+{
+	if (g->alias == NULL) {
+		if (fClosed || fTask == NULL) {
+			return kIOReturnNotAttached;
+		}
+		if (g->surface == NULL || !g->surface->wrapped || g->md == NULL) {
+			return kIOReturnUnsupported;
+		}
+		if (g->kva == NULL) {
+			return kIOReturnNoMemory;               /* BO_SYNC could not reach CPU writes made through the alias */
+		}
+		IOAddressRange *ranges = (IOAddressRange *)IOMallocZeroData(sizeof(IOAddressRange) * ALIAS_RANGES_MAX);
+		if (ranges == NULL) {
+			return kIOReturnNoMemory;
+		}
+		uint32_t n = 0;
+		IOReturn ret = kIOReturnSuccess;
+		for (uint64_t off = 0; off < g->size && ret == kIOReturnSuccess;) {
+			IOByteCount len = 0;
+			addr64_t pa = g->md->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+			if (pa == 0 || len == 0 || (pa & PAGE_MASK) != 0) {
+				ret = kIOReturnVMError;
+			} else if (len > g->size - off) {
+				len = (IOByteCount)(g->size - off);
+			}
+			if (ret != kIOReturnSuccess) {
+				break;
+			}
+			if (n > 0 && ranges[n - 1].address + ranges[n - 1].length == pa) {
+				ranges[n - 1].length += len;
+			} else if (n < ALIAS_RANGES_MAX) {
+				ranges[n].address = pa;
+				ranges[n].length = len;
+				n++;
+			} else {
+				ret = kIOReturnNoSpace;
+			}
+			off += len;
+		}
+		IOMemoryDescriptor *amd = NULL;
+		if (ret == kIOReturnSuccess) {
+			amd = IOMemoryDescriptor::withAddressRanges(ranges, n, kIODirectionInOut | kIOMemoryTypePhysical64, NULL);
+			if (amd == NULL) {
+				ret = kIOReturnNoMemory;
+			}
+		}
+		IOFreeData(ranges, sizeof(IOAddressRange) * ALIAS_RANGES_MAX);
+		if (ret != kIOReturnSuccess) {
+			IOLog("SWEET GPU: writable alias of BO iova %#llx: cannot describe the pages (%#x)\n", g->iova, ret);
+			return ret;
+		}
+		IOMemoryMap *m = amd->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapDefaultCache);
+		amd->release();                         /* the map keeps the descriptor */
+		if (m == NULL || m->getLength() != g->size) {
+			IOLog("SWEET GPU: writable alias of BO iova %#llx: cannot map %llu bytes into pid %d\n", g->iova, g->size, fPid);
+			if (m != NULL) {
+				m->unmap();
+				m->release();
+			}
+			return kIOReturnVMError;
+		}
+		g->alias = m;
+		static uint32_t told;
+		if (told++ < 8) {
+			IOLog("SWEET GPU: writable alias of surface BO iova %#llx: %llu bytes at %#llx in pid %d (%u segments)\n",
+			    g->iova, g->size, (uint64_t)m->getVirtualAddress(), fPid, n);
+		}
+	}
+	r->alias_addr = (uint64_t)g->alias->getVirtualAddress();
+	r->alias_size = g->size;
+	r->flags |= SWEET_GPU_SBO_ALIAS;
+	return kIOReturnSuccess;
+}
