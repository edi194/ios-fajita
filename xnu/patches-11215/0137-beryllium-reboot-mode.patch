+/*
+ * Thread context: make a whitelisted register writable later from atomic
+ * context: find its APID, check EE ownership and map its write channel.
+ * 0 ready, -1 not (not whitelisted, no APID, owned by another EE, no map).
+ */
+int
+sweet_spmi_prepare_write(unsigned sid, unsigned addr)
+{
+	if (!sp_ready || addr > 0xffffu || !sp_write_allowed(sid, addr, 1)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		printf("SWEET SPMI: no usable APID for sid %u peripheral 0x%x\n", sid, addr >> 8);
+		return -1;
+	}
+	unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u;
+	vm_offset_t ch = owner == 0 ? sp_wch_map(apid) : 0;
+	IOLockUnlock(sp_lock);
+	printf("SWEET SPMI: sid %u peripheral 0x%x APID %u owner EE %u write channel %s\n",
+	    sid, addr >> 8, apid, owner, ch ? "mapped" : "unavailable");
+	return ch ? 0 : -1;
+}
+
+/* From here on SPMI accesses never sleep or map (reset time, see sp_take). */
+void
+sweet_spmi_atomic(void)
+{
+	sp_atomic = true;
+}
