new file mode 100644
index 0000000000000000000000000000000000000000..15ebee60b5145db4d51de2128a34478bb2bfc285
--- /dev/null
+++ b/bsd/dev/sweet_reboot.c
@@ -0,0 +1,237 @@
+/*
+ * Poco F1 (beryllium) reboot: the SoC reset path, with a reboot reason.
+ *
+ * Until this file XNU had no restart path on this board (PE_halt_restart was
+ * never set: "MACH Reboot" and spin). Reset = write 0 to PS_HOLD (0x0c264000,
+ * live DT restart@10ac000 "qcom,pshold"); the PMIC then warm/hard resets the
+ * SoC as configured by firmware. If PS_HOLD does not take (2 s), PSCI
+ * SYSTEM_RESET follows.
+ *
+ * Reboot reason, so that a reboot can land in fastboot / recovery:
+ *  - PM8998 PON block (SID 0, base 0x800), PON_SOFT_RB_SPARE (0x8f): Linux
+ *    drivers/power/reset/qcom-pon.c with the pm8998 data (reason_shift = 1,
+ *    GEN2_REASON_SHIFT) and reboot-mode: regmap_update_bits(0x88f,
+ *    GENMASK(7, 1), magic << 1). Magics from arch/arm64/boot/dts/qcom/
+ *    pm8998.dtsi (v6.12): mode-bootloader = <0x2>, mode-recovery = <0x1>
+ *    (the same values the Qualcomm ABL uses: FASTBOOT_MODE 2, RECOVERY_MODE 1).
+ *    Like the reboot-mode core, every reboot writes the field (0 for normal)
+ *    so a stale reason cannot stick; an unchanged value is not rewritten.
+ *  - The live DT (dtb/beryllium/live.dts) has no reboot-mode node; the
+ *    downstream way is qpnp-power-on + msm-poweroff: the same PON reason AND
+ *    the IMEM restart_reason word (qcom,msm-imem@146bf000 / restart_reason@65c
+ *    = 0x146bf65c) with 0x77665500 (bootloader) / 0x77665502 (recovery). Both
+ *    are written (IMEM only for non-normal reasons; XBL clears it).
+ *
+ * Control: boot-arg sweetreboot=bootloader|recovery|normal (default normal),
+ * overridden for the next reboot by the root-only sysctl
+ * kern.sweet_reboot_mode (string; "fastboot" is accepted for "bootloader").
+ *
+ * Panic: unchanged (no reset, the screen/log stays) unless the boot-arg is
+ * sweetreboot=bootloader; then a panic also resets into fastboot (unattended
+ * tests). The sysctl does not affect panics.
+ *
+ * Reset time may be non-preemptible (halt_all_cpus, panic): everything is
+ * mapped by sweet_reboot_init() and the SPMI helpers run lock-less there.
+ * All logs start with "SWEET REBOOT:".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+#include "sweet_board.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int usec);
+
+#define SR_PSHOLD_PA     0x0c264000u
+#define SR_IMEM_PA       0x146bf000u
+#define SR_IMEM_RESTART  0x65cu            /* restart_reason@65c */
+#define SR_IMEM_BOOTLOADER 0x77665500u
+#define SR_IMEM_RECOVERY   0x77665502u
+
+#define SR_PON_SID       0u
+#define SR_PON_SPARE     0x088fu           /* PON base 0x800 + PON_SOFT_RB_SPARE 0x8f */
+#define SR_REASON_SHIFT  1u                /* qcom,pm8998-pon: GEN2_REASON_SHIFT */
+#define SR_REASON_MASK   (0xffu & ~((1u << SR_REASON_SHIFT) - 1u))   /* GENMASK(7, 1) */
+#define SR_MAGIC_NORMAL     0u
+#define SR_MAGIC_RECOVERY   0x1u           /* pm8998.dtsi mode-recovery */
+#define SR_MAGIC_BOOTLOADER 0x2u           /* pm8998.dtsi mode-bootloader */
+
+enum { SR_NORMAL = 0, SR_BOOTLOADER = 1, SR_RECOVERY = 2 };
+
+static int sr_bootarg = SR_NORMAL;
+static int sr_override = -1;               /* sysctl; -1 = none */
+static volatile uint32_t *sr_pshold;
+static volatile uint32_t *sr_imem;
+static bool sr_ready, sr_pon_ready, sr_in_panic;
+
+static const char *
+sr_name(int mode)
+{
+	return mode == SR_BOOTLOADER ? "bootloader" : mode == SR_RECOVERY ? "recovery" : "normal";
+}
+
+static int
+sr_parse(const char *s)
+{
+	if (!strcmp(s, "bootloader") || !strcmp(s, "fastboot")) {
+		return SR_BOOTLOADER;
+	}
+	if (!strcmp(s, "recovery")) {
+		return SR_RECOVERY;
+	}
+	if (!strcmp(s, "normal") || !strcmp(s, "")) {
+		return SR_NORMAL;
+	}
+	return -1;
+}
+
+static int
+sr_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	char buf[16];
+	int error;
+
+	strlcpy(buf, sr_name(sr_override >= 0 ? sr_override : sr_bootarg), sizeof(buf));
+	error = sysctl_handle_string(oidp, buf, sizeof(buf), req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	/* tolerate a trailing newline from echo */
+	size_t n = strlen(buf);
+	while (n && (buf[n - 1] == '\n' || buf[n - 1] == ' ')) {
+		buf[--n] = 0;
+	}
+	int mode = sr_parse(buf);
+	if (mode < 0) {
+		return EINVAL;
+	}
+	sr_override = mode;
+	printf("SWEET REBOOT: next reboot mode set to %s (sysctl)\n", sr_name(mode));
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_reboot_mode,
+    CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sr_sysctl, "A",
+    "Reboot mode of the next reboot: bootloader (fastboot), recovery, normal");
+
+/* PSCI SYSTEM_RESET (SMCCC 1.0): fallback when PS_HOLD does not reset. */
+static void
+sr_psci_system_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7",
+	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+}
+
+/* Thread context, after the SPMI driver can start. Idempotent. */
+void
+sweet_reboot_init(void)
+{
+	char arg[16] = "";
+
+	if (sr_ready || !sweet_board_beryllium()) {
+		return;
+	}
+	if (PE_parse_boot_argn("sweetreboot", arg, sizeof(arg))) {
+		int mode = sr_parse(arg);
+		if (mode < 0) {
+			printf("SWEET REBOOT: unknown boot-arg sweetreboot=%s (normal)\n", arg);
+		} else {
+			sr_bootarg = mode;
+		}
+	}
+	sr_pshold = (volatile uint32_t *)ml_io_map(SR_PSHOLD_PA, 0x1000);
+	sr_imem = (volatile uint32_t *)ml_io_map(SR_IMEM_PA, 0x1000);
+	if (sweet_spmi_init() == 0 && sweet_spmi_prepare_write(SR_PON_SID, SR_PON_SPARE) == 0) {
+		sr_pon_ready = true;
+	}
+	sr_ready = sr_pshold != NULL;
+	printf("SWEET REBOOT: boot-arg mode %s, PS_HOLD %s, IMEM %s, PON spare write %s\n",
+	    sr_name(sr_bootarg), sr_pshold ? "mapped" : "NOT mapped",
+	    sr_imem ? "mapped" : "NOT mapped", sr_pon_ready ? "ready" : "unavailable");
+}
+
+/*
+ * qcom-pon.c qcom_pon_reboot_mode_write(): regmap_update_bits(base + 0x8f,
+ * GENMASK(7, shift), magic << shift) through a read-modify-write.
+ */
+static void
+sr_pon_set_reason(unsigned magic)
+{
+	uint8_t old = 0, upd, back = 0;
+
+	if (!sr_pon_ready) {
+		printf("SWEET REBOOT: PON spare not writable, reason not stored\n");
+		return;
+	}
+	if (sweet_spmi_read(SR_PON_SID, SR_PON_SPARE, &old) != 0) {
+		printf("SWEET REBOOT: PON spare read failed, reason not stored\n");
+		return;
+	}
+	upd = (uint8_t)((old & ~SR_REASON_MASK) | ((magic << SR_REASON_SHIFT) & SR_REASON_MASK));
+	if (upd == old) {
+		printf("SWEET REBOOT: PON_SOFT_RB_SPARE 0x88f = 0x%02x already\n", old);
+		return;
+	}
+	if (sweet_spmi_write(SR_PON_SID, SR_PON_SPARE, &upd, 1) != 0) {
+		printf("SWEET REBOOT: PON_SOFT_RB_SPARE 0x88f write 0x%02x -> 0x%02x FAILED\n", old, upd);
+		return;
+	}
+	(void)sweet_spmi_read(SR_PON_SID, SR_PON_SPARE, &back);
+	printf("SWEET REBOOT: PON_SOFT_RB_SPARE 0x88f 0x%02x -> 0x%02x (read back 0x%02x)\n", old, upd, back);
+}
+
+/* Called by SweetPlatformExpert::haltRestart for panic notifications. */
+void
+sweet_reboot_note_panic(void)
+{
+	sr_in_panic = true;
+}
+
+/*
+ * Reset the SoC. Returns only if nothing reset it (or no reset was wanted:
+ * -1, the old behaviour). panic_restart: the call comes from a panic restart.
+ */
+int
+sweet_reboot_restart(int panic_restart)
+{
+	int mode;
+
+	if (!sr_ready) {
+		return -1;
+	}
+	if (panic_restart || sr_in_panic) {
+		/* Panics keep their old behaviour (stay up) unless asked for fastboot. */
+		if (sr_bootarg != SR_BOOTLOADER) {
+			return -1;
+		}
+		mode = SR_BOOTLOADER;
+	} else {
+		mode = sr_override >= 0 ? sr_override : sr_bootarg;
+	}
+	sweet_spmi_atomic();
+	printf("SWEET REBOOT: resetting, mode %s%s\n", sr_name(mode), panic_restart || sr_in_panic ? " (panic)" : "");
+	sr_pon_set_reason(mode == SR_BOOTLOADER ? SR_MAGIC_BOOTLOADER :
+	    mode == SR_RECOVERY ? SR_MAGIC_RECOVERY : SR_MAGIC_NORMAL);
+	if (sr_imem && mode != SR_NORMAL) {
+		uint32_t magic = mode == SR_BOOTLOADER ? SR_IMEM_BOOTLOADER : SR_IMEM_RECOVERY;
+		sr_imem[SR_IMEM_RESTART / 4] = magic;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("SWEET REBOOT: IMEM restart_reason 0x146bf65c = 0x%08x\n", magic);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*sr_pshold = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(2000 * 1000);
+	printf("SWEET REBOOT: PS_HOLD did not reset, PSCI SYSTEM_RESET\n");
+	sr_psci_system_reset();
+	delay(2000 * 1000);
+	return -1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
