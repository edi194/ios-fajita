+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	switch (type) {
+	case kPEPanicBegin:
+	case kPEPanicSync:
+	case kPEPanicDiagnosticsInProgress:
+	case kPEPanicDiagnosticsDone:
+		sweet_reboot_note_panic();
+		break;
+	case kPEPanicRestartCPU:
+		sweet_reboot_note_panic();
+		(void)sweet_reboot_restart(1);
+		break;
+	case kPERestartCPU:
+		(void)sweet_reboot_restart(0);
+		break;
+	default:
+		break;
+	}
+	return IODTPlatformExpert::haltRestart(type);
+}
