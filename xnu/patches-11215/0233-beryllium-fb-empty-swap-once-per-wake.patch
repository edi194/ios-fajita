+	/*
+	 * 0233: 0227 blanks on a layerless swap, meant for the first swap after a wake. With the Metal compositor such swaps
+	 * also come mid-session; blanking then left the screen black until something redrew it (the power button). Only
+	 * the first swap after boot or a power on may blank now; any other layerless swap keeps the frame that is shown.
+	 */
+	bool hasLayer = false;
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		if ((mask & (1u << layer)) && get32(rec, 0x54 + 4 * layer) != 0) {
+			hasLayer = true;
+		}
+	}
+	if (!hasLayer) {
+		fSt.emptySwaps++;
+		if (!fEmptyBlackArmed) {
+			fSt.emptyKept++;
+			return;
+		}
