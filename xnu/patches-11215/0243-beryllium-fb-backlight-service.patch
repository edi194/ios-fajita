+/*
+ * 0243: the backlight service iOS's brightness stack looks for. backboardd (CoreBrightness, BLControl) matches
+ * IOPropertyMatch { backlight-control = true } and found nothing here, so the slider and auto-brightness reached no
+ * hardware. This publishes one under the framebuffer, advertises IODisplayParameters brightness 0..4095 (the WLED's
+ * 12 bits), logs every property iOS sets on it (what it sends is not documented), and hands a brightness it
+ * recognises to the framebuffer, whose vsync timer writes the WLED (blReqApply).
+ */
+class SweetBacklight : public IOService {
+	OSDeclareDefaultStructors(SweetBacklight);
+public:
+	AppleCLCD *fFB;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetBacklight, IOService);
 
