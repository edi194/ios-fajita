  * (fBlOK cleared, the original value written back as well as possible) when
  * a write fails or does not read back: the caller blacks the screen out instead.
  */
+/* 0243: what iOS sets on the backlight service, logged (first 64 calls), and the brightness taken from it. */
+IOReturn
+SweetBacklight::setProperties(OSObject *properties)
+{
+	static uint32_t logged;
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (d == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (logged++ < 64) {
+		OSSerialize *ser = OSSerialize::withCapacity(512);
+		if (ser != NULL && d->serialize(ser)) {
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			IOLog("SWEET BL: %s sets %.400s\n", name, ser->text());
+		}
+		OSSafeReleaseNULL(ser);
+	}
+	OSNumber *n = OSDynamicCast(OSNumber, d->getObject("brightness"));
+	if (n == NULL) {
+		OSDictionary *dp = OSDynamicCast(OSDictionary, d->getObject("IODisplayParameters"));
+		OSDictionary *br = dp ? OSDynamicCast(OSDictionary, dp->getObject("brightness")) : NULL;
+		n = br ? OSDynamicCast(OSNumber, br->getObject("value")) : NULL;
+	}
+	if (n != NULL && fFB != NULL && n->unsigned64BitValue() <= 4095) {
+		fFB->blRequest((uint32_t)n->unsigned64BitValue());
+	}
+	return kIOReturnSuccess;
+}
