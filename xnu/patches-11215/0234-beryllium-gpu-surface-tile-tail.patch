+/*
+ * 0234: one zeroed GPU page, writable, that the tails of surface BOs map to. The Adreno writes a render target in
+ * whole tiles (rows rounded up), so on a surface whose height is not a multiple of the tile height it writes up to a
+ * tile of rows past the last one: on IOSurfaces sized to the pixel (an app snapshot 281x609, bpr 1152, 704512 bytes)
+ * that ran over the one-page guard into the NEXT BO (black wedges on the lock-screen editor) or faulted on the
+ * unmapped guard (SMMU write fault 64 bytes past the end; three of them and the GPU is lost). Those rows are
+ * outside the image: they may land anywhere harmless, and here they all land on this page.
+ */
+static IOBufferMemoryDescriptor *gScratchBuf;
+static addr64_t gScratchPA;
+
+static bool
+sweet_gpu_scratch(void)
+{
+	if (gScratchPA != 0) {
+		return true;
+	}
+	IOBufferMemoryDescriptor *b = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMapWriteCombineCache, PAGE_SIZE, PAGE_SIZE);
+	if (b == NULL) {
+		return false;
+	}
+	bzero(b->getBytesNoCopy(), PAGE_SIZE);
+	IOByteCount length = 0;
+	addr64_t pa = b->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+	if (pa == 0 || (pa & (GPU_PAGE - 1)) != 0) {
+		b->release();
+		return false;
+	}
+	gScratchBuf = b;
+	gScratchPA = pa;
+	return true;
+}
+
+/* Bytes past size a surface's tiles may write: rows rounded up to 32, for every plane (0 when nothing sticks out). */
+static uint64_t
+sweet_surface_tail(const SweetSurface *s, uint64_t offset, uint64_t size)
+{
+	uint64_t need = 0;
+	if (s->planeCount == 0) {
+		need = offset + (uint64_t)((s->height + 31u) & ~31u) * s->bytesPerRow;
+	} else {
+		for (uint32_t i = 0; i < s->planeCount && i < 3; i++) {
+			uint64_t e = (uint64_t)s->planes[i].offset + (uint64_t)((s->planes[i].height + 31u) & ~31u) * s->planes[i].bytesPerRow;
+			need = e > need ? e : need;
+		}
+	}
+	need = (need + GPU_PAGE - 1) & ~(GPU_PAGE - 1);
+	uint64_t tail = need > size ? need - size : 0;
+	return tail > (4ull << 20) ? (4ull << 20) : tail;
 }
 
