+/* ======================================================================== */
+/* Portable part: FAT16 reader + ELF32 .mdt parser (host-tested on backup/)   */
+/* ======================================================================== */
+
+#define FAT_BUF_MAX     65536u
+#define DIR_BUF_MAX     131072u
+
+struct wl_fat {
+	const char *part;
+	uint32_t bps, spc, reserved, nfats, rootent, fatsz, ncl;
+	uint64_t fat_off, root_off, data_off, cl_bytes;
+};
+
+static uint8_t wl_fatbuf[FAT_BUF_MAX];
+static uint8_t wl_dirbuf[DIR_BUF_MAX];
+
+static uint32_t
+le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return le16(p) | (le16(p + 2) << 16);
+}
+
+static int
+fat_mount(struct wl_fat *f, const char *part)
+{
+	uint8_t b[512];
+	int err = WL_PART_READ(part, 0, b, sizeof(b));
+	if (err) {
+		return err;
+	}
+	if (b[510] != 0x55 || b[511] != 0xaa) {
+		return ENXIO;
+	}
+	f->part = part;
+	f->bps = le16(b + 11);
+	f->spc = b[13];
+	f->reserved = le16(b + 14);
+	f->nfats = b[16];
+	f->rootent = le16(b + 17);
+	uint32_t total = le16(b + 19) ? le16(b + 19) : le32(b + 32);
+	f->fatsz = le16(b + 22);
+	if (f->bps < 512 || f->bps > 4096 || (f->bps & (f->bps - 1)) || f->spc == 0 ||
+	    (f->spc & (f->spc - 1)) || f->nfats == 0 || f->nfats > 2 || f->rootent == 0 ||
+	    f->fatsz == 0 || (uint64_t)f->fatsz * f->bps > FAT_BUF_MAX || f->reserved == 0) {
+		return ENXIO;       /* not FAT12/16 */
+	}
+	f->fat_off = (uint64_t)f->reserved * f->bps;
+	f->root_off = f->fat_off + (uint64_t)f->nfats * f->fatsz * f->bps;
+	uint32_t root_sectors = (f->rootent * 32u + f->bps - 1) / f->bps;
+	f->data_off = f->root_off + (uint64_t)root_sectors * f->bps;
+	f->cl_bytes = (uint64_t)f->spc * f->bps;
+	uint32_t data_sectors = total - (uint32_t)(f->data_off / f->bps);
+	f->ncl = data_sectors / f->spc;
+	if (f->ncl < 4085 || f->ncl > 65524) {
+		return ENXIO;       /* FAT12 or FAT32 */
+	}
+	return WL_PART_READ(part, f->fat_off, wl_fatbuf, (uint64_t)f->fatsz * f->bps);
+}
+
+static uint32_t
+fat_next(const struct wl_fat *f, uint32_t cl)
+{
+	if (cl < 2 || cl >= f->ncl + 2 || (cl * 2 + 1) >= (uint64_t)f->fatsz * f->bps) {
+		return 0xffff;
+	}
+	return le16(wl_fatbuf + cl * 2);
+}
+
+static int
+fat_read_chain(const struct wl_fat *f, uint32_t cl, uint64_t off, void *dst, uint64_t len)
+{
+	uint8_t *out = (uint8_t *)dst;
+	uint32_t guard = 0;
+	while (off >= f->cl_bytes) {
+		cl = fat_next(f, cl);
+		off -= f->cl_bytes;
+		if (cl < 2 || cl >= 0xfff0 || ++guard > f->ncl) {
+			return EIO;
+		}
+	}
+	while (len) {
+		if (cl < 2 || cl >= 0xfff0 || ++guard > f->ncl + 1) {
+			return EIO;
+		}
+		uint64_t n = MIN(len, f->cl_bytes - off);
+		int err = WL_PART_READ(f->part, f->data_off + (uint64_t)(cl - 2) * f->cl_bytes + off, out, n);
+		if (err) {
+			return err;
+		}
+		out += n;
+		len -= n;
+		off = 0;
+		if (len) {
+			cl = fat_next(f, cl);
+		}
+	}
+	return 0;
+}
+
+/* Load a directory (cl == 0: root) into wl_dirbuf; returns the entry count. */
+static int
+fat_dir_load(const struct wl_fat *f, uint32_t cl, uint32_t *nent)
+{
+	if (cl == 0) {
+		uint64_t bytes = (uint64_t)f->rootent * 32;
+		if (bytes > DIR_BUF_MAX) {
+			return EFBIG;
+		}
+		*nent = f->rootent;
+		return WL_PART_READ(f->part, f->root_off, wl_dirbuf, bytes);
+	}
+	uint32_t n = 0, guard = 0;
+	while (cl >= 2 && cl < 0xfff0 && ++guard <= f->ncl) {
+		if ((uint64_t)(n + 1) * f->cl_bytes > DIR_BUF_MAX) {
+			return EFBIG;
+		}
+		int err = WL_PART_READ(f->part, f->data_off + (uint64_t)(cl - 2) * f->cl_bytes,
+		    wl_dirbuf + (uint64_t)n * f->cl_bytes, f->cl_bytes);
+		if (err) {
+			return err;
+		}
+		n++;
+		cl = fat_next(f, cl);
+	}
+	*nent = (uint32_t)((uint64_t)n * f->cl_bytes / 32);
+	return 0;
+}
+
+static void
+fat_83(const char *name, size_t n, char out[11])
+{
+	size_t i = 0, o = 0;
+	memset(out, ' ', 11);
+	for (; i < n && name[i] != '.' && o < 8; i++, o++) {
+		out[o] = (name[i] >= 'a' && name[i] <= 'z') ? (char)(name[i] - 32) : name[i];
+	}
+	if (i < n && name[i] == '.') {
+		i++;
+	}
+	for (o = 8; i < n && o < 11; i++, o++) {
+		out[o] = (name[i] >= 'a' && name[i] <= 'z') ? (char)(name[i] - 32) : name[i];
+	}
+}
+
+/* Only plain 8.3 names (all firmware files here are); long names never match. */
+static int
+fat_find(const uint8_t *dir, uint32_t nent, const char *name, size_t n,
+    uint32_t *cluster, uint32_t *size, bool *is_dir)
+{
+	char want[11];
+	fat_83(name, n, want);
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = dir + (uint64_t)i * 32;
+		if (e[0] == 0) {
+			break;
+		}
+		if (e[0] == 0xe5 || (e[11] & 0x0f) == 0x0f || (e[11] & 0x08)) {
+			continue;
+		}
+		if (memcmp(e, want, 11) == 0) {
+			*cluster = le16(e + 26);
+			*size = le32(e + 28);
+			*is_dir = (e[11] & 0x10) != 0;
+			return 0;
+		}
+	}
+	return ENOENT;
+}
+
+/* "image/mba.mbn" style path, one directory level at a time. */
+static int
+fat_open(const struct wl_fat *f, const char *path, uint32_t *cluster, uint32_t *size)
+{
+	uint32_t cl = 0, nent = 0, sz = 0;
+	bool dir = true;
+	const char *p = path;
+	while (*p) {
+		const char *s = p;
+		while (*p && *p != '/') {
+			p++;
+		}
+		if (!dir) {
+			return ENOTDIR;
+		}
+		int err = fat_dir_load(f, cl, &nent);
+		if (err) {
+			return err;
+		}
+		err = fat_find(wl_dirbuf, nent, s, (size_t)(p - s), &cl, &sz, &dir);
+		if (err) {
+			return err;
+		}
+		if (*p == '/') {
+			p++;
+		}
+	}
+	*cluster = cl;
+	*size = sz;
+	return 0;
+}
+
+/* Count entries of the directory at path whose 8.3 name starts with prefix. */
+static int
+fat_count_prefix(const struct wl_fat *f, const char *dirpath, const char *prefix, uint32_t *count)
+{
+	uint32_t cl = 0, sz = 0, nent = 0;
+	if (*dirpath && fat_open(f, dirpath, &cl, &sz)) {
+		return ENOENT;
+	}
+	int err = fat_dir_load(f, cl, &nent);
+	if (err) {
+		return err;
+	}
+	size_t pl = strlen(prefix);
+	uint32_t c = 0;
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = wl_dirbuf + (uint64_t)i * 32;
+		if (e[0] == 0) {
+			break;
+		}
+		if (e[0] == 0xe5 || (e[11] & 0x0f) == 0x0f || (e[11] & 0x18)) {
+			continue;
+		}
+		size_t k;
+		for (k = 0; k < pl; k++) {
+			char ch = (char)e[k];
+			if (ch >= 'A' && ch <= 'Z') {
+				ch = (char)(ch + 32);
+			}
+			if (ch != prefix[k]) {
+				break;
+			}
+		}
+		c += (k == pl);
+	}
+	*count = c;
+	return 0;
+}
+
+struct elf32_ehdr {
+	uint8_t e_ident[16];
+	uint16_t e_type, e_machine;
+	uint32_t e_version, e_entry, e_phoff, e_shoff, e_flags;
+	uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx;
+} __attribute__((packed));
+struct elf32_phdr {
+	uint32_t p_type, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_flags, p_align;
+} __attribute__((packed));
+
+#define MDT_TYPE_MASK   (7u << 24)
+#define MDT_TYPE_HASH   (2u << 24)
+#define MDT_RELOCATABLE (1u << 27)
+
+struct wl_mdt {
+	uint32_t nphdr, hash_idx, nload;
+	uint32_t lo, hi;                /* span of loadable segments */
+	uint64_t total_file;            /* bytes of the .bNN segment files */
+	uint32_t hash_size;
+	bool relocatable;
+};
+
+/* Print the .mdt program headers and summarise; fw_name for log lines. */
+static int
+mdt_summarise(const struct wl_fat *f, const char *path, const char *tag, struct wl_mdt *out)
+{
+	static uint8_t mdt[16384];
+	uint32_t cl, size;
+	int err = fat_open(f, path, &cl, &size);
+	if (err) {
+		printf("SWEET WLAN: %s: %s not found (%d)\n", tag, path, err);
+		return err;
+	}
+	if (size < sizeof(struct elf32_ehdr) || size > sizeof(mdt)) {
+		printf("SWEET WLAN: %s: %s size %u unexpected\n", tag, path, size);
+		return EFBIG;
+	}
+	err = fat_read_chain(f, cl, 0, mdt, size);
+	if (err) {
+		printf("SWEET WLAN: %s: read %s failed %d\n", tag, path, err);
+		return err;
+	}
+	struct elf32_ehdr eh;
+	memcpy(&eh, mdt, sizeof(eh));
+	if (memcmp(eh.e_ident, "\x7f" "ELF", 4) != 0 || eh.e_ident[4] != 1 ||
+	    eh.e_phentsize != sizeof(struct elf32_phdr) ||
+	    (uint64_t)eh.e_phoff + (uint64_t)eh.e_phnum * sizeof(struct elf32_phdr) > size) {
+		printf("SWEET WLAN: %s: %s is not a 32-bit ELF .mdt\n", tag, path);
+		return ENOEXEC;
+	}
+	memset(out, 0, sizeof(*out));
+	out->nphdr = eh.e_phnum;
+	out->hash_idx = ~0u;
+	out->lo = ~0u;
+	printf("SWEET WLAN: %s: %s %u bytes, %u program headers, entry %#x\n", tag, path, size,
+	    eh.e_phnum, eh.e_entry);
+	for (uint32_t i = 0; i < eh.e_phnum; i++) {
+		struct elf32_phdr ph;
+		memcpy(&ph, mdt + eh.e_phoff + (uint64_t)i * sizeof(ph), sizeof(ph));
+		bool hash = (ph.p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH;
+		bool load = ph.p_type == 1 && ph.p_memsz != 0 && !hash;
+		if (hash) {
+			out->hash_idx = i;
+			out->hash_size = ph.p_filesz;
+		}
+		if (load) {
+			out->nload++;
+			out->lo = MIN(out->lo, ph.p_paddr);
+			out->hi = MAX(out->hi, ph.p_paddr + ph.p_memsz);
+			out->total_file += ph.p_filesz;
+			out->relocatable |= (ph.p_flags & MDT_RELOCATABLE) != 0;
+		}
+		if (i < 6 || hash || i + 1 == eh.e_phnum) {
+			printf("SWEET WLAN: %s:  ph%u type %u paddr %#x filesz %#x memsz %#x flags %#x%s%s\n",
+			    tag, i, ph.p_type, ph.p_paddr, ph.p_filesz, ph.p_memsz, ph.p_flags,
+			    hash ? " HASH" : "", load ? "" : " (not loaded)");
+		}
+	}
+	printf("SWEET WLAN: %s: %u loadable segments span %#x..%#x (%u MiB), hash segment ph%d %u bytes, %s\n",
+	    tag, out->nload, out->lo, out->hi, (out->hi - out->lo) >> 20, (int)out->hash_idx,
+	    out->hash_size, out->relocatable ? "RELOCATABLE" : "fixed address");
+	return 0;
+}
