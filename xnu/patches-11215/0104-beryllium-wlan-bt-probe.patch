+extern int sweet_ufs_part_size(const char *name, uint8_t *lun, uint64_t *bytes);
+extern int sweet_rpmh_vreg_set(const char *res, unsigned mv, bool enable);
+extern int sweet_rpmh_lookup(const char *res, uint32_t *address);
