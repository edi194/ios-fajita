+static struct {
+	vm_offset_t gcc, tlmm, se, smmu, smem, mutex;
+	uint32_t vote_before;           /* GCC_VOTE_WRAP0 before we touched it */
+	uint32_t tx_depth, rx_depth;
+	uint8_t rxq[512];
+	unsigned rxn;
+	unsigned stage, delay_s;
+	int sleep_chan;
+	bool started;
+} wl;
+
+static uint32_t
+wl_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wl_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+wl_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&wl.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+wl_map(void)
+{
+	if (!wl.gcc) {
+		wl.gcc = ml_io_map(WL_GCC_PA, WL_GCC_SIZE);
+	}
+	if (!wl.tlmm) {
+		wl.tlmm = ml_io_map(WL_TLMM_E_PA, 0x50000);
+	}
+	if (!wl.se) {
+		wl.se = ml_io_map(WL_SE6_PA, 0x4000);
+	}
+	if (!wl.smmu) {
+		wl.smmu = ml_io_map(WL_SMMU_PA, 0x1000 + 0x1000);   /* global space: SMR 0x800, S2CR 0xc00 */
+	}
+	if (!wl.smem) {
+		wl.smem = ml_io_map(WL_SMEM_PA, WL_SMEM_SIZE);
+	}
+	if (!wl.mutex) {
+		wl.mutex = ml_io_map(WL_MUTEX_PA, 0x4000);
+	}
+	return wl.gcc && wl.tlmm && wl.se && wl.smmu && wl.smem && wl.mutex;
+}
+
+/* ---------------------------------------------------------------- probe */
+
+static bool
+cbcr_on(uint32_t off)
+{
+	uint32_t v = wl_rd(wl.gcc, off);
+	return v != 0xffffffffu && !(v & (1u << 31));
+}
+
+static void
+wl_dump_gcc(void)
+{
+	static const struct { const char *name; uint32_t off; } clk[] = {
+		{ "wrap0 m_ahb", CBCR_M_AHB }, { "wrap0 s_ahb", CBCR_S_AHB }, { "wrap0 s6", CBCR_S6 },
+		{ "mss cfg_ahb", 0x8a000 }, { "mss q6_memnoc_axi", 0x8a154 }, { "mss snoc_axi", 0x8a150 },
+		{ "mss mfab_axis", 0x8a004 }, { "boot_rom_ahb", 0x38004 }, { "prng_ahb", 0x34004 },
+	};
+	for (unsigned i = 0; i < sizeof(clk) / sizeof(clk[0]); i++) {
+		uint32_t v = wl_rd(wl.gcc, clk[i].off);
+		printf("SWEET WLAN: GCC %-18s CBCR %#x = %#010x (%s)\n", clk[i].name, clk[i].off, v,
+		    (v & (1u << 31)) ? "off" : "on");
+	}
+	printf("SWEET WLAN: GCC vote 0x5200c=%#x 0x52004=%#x (mss_gpll0_div bit17)\n",
+	    wl_rd(wl.gcc, GCC_VOTE_WRAP0), wl_rd(wl.gcc, 0x52004));
+}
+
+/* DFS performance levels of the S6 root clock (clk-rcg2.c clk_rcg2_dfs): decode Hz. */
+static uint64_t
+wl_dfs_level_hz(unsigned lvl)
+{
+	uint32_t cfg = wl_rd(wl.gcc, RCG_S6 + 0x1c + 0x24 * lvl);
+	uint32_t m = wl_rd(wl.gcc, RCG_S6 + 0x20 + 0x24 * lvl);
+	uint32_t nr = wl_rd(wl.gcc, RCG_S6 + 0x24 + 0x24 * lvl);
+	unsigned src = (cfg >> 8) & 7, hid = cfg & 0x1f, mode = (cfg >> 12) & 3;
+	uint64_t parent = src == 0 ? 19200000ull : src == 1 ? GPLL0_HZ : src == 6 ? GPLL0_HZ / 2 : 0;
+	if (!parent || cfg == 0xffffffffu) {
+		return 0;
+	}
+	uint64_t hz = parent * 2 / (hid + 1);
+	if (mode && m) {
+		uint32_t n = (~nr + m) & 0xffffu;
+		if (n == 0) {
+			return 0;
+		}
+		hz = hz * m / n;
+	}
+	return hz;
+}
+
+static void
+wl_dump_dfs(void)
+{
+	uint32_t dfs = wl_rd(wl.gcc, RCG_S6 + 0x14);
+	printf("SWEET WLAN: S6 RCG cmd=%#x cfg=%#x dfs-cmd=%#x (%s)\n", wl_rd(wl.gcc, RCG_S6),
+	    wl_rd(wl.gcc, RCG_S6 + 4), dfs, (dfs & 1) ? "DFS on" : "DFS off: plain RCG");
+	for (unsigned l = 0; l < 8; l++) {
+		printf("SWEET WLAN: S6 DFS level %u: cfg %#x m %#x n %#x -> %llu Hz\n", l,
+		    wl_rd(wl.gcc, RCG_S6 + 0x1c + 0x24 * l), wl_rd(wl.gcc, RCG_S6 + 0x20 + 0x24 * l),
+		    wl_rd(wl.gcc, RCG_S6 + 0x24 + 0x24 * l), wl_dfs_level_hz(l));
+	}
+}
+
+static void
+wl_dump_gpio(void)
+{
+	static const char *const role[] = { "CTS", "RFR", "TX", "RX" };
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t cfg = wl_rd(wl.tlmm, (45 + i) * 0x1000u);
+		uint32_t io = wl_rd(wl.tlmm, (45 + i) * 0x1000u + 4);
+		printf("SWEET WLAN: TLMM EAST gpio%u (%s) ctl=%#x func=%u pull=%u drv=%u oe=%u in=%u\n",
+		    45 + i, role[i], cfg, (cfg >> 2) & 0xf, cfg & 3, (cfg >> 6) & 7, (cfg >> 9) & 1, io & 1);
+	}
+}
+
+static bool
+wl_se_clocks_ok(void)
+{
+	return cbcr_on(CBCR_M_AHB) && cbcr_on(CBCR_S_AHB) && cbcr_on(CBCR_S6);
+}
+
+static void
+wl_dump_se(void)
+{
+	if (!wl_se_clocks_ok()) {
+		printf("SWEET WLAN: SE6 clocks are gated (ABL left them off): SE6 registers NOT read\n");
+		return;
+	}
+	uint32_t fw = wl_rd(wl.se, SE_FW_REV);
+	uint32_t hw0 = wl_rd(wl.se, SE_HW_PARAM_0), hw1 = wl_rd(wl.se, SE_HW_PARAM_1);
+	printf("SWEET WLAN: SE6 fw-rev %#x protocol %u (2 = UART) if-disable %#x status %#x clk-sel %#x\n",
+	    fw, (fw >> 8) & 0xff, wl_rd(wl.se, SE_IF_DISABLE), wl_rd(wl.se, SE_STATUS),
+	    wl_rd(wl.se, SE_CLK_SEL));
+	printf("SWEET WLAN: SE6 hw-param0 %#x hw-param1 %#x\n", hw0, hw1);
+}
+
+static void
+wl_dump_rails(void)
+{
+	static const char *const rails[] = { "smpa4", "ldoa5", "ldoa7", "ldoa17", "ldoa23", "ldoa25" };
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		uint32_t addr = 0;
+		int err = sweet_rpmh_lookup(rails[i], &addr);
+		printf("SWEET WLAN: cmd-db %s -> %s %#x\n", rails[i], err ? "lookup failed" : "VRM address", addr);
+		if (err == EBUSY || err == ENODEV || err == EINVAL) {
+			if (i == 0) {
+				break;      /* RSC/cmd-db unusable: do not repeat the failure five times */
+			}
+		}
+	}
+}
+
+/* Linux qcom_smem.c layout (smem_ptable at the top of SMEM, "$PRT" partitions). */
+static uint32_t
+smem_u32(uint32_t off)
+{
+	return wl_rd(wl.smem, off & ~3u);
+}
+
+static void
+wl_dump_smem(void)
+{
+	uint32_t top = WL_SMEM_SIZE - 0x1000;
+	uint32_t magic = smem_u32(top), version = smem_u32(top + 4), n = smem_u32(top + 8);
+	printf("SWEET WLAN: SMEM table magic %#x (\"$TOC\" = 0x434f5424) version %u entries %u\n",
+	    magic, version, n);
+	if (magic != 0x434f5424u || n > 32) {
+		printf("SWEET WLAN: SMEM table not recognised\n");
+		return;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t e = top + 32 + i * 32;
+		uint32_t offset = smem_u32(e), size = smem_u32(e + 4), hosts = smem_u32(e + 12);
+		if (!offset || !size) {
+			continue;
+		}
+		printf("SWEET WLAN: SMEM partition %u: offset %#x size %#x hosts %u<->%u\n", i, offset, size,
+		    hosts & 0xffff, hosts >> 16);
+		if ((hosts & 0xffff) == 0 && (hosts >> 16) == 1 && offset + 32 < WL_SMEM_SIZE &&
+		    smem_u32(offset) == 0x54525024u) {
+			/* apps<->modem: list the items (the modem is cold if 435 is absent) */
+			uint32_t free_u = smem_u32(offset + 16), pos = offset + 32;
+			unsigned items = 0;
+			printf("SWEET WLAN: apps<->modem partition: free-uncached %#x\n", free_u);
+			while (pos + 16 <= offset + free_u && pos + 16 < WL_SMEM_SIZE && items < 16) {
+				uint32_t w0 = smem_u32(pos), size_e = smem_u32(pos + 4), w2 = smem_u32(pos + 8);
+				if ((w0 & 0xffff) != 0xa5a5) {
+					break;
+				}
+				printf("SWEET WLAN:   item %u size %u\n", w0 >> 16, size_e - (w2 & 0xffff));
+				pos += 16 + (w2 >> 16) + size_e;
+				items++;
+			}
+		}
+	}
+	printf("SWEET WLAN: TCSR mutex 3 (SMEM hwlock) reads %#x\n", wl_rd(wl.mutex, WL_SMEM_HWLOCK * 0x1000));
+}
+
+static void
+wl_dump_smmu(void)
+{
+	uint32_t id0 = wl_rd(wl.smmu, 0x20), id1 = wl_rd(wl.smmu, 0x24), id2 = wl_rd(wl.smmu, 0x28);
+	unsigned nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	printf("SWEET WLAN: apps_smmu sCR0 %#x IDR0 %#x IDR1 %#x IDR2 %#x (%u SMRs, %u context banks)\n",
+	    wl_rd(wl.smmu, 0), id0, id1, id2, nsmr, ncb);
+	if (nsmr == 0 || nsmr > 256 || 0xc00 + nsmr * 4 > 0x2000) {
+		return;
+	}
+	static const unsigned sids[] = { 0x40, 0x740 };     /* WLAN (iommus 0x40 mask 1), USB1 */
+	for (unsigned s = 0; s < sizeof(sids) / sizeof(sids[0]); s++) {
+		bool found = false;
+		for (unsigned i = 0; i < nsmr; i++) {
+			uint32_t smr = wl_rd(wl.smmu, 0x800 + i * 4), s2cr = wl_rd(wl.smmu, 0xc00 + i * 4);
+			if (!(smr >> 31)) {
+				continue;
+			}
+			uint32_t id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+			if (((sids[s] ^ id) & ~mask & 0x7fff) == 0) {
+				printf("SWEET WLAN: SMMU sid %#x matched by SMR%u id %#x mask %#x -> S2CR %#x (type %u cb %u)\n",
+				    sids[s], i, id, mask, s2cr, (s2cr >> 16) & 3, s2cr & 0xff);
+				found = true;
+			}
+		}
+		if (!found) {
+			printf("SWEET WLAN: SMMU sid %#x: no valid SMR matches\n", sids[s]);
+		}
+	}
+}
+
+static void
+wl_probe(void)
+{
+	printf("SWEET WLAN: probe (read-only), stage %u\n", wl.stage);
+	wl_dump_gcc();
+	wl_dump_dfs();
+	wl_dump_gpio();
+	wl_dump_se();
+	wl_dump_rails();
+	wl_dump_smem();
+	wl_dump_smmu();
+	printf("SWEET WLAN: probe done (RMB 0x4180000 / QDSP6 0x4080000 deliberately not read: gated)\n");
+}
+
+/* ---------------------------------------------------------------- stage 3: inventory */
+
+static void
+wl_part_info(const char *name)
+{
+	uint8_t lun = 0;
+	uint64_t bytes = 0;
+	uint8_t head[16];
+	int err = sweet_ufs_part_size(name, &lun, &bytes);
+	if (err) {
+		printf("SWEET WLAN: partition \"%s\": not found (%d)\n", name, err);
+		return;
+	}
+	err = sweet_ufs_read_part(name, 0, head, sizeof(head));
+	bool nonzero = false;
+	for (unsigned i = 0; i < sizeof(head); i++) {
+		nonzero |= head[i] != 0;
+	}
+	printf("SWEET WLAN: partition \"%s\": LUN %u, %llu KiB, first 16 bytes %s%s\n", name, lun,
+	    bytes >> 10, err ? "unreadable" : nonzero ? "non-zero" : "all zero", "");
+}
+
+static void
+wl_file_info(const struct wl_fat *f, const char *path)
+{
+	uint32_t cl, size;
+	int err = fat_open(f, path, &cl, &size);
+	if (err) {
+		printf("SWEET WLAN: %s:%s not found (%d)\n", f->part, path, err);
+	} else {
+		printf("SWEET WLAN: %s:%s cluster %u size %u\n", f->part, path, cl, size);
+	}
+}
+
+static void
+wl_inventory(void)
+{
+	static struct wl_fat fat;
+	static struct wl_mdt mdt, mba_unused;
+	uint32_t cnt = 0;
+	uint32_t cl, size;
+	int err;
+
+	(void)mba_unused;
+	printf("SWEET WLAN: inventory (read-only UFS reads; nothing is written)\n");
+	static const char *const parts[] = { "modemst1", "modemst2", "fsg", "fsc", "persist", "dsp" };
+	for (unsigned i = 0; i < sizeof(parts) / sizeof(parts[0]); i++) {
+		wl_part_info(parts[i]);
+	}
+	err = fat_mount(&fat, "modem");
+	printf("SWEET WLAN: modem partition FAT16 mount: %d", err);
+	if (!err) {
+		printf(" (bytes/sector %u, sectors/cluster %u, clusters %u, FAT %u sectors)\n", fat.bps,
+		    fat.spc, fat.ncl, fat.fatsz);
+		wl_file_info(&fat, "image/mba.mbn");
+		wl_file_info(&fat, "image/wlanmdsp.mbn");
+		wl_file_info(&fat, "image/qdsp6m.qdb");
+		if (!fat_count_prefix(&fat, "image", "bdwlan", &cnt)) {
+			printf("SWEET WLAN: modem:image/bdwlan.* %u files\n", cnt);
+		}
+		if (!fat_count_prefix(&fat, "image", "bdf_", &cnt)) {
+			printf("SWEET WLAN: modem:image/bdf_*.bin %u files\n", cnt);
+		}
+		err = mdt_summarise(&fat, "image/modem.mdt", "MPSS", &mdt);
+		if (!err) {
+			/* DT carve-outs (live DT = Linux beryllium dtsi): mpss 0x8e400000+0x7800000,
+			 * mba 0x96900000+0x200000, wlan msa 0x8e300000+0x100000 */
+			printf("SWEET WLAN: MPSS image %#x..%#x vs carve-out 0x8e400000..0x95c00000: %s\n", mdt.lo, mdt.hi,
+			    mdt.relocatable ? "relocatable (loader picks the base)" :
+			    (mdt.lo >= 0x8e400000u && mdt.hi <= 0x95c00000u) ? "fits" : "DOES NOT FIT at its fixed address");
+		}
+		if (!fat_open(&fat, "image/mba.mbn", &cl, &size)) {
+			printf("SWEET WLAN: MBA %u bytes vs 2 MiB carve-out (0x96900000): %s\n", size,
+			    size <= 0x200000 ? "fits" : "TOO BIG");
+		}
+	} else {
+		printf("\n");
+	}
+	err = fat_mount(&fat, "bluetooth");
+	printf("SWEET WLAN: bluetooth partition FAT16 mount: %d\n", err);
+	if (!err) {
+		static const char *const bt[] = {
+			"image/crbtfw21.tlv", "image/crnv21.bin", "image/crbtfw20.tlv", "image/crnv20.bin",
+			"image/crbtfw11.tlv", "image/crnv11.bin",
+		};
+		for (unsigned i = 0; i < sizeof(bt) / sizeof(bt[0]); i++) {
+			wl_file_info(&fat, bt[i]);
+		}
+	}
+	printf("SWEET WLAN: inventory done\n");
+}
+
+/* ---------------------------------------------------------------- stage 2: Bluetooth */
+
+static void
+wl_gpio_cfg(unsigned pin, unsigned func, unsigned pull, unsigned drive)
+{
+	uint32_t off = pin * 0x1000u;
+	uint32_t cfg = wl_rd(wl.tlmm, off);
+	cfg &= ~0x3ffu;
+	cfg |= (func << 2) | pull | (drive << 6);     /* output enable: owned by the function */
+	wl_wr(wl.tlmm, off, cfg);
+}
+
+static bool
+wl_clocks_on(void)
+{
+	wl.vote_before = wl_rd(wl.gcc, GCC_VOTE_WRAP0);
+	wl_wr(wl.gcc, GCC_VOTE_WRAP0, wl.vote_before | VOTE_M_AHB | VOTE_S_AHB | VOTE_S6);
+	for (unsigned i = 0; i < 2000 && !wl_se_clocks_ok(); i++) {
+		delay(10);
+	}
+	if (!wl_se_clocks_ok()) {
+		printf("SWEET WLAN: SE6 clock branches did not come on: m_ahb %#x s_ahb %#x s6 %#x\n",
+		    wl_rd(wl.gcc, CBCR_M_AHB), wl_rd(wl.gcc, CBCR_S_AHB), wl_rd(wl.gcc, CBCR_S6));
+		return false;
+	}
+	return true;
+}
+
+static void
+wl_clocks_off(void)
+{
+	/* put back only the bits we added */
+	uint32_t now = wl_rd(wl.gcc, GCC_VOTE_WRAP0);
+	uint32_t add = (VOTE_M_AHB | VOTE_S_AHB | VOTE_S6) & ~wl.vote_before;
+	wl_wr(wl.gcc, GCC_VOTE_WRAP0, now & ~add);
+}
+
+/* pick DFS level and GENI divider for a baud rate; 0 on failure */
+static bool
+wl_baud(unsigned baud)
+{
+	unsigned best_l = 8, best_div = 0;
+	uint64_t best_err = ~0ull;
+	if (!(wl_rd(wl.gcc, RCG_S6 + 0x14) & 1)) {
+		printf("SWEET WLAN: S6 root clock is not in DFS mode: need RCG programming, aborting\n");
+		return false;
+	}
+	for (unsigned l = 0; l < 8; l++) {
+		uint64_t hz = wl_dfs_level_hz(l);
+		uint64_t unit = (uint64_t)baud * UART_OVERSAMPLING;
+		if (hz < unit) {
+			continue;
+		}
+		uint64_t div = (hz + unit / 2) / unit;
+		if (div == 0 || div > 4095) {
+			continue;
+		}
+		uint64_t got = hz / div;
+		uint64_t err = got > unit ? got - unit : unit - got;
+		if (err * 1000 < unit * 5 && err < best_err) {      /* < 0.5 % */
+			best_err = err;
+			best_l = l;
+			best_div = (unsigned)div;
+		}
+	}
+	if (best_l == 8) {
+		printf("SWEET WLAN: no DFS level of S6 gives %u baud within 0.5 %%\n", baud);
+		return false;
+	}
+	wl_wr(wl.se, SE_CLK_SEL, best_l);
+	wl_wr(wl.se, SE_M_CLK_CFG, (best_div << 4) | 1u);
+	wl_wr(wl.se, SE_S_CLK_CFG, (best_div << 4) | 1u);
+	printf("SWEET WLAN: UART %u baud: DFS level %u (%llu Hz), divider %u\n", baud, best_l,
+	    wl_dfs_level_hz(best_l), best_div);
+	return true;
+}
+
+static void
+wl_flow(bool hw)
+{
+	uint32_t v = wl_rd(wl.se, SE_UART_TX_TRANS_CFG);
+	v = hw ? (v & ~UART_CTS_MASK) : (v | UART_CTS_MASK);
+	wl_wr(wl.se, SE_UART_TX_TRANS_CFG, v);
+}
+
+/* geni_se_config_packing(8, 4, false, true, true) */
+static void
+wl_packing(void)
+{
+	uint32_t cfg[4] = { 0 };
+	for (int i = 0; i < 4; i++) {
+		cfg[i] = ((uint32_t)(i * 8) << 5) | (7u << 1);
+	}
+	cfg[3] |= 1u;                                 /* stop bit */
+	uint32_t c0 = cfg[0] | (cfg[1] << 10), c1 = cfg[2] | (cfg[3] << 10);
+	wl_wr(wl.se, SE_TX_PACKING0, c0);
+	wl_wr(wl.se, SE_TX_PACKING1, c1);
+	wl_wr(wl.se, SE_RX_PACKING0, c0);
+	wl_wr(wl.se, SE_RX_PACKING1, c1);
+	wl_wr(wl.se, SE_BYTE_GRAN, 0);
+}
+
+static bool
+wl_uart_open(void)
+{
+	uint32_t fw = wl_rd(wl.se, SE_FW_REV);
+	if (((fw >> 8) & 0xff) != SE_PROTO_UART) {
+		printf("SWEET WLAN: SE6 protocol is %u, not UART (QUP firmware not loaded for UART): stop\n",
+		    (fw >> 8) & 0xff);
+		return false;
+	}
+	if (wl_rd(wl.se, SE_STATUS) & ((1u << 0) | (1u << 12))) {
+		printf("SWEET WLAN: SE6 busy (status %#x): stop\n", wl_rd(wl.se, SE_STATUS));
+		return false;
+	}
+	wl.tx_depth = (wl_rd(wl.se, SE_HW_PARAM_0) >> 16) & 0x3f;
+	wl.rx_depth = (wl_rd(wl.se, SE_HW_PARAM_1) >> 16) & 0x3f;
+	if (wl.tx_depth < 8 || wl.rx_depth < 8) {
+		printf("SWEET WLAN: odd FIFO depths tx %u rx %u (hw-param %#x/%#x): stop\n", wl.tx_depth,
+		    wl.rx_depth, wl_rd(wl.se, SE_HW_PARAM_0), wl_rd(wl.se, SE_HW_PARAM_1));
+		return false;
+	}
+	/* geni_se_io_init + io_set_mode + init */
+	wl_wr(wl.se, SE_CGC_CTRL, wl_rd(wl.se, SE_CGC_CTRL) | 0x7fu);
+	wl_wr(wl.se, SE_DMA_GENERAL_CFG, wl_rd(wl.se, SE_DMA_GENERAL_CFG) | 0xfu);
+	wl_wr(wl.se, SE_OUTPUT_CTRL, 0x7fu);
+	wl_wr(wl.se, SE_FORCE_DEFAULT, 1u);
+	wl_wr(wl.se, SE_GSI_EVENT_EN, 0);
+	wl_wr(wl.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	wl_wr(wl.se, SE_S_IRQ_CLEAR, 0xffffffffu);
+	wl_wr(wl.se, SE_DMA_TX_IRQ_CLR, 0xffffffffu);
+	wl_wr(wl.se, SE_DMA_RX_IRQ_CLR, 0xffffffffu);
+	wl_wr(wl.se, SE_IRQ_EN, wl_rd(wl.se, SE_IRQ_EN) | 0xfu);
+	wl_wr(wl.se, SE_DMA_MODE_EN, wl_rd(wl.se, SE_DMA_MODE_EN) & ~1u);
+	wl_packing();
+	wl_wr(wl.se, SE_RX_WM, 2);
+	wl_wr(wl.se, SE_RX_RFR_WM, wl.rx_depth - 2);
+	wl_wr(wl.se, SE_UART_RX_STALE, 160);          /* DEFAULT_BITS_PER_CHAR * STALE_TIMEOUT */
+	wl_wr(wl.se, SE_UART_TX_WORD_LEN, 8);
+	wl_wr(wl.se, SE_UART_RX_WORD_LEN, 8);
+	wl_wr(wl.se, SE_UART_TX_STOP_LEN, 0);
+	wl_wr(wl.se, SE_UART_TX_PARITY, 0);
+	wl_wr(wl.se, SE_UART_RX_PARITY, 0);
+	wl_wr(wl.se, SE_UART_RX_TRANS_CFG, 0);
+	wl_wr(wl.se, SE_UART_TX_TRANS_CFG, UART_CTS_MASK);    /* flow control off */
+	wl_wr(wl.se, SE_UART_MANUAL_RFR, 0);
+	return true;
+}
+
+static void
+wl_rx_start(void)
+{
+	wl_wr(wl.se, SE_S_IRQ_CLEAR, 0xffffffffu);
+	wl_wr(wl.se, SE_S_CMD0, UART_START_READ << 27);
+}
+
+static void
+wl_rx_stop(void)
+{
+	if (wl_rd(wl.se, SE_STATUS) & (1u << 12)) {
+		wl_wr(wl.se, SE_S_CMD_CTRL, 1u << 2);     /* cancel */
+		for (unsigned i = 0; i < 2000 && (wl_rd(wl.se, SE_STATUS) & (1u << 12)); i++) {
+			delay(10);
+		}
+		if (wl_rd(wl.se, SE_STATUS) & (1u << 12)) {
+			wl_wr(wl.se, SE_S_CMD_CTRL, 1u << 1); /* abort */
+			for (unsigned i = 0; i < 2000 && (wl_rd(wl.se, SE_STATUS) & (1u << 12)); i++) {
+				delay(10);
+			}
+		}
+	}
+	wl_wr(wl.se, SE_S_IRQ_CLEAR, 0xffffffffu);
+}
+
+/* drain the RX FIFO into wl.rxq */
+static void
+wl_rx_poll(void)
+{
+	uint32_t st = wl_rd(wl.se, SE_RX_FIFO_STATUS);
+	uint32_t words = st & 0x1ffffffu;
+	if (!words) {
+		return;
+	}
+	uint32_t bytes = 4 * (words - 1);
+	uint32_t lastv = (st >> 28) & 7;
+	bytes += ((st >> 31) && lastv) ? lastv : 4;
+	for (uint32_t w = 0; w < words; w++) {
+		uint32_t v = wl_rd(wl.se, SE_RX_FIFO);
+		for (unsigned k = 0; k < 4 && bytes; k++, bytes--) {
+			if (wl.rxn < sizeof(wl.rxq)) {
+				wl.rxq[wl.rxn++] = (uint8_t)(v >> (8 * k));
+			}
+		}
+	}
+}
+
+static bool
+wl_tx(const uint8_t *buf, unsigned len, unsigned baud)
+{
+	if (len == 0 || len > 4u * (wl.tx_depth - 2)) {
+		return false;
+	}
+	for (unsigned i = 0; i < 1000 && (wl_rd(wl.se, SE_STATUS) & 1u); i++) {
+		delay(10);
+	}
+	wl_wr(wl.se, SE_M_IRQ_CLEAR, 0xffffffffu);
+	wl_wr(wl.se, SE_TX_WM, 2);
+	wl_wr(wl.se, SE_UART_TX_TRANS_LEN, len);
+	wl_wr(wl.se, SE_M_CMD0, UART_START_TX << 27);
+	for (unsigned i = 0; i < len; i += 4) {
+		uint32_t w = 0;
+		for (unsigned k = 0; k < 4 && i + k < len; k++) {
+			w |= (uint32_t)buf[i + k] << (8 * k);
+		}
+		wl_wr(wl.se, SE_TX_FIFO, w);
+	}
+	/* 12 bit times per byte plus 50 ms; flow control may hold the transmitter */
+	uint64_t us = ((uint64_t)len * 12 * 1000000ull) / baud + 50000;
+	bool done = false;
+	for (uint64_t t = 0; t < us; t += 20) {
+		if (wl_rd(wl.se, SE_M_IRQ_STATUS) & M_CMD_DONE) {
+			done = true;
+			break;
+		}
+		delay(20);
+	}
+	if (!done) {
+		wl_wr(wl.se, SE_M_CMD_CTRL, 1u << 1);     /* abort */
+		for (unsigned i = 0; i < 1000 && !(wl_rd(wl.se, SE_M_IRQ_STATUS) & M_CMD_ABORT); i++) {
+			delay(10);
+		}
+		wl_wr(wl.se, SE_M_IRQ_CLEAR, M_CMD_ABORT);
+		printf("SWEET WLAN: UART TX of %u bytes timed out (aborted)\n", len);
+		return false;
+	}
+	wl_wr(wl.se, SE_M_IRQ_CLEAR, M_CMD_DONE);
+	return true;
+}
+
+static void
+wl_power_pulse(bool on, unsigned baud)
+{
+	uint8_t b = on ? QCA_POWER_ON_PULSE : QCA_POWER_OFF_PULSE;
+	wl_rx_stop();
+	wl_flow(false);
+	(void)wl_tx(&b, 1, baud);
+	wl_sleep(on ? 100 : 10);
+	wl_rx_start();
+	wl.rxn = 0;
+}
+
+/* One HCI command; prints and returns the first matching event in rsp. */
+static int
+wl_hci_cmd(uint16_t opcode, const uint8_t *params, unsigned plen, uint8_t *rsp, unsigned *rlen,
+    unsigned timeout_ms)
+{
+	uint8_t pkt[16];
+	if (plen > sizeof(pkt) - 4) {
+		return EINVAL;
+	}
+	pkt[0] = 0x01;
+	pkt[1] = (uint8_t)opcode;
+	pkt[2] = (uint8_t)(opcode >> 8);
+	pkt[3] = (uint8_t)plen;
+	if (plen) {
+		memcpy(pkt + 4, params, plen);
+	}
+	wl.rxn = 0;
+	if (!wl_tx(pkt, 4 + plen, 115200)) {
+		return EIO;
+	}
+	for (unsigned t = 0; t < timeout_ms; t++) {
+		wl_rx_poll();
+		unsigned pos = 0;
+		while (pos < wl.rxn) {
+			if (wl.rxq[pos] != 0x04) {
+				pos++;                      /* not an event: resync */
+				continue;
+			}
+			if (pos + 3 > wl.rxn) {
+				break;
+			}
+			unsigned elen = wl.rxq[pos + 2];
+			if (pos + 3 + elen > wl.rxn) {
+				break;
+			}
+			uint8_t evt = wl.rxq[pos + 1];
+			const uint8_t *d = &wl.rxq[pos + 3];
+			bool match = (evt == 0x0e && elen >= 3 && (d[1] | (d[2] << 8)) == opcode) ||
+			    (evt == 0x0f && elen >= 4 && (d[2] | (d[3] << 8)) == opcode) ||
+			    (evt == 0xff && opcode == 0xfc00);
+			if (match) {
+				*rlen = MIN(elen + 2, 48u);
+				rsp[0] = evt;
+				rsp[1] = (uint8_t)elen;
+				memcpy(rsp + 2, d, *rlen - 2);
+				return 0;
+			}
+			pos += 3 + elen;
+		}
+		delay(1000);
+	}
+	return ETIMEDOUT;
+}
+
+static void
+wl_print_hex(const char *what, const uint8_t *b, unsigned n)
+{
+	char line[3 * 48 + 1];
+	unsigned o = 0;
+	for (unsigned i = 0; i < n && o + 3 < sizeof(line); i++) {
+		o += (unsigned)snprintf(line + o, sizeof(line) - o, "%02x ", b[i]);
+	}
+	printf("SWEET WLAN: HCI %s: %s\n", what, line);
+}
+
+static const struct { const char *res; unsigned mv; } wl_bt_rails[] = {
+	{ "ldoa7", 1800 }, { "ldoa17", 1304 }, { "ldoa25", 3300 },
+};
+
+static void
+wl_bt(void)
+{
+	uint8_t rsp[48];
+	unsigned rlen = 0, n = 0;
+	int err;
+
+	if (!wl_clocks_on()) {
+		return;
+	}
+	/* pins first (Linux order: pinctrl default state, then the UART probes) */
+	wl_gpio_cfg(45, 1, 1 /* pull-down */, 0);
+	wl_gpio_cfg(46, 1, 0, 0);
+	wl_gpio_cfg(47, 1, 0, 0);
+	wl_gpio_cfg(48, 1, 3 /* pull-up */, 0);
+	wl_dump_gpio();
+	if (!wl_uart_open()) {
+		goto out_clocks;
+	}
+	for (n = 0; n < sizeof(wl_bt_rails) / sizeof(wl_bt_rails[0]); n++) {
+		err = sweet_rpmh_vreg_set(wl_bt_rails[n].res, wl_bt_rails[n].mv, true);
+		printf("SWEET WLAN: rail %s %u mV -> %d\n", wl_bt_rails[n].res, wl_bt_rails[n].mv, err);
+		if (err) {
+			goto out_rails;
+		}
+		wl_sleep(2);
+	}
+	wl_sleep(10);
+	/* qca_regulator_init(): 2400 baud power-off pulse, then 115200 baud power-on pulse */
+	if (!wl_baud(2400)) {
+		goto out_rails;
+	}
+	wl_rx_start();
+	wl_power_pulse(false, 2400);
+	if (!wl_baud(115200)) {
+		goto out_rails;
+	}
+	wl_power_pulse(true, 115200);
+	wl_flow(true);
+	wl_rx_poll();
+	printf("SWEET WLAN: after power-on pulse: %u stray RX bytes\n", wl.rxn);
+	wl.rxn = 0;
+
+	err = wl_hci_cmd(0x0c03, NULL, 0, rsp, &rlen, 1000);        /* HCI_Reset */
+	if (err) {
+		printf("SWEET WLAN: HCI Reset: no event (%d)\n", err);
+	} else {
+		wl_print_hex("Reset event", rsp, rlen);
+	}
+	err = wl_hci_cmd(0x1001, NULL, 0, rsp, &rlen, 1000);        /* Read_Local_Version_Information */
+	if (err) {
+		printf("SWEET WLAN: HCI Read Local Version: no event (%d)\n", err);
+	} else {
+		wl_print_hex("Read Local Version", rsp, rlen);
+	}
+	{
+		static const uint8_t ver_req[1] = { 0x19 };             /* EDL_PATCH_VER_REQ_CMD */
+		err = wl_hci_cmd(0xfc00, ver_req, 1, rsp, &rlen, 1000);
+		if (err) {
+			printf("SWEET WLAN: QCA read patch version: no event (%d)\n", err);
+		} else {
+			wl_print_hex("QCA patch version (product/patch/rom/soc follow the 0x19 header)", rsp, rlen);
+		}
+	}
+	/* hci_qca qca_power_off(): 2400 baud power-off pulse, rails off */
+	wl_rx_stop();
+	if (wl_baud(2400)) {
+		wl_power_pulse(false, 2400);
+	}
+out_rails:
+	{
+		unsigned keep = 0;
+		(void)PE_parse_boot_argn("sweetwlankeep", &keep, sizeof(keep));
+		if (!keep) {
+			for (unsigned i = n >= sizeof(wl_bt_rails) / sizeof(wl_bt_rails[0]) ?
+			    (unsigned)(sizeof(wl_bt_rails) / sizeof(wl_bt_rails[0])) : n; i-- > 0;) {
+				err = sweet_rpmh_vreg_set(wl_bt_rails[i].res, wl_bt_rails[i].mv, false);
+				printf("SWEET WLAN: rail %s off -> %d\n", wl_bt_rails[i].res, err);
+				wl_sleep(2);
+			}
+		} else {
+			printf("SWEET WLAN: sweetwlankeep=1: rails left on\n");
+		}
+	}
+out_clocks:
+	wl_rx_stop();
+	wl_clocks_off();
+	printf("SWEET WLAN: bluetooth stage done\n");
+}
+
+/* ---------------------------------------------------------------- thread */
+
+static void
+wl_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	printf("SWEET WLAN: stage %u starts in %u s\n", wl.stage, wl.delay_s);
+	wl_sleep(wl.delay_s * 1000u);
+	if (!wl_map()) {
+		printf("SWEET WLAN: MMIO mapping failed\n");
+		goto out;
+	}
+	wl_probe();
+	if (wl.stage == 2) {
+		wl_bt();
+	} else if (wl.stage == 3) {
+		wl_inventory();
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+beryllium_wlan_init(void)
+{
+	unsigned stage = 0, delay_s = 90;
+	thread_t thread;
+
+	if (wl.started || !sweet_board_beryllium()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetwlan", &stage, sizeof(stage));
+	if (stage == 0) {
+		return;                 /* off by default: no log line, no mapping */
+	}
+	(void)PE_parse_boot_argn("sweetwlandelay", &delay_s, sizeof(delay_s));
+	wl.started = true;
+	wl.stage = stage;
+	wl.delay_s = delay_s;
+	if (kernel_thread_start(wl_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET WLAN: kernel_thread_start failed\n");
+	}
+}
+
+#endif /* !WLAN_HOST_TEST */
+#endif /* WLAN_HOST_TEST || ARM64_BOARD_CONFIG_SWEET */
