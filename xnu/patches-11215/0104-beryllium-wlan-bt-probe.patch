+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+int wl_host_read(const char *part, uint64_t off, void *dst, uint64_t len);
+#define WL_PART_READ(p, o, d, l)  wl_host_read((p), (o), (d), (l))
+#elif defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
