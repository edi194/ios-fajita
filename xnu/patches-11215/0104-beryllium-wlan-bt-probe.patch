+/*
+ * Poco F1 (beryllium, SDM845 + WCN3990) Wi-Fi / Bluetooth bring-up ladder.
+ *
+ * OFF by default. Boot-arg sweetwlan=N selects ONE stage (each stage runs the
+ * read-only probe first); sweetwlandelay=S waits S seconds after the root
+ * device is up (default 90) so the persistent log and the UI are alive if a
+ * register access hangs the SoC.
+ *
+ *   1  read-only probe: GCC clock status, SE6 (BT UART) geometry and QUP
+ *      firmware protocol, TLMM, cmd-db rail addresses, SMEM table, apps SMMU
+ *      stream mapping of the WLAN stream (0x40), TCSR mutex. Writes nothing.
+ *   2  Bluetooth: vote the WCN3990 rails through RPMh, bring up the polled
+ *      GENI UART on SE6 (QUP wrap0 S6, 0x898000), send the QCA power pulses,
+ *      then HCI Reset / Read Local Version / QCA "read patch version"
+ *      (vendor 0xfc00 0x19). No firmware download. Needs NO modem.
+ *   3  Modem groundwork, READ-ONLY: UFS partition inventory (modem, modemst1/2,
+ *      fsg, fsc, bluetooth), FAT16 walk of the modem and bluetooth partitions,
+ *      MBA / MPSS .mdt ELF segment table checked against the MSS carve-outs.
+ *      No SCM call, no MSS reset, no write to any partition.
+ *
+ * Reference: docs/WIFI_BT_PLAN.md. Linux behaviour mirrored here:
+ * drivers/bluetooth/hci_qca.c (power pulses 0xc0 off / 0xfc on at 2400 and
+ * 115200 baud, flow control off while pulsing), btqca.c (EDL read version),
+ * drivers/soc/qcom/qcom-geni-se.c + drivers/tty/serial/qcom_geni_serial.c
+ * (SE init, FIFO UART), gcc-sdm845.c (clock registers).
+ * Nothing here is verified on hardware yet.
+ */
+#if defined(WLAN_HOST_TEST)
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
