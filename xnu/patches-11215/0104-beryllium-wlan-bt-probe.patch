+/*
+ * Read-only access to other GPT partitions (modem, modemst1/2, fsg, fsc,
+ * bluetooth, ...) on LUNs 0-5, for the Wi-Fi/Bluetooth firmware work
+ * (bsd/dev/beryllium_wlan.c). Only READ(10) is ever issued here, the root
+ * device state (su.lun, su.first_block, su.nblocks) is restored before the
+ * lock is dropped, and nothing is cached in the bounce buffer.
+ */
+#define PART_LUNS       6u
+#define PART_CACHE_N    8u
+static struct {
+	char name[24];
+	uint8_t lun;
+	uint64_t first, nblocks;
+} part_cache[PART_CACHE_N];
+static unsigned part_cache_n;
+
+/* Caller holds sweet_ufs_lock and has set su.lun. */
+static int
+ufs_gpt_find_on_lun(const char *want, uint64_t *first, uint64_t *nblocks)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t f, l;
+		memcpy(&f, e + 32, 8);
+		memcpy(&l, e + 40, 8);
+		if (l < f) {
+			return ENXIO;
+		}
+		*first = f;
+		*nblocks = l - f + 1;
+		return 0;
+	}
+	return ENOENT;
+}
+
+/* Caller holds sweet_ufs_lock. */
+static int
+ufs_part_locate(const char *want, uint8_t *lun, uint64_t *first, uint64_t *nblocks)
+{
+	for (unsigned i = 0; i < part_cache_n; i++) {
+		if (strcmp(part_cache[i].name, want) == 0) {
+			*lun = part_cache[i].lun;
+			*first = part_cache[i].first;
+			*nblocks = part_cache[i].nblocks;
+			return 0;
+		}
+	}
+	if (strlen(want) >= sizeof(part_cache[0].name)) {
+		return EINVAL;
+	}
+	uint8_t saved = su.lun;
+	int error = ENOENT;
+	for (uint8_t l = 0; l < PART_LUNS && error == ENOENT; l++) {
+		su.lun = l;
+		int e = ufs_gpt_find_on_lun(want, first, nblocks);
+		if (e == 0) {
+			*lun = l;
+			error = 0;
+		}
+	}
+	su.lun = saved;
+	if (!error && part_cache_n < PART_CACHE_N) {
+		strlcpy(part_cache[part_cache_n].name, want, sizeof(part_cache[0].name));
+		part_cache[part_cache_n].lun = *lun;
+		part_cache[part_cache_n].first = *first;
+		part_cache[part_cache_n].nblocks = *nblocks;
+		part_cache_n++;
+	}
+	return error;
+}
+
+int
+sweet_ufs_part_size(const char *name, uint8_t *lun, uint64_t *bytes)
+{
+	uint64_t first, nblocks;
+	uint8_t l = 0;
+	if (!su.ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = ufs_part_locate(name, &l, &first, &nblocks);
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (!error) {
+		if (lun) {
+			*lun = l;
+		}
+		if (bytes) {
+			*bytes = nblocks * UFS_BLOCK;
+		}
+	}
+	return error;
+}
+
+int
+sweet_ufs_read_part(const char *name, uint64_t off, void *dst, uint64_t len)
+{
+	uint64_t first, nblocks;
+	uint8_t lun = 0, saved;
+	if (!su.ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = ufs_part_locate(name, &lun, &first, &nblocks);
+	if (!error && (off > nblocks * UFS_BLOCK || len > nblocks * UFS_BLOCK - off)) {
+		error = EINVAL;
+	}
+	saved = su.lun;
+	su.lun = lun;
+	for (uint64_t done = 0; !error && done < len;) {
+		uint64_t pos = off + done;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = (uint32_t)MIN(len - done, (uint64_t)BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(first + pos / UFS_BLOCK, blocks);
+		if (!error) {
+			memcpy((uint8_t *)dst + done, (const uint8_t *)(su.dma + DMA_BOUNCE) + skip, want);
+			done += want;
+		}
+	}
+	su.lun = saved;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
