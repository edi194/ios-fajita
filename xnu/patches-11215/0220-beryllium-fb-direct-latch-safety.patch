+/* The newest frame is on the panel: flush bits clear (twice, 20 us apart, with fLatchConfirm). */
+bool
+AppleCLCD::latchedNow(void)
+{
+	volatile uint32_t *flush = (volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH);
