+/* Wait (sleeping) for the queued frame's latch, up to 20 ms, so it is not overwritten (0220). False: gave up. */
+bool
+AppleCLCD::waitReplace(void)
 {
 	volatile uint32_t *flush = (volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH);
+	uint64_t t0 = mach_absolute_time(), limit;
+	nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &limit);
+	fSt.replaceWaits++;
+	while (*flush & fLastFlush) {
+		if (mach_absolute_time() - t0 > limit) {
+			fSt.replaceTimeouts++;
+			return false;
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+	}
+	if (!latchedNow()) {
+		return waitReplace();   /* a glitch: the bits came back */
+	}
+	if (fGuardAbs != 0) {
+		uint64_t us = sweet_abs_us(fGuardAbs);
+		delay_for_interval((uint32_t)us, NSEC_PER_USEC);
+	}
+	return true;
+}
