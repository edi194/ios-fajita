+/*
+ * Early (direct) path: runs on the work loop right after a swap. Takes the pending
+ * frame like vsyncFired does, scans it in place when it can, and otherwise puts it
+ * back (unless a newer swap arrived meanwhile) for the vsync tick's copy path. Never
+ * copies: a copied frame is rate limited by sweetfb_hz, a scanned one is not.
+ */
+void
+AppleCLCD::swapFired(OSObject *owner, IOTimerEventSource *)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	SweetSurface *taken[4] = {};
+
+	if (fb->fPowerOff) {
+		return;         /* the vsync tick runs the backlight ramp and redraws on power on */
+	}
+	IOLockLock(fb->fLock);
+	if (!fb->fDirty) {
+		IOLockUnlock(fb->fLock);
+		return;
+	}
+	memcpy(fb->fEarlyRec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+	fb->fDirty = false;
+	memcpy(taken, fb->fPendHold, sizeof(taken));
+	bzero(fb->fPendHold, sizeof(fb->fPendHold));
+	IOLockUnlock(fb->fLock);
+
+	fb->quietConsole();
+	if (fb->zcPresent(fb->fEarlyRec, get32(fb->fEarlyRec, 0x104))) {
+		sweet_hold_release(taken);      /* zcPresent holds the surface itself until its frame latched */
+		return;
+	}
+	SweetSurface *dropped[4] = {};
+	IOLockLock(fb->fLock);
+	if (!fb->fDirty) {
+		memcpy(fb->fPending, fb->fEarlyRec, SWEET_FB_SWAP_REC_SIZE);
+		fb->fDirty = true;
+		memcpy(fb->fPendHold, taken, sizeof(taken));
+	} else {
+		memcpy(dropped, taken, sizeof(dropped));        /* a newer swap replaced it while we looked */
+		fb->fSt.coalesced++;
+	}
+	IOLockUnlock(fb->fLock);
+	sweet_hold_release(dropped);
+}
