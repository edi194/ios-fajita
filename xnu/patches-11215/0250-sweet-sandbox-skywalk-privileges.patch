+/*
+ * Skywalk privileges, granted like AMFI does on iOS: only to a process holding the matching
+ * entitlement. bluetoothd (com.apple.private.skywalk.register-user-pipe) registers its audio
+ * user-pipe nexus "com.apple.bluetooth.AudioPipe" when an audio device connects; without the
+ * grant nxprov_create failed with EPERM, the audio channel stayed NULL and bluetoothd crashed in
+ * os_channel_get_fd(NULL) on its media queue (boot combo9: every "Connect" dropped, then a
+ * SIGSEGV loop because bluetoothd reconnects the device on every start).
+ */
+static const struct {
+	int priv;
+	const char *entitlement;
