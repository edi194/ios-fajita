+/*
+ * Durability (patch 0221).
+ *
+ * The root is a non-journaled HFS+ volume. HFS only starts its periodic syncer thread for
+ * non-root ejectable media (hfs_mount: HFS_RUN_SYNCER), the buffer cache writes delayed-write
+ * buffers only when it recycles them, and dirty file pages sit in the UBC until a sync or memory
+ * pressure. So on this system nothing pushed recent file data to the device until a userland
+ * sync(), the shutdown path, or an fsync: metadata (B-tree nodes, recycled out of the small buffer
+ * cache) reached the device, file data did not. After a reset the files had their size and
+ * extents and zeros as contents, and a half-written B-tree gives EIO/EINVAL. This thread closes
+ * that window: every ufssyncsecs seconds (default 5, 0 = off) all writable mounts get a
+ * synchronous VFS sync (the same hfs_sync(MNT_WAIT) the unmount path runs: file data first, then
+ * the B-trees, bitmap and volume header), followed by SYNCHRONIZE CACHE when anything was written.
+ */
+static int sweet_ufs_sync_chan;
+
+static int
+sweet_ufs_sync_cb(mount_t mp, __unused void *arg)
+{
+	if (!(vfs_flags(mp) & MNT_RDONLY)) {
+		(void)VFS_SYNC(mp, MNT_WAIT, vfs_context_kernel());
+	}
+	return VFS_RETURNED;
+}
+
+/* VFS sync of everything writable, then SYNCHRONIZE CACHE if the device has unflushed writes. */
+static int
+sweet_ufs_sync_all(void)
+{
+	int error = 0;
+
+	(void)vfs_iterate(LK_NOWAIT, sweet_ufs_sync_cb, NULL);
+	lck_mtx_lock(&sweet_ufs_lock);
+	if (su.dirty) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
+static void
+sweet_ufs_syncer_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t runs = 0;
+	uint64_t bad_mark = 0;
+
+	printf("SWEET UFS: syncer every %u s\n", su.syncsecs);
+	for (;;) {
+		(void)tsleep(&sweet_ufs_sync_chan, PZERO, "sweetsync", hz * (int)su.syncsecs);
+		int error = sweet_ufs_sync_all();
+		ss.syncer_runs++;
+		if (error) {
+			ss.syncer_errors++;
+		}
+		/* A stats line in the persistent log every minute, and at once when something went wrong. */
+		uint64_t bad = ss.errors + ss.timeouts + ss.retries + ss.is_errors + ss.verify_bad +
+		    ss.verify_io_errors + ss.flush_errors + ss.strat_errors;
+		if (bad != bad_mark || ++runs * su.syncsecs >= 60) {
+			printf("SWEET UFS STATS: rd %llu (%llu blk) wr %llu (%llu blk) flush %llu rmw %llu "
+			    "fua %llu | err %llu fail %llu timeout %llu retry %llu is_err %llu flush_err %llu "
+			    "strat_err %llu resid %llu verify ok %llu bad %llu io %llu | last cdb 0x%x ocs 0x%x "
+			    "status 0x%x sense 0x%06x is 0x%x\n",
+			    ss.reads, ss.read_blocks, ss.writes, ss.write_blocks, ss.flushes, ss.strat_rmw,
+			    ss.strat_fua, ss.errors, ss.cmd_failures, ss.timeouts, ss.retries, ss.is_errors,
+			    ss.flush_errors, ss.strat_errors, ss.resid_nonzero, ss.verify_ok, ss.verify_bad,
+			    ss.verify_io_errors, ss.last_cdb, ss.last_ocs, ss.last_status, ss.last_sense,
+			    ss.last_is);
+			bad_mark = bad;
+			runs = 0;
+		}
+	}
+}
+
+static void
+sweet_ufs_syncer_start(void)
+{
+	thread_t thread;
+
+	if (!su.writable || su.syncsecs == 0) {
+		return;
+	}
+	if (kernel_thread_start(sweet_ufs_syncer_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/*
+ * Last flush before the SoC reset (sweet_reboot_restart, also on a panic restart): nothing the
+ * file system or the device queue completed may still sit in the UFS write cache. Safe in
+ * non-preemptible context: the mutex is only tried (a panic inside a UFS command owns it; then the
+ * flush is skipped, as nothing consistent can be said about the device anyway).
+ */
+int sweet_ufs_flush_final(void);
+
+int
+sweet_ufs_flush_final(void)
+{
+	if (!su.ready || !su.writable) {
+		return ENXIO;
+	}
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) {
+		ss.final_flush_skipped++;
+		return EBUSY;
+	}
+	int error = ufs_sync_cache();
+	ss.final_flushes++;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
+/* kern.sweet_ufs.flush: write 1 for a VFS sync of every mount + SYNCHRONIZE CACHE, now. */
+static int
+sweet_ufs_flush_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = 0, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || !req->newptr || !v) {
+		return error;
+	}
+	if (!su.ready || !su.writable) {
+		return ENXIO;
+	}
+	ss.user_flushes++;
+	return sweet_ufs_sync_all();
+}
