+		ss.verify_io_errors++;
+		return EIO;
+	}
+	if (ufs_read_at(lba, count, DMA_VERIFY, su.verify >= 2)) {
+		ss.verify_io_errors++;
+		return EIO;
+	}
+	if (memcmp(want, got, bytes) == 0) {
+		ss.verify_ok++;
+		return 0;
+	}
+	uint32_t i = 0;
+	while (want[i] == got[i]) {
+		i++;
+	}
+	uint32_t blk = i / UFS_BLOCK, zero = 1, diff = 0;
+	for (uint32_t k = blk * UFS_BLOCK; k < (blk + 1) * UFS_BLOCK; k++) {
+		zero &= (got[k] == 0);
+		diff += (got[k] != want[k]);
+	}
+	if (ss.verify_bad++ < 16) {
+		printf("SWEET UFS VERIFY: MISMATCH lba 0x%llx +%u blocks (of %u): first diff at byte %u "
+		    "(block %u, %u bytes differ, readback %s), want 0x%02x got 0x%02x\n",
+		    lba, blk, count, i, blk, diff, zero ? "ALL ZERO" : "not zero", want[i], got[i]);
+	}
+	return EIO;
