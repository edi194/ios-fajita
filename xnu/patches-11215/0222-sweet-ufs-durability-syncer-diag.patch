+ufs_verify_write(uint64_t lba, uint32_t count)
+{
+	const uint8_t *want = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	const uint8_t *got = (const uint8_t *)(su.dma + DMA_VERIFY);
+	uint32_t bytes = count * UFS_BLOCK;
