--- a/bsd/dev/sweet_a630.c
+++ b/bsd/dev/sweet_a630.c
@@ -3904,6 +3904,24 @@
 			sweet_log_sync();
 			printf("SWEET GPU: stage %d finished: GPU kept up, publishing SweetAdreno630\n", mode);
 			SweetAdrenoPublish();
+			/*
+			 * fajita: the userspace shim looks this service up by name (IOServiceMatching
+			 * "SweetAdreno630", then IOServiceOpen) and never even reaches a selector, so check the registry
+			 * entry from inside the kernel. If the lookup here fails, nothing outside this file can open the
+			 * device and the problem is the publication, not the shim.
+			 */
+			{
+				extern io_service_t IOServiceGetMatchingService(mach_port_t, OSDictionary *);
+				extern kern_return_t IOObjectRelease(io_object_t);
+				io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault,
+				    IOServiceMatching("SweetAdreno630"));
+
+				printf("SWEET GPU: registry check: IOServiceMatching(\"SweetAdreno630\") -> %#x (%s)\n",
+				    svc, svc ? "a client can open it" : "NOT MATCHABLE");
+				if (svc) {
+					(void)IOObjectRelease(svc);
+				}
+			}
 			return;
 		}
