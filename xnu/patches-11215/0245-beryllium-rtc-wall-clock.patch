+
+/*
+ * Poco F1 wall clock (patch 0245). The PM8998 RTC (SID 0, RTC_RW 0x60) counts seconds through reboots, but the
+ * application processor cannot set it (TZ-owned; Android keeps an offset in /data). iOS started every boot in 1970
+ * and jumped to 2026 when timed got network time; daemons with time-windowed history (coreduetd's Biome ingestion)
+ * then spun for the rest of the boot. Here the offset to Unix time lives in the RTC alarm's data registers
+ * (RTC_ALARM 0x61, DATA0-3 at 0x6140), used only while that alarm is disabled (ALARM_CTRL 0x6146 bit 7 clear), so
+ * it cannot wake the phone. Registers as Linux rtc-pm8xxx (pm8941 layout): ctrl 0x6046, read 0x6048-0x604b.
+ */
+#define SR_RTC_CTRL      0x6046u
+#define SR_RTC_READ      0x6048u
+#define SR_ALARM_DATA    0x6140u
+#define SR_ALARM_CTRL    0x6146u
+#define SR_EN            0x80u
+#define SR_T_MIN         1735689600ull   /* 2025-01-01: older is not a real wall clock */
+#define SR_T_MAX         4102444800ull   /* 2100-01-01 */
+
+static int
+sr_read32(unsigned addr, uint32_t *v)
+{
+	uint8_t b[4];
+	for (unsigned i = 0; i < 4; i++) {
+		if (sweet_spmi_read(0, addr + i, &b[i]) != 0) {
+			return -1;
+		}
+	}
+	*v = (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+	return 0;
+}
+
+/* Raw RTC seconds, read twice over a byte-0 rollover. */
+static int
+sr_raw(uint32_t *raw)
+{
+	uint8_t ctrl = 0, b0 = 0;
+	if (!sweet_board_beryllium() || sweet_spmi_init() != 0 || sweet_spmi_read(0, SR_RTC_CTRL, &ctrl) != 0 ||
+	    !(ctrl & SR_EN)) {
+		return -1;
+	}
+	for (int t = 0; t < 2; t++) {
+		if (sr_read32(SR_RTC_READ, raw) != 0 || sweet_spmi_read(0, SR_RTC_READ, &b0) != 0) {
+			return -1;
+		}
+		if (b0 == (uint8_t)*raw) {
+			return 0;
+		}
+	}
+	return -1;
+}
+
+/* The stored offset, or -1 when the alarm is armed (not ours) or unreadable. */
+static int
+sr_offset(uint32_t *off)
+{
+	uint8_t actl = SR_EN;
+	if (sweet_spmi_read(0, SR_ALARM_CTRL, &actl) != 0 || (actl & SR_EN)) {
+		return -1;
+	}
+	return sr_read32(SR_ALARM_DATA, off);
+}
+
+/* Thread context. Unix seconds from the RTC (raw + stored offset, or raw when that is already wall time); 0 none. */
+uint64_t
+sweet_rtc_get(void)
+{
+	static bool told;
+	uint32_t raw, off = 0;
+	if (sr_raw(&raw) != 0) {
+		return 0;
+	}
+	bool have = sr_offset(&off) == 0;
+	uint64_t t = (uint64_t)raw + off;
+	if (!have || t < SR_T_MIN || t >= SR_T_MAX) {
+		t = (raw >= SR_T_MIN && raw < SR_T_MAX) ? raw : 0;
+	}
+	if (!told) {
+		told = true;
+		printf("SWEET RTC: raw %u offset %u%s -> %llu\n", raw, off, have ? "" : " (alarm armed or unreadable)", t);
+	}
+	return t;
+}
+
+/* Thread context: keep the offset so the next boot starts at this time. Writes only when it moved by over 2 s. */
+void
+sweet_rtc_set(uint64_t unix_secs)
+{
+	uint32_t raw, off;
+	if (unix_secs < SR_T_MIN || unix_secs >= SR_T_MAX || sr_raw(&raw) != 0 || unix_secs < raw ||
+	    sr_offset(&off) != 0) {
+		return;
+	}
+	uint32_t want = (uint32_t)(unix_secs - raw);
+	if ((off > want ? off - want : want - off) <= 2) {
+		return;
+	}
+	uint8_t d[4] = { (uint8_t)want, (uint8_t)(want >> 8), (uint8_t)(want >> 16), (uint8_t)(want >> 24) };
+	uint32_t back = 0;
+	bool ok = sweet_spmi_write(0, SR_ALARM_DATA, &d[0], 2) == 0 && sweet_spmi_write(0, SR_ALARM_DATA + 2, &d[2], 2) == 0 &&
+	    sr_read32(SR_ALARM_DATA, &back) == 0 && back == want;
+	printf("SWEET RTC: offset %u -> %u (raw %u, time %llu)%s\n", off, want, raw, unix_secs, ok ? "" : " FAILED");
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
