+/* 0245: wall clock from the PM8998 RTC and the offset kept beside it (bsd/dev/sweet_spmi.c), so a boot is not in 1970. */
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	return sweet_board_beryllium() ? (long)sweet_rtc_get() : 0;
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	if (sweet_board_beryllium() && secs > 0) {
+		sweet_rtc_set((uint64_t)secs);
+	}
