+/*
+ * Hardware scan-out (MDP page flipping + the QSEED3 scaler) is an SDM845 feature, not a Poco one: the
+ * OnePlus 6T has the same MDSS block at 0x0ae00000 and the same VIG0/QSEED3 scaler, so the canvas
+ * (1125x2436, patch 0100) can be scaled into the 1080x2340 panel in hardware instead of by the CPU.
+ * sweet_board_beryllium() only matches the Poco's compatible string; sweetts=1 selects the fajita board,
+ * the same switch patches 0252 (touch) and 0255 (RPMh bases) use.
+ */
+static bool
+sweet_fb_sdm845_scanout(void)
+{
+	int fajita = 0;
+
+	if (sweet_board_beryllium()) {
+		return true;
+	}
+	return PE_parse_boot_argn("sweetts", &fajita, sizeof(fajita)) && fajita != 0;
+}
