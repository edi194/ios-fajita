+/*
+ * 0241: scan the GPU scan-out copy in flight once its fence has passed (work loop: swapFired). After 100 ms it is
+ * scanned anyway (a lost GPU must not freeze the panel) and counted as a fallback.
+ */
+void
+AppleCLCD::scanBlitPoll(void)
+{
+	if (fScanBlitT < 0) {
+		return;
+	}
+	if (!sweet_gpu_fence_passed(fScanBlitFence)) {
+		uint64_t lim;
+		nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &lim);
+		if (mach_absolute_time() - fScanBlitAbs < lim) {
+			fSwapTimer->setTimeoutUS(250);
+			return;
+		}
+		fSt.scanGpuFallbacks++;
+	}
+	int t = fScanBlitT;
+	fScanBlitT = -1;
+	if (fScanQueued >= 0 && latchedNow()) {
+		fScanPanel = fScanQueued;
+		fScanQueued = -1;
+	}
+	scanAddr((uint32_t)fScanPA[t], fScanStride, true);
+	fScanForeign = false;
+	fScanQueued = t;
+	fScanFront = true;
+	__atomic_store_n(&fShotId, fScanBlitId, __ATOMIC_RELEASE);
+}
