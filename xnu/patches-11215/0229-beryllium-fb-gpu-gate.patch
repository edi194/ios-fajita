+/*
+ * 0229: the framebuffer's scan-out gate. A compositor that commits its GPU work and swaps at once (QuartzCore's render
+ * server on Chlorophyll with asynchronous command buffers) hands over a framebuffer the GPU may still be writing; Apple's
+ * display waits on the GPU's write fence, and this pair is ours: the newest submitted fence when a swap arrives, and whether
+ * a fence has passed. With the GPU not running every fence counts as passed.
+ */
+uint32_t sweet_gpu_fence_snapshot(void);
+bool sweet_gpu_fence_passed(uint32_t fence);
+bool sweet_gpu_fence_done(uint32_t fence);
+
+uint32_t
+sweet_gpu_fence_snapshot(void)
+{
+	return a630_dev.ready && cp_memory ? a630_dev.seqno : 0;
+}
+
+bool
+sweet_gpu_fence_passed(uint32_t fence)
+{
+	if (fence == 0 || !a630_dev.ready || !cp_memory) {
+		return true;
+	}
+	return sweet_gpu_fence_done(fence);
+}
