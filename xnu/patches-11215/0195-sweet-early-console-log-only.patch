+void
+sweet_early_set_cmdline(const char *cmdline)
+{
+	static const char key[] = "sweetearlyfb=1";
+
+	for (unsigned int i = 0; cmdline[i] != '\0' && i < 256; i++) {
+		unsigned int k = 0;
+		while (key[k] != '\0' && cmdline[i + k] == key[k]) {
+			k++;
+		}
+		if (key[k] == '\0' && (i == 0 || cmdline[i - 1] == ' ')) {
+			early_screen = 1;
+			return;
+		}
+	}
+}
+
+/* kprintf (serial and the persistent log) is up: pass the recorded lines on, once. */
+void
+sweet_early_flush_log(void)
+{
+	if (early_flushed) {
+		return;
+	}
+	early_flushed = 1;
+	if (early_ring_len < EARLY_RING) {
+		early_ring[early_ring_len] = '\0';
+	} else {
+		early_ring[EARLY_RING - 1] = '\0';
+	}
+	kprintf("%s", early_ring);
+}
