diff --git a/iokit/Kernel/arm/SweetNetwork.cpp b/iokit/Kernel/arm/SweetNetwork.cpp
index 3c97872a5ae4caa0e27e671bce60d9897bba8c80..5ea056b229a88b3895f29e9b9ea218f99bec8fb5 100644
