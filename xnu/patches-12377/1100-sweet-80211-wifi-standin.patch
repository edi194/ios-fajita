 };
 OSDefineMetaClassAndStructors(IONetworkStack, SweetNetService);
 
+/*
+ * Wi-Fi (bsd/dev/sweet_80211.c, boot-arg sweet80211): iOS 26 wifid matches
+ * no class names, only properties (docs/WIFI_IOS26.md 1.2); the names below
+ * are for configd and CoreWiFi, which look for IO80211Controller. Neither
+ * has a user client, so the IO80211 framework takes its ioctl path.
+ */
+class IO80211Controller : public SweetNetService {
+	OSDeclareDefaultStructors(IO80211Controller);
+};
