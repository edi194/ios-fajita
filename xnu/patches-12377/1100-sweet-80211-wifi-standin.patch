+/*
+ * Publish bus -> IO80211Controller ("AppleWLANDriver") -> IO80211Interface
+ * for the Wi-Fi stand-in's ifnet. Properties are set before registerService
+ * so wifid's matching notifications see them:
+ *   {IOPropertyExistsMatch: WiFiHardwareHealthy}           (controller)
+ *   {IOPropertyMatch: {IO80211InterfaceRole: Infrastructure}} (interface)
+ *   IOServiceNameMatching("AppleWLANDriver")                (controller)
+ * The interface has no NetworkConfigurationOverrides: configd runs DHCP.
+ * Returns 1 when the interface object was published, else 0.
+ */
+extern "C" int
+sweet_net_publish_wlan(const char *bsd_name, const char *prefix, unsigned unit, const uint8_t *mac)
+{
+	IOService *platform = IOService::getPlatform();
+
+	if (platform == NULL) {
+		IOLog("SWEET 80211: no platform expert; IOKit interface not published\n");
+		return 0;
+	}
+	SweetNetworkBus *bus = OSTypeAlloc(SweetNetworkBus);
+	if (bus == NULL || !bus->init()) {
+		OSSafeReleaseNULL(bus);
+		return 0;
+	}
+	bus->setName("sweet-wlan");
+	bus->retain();
+	if (!sweet_net_attach(bus, platform)) {
+		bus->release();
+		return 0;
+	}
+
+	IO80211Controller *ctrl = OSTypeAlloc(IO80211Controller);
+	if (ctrl == NULL || !ctrl->init()) {
+		OSSafeReleaseNULL(ctrl);
+		bus->release();
+		return 0;
+	}
+	ctrl->setName("AppleWLANDriver");
+	ctrl->setProperty("IOMACAddress", (void *)mac, 6);
+	ctrl->setProperty("SelfNamed", kOSBooleanTrue);
+	ctrl->setProperty("WiFiHardwareHealthy", kOSBooleanTrue);
+	ctrl->setProperty("IOModel", "WCN3990");
+	ctrl->setProperty("IOVendor", "Qualcomm");
+	ctrl->retain();
+	bool ctrl_ok = sweet_net_attach(ctrl, bus);
+	bus->release();
+	if (!ctrl_ok) {
+		ctrl->release();
+		return 0;
+	}
+
+	IO80211Interface *intf = OSTypeAlloc(IO80211Interface);
+	if (intf == NULL || !intf->init()) {
+		OSSafeReleaseNULL(intf);
+		ctrl->release();
+		return 0;
+	}
+	intf->setProperty("IOInterfaceType", 6ULL, 32);         /* IFT_ETHER */
+	intf->setProperty("IOBuiltin", kOSBooleanTrue);
+	intf->setProperty("IOPrimaryInterface", kOSBooleanTrue);
+	intf->setProperty("BSD Name", bsd_name);
+	intf->setProperty("IOInterfaceName", bsd_name);
+	intf->setProperty("IOInterfaceNamePrefix", prefix);
+	intf->setProperty("IOInterfaceUnit", (unsigned long long)unit, 32);
+	intf->setProperty("IO80211InterfaceRole", "Infrastructure");
+	bool intf_ok = sweet_net_attach(intf, ctrl);
+	ctrl->release();
+
+	IOLog("SWEET 80211: IOKit interface %s %s (AppleWLANDriver, Infrastructure role)\n",
+	    bsd_name, intf_ok ? "published" : "NOT published");
+	return intf_ok ? 1 : 0;
+}
