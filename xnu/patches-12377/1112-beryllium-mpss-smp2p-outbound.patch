+/* the data of an SMEM item in the private partition of hosts a<->b, 0 if absent */
+static uint32_t
+ms_smem_item(uint32_t a, uint32_t b, uint32_t item, uint32_t *size)
+{
+	uint32_t offset, psize;
+	if (!ms_smem_part(a, b, &offset, &psize)) {
