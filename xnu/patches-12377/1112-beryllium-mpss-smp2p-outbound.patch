+/* SMEM hwspinlock: TCSR mutex 3 (qcom_hwspinlock.c, stride 0x1000, owner id 1 = apps), 1 s like Linux */
+static bool
+ms_smem_lock(void)
+{
+	const uint32_t r = WL_SMEM_HWLOCK * 0x1000;
+	for (unsigned i = 0; i < 1000; i++) {
+		wl_wr(wl.mutex, r, 1);
+		if (wl_rd(wl.mutex, r) == 1) {
+			return true;
+		}
+		delay(1000);
+	}
+	printf("SWEET MSS: SMEM hwlock %u busy (owner %#x)\n", WL_SMEM_HWLOCK, wl_rd(wl.mutex, r));
+	return false;
+}
+
 static void
+ms_smem_unlock(void)
+{
+	const uint32_t r = WL_SMEM_HWLOCK * 0x1000;
+	if (wl_rd(wl.mutex, r) == 1) {
+		wl_wr(wl.mutex, r, 0);
+	} else {
+		printf("SWEET MSS: SMEM hwlock not owned by us (owner %#x)\n", wl_rd(wl.mutex, r));
+	}
+}
+
+/*
+ * qcom_smem_alloc() for the apps<->modem partition (qcom_smem_alloc_private): under the hwlock, walk the
+ * uncached list; an existing item is reused (-EEXIST), else a new entry {canary 0xa5a5, item, size
+ * aligned to 8, padding_data, padding_hdr 0} goes at offset_free_uncached, which then advances.
+ * Returns the data offset in SMEM, 0 on failure. This is the first write into shared SMEM.
+ */
+static uint32_t
+ms_smem_alloc(uint32_t item, uint32_t size)
+{
+	uint32_t off, psize, data = 0, free_u = 0, free_c = 0, pos = 0, have = 0;
+	enum { A_BAD, A_EXISTS, A_SMALL, A_NEW, A_FULL } res = A_BAD;
+	if (!ms_smem_part(0, 1, &off, &psize)) {
+		printf("SWEET MSS: no apps<->modem SMEM partition\n");
+		return 0;
+	}
+	if (!ms_smem_lock()) {
+		return 0;
+	}
+	/* nothing in here prints: the modem spins on the same hwlock while we hold it */
+	free_u = smem_u32(off + 12);
+	free_c = smem_u32(off + 16);
+	pos = off + 32;
+	if (free_u > psize || free_c > psize || free_u > free_c || free_u < 32) {
+		goto out;
+	}
+	while (pos < off + free_u) {
+		uint32_t w0 = smem_u32(pos), sz = smem_u32(pos + 4), w2 = smem_u32(pos + 8);
+		if ((w0 & 0xffff) != 0xa5a5 || sz > psize) {
+			goto out;
+		}
+		if ((w0 >> 16) == item) {
+			have = sz - (w2 & 0xffff);
+			if (have >= size) {
+				data = pos + 16 + (w2 >> 16);
+				res = A_EXISTS;
+			} else {
+				res = A_SMALL;
+			}
+			goto out;
+		}
+		pos += 16 + (w2 >> 16) + sz;
+	}
+	if (pos != off + free_u) {
+		goto out;               /* the list does not end at offset_free_uncached */
+	}
+	uint32_t asize = (size + 7u) & ~7u;
+	if (pos + 16 + asize > off + free_c) {
+		res = A_FULL;
+		goto out;
+	}
+	wl_wr(wl.smem, pos, 0xa5a5u | (item << 16));
+	wl_wr(wl.smem, pos + 4, asize);
+	wl_wr(wl.smem, pos + 8, asize - size);  /* padding_data, padding_hdr 0 */
+	wl_wr(wl.smem, pos + 12, 0);
+	wl_wr(wl.smem, off + 12, free_u + 16 + asize);  /* after the header (wl_wr: dmb before, dsb after) */
+	data = pos + 16;
+	res = A_NEW;
+out:
+	ms_smem_unlock();
+	switch (res) {
+	case A_NEW:
+		printf("SWEET MSS: SMEM item %u allocated at +%#x (%u bytes), free-uncached %#x -> %#x\n", item, data,
+		    size, free_u, free_u + 16 + ((size + 7u) & ~7u));
+		break;
+	case A_EXISTS:
+		printf("SWEET MSS: SMEM item %u exists at +%#x (%u bytes, reused)\n", item, data, have);
+		break;
+	case A_SMALL:
+		printf("SWEET MSS: SMEM item %u exists but has only %u bytes\n", item, have);
+		break;
+	case A_FULL:
+		printf("SWEET MSS: SMEM partition out of memory\n");
+		break;
+	case A_BAD:
+		printf("SWEET MSS: apps<->modem partition not sane (free %#x/%#x size %#x, walk ended at +%#x)\n",
+		    free_u, free_c, psize, pos - off);
+		break;
+	}
+	return data;
+}
