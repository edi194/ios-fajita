+/* qcom_smp2p_kick(): apcs ipc doorbell, sdm845 apss_shared +12, channel 14 for the modem */
+static void
+ms_smp2p_kick(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wl_wr(ms.ipc, 12, 1u << MPSS_SMP2P_DOORBELL);
+}
+
+static void
+ms_smp2p_add_entry(uint32_t d, const char *name)
+{
+	uint32_t valid = smem_u32(d + 12) >> 16;
+	char buf[16];
+	memset(buf, 0, sizeof(buf));
+	strlcpy(buf, name, sizeof(buf));
+	for (uint32_t c = 0; c < 16; c += 4) {
+		uint32_t w;
+		memcpy(&w, buf + c, 4);
+		wl_wr(wl.smem, d + 20 + valid * 20 + c, w);
+	}
+	wl_wr(wl.smem, d + 20 + valid * 20 + 16, 0);
+	wl_wr(wl.smem, d + 12, SMP2P_MAX_ENTRY | ((valid + 1) << 16));
+}
+
+/*
+ * qcom_smp2p_alloc_outbound_item() + the outbound entries of the sdm845 smp2p-mpss node in DT order
+ * ("master-kernel": bit 0 = stop; "ipa"), with Linux's two kicks.
+ */
+static bool
+ms_smp2p_out_setup(void)
+{
+	if (!wl.mutex) {
+		wl.mutex = ml_io_map(WL_MUTEX_PA, 0x4000);
+	}
+	uint32_t d = ms_smem_alloc(MPSS_SMP2P_OUT_ITEM, SMP2P_ITEM_SIZE);
+	if (!d) {
+		return false;
+	}
+	for (uint32_t k = 0; k < SMP2P_ITEM_SIZE; k += 4) {
+		wl_wr(wl.smem, d + k, 0);
+	}
+	wl_wr(wl.smem, d + 0, SMP2P_MAGIC);
+	wl_wr(wl.smem, d + 4, SMP2P_FEATURE_SSR_ACK << 8);     /* version 0 until the header is complete */
+	wl_wr(wl.smem, d + 8, 0u | (1u << 16));                 /* local pid 0, remote pid 1 */
+	wl_wr(wl.smem, d + 12, SMP2P_MAX_ENTRY);                /* total 16, valid 0 */
+	wl_wr(wl.smem, d + 4, (SMP2P_FEATURE_SSR_ACK << 8) | 1u);
+	ms_smp2p_kick();
+	ms_smp2p_add_entry(d, "master-kernel");
+	ms_smp2p_add_entry(d, "ipa");
+	ms_smp2p_kick();
+	ms.smp2p_out = d;
+	printf("SWEET MSS: smp2p item %u ready at +%#x: version 1, pid 0->1, entries master-kernel + ipa, doorbell bit %u\n",
+	    MPSS_SMP2P_OUT_ITEM, d, MPSS_SMP2P_DOORBELL);
+	return true;
+}
