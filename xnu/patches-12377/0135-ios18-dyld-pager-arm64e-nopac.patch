--- a/osfmk/vm/vm_dyld_pager.c
+++ b/osfmk/vm/vm_dyld_pager.c
@@ -60,8 +60,8 @@
 
 #include <sys/kdebug_triage.h>
 #include <mach-o/fixup-chains.h>
+#include <ptrauth.h> /* ptrauth_key is needed by the fixup code even without PAC (sweet) */
 #if defined(HAS_APPLE_PAC)
-#include <ptrauth.h>
 #include <arm/misc_protos.h>
 #endif /* defined(HAS_APPLE_PAC) */
 
@@ -603,6 +603,30 @@ signPointer(
 	return KERN_SUCCESS;
 }
 
+#else /* !defined(HAS_APPLE_PAC) */
+/*
+ * No pointer authentication in this kernel (SWEET, SDM845): arm64e images
+ * (rewritten offline by tools/ios18/pacstrip.py so that their code contains no
+ * PAC instruction) still carry DYLD_CHAINED_PTR_ARM64E fixups. Their pointers
+ * stay unsigned: the AUTx and PACx instructions are NOPs in the rewritten code.
+ * Without this the pager failed every such page ("unknown pointer_format",
+ * KERN_MEMORY_ERROR on the first touch of __AUTH_CONST/__AUTH).
+ */
+static kern_return_t
+signPointer(
+	uint64_t         unsignedAddr,
+	__unused void    *loc,
+	__unused bool    addrDiv,
+	__unused uint16_t diversity,
+	__unused ptrauth_key key,
+	__unused dyld_pager_t pager,
+	uint64_t         *signedAddr)
+{
+	*signedAddr = unsignedAddr;
+	return KERN_SUCCESS;
+}
+#endif /* defined(HAS_APPLE_PAC) */
+
 /*
  * Apply fixups to a page used by a 64 bit process using pointer authentication.
  */
@@ -813,7 +837,6 @@ fixupCachePageAuth64(
 	} while (valid_chain);
 	return KERN_SUCCESS;
 }
-#endif /* defined(HAS_APPLE_PAC) */
 
 
