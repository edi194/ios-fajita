+/* the WLAN service thread: one received Ethernet II frame */
+void
+sweet80211_input(const uint8_t *eth, size_t len)
+{
+	mbuf_t m = NULL;
+	unsigned int one = 1;
+	if (s8.ifp == NULL || len < ETHER_HDR_LEN || mbuf_allocpacket(MBUF_DONTWAIT, len, &one, &m) != 0) {
+		s8.rx_drops++;
+		return;
+	}
+	if (mbuf_copyback(m, 0, len, eth, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(m);
+		s8.rx_drops++;
+		return;
+	}
+	mbuf_pkthdr_setrcvif(m, s8.ifp);
+	mbuf_pkthdr_setlen(m, len);
+	bpf_tap_in(s8.ifp, DLT_EN10MB, m, NULL, 0);
+	mbuf_pkthdr_setheader(m, mbuf_data(m));
+	mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+	mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+	struct ifnet_stat_increment_param st = { .packets_in = 1, .bytes_in = (u_int32_t)len };
+	s8.rx_frames++;
+	(void)ifnet_input(s8.ifp, m, &st);
+}
