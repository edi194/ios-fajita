+/*
+ * WL3/WL4: join, link, data (docs/WIFI_IOS26_PHASE2.md). wifid's ASSOCIATE carries the SSID, the PMK (IO80211 derives
+ * it from the passphrase) and the RSN element for the association request; the BSSID is usually zero and the
+ * service picks the strongest BSS with that SSID from the last scan. The 4-way handshake runs in the service.
+ */
+struct sweet_wlan_join {
+	uint8_t  ssid[32];
+	uint8_t  ssid_len;
+	uint8_t  bssid[6];              /* all zero: any BSS of this SSID */
+	uint8_t  rsn_ie_len;            /* 0: open network */
+	uint8_t  rsn_ie[64];
+	uint8_t  pmk[32];
+};
+
+/* the current association, for wifid's GETs while associated */
+struct sweet_wlan_link {
+	uint8_t  bssid[6];
+	uint8_t  ssid_len;
+	uint8_t  ssid[32];
+	uint16_t mhz;
+	int8_t   rssi;
+	int8_t   noise;
+	uint16_t aid;
+	uint16_t rate;                  /* Mb/s */
+	uint8_t  ht;
+	uint8_t  rsn;
+};
+
+/* Apple80211 ASSOCIATE_RESULT codes (IO80211 _errorForAssociateResult) */
+#define SWEET_WLAN_JOIN_RUNNING         0
+#define SWEET_WLAN_JOIN_OK              1
+#define SWEET_WLAN_JOIN_FAILED          2       /* unspecified */
+#define SWEET_WLAN_JOIN_UNSUPPORTED     3       /* unsupported capabilities */
+#define SWEET_WLAN_JOIN_TIMEOUT         9
+#define SWEET_WLAN_JOIN_SUPP_TIMEOUT    22      /* supplicant timeout */
+#define SWEET_WLAN_JOIN_NO_BSS          25      /* BSS not found */
+#define SWEET_WLAN_JOIN_AUTH_NO_ACK     26
+#define SWEET_WLAN_JOIN_AUTH_NO_RESP    27
+#define SWEET_WLAN_JOIN_ASSOC_NO_ACK    28
+#define SWEET_WLAN_JOIN_ASSOC_NO_RESP   29
+#define SWEET_WLAN_JOIN_EAPOL           30      /* EAPOL M1-M4 failure */
+
+/* beryllium_wlan.c: 0 = join started, ENXIO = service not up, EINVAL = bad request */
+int sweet_wlan_join(const struct sweet_wlan_join *j);
+/* beryllium_wlan.c: SWEET_WLAN_JOIN_* of the last join (RUNNING while it runs) */
+int sweet_wlan_join_result(void);
+/* beryllium_wlan.c: leave the network (or cancel a join); 0 */
+int sweet_wlan_leave(void);
+/* beryllium_wlan.c: 0 and the link while associated, ENXIO otherwise */
+int sweet_wlan_link_get(struct sweet_wlan_link *out);
