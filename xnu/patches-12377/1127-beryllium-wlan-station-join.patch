+/* ---- WMI command queue ---- */
+static bool
+sta_wmi(const uint8_t *c, uint32_t n, const char *what)
+{
+	if (n > STA_WMI_MAX || sta.wq_n >= STA_WMIQ) {
+		printf("SWEET WLAN sta: WMI queue full, %s dropped\n", what);
+		return false;
+	}
+	unsigned k = (sta.wq_head + sta.wq_n) % STA_WMIQ;
+	memcpy(sta.wq[k], c, n);
+	sta.wq_len[k] = (uint16_t)n;
+	sta.wq_n++;
+	return true;
+}
+
+static void
+sta_wmi_pump(void)
+{
+	while (sta.wq_n && wce.wmi_credits) {
+		if (!wce_send(1, wce.wmi_eid, sta.wq[sta.wq_head], sta.wq_len[sta.wq_head])) {
+			return;
+		}
+		sta.wq_head = (sta.wq_head + 1) % STA_WMIQ;
+		sta.wq_n--;
+	}
+}
