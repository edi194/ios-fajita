+/* KEV_DL_LINK_ON / OFF as bsd/net/if_fake.c interface_link_event does: configd starts / stops DHCP on these */
 static void
+s8_link_event(u_int32_t code)
+{
+	struct ev {
+		u_int32_t family, unit;
+		char      name[IFNAMSIZ];
+	};
+	_Alignas(struct kern_event_msg) char msg[offsetof(struct kern_event_msg, event_data) + sizeof(struct ev)] = { 0 };
+	struct kern_event_msg *h = (struct kern_event_msg *)msg;
+	struct ev *e = (struct ev *)(void *)(msg + offsetof(struct kern_event_msg, event_data));   /* as if_fake.c */
+	h->total_size = sizeof(msg);
+	h->vendor_code = KEV_VENDOR_APPLE;
+	h->kev_class = KEV_NETWORK_CLASS;
+	h->kev_subclass = KEV_DL_SUBCLASS;
+	h->event_code = code;
+	e->family = ifnet_family(s8.ifp);
+	e->unit = (u_int32_t)ifnet_unit(s8.ifp);
+	strlcpy(e->name, ifnet_name(s8.ifp), IFNAMSIZ);
+	ifnet_event(s8.ifp, h);
+}
