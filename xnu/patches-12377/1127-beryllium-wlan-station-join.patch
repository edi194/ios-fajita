 /*
+ * ---- WL3/WL4: the station (sweet80211=3 joins). What ath10k + mac80211 + wpa_supplicant do for a client, in the
+ * service thread (docs/WIFI_IOS26.md 6.3, the order of ath10k mac.c): STOP_SCAN if one runs, VDEV_START on the AP's
+ * channel (VDEV_START_RESP), STA_POWERSAVE_MODE off, beacon interval and management rate, PEER_CREATE (HTT PEER_MAP),
+ * open-system authentication and the association request through WMI MGMT_TX_SEND by reference (HTT TX_FRM type
+ * MGMT when the firmware lacks service 76), PEER_ASSOC (+ SMPS), VDEV_UP; then for WPA2-PSK the 4-way handshake
+ * (sweet_wpa.c) over the data path and VDEV_INSTALL_KEY pairwise (HTT SEC_IND), PEER_SET_PARAM authorize, group.
+ * Data: HTT TX_FRM native wifi (ext descriptor in the frag bank, two CE4 gather descriptors), TX_COMPL_IND frees the
+ * msdu id; RX_IN_ORD_PADDR_IND hands back RX ring buffers (payload at +360), which are posted again at once.
+ */
+#define STA_MGMT_OFF            0x430000u       /* 8 management frame buffers of 1 KiB */
+#define STA_MGMT_N              8u
+#define STA_TXBUF_OFF           0x438000u       /* per msdu id: HTC header + HTT TX_FRM descriptor (64 bytes) */
+#define STA_TXFR_OFF            0x440000u       /* per msdu id: the native-wifi frame (2 KiB) */
+#define STA_NTX                 256u            /* msdu ids in use (of HTT_FRAG_DESCS) */
+#define STA_TXQ                 64u             /* Ethernet frames queued by en0 for the service thread */
+#define STA_TXQ_MAX             1600u
+#define STA_WMIQ                16u
+#define STA_WMI_MAX             320u
+#define STA_RXDESC              360u            /* sizeof(struct htt_rx_desc_v2): the payload offset */
+
+enum { ST_IDLE, ST_STOPSCAN, ST_START, ST_PEER, ST_AUTH, ST_ASSOC, ST_UP, ST_4WAY, ST_KEYS, ST_CONNECTED, ST_DOWN };
+static const char *const st_name[] = { "idle", "stop-scan", "vdev-start", "peer", "auth", "assoc", "up", "4-way",
+	                               "keys", "CONNECTED", "teardown" };
+
+static struct {
+	int state;
+	struct sweet_wlan_join req;     /* the join being done (service thread only) */
+	struct sweet_wlan_join pend;    /* the next join, written by the ioctl under sta_lock */
+	volatile bool req_pending, leave_pending;
+	volatile int result;            /* SWEET_WLAN_JOIN_* */
+	uint64_t t_ms, join_ms;         /* state entered, join started */
+	unsigned tries;
+	/* the BSS */
+	int bss;                        /* scan cache index */
+	uint8_t bssid[6];
+	uint16_t mhz, beacon_int, ap_cap, aid;
+	uint8_t dtim, mgmt_rate;
+	bool rsn, ht, wmm, svc_mgmt_wmi;
+	uint32_t group_cipher;
+	struct swf_assoc_resp ar;
+	/* firmware state */
+	bool vdev_started, vdev_up, peer, peer_mapped, start_resp, stopped, sec_ind, ptk_installed, connected, by_ap;
+	unsigned down_step;
+	bool had_peer;
+	uint8_t eapol_hold[256];        /* message 1 that arrived before PEER_ASSOC / VDEV_UP were through */
+	uint16_t eapol_hold_len;
+	uint16_t peer_id, seq;
+	uint32_t start_status;
+	unsigned keys_step;
+	bool key_pending[2];            /* pairwise, group */
+	uint8_t ptk[16], gtk[16];
+	unsigned gtk_idx;
+	int eapol_msdu;                 /* msdu id of the last EAPOL frame sent, -1 = none in flight */
+	uint64_t keys_ms;
+	struct sweet_wpa wpa;
+	/* management TX: one frame in flight, 8 buffers / desc ids in turn */
+	bool mgmt_busy;
+	unsigned mgmt_slot;
+	int mgmt_status;                /* completion status, -1 = not yet */
+	/* data path */
+	uint8_t txfree[STA_NTX];        /* 1 = msdu id free */
+	unsigned tx_inflight, rx_idx;
+	uint64_t tx_frames, tx_bytes, tx_fail, tx_drop, rx_frames, rx_bytes, rx_drop, rx_eapol, tx_eapol, rx_ind;
+	int8_t rssi;
+	/* the frames en0 hands over */
+	uint8_t *txq;
+	uint16_t txq_len[STA_TXQ];
+	unsigned txq_head, txq_n;
+	/* WMI commands, one in flight */
+	uint8_t wq[STA_WMIQ][STA_WMI_MAX];
+	uint16_t wq_len[STA_WMIQ];
+	unsigned wq_head, wq_n;
+	uint64_t last_status_ms;
+	uint32_t kickouts, bmiss, deauths;
+} sta;
