+		lc[0] = 1;
+		memcpy(lc + 20, &why, 4);
+		s8_post_event(M_LINK_CHANGED, lc, sizeof(lc));
+		s8_post_event(M_BSSID_CHANGED, NULL, 0);
+		s8_post_event(M_SSID_CHANGED, NULL, 0);
+		if (by_ap) {
+			s8_post_event(M_DEAUTH_RECEIVED, dr, sizeof(dr));
+		}
+		s8_link_event(KEV_DL_LINK_OFF);
+		ifnet_set_flags(s8.ifp, 0, IFF_RUNNING);
+		printf("SWEET 80211: link down (reason %u): %llu frames out (%llu dropped), %llu in (%llu dropped)\n", reason,
+		    s8.tx_frames, s8.tx_drops, s8.rx_frames, s8.rx_drops);
+	}
+}
+
+static void
 sweet80211_if_detach(ifnet_t ifp __unused)
 {
 }
