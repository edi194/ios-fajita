+/*
+ * ASSOCIATE (type 20, 908 bytes, IO80211 1565.3 _performAssociation): version @0, mode @4, auth lower @8 / upper
+ * @0xc (8 = WPA2-PSK), ssid len @0x10 + ssid @0x14, bssid @0x34, key {version @0x3c, len @0x40, cipher @0x44
+ * (6 = PMK)} with the PMK @0x4c, RSN element len @0xd0 (u16) + bytes @0xd2, flags2 @0x1fc. Logged without the key.
+ */
+static int
+s8_associate(struct sweet80211_req *req)
+{
+	uint8_t *d;
+	struct sweet_wlan_join j;
+	uint32_t ver, mode, al, au, sl, kl, kc, f2;
+	uint16_t rl;
+	int err;
+
+	if (s8.stage != 3) {
+		return ENXIO;                           /* nothing to join with a null backend */
+	}
+	if (req->data == 0 || req->len < 0x200 || req->len > 4096) {
+		printf("SWEET 80211: ASSOCIATE with %u bytes: refused\n", req->len);
+		return EINVAL;
+	}
+	d = kalloc_data(req->len, Z_WAITOK | Z_ZERO);
+	if (d == NULL) {
+		return ENOMEM;
+	}
+	err = copyin((user_addr_t)req->data, d, req->len);
+	if (err) {
+		kfree_data(d, req->len);
+		return err;
+	}
+	memcpy(&ver, d + 0x00, 4);
+	memcpy(&mode, d + 0x04, 4);
+	memcpy(&al, d + 0x08, 4);
+	memcpy(&au, d + 0x0c, 4);
+	memcpy(&sl, d + 0x10, 4);
+	memcpy(&kl, d + 0x40, 4);
+	memcpy(&kc, d + 0x44, 4);
+	memcpy(&rl, d + 0xd0, 2);
+	memcpy(&f2, d + 0x1fc, 4);
+	bzero(&j, sizeof(j));
+	j.ssid_len = (uint8_t)MIN(sl, 32u);
+	memcpy(j.ssid, d + 0x14, j.ssid_len);
+	memcpy(j.bssid, d + 0x34, 6);
+	char hex[3 * 64 + 1];
+	unsigned hl = 0;
+	for (unsigned i = 0; i < MIN((unsigned)rl, 64u); i++) {
+		hl += (unsigned)snprintf(hex + hl, sizeof(hex) - hl, "%02x", d[0xd2 + i]);
+	}
+	hex[hl] = 0;
+	printf("SWEET 80211: ASSOCIATE len %u: version %u mode %u auth %u/%#x ssid %u bytes, bssid %02x:%02x:%02x:%02x:%02x:%02x, "
+	    "key len %u cipher %u, rsn ie %u bytes %s, flags %02x %02x %02x, flags2 %#x\n", req->len, ver, mode & 0xffff, al, au,
+	    sl, j.bssid[0], j.bssid[1], j.bssid[2], j.bssid[3], j.bssid[4], j.bssid[5], kl, kc, rl, hex, d[0x1d3], d[0x1d4],
+	    d[0x1d5], f2);
+	err = 0;
+	if (ver != 1 || sl == 0 || sl > 32 || (mode & 0xffff) != 2) {
+		err = EINVAL;
+	} else if (au == 0 && rl == 0) {
+		j.rsn_ie_len = 0;                       /* open network */
+	} else if (au == 8 && kc == 6 && kl == 32 && rl >= 8 && rl <= sizeof(j.rsn_ie) && d[0xd2] == 0x30) {
+		memcpy(j.pmk, d + 0x4c, 32);
+		j.rsn_ie_len = (uint8_t)rl;
+		memcpy(j.rsn_ie, d + 0xd2, rl);
+	} else {
+		err = EOPNOTSUPP;                       /* WEP, WPA1, SAE, enterprise, passphrase mode */
+	}
+	bzero(d, req->len);                             /* the PMK */
+	kfree_data(d, req->len);
+	if (err == 0) {
+		s8.auth_upper = au;
+		err = sweet_wlan_join(&j);
+	}
+	bzero(&j, sizeof(j));
+	printf("SWEET 80211: ASSOCIATE -> %d\n", err);
+	return err;
+}
