diff --git a/bsd/dev/sweet_wlan.h b/bsd/dev/sweet_wlan.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_wlan.h
@@ -0,0 +1,33 @@
+/*
+ * SWEET: the interface between the iOS-facing Wi-Fi stand-in (sweet_80211.c) and the WCN3990 WLAN service
+ * (beryllium_wlan.c, sweetwlan=5). docs/WIFI_IOS26_PHASE2.md WL2.
+ */
+#ifndef _SWEET_WLAN_H_
+#define _SWEET_WLAN_H_
+
+#include <stdint.h>
+
+#define SWEET_WLAN_IE_MAX       1024u
+
+/* one network from the last scan, as the firmware reported it (beacon or probe response) */
+struct sweet_wlan_bss {
+	uint8_t  bssid[6];
+	uint16_t mhz;
+	int8_t   rssi;                  /* dBm */
+	int8_t   noise;                 /* dBm */
+	uint16_t beacon_int;            /* TU */
+	uint16_t cap;                   /* 802.11 capability field */
+	uint8_t  ssid_len;
+	uint8_t  ssid[32];              /* raw bytes */
+	uint16_t ie_len;
+	uint8_t  ie[SWEET_WLAN_IE_MAX]; /* the frame's information elements, from the SSID element on */
+};
+
+/* beryllium_wlan.c: 0 = scan queued (or already running), ENXIO = the service is not up (yet) */
+int sweet_wlan_scan_request(void);
+/* beryllium_wlan.c: network i of the last completed scan; ENOENT past the end */
+int sweet_wlan_bss_get(unsigned i, struct sweet_wlan_bss *out);
+/* sweet_80211.c: called by the WLAN service when a requested scan has completed */
+void sweet80211_scan_done(void);
+
+#endif /* _SWEET_WLAN_H_ */
