 /*
+ * ---- WL2: scans on request from sweet_80211 (sweet80211=3) and the BSS cache of the last scan. Only the
+ * service thread touches the chip; a request sets a flag the service picks up when the previous scan is done.
+ */
+int
+sweet_wlan_scan_request(void)
+{
+	int err = ENXIO;
+	lck_mtx_lock(&scan_lock);
+	if (wl.service && ipc.scan && wce.rings && !mw.fatal && (wf.state == WS_SCAN_DONE ||
+	    wf.state == WS_SCAN_SETUP || wf.state == WS_SCANNING)) {
+		scan_notify = true;
+		if (wf.state == WS_SCAN_DONE) {
+			scan_req = true;        /* a new scan; a running one just reports when it ends */
+		}
+		err = 0;
+	}
+	lck_mtx_unlock(&scan_lock);
+	return err;
+}
+
+/* a scan that will not complete (failure, modem down): still tell sweet_80211 so wifid does not wait forever */
+static void
+scan_flush_notify(const char *why)
+{
+	lck_mtx_lock(&scan_lock);
+	bool notify = scan_notify;
+	scan_notify = false;
+	scan_req = false;
+	lck_mtx_unlock(&scan_lock);
+	if (notify) {
+		printf("SWEET IPC: scan: completing the pending request without a scan (%s)\n", why);
+		sweet80211_scan_done();
+	}
+}
+
+int
+sweet_wlan_bss_get(unsigned i, struct sweet_wlan_bss *out)
+{
+	int err = ENOENT;
+	lck_mtx_lock(&scan_lock);
+	if (i < scan.nbss && scan_ie) {
+		memset(out, 0, sizeof(*out));
+		memcpy(out->bssid, scan.bss[i].bssid, 6);
+		out->mhz = scan.bss[i].mhz;
+		out->rssi = scan.bss[i].rssi;
+		out->noise = -95;               /* ATH10K_DEFAULT_NOISE_FLOOR */
+		out->beacon_int = scan.bss[i].beacon_int;
+		out->cap = scan.bss[i].cap;
+		out->ssid_len = scan.bss[i].ssid_len;
+		memcpy(out->ssid, scan.bss[i].raw_ssid, scan.bss[i].ssid_len);
+		out->ie_len = scan.bss[i].ie_len;
+		memcpy(out->ie, scan_ie + i * SWEET_WLAN_IE_MAX, scan.bss[i].ie_len);
+		err = 0;
+	}
+	lck_mtx_unlock(&scan_lock);
+	return err;
+}
+
+/* service thread: start a requested scan once the previous one is done and the WMI credit is back */
+static void
+svc_scan(void)
+{
+	if (!scan_req || wf.state != WS_SCAN_DONE || !wce.wmi_credits) {
+		return;
+	}
+	lck_mtx_lock(&scan_lock);
+	scan_req = false;
+	scan.nbss = 0;
+	wf.state = WS_SCAN_SETUP;
+	lck_mtx_unlock(&scan_lock);
+	scan.beacons = 0;
+	scan.foreign = 0;
+	scan.started = false;
+	scan.completed = false;
+	scan.step = 8;                          /* START_SCAN only: the setup steps are done */
+	wf.sent_ms = ms_now_ms();
+}
