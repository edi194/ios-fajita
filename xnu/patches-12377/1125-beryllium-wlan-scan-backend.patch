+/* sweet80211=3: network s8.scan_next of the WLAN service's last scan, in the same layout as the fake one */
 static int
+s8_real_result(struct sweet80211_req *req)
+{
+	struct sweet_wlan_bss *b = kalloc_data(sizeof(*b), Z_WAITOK | Z_ZERO);
+	struct s8_scan_result *r = kalloc_data(sizeof(struct s8_scan_result), Z_WAITOK | Z_ZERO);
+	int err = ENOMEM;
+	if (b == NULL || r == NULL) {
+		goto out;
+	}
+	if (sweet_wlan_bss_get(s8.scan_next, b) != 0) {
+		err = EIO;                              /* no more results: the framework stops here */
+		goto out;
+	}
+	bool g5 = b->mhz > 4900;
+	r->version = 1;
+	r->ch_version = 1;
+	r->ch_channel = b->mhz == 2484 ? 14 : g5 ? (b->mhz - 5000) / 5 : (b->mhz - 2407) / 5;
+	r->ch_flags = (g5 ? C_FLAG_5GHZ : C_FLAG_2GHZ) | C_FLAG_20MHZ | C_FLAG_ACTIVE;
+	r->unk = 1;
+	r->noise = b->noise;
+	r->rssi = b->rssi;
+	r->snr = (int16_t)(b->rssi - b->noise);
+	r->beacon_int = b->beacon_int;
+	r->cap = b->cap;
+	memcpy(r->bssid, b->bssid, 6);
+	r->ssid_len = MIN(b->ssid_len, 32);
+	memcpy(r->ssid, b->ssid, r->ssid_len);
+	/* rates in Mb/s from Supported Rates (1) and Extended Supported Rates (50), 500 kb/s units */
+	for (uint32_t o = 0; o + 2 <= b->ie_len;) {
+		uint8_t id = b->ie[o], l = b->ie[o + 1];
+		if (o + 2u + l > b->ie_len) {
+			break;
+		}
+		for (unsigned i = 0; (id == 1 || id == 50) && i < l && r->nrates < 15; i++) {
+			uint8_t v = b->ie[o + 2 + i] & 0x7f;
+			if (v >= 0x7b) {
+				continue;       /* membership selectors (HT 0xff, VHT 0xfe, SAE H2E 0xfb), not rates */
+			}
+			r->rates[r->nrates++] = v / 2;
+		}
+		o += 2u + l;
+	}
+	r->ie_len = MIN(b->ie_len, (uint16_t)sizeof(r->ie));
+	memcpy(r->ie, b->ie, r->ie_len);
+	s8.scan_next++;
+	err = s8_reply(req, r, sizeof(*r));
+out:
+	if (b) {
+		kfree_data(b, sizeof(*b));
+	}
+	if (r) {
+		kfree_data(r, sizeof(struct s8_scan_result));
+	}
+	return err;
+}
