+/*
+ * scanTo() only queues the new source address: the MDP latches it at the
+ * next panel vsync and clears the pipe's CTL0 flush bits then. Until that
+ * happens the previous front buffer is still being scanned out, and it is
+ * the buffer present() draws into next when flushes come less than one
+ * panel frame apart (sweetfb_hz >= ~40, or sweetfb_vsync=1): torn frames.
+ * Wait (bounded, one vsync plus slack) for the latch before drawing.
+ */
+void
+AppleCLCD::waitLatch(void)
+{
+	static bool warned;
+	volatile uint32_t *flush = (volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH);
+	uint32_t mask = sweet_mdp_pipes[fPipe].flush | SWEET_MDP_CTL_BIT;
+
+	for (uint32_t i = 0; i < 25000; i++) {
+		if (!(*flush & mask)) {
+			return;
+		}
+		IODelay(1);
+	}
+	if (!warned) {
+		warned = true;
+		IOLog("SWEET FB: MDP flush 0x%x did not latch within 25 ms\n", *flush);
+	}
+}
