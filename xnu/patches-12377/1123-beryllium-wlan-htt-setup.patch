+/*
+ * The rest of ath10k_htt_setup() after the version exchange (64-bit variants, target_64bit): FRAG_DESC_BANK_CFG,
+ * the RX ring filled to HTT_RX_RING_FILL_LEVEL_DUAL_MAC (2047) with the alloc index word, RX_RING_CFG (all 16 rx
+ * flags, the htt_rx_desc_v2 offsets of wcn3990_rx_desc_ops) and AGGR_CFG v2 (64 / 3). The pool is zeroed, so the
+ * descriptors and every buffer's rx_attention word start at 0 as ath10k leaves them.
+ */
+static bool
+scan_htt_setup(void)
+{
+	uint8_t m[64];
+	/* FRAG_DESC_BANK_CFG: type, info 0, 1 bank, desc size 72, 4 x le64 bank base, 4 x {min, max} id, q_state */
+	memset(m, 0, sizeof(m));
+	m[0] = 6;
+	m[2] = 1;
+	m[3] = HTT_FRAG_DESC_SIZE;
+	uint64_t bank = WCE_POOL_PA + HTT_FRAG_OFF;
+	memcpy(m + 4, &bank, 8);
+	uint16_t maxid = HTT_FRAG_DESCS - 1;
+	memcpy(m + 36 + 2, &maxid, 2);          /* bank_id[0] = {0, 1055} */
+	m[60] = 1;                              /* q_state record_size HTT_TX_Q_STATE_ENTRY_SIZE, multiplier 0 */
+	if (!wce_send(4, wce.htt_eid, m, 64)) {
+		return false;
+	}
+	/* RX ring: buffer i at pool + 8 MiB + i * 2 KiB, 2047 posted, alloc index = 2047 */
+	uint64_t *ring = (uint64_t *)(wce.pool + HTT_RXRING_OFF);
+	for (uint32_t i = 0; i < HTT_RX_RING_SIZE; i++) {
+		ring[i] = i < HTT_RX_RING_SIZE - 1 ? WCE_POOL_PA + HTT_RXBUF_OFF + (uint64_t)i * HTT_RX_BUF_SIZE : 0;
+	}
+	*(volatile uint32_t *)(wce.pool + HTT_ALLOC_IDX_OFF) = HTT_RX_RING_SIZE - 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* RX_RING_CFG: type 2, 1 ring, rsvd; fw idx shadow paddr, ring paddr, len, bufsize, flags, idx init, offsets */
+	memset(m, 0, sizeof(m));
+	m[0] = 2;
+	m[1] = 1;
+	uint64_t idxpa = WCE_POOL_PA + HTT_ALLOC_IDX_OFF, ringpa = WCE_POOL_PA + HTT_RXRING_OFF;
+	memcpy(m + 4, &idxpa, 8);
+	memcpy(m + 12, &ringpa, 8);
+	uint16_t r16[4] = { HTT_RX_RING_SIZE, HTT_RX_BUF_SIZE, 0xffff, HTT_RX_RING_SIZE - 1 };   /* len in entries */
+	memcpy(m + 20, r16, 8);
+	/* mac80211_hdr, msdu_payload, ppdu_start, ppdu_end, mpdu_start, mpdu_end, msdu_start, msdu_end, attention, frag */
+	static const uint16_t offs[10] = { 74, 90, 27, 37, 4, 26, 7, 12, 1, 2 };
+	memcpy(m + 28, offs, 20);
+	if (!wce_send(4, wce.htt_eid, m, 48)) {
+		return false;
+	}
+	uint8_t ag[4] = { 5, 64, 3, 0 };        /* AGGR_CFG v2: max A-MPDU 64, max A-MSDU 3 */
+	if (!wce_send(4, wce.htt_eid, ag, 4)) {
+		return false;
+	}
+	printf("SWEET IPC: scan: HTT setup sent: frag bank %u x %u at %#llx, RX ring %u (%u posted) at %#llx, aggr 64/3\n",
+	    HTT_FRAG_DESCS, HTT_FRAG_DESC_SIZE, bank, HTT_RX_RING_SIZE, HTT_RX_RING_SIZE - 1, ringpa);
+	ipc_note(" htt setup;");
+	return true;
+}
