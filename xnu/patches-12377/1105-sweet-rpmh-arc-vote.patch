+/*
+ * ARC power-domain level vote for the modem boot (docs/WIFI_IOS26.md, P3): the
+ * three domains the MSS needs (Linux sdm845 mss power-domains cx/mx/mss). max=true
+ * votes the highest hlvl of the cmd-db level map, as Linux's
+ * dev_pm_genpd_set_performance_state(pd, INT_MAX) for proxy votes does; max=false
+ * votes hlvl 0 (off). Active set only, like the VRM votes above.
+ */
+int
+sweet_rpmh_arc_vote(const char *res, bool max)
+{
+	static const char *const allowed[] = { "cx.lvl", "mx.lvl", "mss.lvl" };
+	unsigned i;
+	if (!sweet_board_beryllium() || !res) {
+		return EINVAL;
+	}
+	for (i = 0; i < sizeof(allowed) / sizeof(allowed[0]); ++i) {
+		if (!strcmp(res, allowed[i])) {
+			break;
+		}
+	}
+	if (i == sizeof(allowed) / sizeof(allowed[0])) {
+		printf("SWEET RPMH: %s is not an allowed ARC resource\n", res);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, aux = 0, aux_len = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_slave(res, RH_ARC, &address, &aux, &aux_len);
+	}
+	if (!error) {
+		unsigned count = aux_len / 2;
+		uint16_t vl[RH_ARC_LEVELS];
+		if (count == 0 || count > RH_ARC_LEVELS) {
+			printf("SWEET RPMH: %s level map has %u entries\n", res, count);
+			error = EINVAL;
+			goto out;
+		}
+		for (unsigned k = 0; k < count; ++k) {
+			vl[k] = (uint16_t)rh_db16(aux + 2 * k);
+			if (k > 0 && vl[k] == 0) {      /* zero padding ends the map */
+				count = k;
+				break;
+			}
+		}
+		/*
+		 * Never an off vote for cx/mx: an apps-DRV vote replaces ABL's vote through this DRV, and
+		 * CX/MX feed the display, UFS and memory (Linux clamps to the top level before sync_state;
+		 * an ldoa7 off vote panicked boot 0116hw). Only mss.lvl, which nothing else on the AP uses,
+		 * is voted back to 0.
+		 */
+		if (!max && strcmp(res, "mss.lvl")) {
+			printf("SWEET RPMH: %s off vote refused (kept at the top level)\n", res);
+			error = 0;
+			goto out;
+		}
+		uint32_t hlvl = max ? count - 1 : 0;
+		printf("SWEET RPMH: %s ARC %#x: %u levels, vote hlvl %u (vlvl %u)\n", res, address, count, hlvl,
+		    vl[hlvl]);
+		error = rh_cmds(&address, &hlvl, 1);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: %s ARC vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
