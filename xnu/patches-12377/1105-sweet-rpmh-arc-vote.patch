+/* VRM: enable=false sends a single ENABLE=0 command (voltage and mode stay as they were). */
+static int
+rh_send(uint32_t address, unsigned mv, bool enable)
+{
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t on_addr[3] = { address + 0, address + 8, address + 4 };
+	const uint32_t on_val[3] = { mv, 7, 1 };
+	const uint32_t off_addr[1] = { address + 4 };
+	const uint32_t off_val[1] = { 0 };
+	printf("SWEET RPMH: VRM %#x %u mV mode=7 enable=%d\n", address, mv, enable);
+	return enable ? rh_cmds(on_addr, on_val, 3) : rh_cmds(off_addr, off_val, 1);
+}
