+/*
+ * Scan result as IO80211 1565.3 reads it (_addScanResultToList; Apple80211Scan gets type 11
+ * into a 2272-byte buffer until EIO): the classic apple80211_scan_result layout.
+ */
+struct s8_scan_result {
+	uint32_t version;               /* 0: 1 */
+	uint32_t ch_version;            /* 4 */
+	uint32_t ch_channel;            /* 8 */
+	uint32_t ch_flags;              /* 12: C_FLAG_* */
+	int16_t  unk;                   /* 16: nonzero = noise and snr valid */
+	int16_t  noise;                 /* 18 */
+	int16_t  snr;                   /* 20 */
+	int16_t  rssi;                  /* 22 */
+	uint16_t beacon_int;            /* 24 */
+	uint16_t cap;                   /* 26: bit 0 ESS, 0x10 privacy */
+	uint8_t  bssid[6];              /* 28 */
+	uint8_t  nrates;                /* 34 */
+	uint8_t  pad0;
+	uint32_t rates[15];             /* 36: Mb/s */
+	uint8_t  ssid_len;              /* 96 */
+	uint8_t  ssid[32];              /* 97 */
+	uint8_t  pad1[3];
+	uint32_t age;                   /* 132 */
+	uint16_t flags;                 /* 136 */
+	uint16_t ie_len;                /* 138 */
+	uint8_t  ie[2048];              /* 140 */
+} __attribute__((packed));
+static_assert(__builtin_offsetof(struct s8_scan_result, ssid_len) == 96, "scan result layout");
+static_assert(__builtin_offsetof(struct s8_scan_result, ie_len) == 138, "scan result layout");
+
+/* sweet80211=2: one synthetic open network per scan, to exercise wifid's scan path and Settings */
+static int
+s8_fake_result(struct sweet80211_req *req)
+{
+	static const char ssid[] = "Bergamota-test";
+	static const uint8_t rates[] = { 1, 2, 5, 6, 9, 11, 12, 18, 24, 36, 48, 54 };
+	struct s8_scan_result *r;
+	int err;
+
+	if (s8.scan_next != 0) {
+		return EIO;
+	}
+	r = kalloc_data(sizeof(*r), Z_WAITOK | Z_ZERO);
+	if (r == NULL) {
+		return ENOMEM;
+	}
+	r->version = 1;
+	r->ch_version = 1;
+	r->ch_channel = 6;
+	r->ch_flags = C_FLAG_2GHZ | C_FLAG_20MHZ | C_FLAG_ACTIVE;
+	r->unk = 1;
+	r->noise = -92;
+	r->snr = 40;
+	r->rssi = -52;
+	r->beacon_int = 100;
+	r->cap = 0x0001;                /* ESS, open */
+	memcpy(r->bssid, (const uint8_t[]){ 0x02, 0x00, 0x5e, 0x77, 0xe0, 0xaa }, 6);
+	r->nrates = sizeof(rates);
+	for (unsigned i = 0; i < sizeof(rates); i++) {
+		r->rates[i] = rates[i];
+	}
+	r->ssid_len = sizeof(ssid) - 1;
+	memcpy(r->ssid, ssid, sizeof(ssid) - 1);
+	/* IEs: SSID, supported rates (500 kb/s units, basic bit on 1/2/5.5/11), DS parameter set */
+	uint8_t *ie = r->ie;
+	*ie++ = 0;
+	*ie++ = sizeof(ssid) - 1;
+	memcpy(ie, ssid, sizeof(ssid) - 1);
+	ie += sizeof(ssid) - 1;
+	static const uint8_t supp[] = { 1, 8, 0x82, 0x84, 0x8b, 0x96, 0x0c, 0x12, 0x18, 0x24 };
+	memcpy(ie, supp, sizeof(supp));
+	ie += sizeof(supp);
+	*ie++ = 3;
+	*ie++ = 1;
+	*ie++ = 6;
+	r->ie_len = (uint16_t)(ie - r->ie);
+	s8.scan_next++;
+	err = s8_reply(req, r, sizeof(*r));
+	kfree_data(r, sizeof(*r));
+	return err;
+}
