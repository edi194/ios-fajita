 		s8_post_event(M_SSID_CHANGED, NULL, 0);
 		s8_post_event(M_BSSID_CHANGED, NULL, 0);
-		s8_post_event(M_ASSOC_DONE, &ok, sizeof(ok));
+		s8_assoc_done();
 		if (s8.auth_upper) {
