diff --git a/bsd/dev/sweet_80211.c b/bsd/dev/sweet_80211.c
--- a/bsd/dev/sweet_80211.c
+++ b/bsd/dev/sweet_80211.c
@@ -812,6 +812,34 @@
 	ifnet_event(s8.ifp, h);
 }
 
+/*
+ * APPLE80211_M_ASSOC_DONE. Boot 54: wifid joins with the async API (no GET 21 polls), whose handler
+ * (_dispatchAsyncAssocEvent) reads a >= 460-byte status blob: 10 x 44-byte per-BSS records, then u32s @440, @448
+ * (extended status), @452 (result) and @456 (result valid). A 4-byte payload left it reading its own 0xAA fill:
+ * "Unable to join" over a working link. With valid = 0 it asks GET 21 for the result instead (the sync API's
+ * source of truth too; IO80211 does the same GET for any ASSOC_DONE that is not 4 bytes long).
+ */
+static void
+s8_assoc_done(void)
+{
+	uint8_t *blob = kalloc_data(460, Z_WAITOK | Z_ZERO);
+	if (blob != NULL) {
+		s8_post_event(M_ASSOC_DONE, blob, 460);
+		kfree_data(blob, 460);
+	}
+}
+
+/* the WLAN service thread: a join failed (the result is already in GET 21) */
+void
+sweet80211_join_failed(int result)
+{
+	if (s8.ifp == NULL || s8.stage != 3) {
+		return;
+	}
+	printf("SWEET 80211: join failed (result %d)\n", result);
+	s8_assoc_done();
+}
+
 /* the WLAN service thread: joined (keys in) or the association ended */
