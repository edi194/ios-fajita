diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index a7397000c656bb462bf4b08084fe703702a6213f..90ae07ebbee1f8417b7eb8ab5f9ecf829001f5df 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1137,6 +1137,15 @@ sweet_crash_strings(const char *name)
  * SWEET process sampler (bsd/dev/sweet_sample.c): user pc/lr/sp and a frame
  * pointer backtrace of every thread of a task, from the saved user state.
  */
+/*
+ * xnu-12377 removed IO_NULL and io_otype(): every port is now one of many IOT_*_PORT object types.
+ * The samplers only ask "port or port set", which is what these give back.
+ */
+#ifndef IO_NULL
+#define IO_NULL IPC_OBJECT_NULL
+#define io_otype(io) (io_is_pset_type(io_type(io)) ? IOT_PORT_SET : IOT_PORT)
+#endif
+
 void sweet_sample_task(const char *name, int pid, task_t task);
 
 void
@@ -1181,6 +1190,57 @@ sweet_sample_task(const char *name, int pid, task_t task)
 		printf("%s\n", line);
 	}
 	task_unlock(task);
+
+	/*
+	 * Receive rights of the task: is the service endpoint checked in (a receive right exists) and are messages
+	 * piling up on it (clients sent, nobody dequeues)? "SMP name PORTS recv N queued M: name:count ..." lists the
+	 * receive rights that hold queued messages (up to 24), N = all receive rights, M = those with messages.
+	 */
+	{
+		ipc_space_t space = task->itk_space;
+		mach_port_name_t qn[24];
+		uint32_t qc[24];
+		int nq = 0;
+		uint32_t nrecv = 0, nqueued = 0, npset = 0;
+
+		if (space != IS_NULL) {
+			is_read_lock(space);
+			if (is_active(space)) {
+				ipc_entry_table_t table = is_active_table(space);
+				ipc_entry_num_t tsize = ipc_entry_table_count(table);
+				for (mach_port_index_t index = 1; index < tsize; index++) {
+					ipc_entry_t entry = ipc_entry_table_get_nocheck(table, index);
+					ipc_entry_bits_t bits = entry->ie_bits;
+					if (!(IE_BITS_TYPE(bits) & MACH_PORT_TYPE_RECEIVE) || entry->ie_object == IO_NULL) {
+						continue;
+					}
+					nrecv++;
+					ipc_object_t obj = entry->ie_object;
+					if (io_otype(obj) != IOT_PORT) {
+						npset++;
+						continue;
+					}
+					ipc_port_t port = ip_object_to_port(obj);
+					uint32_t cnt = port->ip_messages.imq_msgcount;
+					if (cnt != 0) {
+						nqueued++;
+						if (nq < 24) {
+							qn[nq] = MACH_PORT_MAKE(index, IE_BITS_GEN(bits));
+							qc[nq] = cnt;
+							nq++;
+						}
+					}
+				}
+			}
+			is_read_unlock(space);
+		}
+		char pl[300];
+		int pn = snprintf(pl, sizeof(pl), "SMP %s PORTS recv %u psets %u queued %u:", name, nrecv, npset, nqueued);
+		for (int i = 0; i < nq && pn < (int)sizeof(pl) - 24; i++) {
+			pn += snprintf(pl + pn, sizeof(pl) - pn, " 0x%x:%u", qn[i], qc[i]);
+		}
+		printf("%s\n", pl);
+	}
 }
 
 #endif /* ARM64_BOARD_CONFIG_SWEET */
