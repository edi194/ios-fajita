+static bool
+ms_assign(const char *what, uint64_t pa, uint64_t size, uint32_t src_vmid, uint32_t dst_vmid, uint32_t perm)
+{
+	return ms_assign_list(what, pa, size, &src_vmid, 1, &dst_vmid, &perm, 1);
+}
+
+/*
+ * q6v5_xfer_mem_ownership(): local = HLOS RWX, remote = MSS_MSA RW; the sources are the current owners in
+ * ascending VMID order (qcom_scm_assign_mem walks the bitmask), the size is rounded up to 4 KiB.
+ */
+static bool
+ms_xfer(const char *what, uint64_t pa, uint64_t size, uint32_t *cur, bool local, bool remote)
+{
+	if (local == ((*cur & VMBIT(SCM_VMID_HLOS)) != 0) && remote == ((*cur & VMBIT(SCM_VMID_MSS_MSA)) != 0)) {
+		return true;
+	}
+	uint32_t src[2], dst[2], perm[2];
+	unsigned nsrc = 0, ndst = 0;
+	for (uint32_t v = 0; v < 32 && nsrc < 2; v++) {
+		if (*cur & VMBIT(v)) {
+			src[nsrc++] = v;
+		}
+	}
+	if (local) {
+		dst[ndst] = SCM_VMID_HLOS;
+		perm[ndst++] = SCM_PERM_RWX;
+	}
+	if (remote) {
+		dst[ndst] = SCM_VMID_MSS_MSA;
+		perm[ndst++] = SCM_PERM_RW;
+	}
+	if (!ms_assign_list(what, pa, (size + 0xfffull) & ~0xfffull, src, nsrc, dst, perm, ndst)) {
+		return false;
+	}
+	*cur = (local ? VMBIT(SCM_VMID_HLOS) : 0) | (remote ? VMBIT(SCM_VMID_MSS_MSA) : 0);
+	return true;
+}
