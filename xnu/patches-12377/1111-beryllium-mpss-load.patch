+
+/*
+ * ---- P4: MPSS load and boot (docs/WIFI_IOS26.md 5.7), from "MBA alive", sweetmpss=1 only.
+ * Linux v6.6 qcom_q6v5_mss.c q6v5_mpss_load() / q6v5_mpss_init_image(), mdt_loader.c
+ * qcom_mdt_read_metadata(), then the "ready" bit of the modem's SMP2P entry (qcom_q6v5_wait_for_start)
+ * polled from SMEM, since nothing here takes the SMP2P interrupt.
+ */
+static struct wl_fat ms_fat;
+static uint8_t *ms_mdt, *ms_meta;
+static uint32_t ms_mdt_len, ms_meta_len;
+
+static int32_t
+ms_rmb_wait(int32_t want, unsigned max_ms, unsigned *waited)
+{
+	/* q6v5_rmb_mba_wait(): a negative status is an error, 0 = still working */
+	int32_t v = 0;
+	unsigned i;
+	for (i = 0; i < max_ms; i++) {
+		v = (int32_t)wl_rd(ms.rmb, RMB_MBA_STATUS);
+		if (v < 0 || v == want) {
+			break;
+		}
+		wl_sleep(1);
+	}
+	*waited = i;
+	return v;
+}
+
+static uint64_t
+ms_now_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static void
+ms_phdr(uint32_t i, struct elf32_phdr *ph)
+{
+	struct elf32_ehdr eh;
+	memcpy(&eh, ms_mdt, sizeof(eh));
+	memcpy(ph, ms_mdt + eh.e_phoff + (uint64_t)i * sizeof(*ph), sizeof(*ph));
+}
+
+/* q6v5_phdr_valid() */
+static bool
+ms_phdr_valid(const struct elf32_phdr *ph)
+{
+	return ph->p_type == 1 && (ph->p_flags & MDT_TYPE_MASK) != MDT_TYPE_HASH && ph->p_memsz != 0;
+}
+
+/* modem.bNN for program header i (Linux replaces the "mdt" suffix with "bNN") */
+static int
+ms_seg_open(uint32_t i, uint32_t *cl, uint32_t *size, char path[24])
+{
+	snprintf(path, 24, "image/modem.b%02u", i);
+	return fat_open(&ms_fat, path, cl, size);
+}
+
+/* step 9: modem.mdt and its metadata (qcom_mdt_read_metadata) */
+static bool
+ms_mdt_prepare(void)
+{
+	uint32_t cl, size;
+	if (fat_mount(&ms_fat, "modem") || fat_open(&ms_fat, "image/modem.mdt", &cl, &size)) {
+		printf("SWEET MSS: modem:image/modem.mdt not readable\n");
+		return false;
+	}
+	if (size < sizeof(struct elf32_ehdr) || size > MSS_MDATA_MAX) {
+		printf("SWEET MSS: modem.mdt size %u not accepted\n", size);
+		return false;
+	}
+	ms_mdt = kalloc_data(size, Z_WAITOK | Z_ZERO);
+	ms_mdt_len = size;
+	if (ms_mdt == NULL || fat_read_chain(&ms_fat, cl, 0, ms_mdt, size)) {
+		printf("SWEET MSS: modem.mdt read failed\n");
+		return false;
+	}
+	struct elf32_ehdr eh;
+	memcpy(&eh, ms_mdt, sizeof(eh));
+	if (memcmp(eh.e_ident, "\x7f" "ELF", 4) != 0 || eh.e_ident[4] != 1 || eh.e_phentsize != sizeof(struct elf32_phdr) ||
+	    eh.e_phnum < 2 || (uint64_t)eh.e_phoff + (uint64_t)eh.e_phnum * sizeof(struct elf32_phdr) > size) {
+		printf("SWEET MSS: modem.mdt is not a 32-bit ELF with program headers\n");
+		return false;
+	}
+	struct elf32_phdr ph0, hp;
+	ms_phdr(0, &ph0);
+	if (ph0.p_type == 1) {
+		printf("SWEET MSS: modem.mdt program header 0 is loadable (no ELF header segment)\n");
+		return false;
+	}
+	uint32_t h;
+	for (h = 1; h < eh.e_phnum; h++) {
+		ms_phdr(h, &hp);
+		if ((hp.p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+			break;
+		}
+	}
+	if (h == eh.e_phnum) {
+		printf("SWEET MSS: no hash segment in modem.mdt\n");
+		return false;
+	}
+	uint32_t ehdr_size = ph0.p_filesz, hash_size = hp.p_filesz;
+	if (ehdr_size > size || hash_size == 0 || (uint64_t)ehdr_size + hash_size > MSS_MDATA_MAX) {
+		printf("SWEET MSS: metadata %u + %u bytes not accepted\n", ehdr_size, hash_size);
+		return false;
+	}
+	ms_meta_len = ehdr_size + hash_size;
+	ms_meta = kalloc_data(ms_meta_len, Z_WAITOK | Z_ZERO);
+	if (ms_meta == NULL) {
+		return false;
+	}
+	memcpy(ms_meta, ms_mdt, ehdr_size);
+	const char *from;
+	if (ehdr_size + hash_size == size) {
+		memcpy(ms_meta + ehdr_size, ms_mdt + ehdr_size, hash_size);
+		from = "packed after the ELF header";
+	} else if ((uint64_t)hp.p_offset + hash_size <= size) {
+		memcpy(ms_meta + ehdr_size, ms_mdt + hp.p_offset, hash_size);
+		from = "its own segment inside modem.mdt";
+	} else {
+		char path[24];
+		uint32_t scl, ssize;
+		if (ms_seg_open(h, &scl, &ssize, path) || ssize != hash_size ||
+		    fat_read_chain(&ms_fat, scl, 0, ms_meta + ehdr_size, hash_size)) {
+			printf("SWEET MSS: hash segment %u: %s missing or truncated\n", h, path);
+			return false;
+		}
+		from = "its own .bNN file";
+	}
+	printf("SWEET MSS: modem.mdt %u bytes, %u program headers, hash ph%u: metadata %u + %u = %u bytes (hash %s)\n",
+	    size, eh.e_phnum, h, ehdr_size, hash_size, ms_meta_len, from);
+	return true;
+}
+
+/* step 10: metadata authentication (q6v5_mpss_init_image) */
+static bool
+ms_mdata_auth(void)
+{
+	uint32_t perm = VMBIT(SCM_VMID_HLOS);
+	vm_offset_t va = ml_io_map_unmappable(MSS_MDATA_PA, MSS_MDATA_MAX, VM_WIMG_WCOMB);
+	if (!va) {
+		printf("SWEET MSS: metadata slice mapping failed\n");
+		return false;
+	}
+	memcpy((void *)va, ms_meta, ms_meta_len);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ml_io_unmap(va, MSS_MDATA_MAX);         /* no kernel mapping while the modem owns it */
+	if (!ms_xfer("metadata", MSS_MDATA_PA, ms_meta_len, &perm, false, true)) {
+		return false;
+	}
+	wl_wr(ms.rmb, RMB_PMI_META_DATA, (uint32_t)MSS_MDATA_PA);
+	wl_wr(ms.rmb, RMB_MBA_COMMAND, RMB_CMD_META_DATA_READY);
+	unsigned t;
+	int32_t st = ms_rmb_wait(RMB_MBA_META_DATA_AUTH_SUCCESS, 1000, &t);
+	printf("SWEET MSS: metadata at %#llx: MBA status %d after %u ms (3 = header authenticated)\n", MSS_MDATA_PA, st, t);
+	sweet_log_sync();
+	if (!ms_xfer("metadata back", MSS_MDATA_PA, ms_meta_len, &perm, true, false)) {
+		printf("SWEET MSS: metadata slice NOT reclaimed: it stays with the modem until the next reboot\n");
+	}
+	return st == RMB_MBA_META_DATA_AUTH_SUCCESS;
+}
+
+static void
+ms_zero_nc(volatile uint8_t *p, uint64_t n)
+{
+	while (n && ((uintptr_t)p & 7)) {
+		*p++ = 0;
+		n--;
+	}
+	volatile uint64_t *q = (volatile uint64_t *)(uintptr_t)p;
+	for (; n >= 8; n -= 8) {
+		*q++ = 0;
+	}
+	p = (volatile uint8_t *)q;
+	while (n--) {
+		*p++ = 0;
+	}
+}
+
+/* step 11: the segments (q6v5_mpss_load's loop), one write-combined window per segment */
+static bool
+ms_mpss_segments(void)
+{
+	struct elf32_ehdr eh;
+	memcpy(&eh, ms_mdt, sizeof(eh));
+	uint32_t min_addr = ~0u;
+	bool relocate = false;
+	for (uint32_t i = 0; i < eh.e_phnum; i++) {
+		struct elf32_phdr ph;
+		ms_phdr(i, &ph);
+		if (ms_phdr_valid(&ph)) {
+			relocate |= (ph.p_flags & MDT_RELOCATABLE) != 0;
+			min_addr = MIN(min_addr, ph.p_paddr);
+		}
+	}
+	if (min_addr == ~0u) {
+		printf("SWEET MSS: modem.mdt has no loadable segment\n");
+		return false;
+	}
+	/* "the modem memory can be reclaimed only after MBA is loaded", then shared during the copy */
+	ms.mpss_loading = true;
+	(void)ms_xfer("mpss reclaim", MSS_MPSS_PA, MSS_MPSS_SIZE, &ms.mpss_perm, true, false);
+	if (!ms_xfer("mpss share", MSS_MPSS_PA, MSS_MPSS_SIZE, &ms.mpss_perm, true, true)) {
+		printf("SWEET MSS: assigning Q6 access to mpss memory failed\n");
+		return false;
+	}
+	uint64_t reloc = relocate ? min_addr : MSS_MPSS_PA;
+	const uint32_t chunk_size = 0x100000u;
+	uint8_t *chunk = kalloc_data(chunk_size, Z_WAITOK);
+	if (chunk == NULL) {
+		return false;
+	}
+	bool ok = false;
+	uint32_t total = 0;
+	uint64_t t0 = ms_now_ms();
+	for (uint32_t i = 0; i < eh.e_phnum; i++) {
+		struct elf32_phdr ph;
+		ms_phdr(i, &ph);
+		if (!ms_phdr_valid(&ph)) {
+			continue;
+		}
+		int64_t off = (int64_t)ph.p_paddr - (int64_t)reloc;
+		if (off < 0 || (uint64_t)off + ph.p_memsz > MSS_MPSS_SIZE || ph.p_filesz > ph.p_memsz) {
+			printf("SWEET MSS: segment %u paddr %#x memsz %#x filesz %#x outside the carve-out\n", i, ph.p_paddr,
+			    ph.p_memsz, ph.p_filesz);
+			goto done;
+		}
+		uint64_t pa = MSS_MPSS_PA + (uint64_t)off;
+		uint64_t base = trunc_page_64(pa), len = round_page_64(pa + ph.p_memsz) - base;
+		vm_offset_t va = ml_io_map_unmappable(base, len, VM_WIMG_WCOMB);
+		if (!va) {
+			printf("SWEET MSS: segment %u: mapping %#llx+%#llx failed\n", i, base, len);
+			goto done;
+		}
+		uint8_t *ptr = (uint8_t *)(va + (pa - base));
+		char path[24] = "modem.mdt";
+		bool seg_ok = true;
+		if (ph.p_filesz && ph.p_offset < ms_mdt_len) {
+			if ((uint64_t)ph.p_offset + ph.p_filesz > ms_mdt_len) {
+				seg_ok = false;
+			} else {
+				memcpy(ptr, ms_mdt + ph.p_offset, ph.p_filesz);
+			}
+		} else if (ph.p_filesz) {
+			uint32_t scl = 0, ssize = 0;
+			if (ms_seg_open(i, &scl, &ssize, path) || ssize != ph.p_filesz) {
+				seg_ok = false;
+			}
+			for (uint32_t o = 0; seg_ok && o < ph.p_filesz; o += chunk_size) {
+				uint32_t n = MIN(chunk_size, ph.p_filesz - o);
+				if (fat_read_chain(&ms_fat, scl, o, chunk, n)) {
+					seg_ok = false;
+					break;
+				}
+				memcpy(ptr + o, chunk, n);
+			}
+		}
+		if (seg_ok && ph.p_memsz > ph.p_filesz) {
+			ms_zero_nc(ptr + ph.p_filesz, ph.p_memsz - ph.p_filesz);
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		ml_io_unmap(va, len);
+		if (!seg_ok) {
+			printf("SWEET MSS: failed to load segment %u from %s (missing or truncated)\n", i, path);
+			goto done;
+		}
+		total += ph.p_memsz;
+		if (wl_rd(ms.rmb, RMB_PMI_CODE_LENGTH) == 0) {
+			wl_wr(ms.rmb, RMB_PMI_CODE_START, relocate ? (uint32_t)MSS_MPSS_PA : min_addr);
+			wl_wr(ms.rmb, RMB_MBA_COMMAND, RMB_CMD_LOAD_READY);
+		}
+		wl_wr(ms.rmb, RMB_PMI_CODE_LENGTH, total);
+		int32_t st = (int32_t)wl_rd(ms.rmb, RMB_MBA_STATUS);
+		printf("SWEET MSS: segment %u %s paddr %#x file %#x mem %#x: code length %#x, MBA status %d (%llu ms)\n", i,
+		    path, ph.p_paddr, ph.p_filesz, ph.p_memsz, total, st, ms_now_ms() - t0);
+		sweet_log_sync();
+		if (st < 0) {
+			printf("SWEET MSS: MPSS authentication failed: %d\n", st);
+			goto done;
+		}
+	}
+	ok = true;
+done:
+	kfree_data(chunk, chunk_size);
+	return ok;
+}
+
+/* the data of an SMEM item in the private partition of hosts a<->b (either order), 0 if absent */
+static uint32_t
+ms_smem_item(uint32_t a, uint32_t b, uint32_t item, uint32_t *size)
+{
+	uint32_t top = WL_SMEM_SIZE - 0x1000;
+	if (smem_u32(top) != 0x434f5424u) {
+		return 0;
+	}
+	uint32_t n = MIN(smem_u32(top + 8), 32u);
+	for (uint32_t k = 0; k < n; k++) {
+		uint32_t e = top + 32 + k * 48;
+		uint32_t offset = smem_u32(e), psize = smem_u32(e + 4), hosts = smem_u32(e + 12);
+		uint32_t h0 = hosts & 0xffff, h1 = hosts >> 16;
+		if (!offset || !psize || !((h0 == a && h1 == b) || (h0 == b && h1 == a))) {
+			continue;
+		}
+		if ((uint64_t)offset + psize > WL_SMEM_SIZE || smem_u32(offset) != 0x54525024u) {
+			return 0;
+		}
+		uint32_t free_u = MIN(smem_u32(offset + 12), psize), pos = offset + 32;
+		for (unsigned guard = 0; pos + 16 <= offset + free_u && guard < 512; guard++) {
+			uint32_t w0 = smem_u32(pos), sz = smem_u32(pos + 4), w2 = smem_u32(pos + 8);
+			if ((w0 & 0xffff) != 0xa5a5 || sz > psize) {
+				return 0;
+			}
+			if ((w0 >> 16) == item) {
+				*size = sz - (w2 & 0xffff);
+				return pos + 16 + (w2 >> 16);
+			}
+			pos += 16 + (w2 >> 16) + sz;
+		}
+		return 0;
+	}
+	return 0;
+}
+
+static void
+ms_crash_reason(void)
+{
+	/* qcom_smem_get(QCOM_SMEM_HOST_ANY, ...): the global partition */
+	uint32_t sz = 0, it = ms_smem_item(0xfffe, 0xfffe, MPSS_CRASH_REASON_ITEM, &sz);
+	if (!it || !sz) {
+		printf("SWEET MSS: no crash reason in SMEM (item %u)\n", MPSS_CRASH_REASON_ITEM);
+		return;
+	}
+	char msg[129];
+	uint32_t n = MIN(sz, 128u);
+	for (uint32_t k = 0; k < n; k += 4) {
+		uint32_t w = smem_u32(it + k);
+		memcpy(msg + k, &w, MIN(4u, n - k));
+	}
+	msg[n] = 0;
+	printf("SWEET MSS: modem crash reason: \"%s\"\n", msg);
+}
+
+/*
+ * step 13: watch the modem's SMP2P item for hold_s seconds (struct smp2p_smem_item: magic "$SMP",
+ * version, features, local/remote pid, total/valid entries, flags, then {char name[16]; u32 value}
+ * entries). Nothing here allocates the apps-side outbound item (428) or kicks the modem (Linux
+ * qcom_smp2p_alloc_outbound_item): if the modem waits for it, ready never shows. sdm845 mss: "fatal" = bit 0, "ready" = 1, "handover" = 2, "stop-ack" = 3 of "slave-kernel".
+ */
+static bool
+ms_mpss_watch(unsigned hold_s)
+{
+	uint32_t last[8];
+	bool seen = false, ready = false;
+	memset(last, 0xff, sizeof(last));
+	uint64_t t0 = ms_now_ms();
+	for (unsigned t = 0; t < hold_s * 10; t++) {
+		uint32_t sz = 0, it = ms_smem_item(0, 1, MPSS_SMP2P_IN_ITEM, &sz);
+		if (it && sz >= 20 && smem_u32(it) == 0x504d5324u) {
+			uint32_t w1 = smem_u32(it + 4), pids = smem_u32(it + 8), ents = smem_u32(it + 12);
+			if (!seen) {
+				printf("SWEET MSS: smp2p item %u at +%#x: version %u features %#x pid %u->%u entries %u/%u (%llu ms)\n",
+				    MPSS_SMP2P_IN_ITEM, it, w1 & 0xff, w1 >> 8, pids & 0xffff, pids >> 16, ents >> 16, ents & 0xffff,
+				    ms_now_ms() - t0);
+				seen = true;
+			}
+			uint32_t valid = MIN(ents >> 16, 8u);
+			for (uint32_t k = 0; k < valid && 20 + (k + 1) * 20 <= sz; k++) {
+				uint32_t e = it + 20 + k * 20;
+				char name[17];
+				for (uint32_t c = 0; c < 16; c += 4) {
+					uint32_t w = smem_u32(e + c);
+					memcpy(name + c, &w, 4);
+				}
+				name[16] = 0;
+				uint32_t v = smem_u32(e + 16);
+				if (v == last[k]) {
+					continue;
+				}
+				last[k] = v;
+				printf("SWEET MSS: smp2p in[%u] \"%s\" = %#x (%llu ms)\n", k, name, v, ms_now_ms() - t0);
+				if (strcmp(name, "slave-kernel") == 0) {
+					if ((v & 2u) && !ready) {
+						ready = true;
+						printf("SWEET MSS: MPSS READY\n");
+					}
+					if (v & 1u) {
+						printf("SWEET MSS: MPSS reported a fatal error\n");
+						ms_crash_reason();
+						sweet_log_sync();
+						return false;   /* crashed: not running, whatever came before */
+					}
+				}
+				sweet_log_sync();
+			}
+		}
+		wl_sleep(100);
+	}
+	if (!seen) {
+		printf("SWEET MSS: smp2p item %u never appeared in %u s\n", MPSS_SMP2P_IN_ITEM, hold_s);
+		wl_dump_smem();
+	}
+	return ready;
+}
+
+/* steps 9-13 */
+static bool
+ms_mpss(unsigned hold_s)
+{
+	bool ready = false;
+	if (!wl.smem) {
+		wl.smem = ml_io_map(WL_SMEM_PA, WL_SMEM_SIZE);
+	}
+	if (!ms_step(9, "read modem.mdt, build the metadata") || !ms_mdt_prepare()) {
+		goto done;
+	}
+	if (!ms_step(10, "metadata authentication (RMB META_DATA_READY)")) {
+		goto done;
+	}
+	wl_wr(ms.rmb, RMB_PMI_CODE_LENGTH, 0);  /* "Initialize the RMB validator" */
+	if (!ms_mdata_auth()) {
+		goto done;
+	}
+	if (!ms_step(11, "load the MPSS segments (RMB LOAD_READY, code length)") || !ms_mpss_segments()) {
+		goto done;
+	}
+	if (!ms_step(12, "MPSS to the modem, wait for AUTH_COMPLETE")) {
+		goto done;
+	}
+	if (!ms_xfer("mpss to modem", MSS_MPSS_PA, MSS_MPSS_SIZE, &ms.mpss_perm, false, true)) {
+		printf("SWEET MSS: assigning Q6 access to mpss memory failed\n");
+		goto done;
+	}
+	unsigned t;
+	int32_t st = ms_rmb_wait(RMB_MBA_AUTH_COMPLETE, 10000, &t);
+	printf("SWEET MSS: MPSS MBA status %d after %u ms (4 = authenticated, running)\n", st, t);
+	if (st != RMB_MBA_AUTH_COMPLETE) {
+		goto done;
+	}
+	printf("SWEET MSS: MPSS AUTHENTICATED\n");
+	if (!ms_step(13, "watch the modem's SMP2P entry for ready")) {
+		goto done;
+	}
+	ready = ms_mpss_watch(hold_s);
+	if (ready && ms.mba_assigned &&
+	    ms_assign("mba back", MSS_MBA_PA, MSS_MBA_SIZE, SCM_VMID_MSS_MSA, SCM_VMID_HLOS, SCM_PERM_RWX)) {
+		ms.mba_assigned = false;        /* q6v5_start() reclaims the MBA region once the modem is up */
+	}
+done:
 	sweet_log_sync();
+	return ready;
 }
 
