 extern "C" void sweet_bootlog_stop(void);     /* osfmk/console/video_console.c: the -v boot log stops at the first frame */
+
+/*
+ * Debug: boot-arg sweetbootlog_keep=1 (with -v) keeps the boot log on the screen for the whole session. The GUI's swaps
+ * are accepted and completed as usual, only never scanned out, so the console framebuffer the boot log draws into stays
+ * what the panel shows (watching an iOS bring-up whose GUI hangs or crash-loops).
+ */
+static bool
+sweet_bootlog_keep(void)
+{
+	static int keep = -1;
+	if (keep < 0) {
+		int v = 0;
+		keep = PE_parse_boot_argn("sweetbootlog_keep", &v, sizeof(v)) && v != 0;
+	}
+	return keep != 0;
+}
