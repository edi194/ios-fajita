+/* SERVICE_READY (ath10k_wmi_tlv_op_pull_svc_rdy_ev): ABI check, capabilities, service map, memory requests */
+static void
+wmi_service_ready(const uint8_t *t, uint32_t len)
+{
+	const uint8_t *ev = NULL, *reg = NULL, *bmap = NULL, *reqs = NULL;
+	uint16_t evl = 0, regl = 0, bmapl = 0, reqsl = 0;
+	for (uint32_t o = 0; o + 4 <= len;) {
+		uint16_t l, tag;
+		memcpy(&l, t + o, 2);
+		memcpy(&tag, t + o + 2, 2);
+		if (o + 4 + l > len) {
+			break;
+		}
+		const uint8_t *v = t + o + 4;
+		if (tag == WMI_TLV_SVC_READY_EV) {
+			ev = v;
+			evl = l;
+		} else if (tag == WMI_TLV_HAL_REG_CAPS) {
+			reg = v;
+			regl = l;
+		} else if (tag == WMI_TLV_ARRAY_UINT32 && !bmap) {
+			bmap = v;
+			bmapl = l;
+		} else if (tag == WMI_TLV_ARRAY_STRUCT) {
+			reqs = v;
+			reqsl = l;
+		}
+		o += 4 + l;
+	}
+	uint32_t e[22];
+	memset(e, 0, sizeof(e));
+	if (!ev || evl < 88 || !reg || regl < 36 || !bmap || !reqs) {
+		wf_fail("malformed WMI SERVICE_READY", 0);
+		return;
+	}
+	memcpy(e, ev, 88);                      /* fw_build_vers, abi[6], phy_cap, max_frag, rf_chains, ht, vht, vht_mcs,
+	                                         * min_tx, max_tx, sys_cap, min_pkt, max_bcn_ie, num_mem_reqs, max_scan_chans */
+	uint32_t rg[9];
+	memcpy(rg, reg, 36);
+	memset(wce.svc, 0, sizeof(wce.svc));
+	memcpy(wce.svc, bmap, MIN((uint32_t)bmapl, (uint32_t)sizeof(wce.svc)));
+	wce.svc_bytes = bmapl;
+	printf("SWEET IPC: wmi: service bitmap %u bytes: %08x %08x %08x %08x %08x %08x %08x %08x ...\n", bmapl, wce.svc[0],
+	    wce.svc[1], wce.svc[2], wce.svc[3], wce.svc[4], wce.svc[5], wce.svc[6], wce.svc[7]);
+	printf("SWEET IPC: wmi: SERVICE_READY fw_build %#x abi %#x/%u ns %#x %#x, phy_cap %#x, %u rf chains, ht_cap %#x "
+	    "vht_cap %#x, tx power %u..%u, %u memory requests; regdomain %#x, 2 GHz %u-%u, 5 GHz %u-%u\n", e[0], e[1], e[2],
+	    e[3], e[4], e[7], e[9], e[10], e[11], e[13], e[14], e[18], rg[0], rg[5], rg[6], rg[7], rg[8]);
+	ipc_note(" wmi svc-ready fw %#x phy %#x chains %u mem %u rd %#x;", e[0], e[7], e[9], e[18], rg[0]);
+	if (e[1] != 0x01000000u || e[3] != WMI_TLV_ABI_NS0 || e[4] != WMI_TLV_ABI_NS1 || e[5] || e[6]) {
+		wf_fail("WMI TLV ABI mismatch", 0);
+		return;
+	}
+	/* the memory requests: nested TLVs of struct wlan_host_mem_req {req_id, unit_size, num_unit_info, num_units} */
+	uint32_t off = WCE_HOSTMEM_OFF;
+	wce.nchunks = 0;
+	if (e[18] > 16) {                       /* WMI_MAX_MEM_REQS */
+		wf_fail("more than 16 memory requests", 0);
+		return;
+	}
+	for (uint32_t o = 0; o + 4 <= reqsl && wce.nchunks < 16;) {
+		uint16_t l, tag;
+		memcpy(&l, reqs + o, 2);
+		memcpy(&tag, reqs + o + 2, 2);
+		if (o + 4 + l > reqsl || tag != WMI_TLV_HOST_MEM_REQ || l < 16) {
+			wf_fail("malformed memory request", 0);
+			return;
+		}
+		uint32_t q[4];
+		memcpy(q, reqs + o + 4, 16);
+		uint32_t units = q[3], usize = (q[1] + 3) & ~3u;
+		if (q[2] & 4) {
+			units = 33 + 1;                 /* NUM_UNITS_IS_NUM_ACTIVE_PEERS, no active peers: max_num_peers + 1 */
+		} else if (q[2] & 2) {
+			units = 33 + 1;                 /* NUM_UNITS_IS_NUM_PEERS */
+		} else if (q[2] & 1) {
+			units = 4 + 1;                  /* NUM_UNITS_IS_NUM_VDEVS */
+		}
+		uint64_t sz = (uint64_t)units * usize;
+		printf("SWEET IPC: wmi: memory request %u: id %u, %u units of %u bytes (info %#x) = %llu bytes\n",
+		    wce.nchunks, q[0], units, q[1], q[2], sz);
+		if (sz == 0 || sz > WCE_POOL_LEN - off) {
+			wf_fail("memory request does not fit the pool", 0);
+			return;
+		}
+		wce.chunk[wce.nchunks].req_id = q[0];
+		wce.chunk[wce.nchunks].pa = WCE_POOL_PA + off;
+		wce.chunk[wce.nchunks].len = (uint32_t)sz;
+		wce.nchunks++;
+		off = (uint32_t)((off + sz + 0xfff) & ~0xfffull);
+		o += 4 + l;
+	}
+	if (wce.nchunks != e[18]) {
+		printf("SWEET IPC: wmi: %u memory requests parsed, the event says %u\n", wce.nchunks, e[18]);
+		wf_fail("memory request count mismatch", 0);
+		return;
+	}
+	wf.state = WS_WMI_SVC_READY;
+	wf.sent_ms = ms_now_ms();       /* SERVICE_AVAILABLE usually follows at once; INIT goes after it or 300 ms */
+}
