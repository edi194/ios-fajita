+static void
+wmi_connect(uint16_t svc)
+{
+	uint8_t m[8] = { 2, 0 };                        /* CONNECT_SERVICE: id, service, flags, pad */
+	uint16_t flags = svc == HTC_SVC_WMI_CONTROL ? (uint16_t)(1u << 8) : (uint16_t)(1u << 3);
+	memcpy(m + 2, &svc, 2);
+	memcpy(m + 4, &flags, 2);
+	wce.conn_svc = svc;
+	if (!wce_send(0, 0, m, sizeof(m))) {
+		wf_fail("HTC connect not sent", 0);
+		return;
+	}
+	wf.state = WS_HTC_CONNECT;
+	wf.sent_ms = ms_now_ms();
+}
+
+/*
+ * wmi_tlv_svc_map(): WMI_SERVICE_IS_ENABLED (service < len: word service / 4, bit service % 4, the legacy packing)
+ * or WMI_TLV_EXT_SERVICE_IS_ENABLED (len <= service < 256: word (service - len) / 32, bit (service - len) % 32), with
+ * len = the bitmap's TLV length in bytes, exactly as ath10k evaluates them.
+ */
+static bool
+wmi_svc_on(uint32_t id)
+{
+	uint32_t len = wce.svc_bytes, words = MIN(len / 4, 32u), w;
+	if (id < len) {
+		w = id / 4;
+		return w < words && ((wce.svc[w] >> (id % 4)) & 1);
+	}
+	if (id >= 256) {
+		return false;
+	}
+	w = (id - len) / 32;
+	return w < words && ((wce.svc[w] >> ((id - len) % 32)) & 1);
+}
