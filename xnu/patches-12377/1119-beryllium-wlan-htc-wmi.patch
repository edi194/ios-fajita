+/* WMI INIT (ath10k_wmi_tlv_op_gen_init) with the host memory chunks of the service-ready event */
+static void
+wmi_send_init(void)
+{
+	uint8_t c[4 + 4 + 28 + 4 + sizeof(struct wmi_rsrc_cfg) + 4 + 16 * 20];
+	uint32_t n = 0, cmd = 0x1, v;           /* WMI_TLV_INIT_CMDID, no platform bits */
+	uint16_t tl, tg;
+	memcpy(c, &cmd, 4);
+	n = 4;
+	tl = 28;
+	tg = WMI_TLV_INIT_CMD;
+	memcpy(c + n, &tl, 2);
+	memcpy(c + n + 2, &tg, 2);
+	uint32_t abi[7] = { 0x01000000u, 53, WMI_TLV_ABI_NS0, WMI_TLV_ABI_NS1, 0, 0, wce.nchunks };
+	memcpy(c + n + 4, abi, 28);
+	n += 4 + 28;
+	struct wmi_rsrc_cfg cfg;
+	memset(&cfg, 0, sizeof(cfg));
+	bool reorder = wmi_svc_on(65);          /* WMI_TLV_SERVICE_RX_FULL_REORDER */
+	cfg.num_vdevs = 4;                      /* TARGET_TLV_NUM_VDEVS */
+	cfg.num_peers = 33;                     /* hw_params num_peers TARGET_HL_TLV_NUM_PEERS */
+	cfg.ast_skid_limit = 16;
+	cfg.num_wds_entries = 2;
+	cfg.num_offload_peers = reorder ? 4 : 0;
+	cfg.num_offload_reorder_bufs = reorder ? 4 : 0;
+	cfg.num_peer_keys = 2;
+	cfg.num_tids = 33 * 2;
+	cfg.tx_chain_mask = 7;
+	cfg.rx_chain_mask = 7;
+	cfg.rx_timeout_pri[0] = 0x64;
+	cfg.rx_timeout_pri[1] = 0x64;
+	cfg.rx_timeout_pri[2] = 0x64;
+	cfg.rx_timeout_pri[3] = 0x28;
+	cfg.rx_decap_mode = 1;                  /* ATH10K_HW_TXRX_NATIVE_WIFI */
+	cfg.scan_max_pending_reqs = 4;
+	cfg.bmiss_offload_max_vdev = 4;
+	cfg.roam_offload_max_vdev = 4;
+	cfg.roam_offload_max_ap_profiles = 8;
+	cfg.tx_dbg_log_size = 0x400;
+	cfg.gtk_offload_max_vdev = 2;
+	cfg.num_msdu_desc = 1024 + 32;          /* TARGET_TLV_NUM_MSDU_DESC */
+	cfg.max_frag_entries = 2;
+	cfg.num_tdls_vdevs = 1;
+	cfg.num_tdls_conn_table_entries = 0x20;
+	cfg.beacon_tx_offload_max_vdev = 2;
+	cfg.num_multicast_filter_entries = 5;
+	cfg.num_wow_filters = 22;               /* TARGET_TLV_NUM_WOW_PATTERNS */
+	cfg.num_keep_alive_pattern = 6;
+	cfg.max_tdls_concurrent_sleep_sta = 1;
+	cfg.max_tdls_concurrent_buffer_sta = 1;
+	cfg.host_capab = 1u << 9;               /* WMI_TLV_FLAG_MGMT_BUNDLE_TX_COMPL */
+	if (wce.ack_rssi) {
+		cfg.host_capab |= 1u << 18;     /* WMI_RSRC_CFG_FLAG_TX_ACK_RSSI */
+	}
+	tl = sizeof(cfg);
+	tg = WMI_TLV_RESOURCE_CONFIG;
+	memcpy(c + n, &tl, 2);
+	memcpy(c + n + 2, &tg, 2);
+	memcpy(c + n + 4, &cfg, sizeof(cfg));
+	n += 4 + (uint32_t)sizeof(cfg);
+	tl = (uint16_t)(wce.nchunks * 20);
+	tg = WMI_TLV_ARRAY_STRUCT;
+	memcpy(c + n, &tl, 2);
+	memcpy(c + n + 2, &tg, 2);
+	n += 4;
+	for (unsigned k = 0; k < wce.nchunks; k++) {
+		uint32_t ch[4] = { wce.chunk[k].req_id, (uint32_t)wce.chunk[k].pa, wce.chunk[k].len,
+			           wce.ext_addr ? (uint32_t)(wce.chunk[k].pa >> 32) : 0 };
+		tl = 16;
+		tg = WMI_TLV_HOST_MEM_CHUNK;
+		memcpy(c + n, &tl, 2);
+		memcpy(c + n + 2, &tg, 2);
+		memcpy(c + n + 4, ch, 16);
+		n += 20;
+	}
+	v = n;
+	printf("SWEET IPC: wmi: INIT (%u bytes, %u memory chunks, rx reorder offload %s, tx ack rssi %s)\n", v,
+	    wce.nchunks, reorder ? "on" : "off", wce.ack_rssi ? "on" : "off");
+	if (!wce_send(1, wce.wmi_eid, c, n)) {
+		wf_fail("WMI INIT not sent", 0);
+		return;
+	}
+	wf.state = WS_WMI_INIT;
+	wf.sent_ms = ms_now_ms();
+}
