+/* HTC send (ath10k_htc_send + ath10k_ce_send_nolock_64 + the shadow write index): r = 0 for CE0, 1 for CE3 */
+static bool
+wce_send(unsigned r, uint8_t eid, const void *payload, uint32_t plen)
+{
+	if (!wce.rings || r > 1 || 8 + plen > CE_RX_BUF) {
+		return false;
+	}
+	uint32_t b = WCE_BASE(wce_ring[r].ce), mask = wce_ring[r].n - 1, wr = wce.wr[r];
+	uint32_t srri = wl_rd(wce.regs, b + CE_CURRENT_SRRI) & mask;
+	if (((srri - 1 - wr) & mask) == 0) {
+		printf("SWEET IPC: wmi: CE%u source ring full\n", wce_ring[r].ce);
+		return false;
+	}
+	uint8_t *buf = (uint8_t *)(wce.pool + wce_ring[r].bufs + (uint64_t)wr * CE_RX_BUF);
+	uint16_t l = (uint16_t)plen;
+	buf[0] = eid;
+	buf[1] = eid != 0 && eid == wce.wmi_eid ? 1 : 0;   /* NEED_CREDIT_UPDATE on the credit-flow endpoint */
+	memcpy(buf + 2, &l, 2);
+	buf[4] = 0;
+	buf[5] = wce.seq[eid & 7]++;
+	buf[6] = 0;
+	buf[7] = 0;
+	memcpy(buf + 8, payload, plen);
+	struct wce_desc *d = wce_desc(r, wr);
+	d->addr = (WCE_POOL_PA + wce_ring[r].bufs + (uint64_t)wr * CE_RX_BUF) & 0x7ffffffffull;
+	d->nbytes = (uint16_t)(8 + plen);
+	d->flags = (uint16_t)(((uint32_t)eid << 4) & 0xfff0);  /* transfer id = endpoint (CE_DESC_FLAGS_META_DATA) */
+	d->hash = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr = (wr + 1) & mask;
+	wce.wr[r] = wr;
+	wl_wr(wce.regs, wce_ring[r].ce == 0 ? 0x32000u : 0x3200cu, wr);
+	return true;
+}
