+/* qca_tlv_check_data(), TLV_TYPE_PATCH: log the header, return download_mode */
+static bool
+wl_qca_patch_check(const uint8_t *fw, size_t size, unsigned *mode)
+{
+	if (size < 28) {
+		printf("SWEET WLAN: BT fw patch: only %u bytes\n", (unsigned)size);
+		return false;
+	}
+	uint32_t type_len = le32(fw);
+	if ((type_len & 0xff) != QCA_TLV_TYPE_PATCH) {
+		printf("SWEET WLAN: BT fw patch: TLV type %#x is not a patch (1)\n", type_len & 0xff);
+		return false;
+	}
+	/* tlv_type_hdr {type_len} + tlv_type_patch {total_size, data_length, format_version, signature,
+	 * download_mode, reserved1, product_id, rom_build, patch_version, reserved2, entry} */
+	printf("SWEET WLAN: BT fw patch: TLV type %u length %u (file %u), total_size %u, data_length %u, "
+	    "format %u, signature %u, download_mode %u, product %#06x, rom_build %#06x, patch_version %#06x, "
+	    "entry %#x\n", type_len & 0xff, type_len >> 8, (unsigned)size, le32(fw + 4), le32(fw + 8), fw[12], fw[13], fw[14],
+	    le16(fw + 16), le16(fw + 18), le16(fw + 20), le32(fw + 24));
+	if ((type_len >> 8) != size - 4) {
+		printf("SWEET WLAN: BT fw patch: note: TLV length %u != file size - 4\n", type_len >> 8);
+	}
+	*mode = fw[14] <= 3 ? fw[14] : 0;
+	return true;
+}
