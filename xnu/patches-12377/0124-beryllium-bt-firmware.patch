+/*
+ * qca_tlv_check_data(), TLV_TYPE_NVM: HCI transport tag (17): data[0] |= 0x80
+ * (software in-band sleep), data[1] = UART baud rate code (WCN399x); deep sleep
+ * tag (27): data[0] |= 0x01. Linux enables both because it runs IBS; this stage
+ * has no IBS (a sleeping controller would need the 0xfd/0xfc/0xfe protocol), so
+ * unless sweetbtibs=1 the two bits are cleared instead.
+ */
+static bool
+wl_qca_nvm_edit(uint8_t *fw, size_t size, int baud_code)
+{
+	if (size < 16) {
+		printf("SWEET WLAN: BT fw NVM: only %u bytes\n", (unsigned)size);
+		return false;
+	}
+	uint32_t type_len = le32(fw);
+	size_t limit = MIN(size, (size_t)4 + (type_len >> 8));
+	printf("SWEET WLAN: BT fw NVM: TLV type %u length %u (file %u)\n", type_len & 0xff, type_len >> 8, (unsigned)size);
+	struct wl_nvm_scan a, b;
+	wl_nvm_scan_at(fw, limit, 4, &a);       /* Linux: tlv->data */
+	wl_nvm_scan_at(fw, limit, 8, &b);       /* some images carry one more header word */
+	const struct wl_nvm_scan *s = b.ntags > a.ntags ? &b : &a;
+	if (s->start != 4) {
+		printf("SWEET WLAN: BT fw NVM: tags start at offset %u (extra header word %#010x), not at 4 as "
+		    "in Linux's struct tlv_type_hdr\n", s->start, le32(fw + 4));
+	}
+	printf("SWEET WLAN: BT fw NVM: %u tags from offset %u, stopped at %u (tag id %#x); HCI tag 17 at %u, "
+	    "deep sleep tag 27 at %u\n", s->ntags, s->start, s->stop_idx, s->stop_tag, s->idx17, s->idx27);
+	if (s->ntags < 3) {
+		printf("SWEET WLAN: BT fw NVM: tag layout not recognised, NVM sent unmodified\n");
+		return true;
+	}
+	if (s->idx17 && le16(fw + s->idx17 + 2) >= 2) {
+		uint8_t *t = fw + s->idx17 + 12;
+		uint8_t old0 = t[0], old1 = t[1];
+		t[0] = wl.bt_ibs ? (t[0] | 0x80) : (t[0] & ~0x80);
+		t[1] = (uint8_t)baud_code;
+		printf("SWEET WLAN: BT fw NVM: HCI tag: data[0] %#04x -> %#04x (IBS %s), data[1] (baud) %#04x -> %#04x\n",
+		    old0, t[0], wl.bt_ibs ? "on" : "off", old1, t[1]);
+	} else {
+		printf("SWEET WLAN: BT fw NVM: no HCI tag 17, baud not patched\n");
+	}
+	if (s->idx27 && le16(fw + s->idx27 + 2) >= 1) {
+		uint8_t *t = fw + s->idx27 + 12;
+		uint8_t old0 = t[0];
+		t[0] = wl.bt_ibs ? (t[0] | 0x01) : (t[0] & ~0x01);
+		printf("SWEET WLAN: BT fw NVM: deep sleep tag: data[0] %#04x -> %#04x (deep sleep %s)\n", old0, t[0],
+		    wl.bt_ibs ? "on" : "off");
+	} else {
+		printf("SWEET WLAN: BT fw NVM: no deep sleep tag 27\n");
+	}
+	return true;
+}
