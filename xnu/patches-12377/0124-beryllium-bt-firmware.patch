+/* One HCI command; prints and returns the first matching event in rsp. */
+static int
+wl_hci_cmd(uint16_t opcode, const uint8_t *params, unsigned plen, uint8_t *rsp, unsigned *rlen,
+    unsigned timeout_ms)
+{
+	wl.rxn = 0;
+	if (!wl_hci_send(opcode, params, plen)) {
+		return EIO;
+	}
+	return wl_hci_wait(opcode, WL_EVT_CC | ((opcode >> 10) == 0x3f ? WL_EVT_VSE : 0), rsp, rlen,
+	    timeout_ms);
+}
+
+/* consume every complete event already queued; false when one reports an error */
+static bool
+wl_evt_drain(const char *ctx)
+{
+	bool ok = true;
+	unsigned pos = 0;
+	wl_rx_poll();
+	while (pos < wl.rxn) {
+		if (wl.rxq[pos] != 0x04) {
+			pos++;
+			continue;
+		}
+		if (pos + 3 > wl.rxn) {
+			break;
+		}
+		unsigned elen = wl.rxq[pos + 2];
+		if (pos + 3 + elen > wl.rxn) {
+			break;
+		}
+		uint8_t evt = wl.rxq[pos + 1];
+		const uint8_t *d = &wl.rxq[pos + 3];
+		if (evt == 0x0e && elen >= 4) {
+			if (d[3] != 0) {
+				printf("SWEET WLAN: BT fw %s: Command Complete for %#06x status %#x\n", ctx,
+				    d[1] | (d[2] << 8), d[3]);
+				ok = false;
+			} else {
+				wl.ev_cc++;
+			}
+		} else if (evt == 0xff && elen >= 3 && d[0] == 0 && d[1] == 4 && d[2] != 0) {
+			printf("SWEET WLAN: BT fw %s: TLV download vendor event status %#x\n", ctx, d[2]);
+			ok = false;
+		} else {
+			wl.ev_other++;
+			if (wl.ev_other <= 8) {
+				wl_print_hex("BT fw event during download", &wl.rxq[pos], 3 + elen);
+			}
+		}
+		pos += 3 + elen;
+	}
+	wl_rxq_drop(pos);
+	return ok;
+}
