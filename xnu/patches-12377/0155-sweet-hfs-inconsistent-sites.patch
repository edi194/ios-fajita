@@ -904,6 +904,14 @@ typedef enum {
 
 void hfs_mark_inconsistent(struct hfsmount *hfsmp,
 						   hfs_inconsistency_reason_t reason);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* 0155: report which call site flags the volume corrupt (file:line, pid, reason) */
+#define hfs_mark_inconsistent(h, r) ({ \
+	printf("SWEET HFSINC %s:%d pid %d reason %d\n", __FILE__, __LINE__, proc_selfpid(), (int)(r)); \
+	hfs_mark_inconsistent((h), (r)); \
+})
+#endif
