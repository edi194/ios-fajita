 #include <IOKit/IOLocks.h>
 #include "sweet_spmi.h"
+#include "sweet_board.h"
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 
@@ -86,11 +87,22 @@ sweet_spmi_init(void)
 int
 sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 {
-	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	/*
+	 * Restrict access to the battery blocks; keys retain their own lanes.
+	 * sweet: PM6150 (SID 0) charger 0x10-0x13 and QG 0x48. Poco F1: PMI8998
+	 * (SID 2) SMB2 charger CHGR 0x10 / USBIN 0x13 and FG gen3 BATT_SOC 0x40 /
