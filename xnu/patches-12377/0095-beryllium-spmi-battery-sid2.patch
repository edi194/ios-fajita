+	bool allowed;
+	if (sweet_board_beryllium()) {
+		allowed = sid == 2 && (peripheral == 0x10 || peripheral == 0x13 ||
+		    peripheral == 0x40 || peripheral == 0x41);
+	} else {
+		allowed = sid == 0 && (peripheral == 0x10 || peripheral == 0x11 ||
+		    peripheral == 0x12 || peripheral == 0x13 || peripheral == 0x48);
+	}
+	if (!sp_ready || !out || addr > 0xffffu || !allowed) {
 		return -1;
 	}
