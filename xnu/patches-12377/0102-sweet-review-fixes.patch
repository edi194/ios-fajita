@@ -41,6 +41,7 @@
 #include <libkern/libkern.h>
 #include <machine/atomic.h>
 
+#include "sweet_board.h"
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 /* osfmk/arm/machine_routines.h, not exported to the BSD layer */
 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
@@ -111,6 +112,7 @@ static struct {
 	bool writable;                          /* boot-arg ufsrw=1 */
 	bool cache;                             /* boot-arg ufscache=1 */
 	bool wait;                              /* boot-arg ufswait=1 */
+	bool dmasync;                           /* boot-arg ufsdmasync=1: real cache maintenance */
 	int bmajor, cmajor;
 	dev_t bdev;
 	bool ready;
@@ -131,15 +133,26 @@ ufs_wr(uint32_t off, uint32_t v)
 	*(volatile uint32_t *)(su.regs + off) = v;
 }
 
+/*
+ * flush_dcache64()/clean_dcache64() are a bare dsb under __ARM_COHERENT_IO__.
+ * The UFS root works with that today (the host evidently snoops), so the
+ * real clean+invalidate by VA (sweet_dma_sync_va) is opt-in: ufsdmasync=1.
+ */
 static void
 dma_sync(uint32_t off, uint32_t len)
 {
+	if (su.dmasync) {
+		sweet_dma_sync_va((const void *)(su.dma + off), len);
+	}
 	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
 }
 
 static void
 dma_clean(uint32_t off, uint32_t len)
 {
+	if (su.dmasync) {
+		sweet_dma_sync_va((const void *)(su.dma + off), len);
+	}
 	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
 }
 
@@ -608,6 +621,9 @@ sweet_ufs_init(void)
 	PE_parse_boot_argn("ufswait", &wait, sizeof(wait));
 	su.cache = (cache == 1);
 	su.wait = (wait == 1);
+	uint32_t dmasync = 0;
+	PE_parse_boot_argn("ufsdmasync", &dmasync, sizeof(dmasync));
+	su.dmasync = (dmasync == 1);
 
 	printf("SWEET UFS: init, regs 0x%lx+0x%lx\n", (unsigned long)reg[0], (unsigned long)reg[1]);
 	su.regs = ml_io_map(reg[0], reg[1]);
