-		sweet_priv_logged_count++;
-		printf("SWEET Sandbox: %s privilege %d denied\n", name, priv);
+	if (seen < SWEET_PRIV_LOG_MAX) {
+		int slot = os_atomic_inc_orig(&sweet_priv_logged_count, relaxed);
+		if (slot < SWEET_PRIV_LOG_MAX) {
+			sweet_priv_logged[slot].priv = priv;
+			strlcpy(sweet_priv_logged[slot].name, name, sizeof(name));
+			printf("SWEET Sandbox: %s privilege %d denied\n", name, priv);
+		}
 	}
 	return EPERM;
