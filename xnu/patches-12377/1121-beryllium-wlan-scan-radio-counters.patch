+
+/*
+ * CHAN_INFO (0x4002, tag 38: err_code, freq, cmd_flags (bit 0 COMPLETE, bit 1 PRE_COMPLETE), noise_floor,
+ * rx_clear_count, cycle_count, chan_tx_pwr_range, chan_tx_pwr_tp, rx_frame_count, my_bss_rx_cycle_count,
+ * rx_11b_mode_data_duration, tx_frame_cnt, mac_clk_mhz): the radio's own counters for each channel visit. A
+ * non-zero rx_frame_count with a sane noise floor means the RF hears frames that never reach the host.
+ */
+static void
+scan_chan_info(const uint8_t *t, uint32_t len)
+{
+	uint16_t tl, tag;
+	if (len < 4 + 52) {
+		return;
+	}
+	memcpy(&tl, t, 2);
+	memcpy(&tag, t + 2, 2);
+	if (tag != 38 || tl < 52) {
+		return;
+	}
+	uint32_t c[13];
+	memcpy(c, t + 4, 52);
+	scan.chan_infos++;
+	if (c[2] & 1) {                         /* COMPLETE: counters for the visit that just ended */
+		scan.rx_frames += c[8];
+		scan.tx_frames += c[11];
+		for (unsigned k = 0; k < SCAN_NCHAN; k++) {
+			if (scan_chans[k] == c[1]) {
+				scan.ch[k].mhz = c[1];
+				scan.ch[k].rx_frames = c[8];
+				scan.ch[k].nf = c[3];
+				scan.ch[k].rx_clear = c[4];
+				scan.ch[k].cycles = c[5];
+			}
+		}
+	}
+	if (scan.chan_logged < 64) {
+		scan.chan_logged++;
+		printf("SWEET IPC: scan: chan_info %u MHz flags %#x err %u nf %d rx_clear %u cycles %u rx_frames %u tx_frames %u "
+		    "my_bss_cycles %u mac_clk %u MHz\n", c[1], c[2], c[0], (int32_t)c[3], c[4], c[5], c[8], c[11], c[9], c[12]);
+	}
 }
 
+static void
+scan_tally(uint32_t id)
+{
+	for (unsigned k = 0; k < scan.nev; k++) {
+		if (scan.ev[k].id == id) {
+			scan.ev[k].n++;
+			return;
+		}
+	}
+	if (scan.nev < 24) {
+		scan.ev[scan.nev].id = id;
+		scan.ev[scan.nev].n = 1;
+		scan.nev++;
+	}
+}
