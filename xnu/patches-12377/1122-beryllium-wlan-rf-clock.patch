+/*
+ * WCN3990 reference clock (beryllium &wifi clocks = <&rpmhcc RPMH_RF_CLK2>, "cxo_ref_clk_pin"): clk-rpmh.c
+ * DEFINE_CLK_RPMH_VRM(rf_clk2, _a, "rfclka2", 1) votes value 1 at the cmd-db address + CLK_RPMH_VRM_EN_OFFSET (4).
+ * Active-set vote only, like the rail votes; never voted off. Only "rfclka2" is accepted.
+ */
+int
+sweet_rpmh_rfclk_enable(const char *res)
+{
+	if (!sweet_board_beryllium() || !res || strcmp(res, "rfclka2")) {
+		printf("SWEET RPMH: %s is not an allowed RF clock\n", res ? res : "(null)");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		const uint32_t a[1] = { address + 4 }, v[1] = { 1 };
+		printf("SWEET RPMH: RF clock %s enable at %#x\n", res, address + 4);
+		error = rh_cmds(a, v, 1);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: RF clock %s enable failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
