+/*
+ * ---- W5 (sweetrmtfs=1): rmtfs for the running MPSS, docs/WIFI_IOS26.md 5.12. The modem reaches rmtfs as
+ * QMI service 14 over QRTR, which runs on the GLINK channel "IPCRTR" over SMEM, so this is four layers:
+ * the rmtfs buffer (rmtfs_mem.c), the GLINK SMEM transport (qcom_glink_smem.c + qcom_glink_native.c),
+ * QRTR (af_qrtr.c + ns.c) and the rmtfs server (linux-msm/rmtfs). Everything is polled from the stage-4
+ * thread; nothing takes the GLINK/SMP2P interrupts. EFS partitions are only read: writes land in a RAM
+ * copy of the partition (rmtfs -o), so the modem reads back what it wrote and storage is never touched.
+ */
+#define RMTFS_MEM_PA            0xf6301000ull   /* beryllium rmtfs_mem (sdm845-xiaomi-beryllium-common.dtsi) */
+#define RMTFS_MEM_SIZE          0x200000u
+#define GLINK_DESC_ITEM         478u            /* SMEM_GLINK_NATIVE_XPRT_DESCRIPTOR */
+#define GLINK_TX_ITEM           479u            /* XPRT_FIFO_0: ours */
+#define GLINK_RX_ITEM           480u            /* XPRT_FIFO_1: the modem's */
+#define GLINK_TX_SIZE           0x4000u
+#define GLINK_DOORBELL          12u             /* modem glink-edge mboxes = <&apss_shared 12> */
+#define GLINK_FEATURE_REUSE     1u              /* GLINK_FEATURE_INTENT_REUSE */
+#define GLINK_LCID              1u              /* our id for IPCRTR (idr_alloc_cyclic from 1) */
+#define GLINK_TX_MAX            0x2000u         /* one chunk (SZ_8K) */
+#define QRTR_NODE_LOCAL         1u              /* qrtr_local_nid */
+#define QRTR_PORT_CTRL          0xfffffffeu
+#define QRTR_RMTFS_PORT         0x4000u
+#define RMTFS_SERVICE           14u
+#define RMTFS_INSTANCE          1u              /* qrtr_publish: instance << 8 | version 1 */
+#define IPC_INTENTS             5u              /* qcom_glink_announce_create default: 5 x SZ_1K */
+#define IPC_INTENT_SIZE         1024u
+#define IPC_MAX_INTENTS         16u             /* ours */
+#define IPC_MAX_RINTENTS        64u             /* the modem's */
+#define IPC_TXQ                 16u
+#define RMTFS_SECTOR            512u
+
+enum { G_VERSION = 0, G_VERSION_ACK = 1, G_OPEN = 2, G_CLOSE = 3, G_OPEN_ACK = 4, G_INTENT = 5, G_RX_DONE = 6,
+       G_RX_INTENT_REQ = 7, G_RX_INTENT_REQ_ACK = 8, G_TX_DATA = 9, G_CLOSE_ACK = 11, G_TX_DATA_CONT = 12,
+       G_READ_NOTIF = 13, G_RX_DONE_W_REUSE = 14, G_SIGNALS = 15 };
+enum { Q_DATA = 1, Q_HELLO = 2, Q_BYE = 3, Q_NEW_SERVER = 4, Q_DEL_SERVER = 5, Q_DEL_CLIENT = 6, Q_RESUME_TX = 7 };
+
+struct ipc_lintent {
+	uint32_t id, size, off;
+	uint8_t *buf;
+	bool reuse, bad;
+};
+struct ipc_rintent {
+	uint32_t id, size;
+	bool valid, used;
+};
+static const struct {
+	const char *path, *part;
+} ipc_parts[4] = {
+	{ "/boot/modem_fs1", "modemst1" }, { "/boot/modem_fs2", "modemst2" },
+	{ "/boot/modem_fsc", "fsc" }, { "/boot/modem_fsg", "fsg" },
+};
+static struct {
+	uint32_t desc, tx, tx_len, rx, rx_len;  /* SMEM offsets; rx 0 until the modem's FIFO exists */
+	uint32_t features;
+	bool version_acked, bad_rx, closed;
+	uint32_t rcid;                  /* the modem's id for IPCRTR, 0 = not opened yet */
+	bool open_acked, intents_sent;
+	struct ipc_lintent li[IPC_MAX_INTENTS];
+	struct ipc_rintent ri[IPC_MAX_RINTENTS];
+	struct {
+		uint32_t len;
+		uint8_t data[32 + 1024];
+	} txq[IPC_TXQ];                 /* QRTR packets waiting for a modem intent */
+	unsigned txq_n;
+	bool intent_asked;
+	uint32_t next_liid;
+	uint32_t node;                  /* the modem's QRTR node, learned from its packets */
+	bool hello_seen, announced;
+	uint64_t open_ms;
+	vm_offset_t win;                /* kernel window over the rmtfs buffer */
+	uint64_t win_base, win_len;
+	uint32_t rmtfs_perm;
+	uint8_t *shadow[4];
+	uint64_t part_bytes[4];
+	unsigned rx_pkts, tx_pkts, reads, writes, iovec_logged;
+	uint64_t read_bytes, write_bytes;
+} ipc;
+
+/* ---- GLINK SMEM pipes: descriptor words tx tail @0, tx head @4, rx tail @8, rx head @12 */
+static void
+ipc_kick(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wl_wr(ms.ipc, 12, 1u << GLINK_DOORBELL);
+}
+
+static uint32_t
+ipc_rx_avail(void)
+{
+	if (!ipc.rx) {
+		uint32_t sz = 0, it = ms_smem_item(0, 1, GLINK_RX_ITEM, &sz);
+		if (!it || sz < 64 || (sz & 7)) {
+			return 0;
+		}
+		ipc.rx = it;
+		ipc.rx_len = sz;
+		printf("SWEET IPC: modem's GLINK FIFO (item %u) at +%#x, %u bytes\n", GLINK_RX_ITEM, it, sz);
+	}
+	uint32_t head = smem_u32(ipc.desc + 12), tail = smem_u32(ipc.desc + 8);
+	if (head >= ipc.rx_len || tail >= ipc.rx_len) {
+		return 0;
+	}
+	return head >= tail ? head - tail : ipc.rx_len - tail + head;
+}
+
+/* glink_smem_rx_peek(): byte copy out of the ring through 32-bit device reads */
+static void
+ipc_rx_peek(uint32_t offset, void *dst, uint32_t count)
+{
+	uint8_t *d = dst;
+	uint32_t pos = smem_u32(ipc.desc + 8) + offset;
+	while (count) {
+		while (pos >= ipc.rx_len) {
+			pos -= ipc.rx_len;
+		}
+		uint32_t w = smem_u32(ipc.rx + (pos & ~3u)), b = pos & 3u, n = MIN(4u - b, count);
+		memcpy(d, (uint8_t *)&w + b, n);
+		d += n;
+		count -= n;
+		pos += n;
+	}
+}
+
+static void
+ipc_rx_advance(uint32_t count)
+{
+	uint32_t tail = smem_u32(ipc.desc + 8) + count;
+	while (tail >= ipc.rx_len) {
+		tail -= ipc.rx_len;
+	}
+	wl_wr(wl.smem, ipc.desc + 8, tail);
+}
+
+/* glink_smem_tx_avail(): FIFO_FULL_RESERVE + TX_BLOCKED_CMD_RESERVE = 16 bytes kept free */
+static uint32_t
+ipc_tx_avail(void)
+{
+	uint32_t head = smem_u32(ipc.desc + 4), tail = smem_u32(ipc.desc + 0);
+	uint32_t avail = tail <= head ? ipc.tx_len - head + tail : tail - head;
+	return avail < 16 ? 0 : avail - 16;
+}
+
+/* qcom_glink_tx() + glink_smem_tx_write(): header and data back to back, head aligned to 8, then the doorbell */
+static bool
+ipc_tx(const void *hdr, uint32_t hlen, const void *data, uint32_t dlen)
+{
+	static uint8_t buf[GLINK_TX_MAX + 64];
+	uint32_t tlen = hlen + dlen, total = (tlen + 7u) & ~7u;
+	if (total > sizeof(buf) || tlen >= ipc.tx_len) {
+		return false;
+	}
+	for (unsigned i = 0; ipc_tx_avail() < tlen; i++) {
+		if (i == 1000) {
+			printf("SWEET IPC: GLINK TX FIFO full for 1 s (head %#x tail %#x)\n", smem_u32(ipc.desc + 4),
+			    smem_u32(ipc.desc + 0));
+			return false;
+		}
+		wl_sleep(1);
+	}
+	memcpy(buf, hdr, hlen);
+	if (dlen) {
+		memcpy(buf + hlen, data, dlen);
+	}
+	bzero(buf + tlen, total - tlen);
+	uint32_t head = smem_u32(ipc.desc + 4);
+	for (uint32_t i = 0; i < total; i += 4) {       /* head and the ring size are 8-aligned: no word wraps */
+		uint32_t w, p = head + i;
+		memcpy(&w, buf + i, 4);
+		if (p >= ipc.tx_len) {
+			p -= ipc.tx_len;
+		}
+		wl_wr(wl.smem, ipc.tx + p, w);
+	}
+	head += total;
+	if (head >= ipc.tx_len) {
+		head -= ipc.tx_len;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wl_wr(wl.smem, ipc.desc + 4, head);
+	ipc_kick();
+	return true;
+}
+
+static bool
+ipc_tx_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint8_t m[8];
+	memcpy(m, &cmd, 2);
+	memcpy(m + 2, &p1, 2);
+	memcpy(m + 4, &p2, 4);
+	return ipc_tx(m, 8, NULL, 0);
+}
+
+/* qcom_glink_alloc_intent() + qcom_glink_advertise_intent() */
+static bool
+ipc_add_intent(uint32_t size, bool reuse)
+{
+	for (unsigned k = 0; k < IPC_MAX_INTENTS; k++) {
+		struct ipc_lintent *in = &ipc.li[k];
+		if (in->buf) {
+			continue;
+		}
+		in->buf = kalloc_data(size, Z_WAITOK | Z_ZERO);
+		if (!in->buf) {
+			return false;
+		}
+		in->id = ++ipc.next_liid;
+		in->size = size;
+		in->off = 0;
+		in->reuse = reuse;
+		uint8_t c[16];
+		uint16_t id = G_INTENT, lcid = GLINK_LCID;
+		uint32_t one = 1;
+		memcpy(c, &id, 2);
+		memcpy(c + 2, &lcid, 2);
+		memcpy(c + 4, &one, 4);
+		memcpy(c + 8, &size, 4);
+		memcpy(c + 12, &in->id, 4);
+		return ipc_tx(c, 16, NULL, 0);
+	}
+	return false;
+}
+
+static void
+ipc_send_open(void)
+{
+	/* qcom_glink_create_remote(): open-ack for the modem's id, then our own open of the same name */
+	struct {
+		uint16_t cmd, lcid;
+		uint32_t len;
+		char name[8];
+	} __attribute__((packed)) req = { G_OPEN, GLINK_LCID, 7, "IPCRTR" };
+	(void)ipc_tx_cmd(G_OPEN_ACK, (uint16_t)ipc.rcid, 0);
+	(void)ipc_tx(&req, (uint32_t)sizeof(req), NULL, 0);
+}
+
+static void ipc_qrtr_rx(const uint8_t *p, uint32_t len);
+
+/* qcom_glink_native_rx() + qcom_glink_work(); only ever called from the service loop (no nesting) */
+static void
+ipc_rx_poll(void)
+{
+	for (unsigned guard = 0; guard < 64 && !ipc.bad_rx; guard++) {
+		uint32_t avail = ipc_rx_avail();
+		if (avail < 8) {
+			return;
+		}
+		uint8_t m[16];
+		ipc_rx_peek(0, m, 8);
+		uint16_t cmd, p1;
+		uint32_t p2;
+		memcpy(&cmd, m, 2);
+		memcpy(&p1, m + 2, 2);
+		memcpy(&p2, m + 4, 4);
+		switch (cmd) {
+		case G_VERSION:
+			ipc_rx_advance(8);
+			if (p1 == 1) {
+				ipc.features &= p2;
+			}
+			printf("SWEET IPC: glink version %u features %#x from the modem -> ack with %#x\n", p1, p2,
+			    ipc.features);
+			if (p1 != 0) {
+				(void)ipc_tx_cmd(G_VERSION_ACK, 1, ipc.features);
+			}
+			break;
+		case G_VERSION_ACK:
+			ipc_rx_advance(8);
+			printf("SWEET IPC: glink version-ack %u features %#x\n", p1, p2);
+			if (p1 == 1 && p2 != ipc.features) {
+				ipc.features &= p2;
+				(void)ipc_tx_cmd(G_VERSION, 1, ipc.features);
+			} else if (p1 == 1) {
+				ipc.version_acked = true;
+			}
+			break;
+		case G_OPEN: {
+			uint32_t extra = (p2 + 7u) & ~7u;
+			char name[33];
+			if (avail < 8 + extra) {
+				return;
+			}
+			memset(name, 0, sizeof(name));
+			ipc_rx_peek(8, name, MIN(p2, 32u));
+			ipc_rx_advance(8 + extra);
+			printf("SWEET IPC: glink: modem opens \"%s\" (its id %u)\n", name, p1);
+			if (strcmp(name, "IPCRTR") == 0 && !ipc.rcid) {
+				ipc.rcid = p1;
+				ipc_send_open();
+			}
+			break;
+		}
+		case G_OPEN_ACK:
+			ipc_rx_advance(8);
+			if (p1 == GLINK_LCID && !ipc.open_acked) {
+				ipc.open_acked = true;
+				ipc.open_ms = ms_now_ms();
+				printf("SWEET IPC: glink IPCRTR open both ways; advertising %u x %u-byte intents\n", IPC_INTENTS,
+				    IPC_INTENT_SIZE);
+				for (unsigned k = 0; k < IPC_INTENTS; k++) {
+					(void)ipc_add_intent(IPC_INTENT_SIZE, true);
+				}
+				ipc.intents_sent = true;
+			}
+			break;
+		case G_CLOSE:
+			ipc_rx_advance(8);
+			printf("SWEET IPC: glink: modem closes its id %u\n", p1);
+			(void)ipc_tx_cmd(G_CLOSE_ACK, p1, 0);
+			if (p1 == ipc.rcid) {
+				ipc.closed = true;
+			}
+			break;
+		case G_INTENT: {
+			uint32_t msglen = 8 + 8 * p2;
+			if (p2 > 64 || avail < msglen) {
+				return;
+			}
+			for (uint32_t k = 0; k < p2; k++) {
+				uint32_t pair[2];
+				ipc_rx_peek(8 + 8 * k, pair, 8);
+				unsigned j;
+				for (j = 0; j < IPC_MAX_RINTENTS; j++) {
+					if (!ipc.ri[j].valid) {
+						ipc.ri[j] = (struct ipc_rintent){ pair[1], pair[0], true, false };
+						break;
+					}
+				}
+				if (j == IPC_MAX_RINTENTS) {
+					printf("SWEET IPC: glink: modem intent %u (%u bytes) not kept: table full\n", pair[1], pair[0]);
+				}
+			}
+			ipc_rx_advance((msglen + 7u) & ~7u);
+			break;
+		}
+		case G_RX_DONE:
+		case G_RX_DONE_W_REUSE:
+			ipc_rx_advance(8);
+			for (unsigned j = 0; j < IPC_MAX_RINTENTS; j++) {
+				if (ipc.ri[j].valid && ipc.ri[j].id == p2) {
+					ipc.ri[j].used = false;
+					if (cmd == G_RX_DONE) {
+						ipc.ri[j].valid = false;
+					}
+				}
+			}
