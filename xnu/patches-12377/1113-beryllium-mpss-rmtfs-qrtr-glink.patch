+/* ---- rmtfs QMI (qmi_rmtfs.qmi): 7-byte header {u8 type, u16 txn, u16 msg, u16 len}, then TLVs */
+static const uint8_t *
+qmi_tlv(const uint8_t *p, uint32_t len, uint8_t type, uint16_t *tlen)
+{
+	for (uint32_t o = 0; o + 3 <= len;) {
+		uint16_t l;
+		memcpy(&l, p + o + 1, 2);
+		if (o + 3 + l > len) {
+			return NULL;
+		}
+		if (p[o] == type) {
+			*tlen = l;
+			return p + o + 3;
+		}
+		o += 3 + l;
+	}
+	return NULL;
+}
+
+static uint32_t
+qmi_u32(const uint8_t *p, uint32_t len, uint8_t type, bool *ok)
+{
+	uint16_t l = 0;
+	const uint8_t *v = qmi_tlv(p, len, type, &l);
+	uint32_t x = 0;
+	if (!v || l < 4) {
+		*ok = false;
+		return 0;
+	}
+	memcpy(&x, v, 4);
+	return x;
+}
+
+static void
+rmtfs_respond(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, bool ok, uint8_t opt_type, const void *opt,
+    uint16_t opt_len)
+{
+	uint8_t r[64];
+	uint16_t n = 0, res = ok ? 0 : 1, err = ok ? 0 : 1, four = 4;
+	r[0] = 2;                       /* QMI_RESPONSE */
+	memcpy(r + 1, &txn, 2);
+	memcpy(r + 3, &msg, 2);
+	n = 7;
+	r[n] = 2;                       /* TLV 2: qmi_result {u16 result, u16 error} */
+	memcpy(r + n + 1, &four, 2);
+	memcpy(r + n + 3, &res, 2);
+	memcpy(r + n + 5, &err, 2);
+	n += 7;
+	if (ok && opt && opt_len <= 16) {
+		r[n] = opt_type;
+		memcpy(r + n + 1, &opt_len, 2);
+		memcpy(r + n + 3, opt, opt_len);
+		n += 3 + opt_len;
+	}
+	uint16_t body = n - 7;
+	memcpy(r + 5, &body, 2);
+	(void)ipc_qrtr_send(Q_DATA, QRTR_RMTFS_PORT, node, port, r, n);
+}
