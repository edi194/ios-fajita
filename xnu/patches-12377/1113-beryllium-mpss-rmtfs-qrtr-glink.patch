+static void
+ipc_qrtr_rx(const uint8_t *p, uint32_t len)
+{
+	uint32_t h[8], type, snode, sport, confirm, size, dnode, dport, hdrlen;
+	if (len < 16) {
+		return;
+	}
+	if (p[0] == 3) {
+		/* struct qrtr_hdr_v2: u8 version, type, flags, optlen; u32 size; u16 src node/port, dst node/port */
+		uint16_t a[4];
+		memcpy(&size, p + 4, 4);
+		memcpy(a, p + 8, 8);
+		type = p[1];
+		confirm = p[2] & 1u;            /* QRTR_FLAGS_CONFIRM_RX */
+		hdrlen = 16u + p[3];
+		snode = a[0];
+		sport = a[1] == 0xffffu ? QRTR_PORT_CTRL : a[1];
+		dnode = a[2];
+		dport = a[3] == 0xffffu ? QRTR_PORT_CTRL : a[3];
+	} else {
+		if (len < 32) {
+			return;
+		}
+		memcpy(h, p, 32);
+		type = h[1];
+		snode = h[2];
+		sport = h[3];
+		confirm = h[4];
+		size = h[5];
+		dnode = h[6];
+		dport = h[7];
+		hdrlen = 32;
+	}
+	if ((p[0] != 1 && p[0] != 3) || size > len || hdrlen + ((size + 3u) & ~3u) > len) {
+		printf("SWEET IPC: qrtr: version %u packet of %u bytes (size %u) dropped\n", p[0], len, size);
+		return;
+	}
+	const uint8_t *pl = p + hdrlen;
+	ipc.node = snode;
+	switch (type) {
+	case Q_HELLO:
+		printf("SWEET IPC: qrtr: hello from node %u\n", snode);
+		ipc.hello_seen = true;
+		ipc_qrtr_announce();            /* ns.c ctrl_cmd_hello(): hello back + our servers */
+		break;
+	case Q_NEW_SERVER:
+	case Q_DEL_SERVER:
+		if (size >= 20) {
+			uint32_t s[5];
+			memcpy(s, pl, 20);
+			printf("SWEET IPC: qrtr: %s service %u (%#x) version %u instance %u at %u:%#x\n",
+			    type == Q_NEW_SERVER ? "modem offers" : "modem removes", s[1], s[1], s[2] & 0xff, s[2] >> 8, s[3],
