+			if (strcmp(path, ipc_parts[k].path) == 0) {
+				caller = k;
+			}
+		}
+		ok = caller < 4 && rmtfs_part(caller);
+		printf("SWEET IPC: rmtfs open \"%s\" -> %s caller %u (%llu bytes)\n", path,
