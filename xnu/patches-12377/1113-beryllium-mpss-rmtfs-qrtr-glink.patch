+/* one poll of the modem's SMP2P item: prints every entry change, sets mw.ready / mw.fatal */
+static void
+ms_mpss_poll(void)
+{
+	uint32_t sz = 0, it = ms_smem_item(0, 1, MPSS_SMP2P_IN_ITEM, &sz);
+	if (!it || sz < 20 || smem_u32(it) != 0x504d5324u) {
+		return;
+	}
+	uint32_t w1 = smem_u32(it + 4), pids = smem_u32(it + 8), ents = smem_u32(it + 12);
+	if (!mw.seen) {
+		printf("SWEET MSS: smp2p item %u at +%#x: version %u features %#x pid %u->%u entries %u/%u (%llu ms)\n",
+		    MPSS_SMP2P_IN_ITEM, it, w1 & 0xff, w1 >> 8, pids & 0xffff, pids >> 16, ents >> 16, ents & 0xffff,
+		    ms_now_ms() - mw.t0);
+		mw.seen = true;
+	}
+	ms_smp2p_service(it);
+	uint32_t valid = MIN(ents >> 16, 8u);
+	for (uint32_t k = 0; k < valid && 20 + (k + 1) * 20 <= sz; k++) {
+		uint32_t e = it + 20 + k * 20;
+		char name[17];
+		for (uint32_t c = 0; c < 16; c += 4) {
+			uint32_t w = smem_u32(e + c);
+			memcpy(name + c, &w, 4);
+		}
+		name[16] = 0;
+		uint32_t v = smem_u32(e + 16);
+		if (v == mw.last[k]) {
+			continue;
+		}
+		mw.last[k] = v;
+		printf("SWEET MSS: smp2p in[%u] \"%s\" = %#x (%llu ms)\n", k, name, v, ms_now_ms() - mw.t0);
+		if (strcmp(name, "slave-kernel") == 0) {
+			if ((v & 2u) && !mw.ready) {
+				mw.ready = true;
+				printf("SWEET MSS: MPSS READY\n");
