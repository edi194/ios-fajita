+/* the partition behind a caller id, with its RAM copy once the modem has written to it */
+static bool
+rmtfs_part(uint32_t caller)
+{
+	if (caller >= 4) {
+		return false;
+	}
+	if (!ipc.part_bytes[caller]) {
+		uint8_t lun;
+		uint64_t bytes = 0;
+		if (sweet_ufs_part_size(ipc_parts[caller].part, &lun, &bytes) || !bytes) {
+			return false;
+		}
+		ipc.part_bytes[caller] = bytes;
+	}
+	return true;
+}
+
+/* one iovec entry: sectors of the partition <-> the rmtfs buffer (absolute physical address) */
+static bool
+rmtfs_xfer(uint32_t caller, bool write, uint32_t sector, uint32_t phys, uint32_t nsec)
+{
+	uint64_t off = (uint64_t)sector * RMTFS_SECTOR, len = (uint64_t)nsec * RMTFS_SECTOR;
+	if (phys < RMTFS_MEM_PA || (uint64_t)phys + len > RMTFS_MEM_PA + RMTFS_MEM_SIZE ||
+	    off + len > ipc.part_bytes[caller]) {
+		return false;
+	}
+	uint8_t *win = (uint8_t *)(ipc.win + (phys - ipc.win_base));
+	if (write) {
+		if (!ipc.shadow[caller]) {
+			/* first write: a RAM copy of the whole partition takes it (rmtfs read-only mode) */
+			uint64_t sz = ipc.part_bytes[caller];
+			ipc.shadow[caller] = kalloc_data(sz, Z_WAITOK);
+			if (!ipc.shadow[caller] || sweet_ufs_read_part(ipc_parts[caller].part, 0, ipc.shadow[caller], sz)) {
+				printf("SWEET IPC: rmtfs: no RAM copy of %s\n", ipc_parts[caller].part);
+				if (ipc.shadow[caller]) {
+					kfree_data(ipc.shadow[caller], sz);
+					ipc.shadow[caller] = NULL;
+				}
+				return false;
+			}
+			printf("SWEET IPC: rmtfs: %s copied to RAM (%llu bytes): its writes stay there\n",
+			    ipc_parts[caller].part, sz);
+		}
+		memcpy(ipc.shadow[caller] + off, win, len);
+		ipc.writes++;
+		ipc.write_bytes += len;
+		return true;
+	}
+	ipc.reads++;
+	ipc.read_bytes += len;
+	if (ipc.shadow[caller]) {
+		memcpy(win, ipc.shadow[caller] + off, len);
+		return true;
+	}
+	static uint8_t *bounce;
+	const uint32_t bsz = 0x40000u;
+	if (!bounce && !(bounce = kalloc_data(bsz, Z_WAITOK))) {
+		return false;
+	}
+	for (uint64_t o = 0; o < len; o += bsz) {
+		uint64_t n = MIN((uint64_t)bsz, len - o);
+		if (sweet_ufs_read_part(ipc_parts[caller].part, off + o, bounce, n)) {
+			return false;
+		}
+		memcpy(win + o, bounce, n);
+	}
+	return true;
+}
