+	}
+	ipc.tx = ms_smem_alloc(GLINK_TX_ITEM, GLINK_TX_SIZE);
+	if (!ipc.tx || ms_smem_item(0, 1, GLINK_TX_ITEM, &sz) != ipc.tx || sz < 1024 || (sz & 7)) {
+		printf("SWEET IPC: glink TX FIFO not usable (size %u)\n", sz);
+		return false;
+	}
+	ipc.tx_len = sz;                        /* the item's own size, as qcom_smem_get() returns it */
+	wl_wr(wl.smem, ipc.desc + 8, 0);        /* *rx_pipe->tail = 0 */
+	wl_wr(wl.smem, ipc.desc + 4, 0);        /* *tx_pipe->head = 0 */
+	bool v = ipc_tx_cmd(G_VERSION, 1, ipc.features);
+	printf("SWEET IPC: glink up: descriptor +%#x, TX FIFO +%#x (%u bytes), version 1 features %#x %s\n", ipc.desc,
+	    ipc.tx, ipc.tx_len, ipc.features, v ? "sent" : "NOT SENT");
+	return v;
+}
+
+/* the service loop: GLINK every millisecond, the modem's SMP2P entry every 100 ms */
+static bool
+ms_ipc_run(unsigned hold_s)
+{
+	uint64_t t0 = ms_now_ms(), next = t0, end = t0 + (uint64_t)hold_s * 1000;
+	bool alive = true;
+	while (ms_now_ms() < end) {
+		ipc_rx_poll();
+		ipc_flush();
+		if (ipc.open_acked && !ipc.announced && ms_now_ms() > ipc.open_ms + 3000) {
+			printf("SWEET IPC: qrtr: no hello from the modem 3 s after IPCRTR opened: sending ours\n");
+			ipc_qrtr_announce();
+		}
+		if (ms_now_ms() >= next) {
+			next += 100;
+			ms_mpss_poll();
+			if (mw.fatal) {
+				alive = false;
+				break;
+			}
+		}
+		wl_sleep(1);
+	}
+	printf("SWEET IPC: %u s: glink %s, IPCRTR %s, qrtr hello %s; %u packets in, %u out; rmtfs %u reads (%llu bytes), "
+	    "%u writes kept in RAM (%llu bytes)\n", (unsigned)((ms_now_ms() - t0) / 1000), ipc.version_acked ? "versioned" : "no version-ack",
+	    ipc.open_acked ? "open" : "not open", ipc.hello_seen ? "seen" : "not seen", ipc.rx_pkts, ipc.tx_pkts, ipc.reads,
+	    ipc.read_bytes, ipc.writes, ipc.write_bytes);
+	sweet_log_sync();
+	return alive;
+}
+
+/* teardown part (after the modem is stopped): rmtfs buffer back to HLOS (qcom_rmtfs_mem_remove), RAM freed */
+static void
+ms_ipc_teardown(void)
+{
+	if (ipc.rmtfs_perm & VMBIT(SCM_VMID_MSS_MSA)) {
+		uint32_t src[2] = { SCM_VMID_HLOS, SCM_VMID_MSS_MSA }, dst = SCM_VMID_HLOS, perm = SCM_PERM_RW;
+		if (ms_assign_list("rmtfs back", RMTFS_MEM_PA, RMTFS_MEM_SIZE, src, 2, &dst, &perm, 1)) {
+			ipc.rmtfs_perm = VMBIT(SCM_VMID_HLOS);
+		}
+	}
+	if (ipc.win) {
+		ml_io_unmap(ipc.win, ipc.win_len);
+		ipc.win = 0;
+	}
+	for (unsigned k = 0; k < 4; k++) {
+		if (ipc.shadow[k]) {
+			kfree_data(ipc.shadow[k], ipc.part_bytes[k]);
+			ipc.shadow[k] = NULL;
+		}
+	}
+	for (unsigned k = 0; k < IPC_MAX_INTENTS; k++) {
+		if (ipc.li[k].buf) {
+			kfree_data(ipc.li[k].buf, ipc.li[k].size);
+			ipc.li[k].buf = NULL;
+		}
+	}
+}
