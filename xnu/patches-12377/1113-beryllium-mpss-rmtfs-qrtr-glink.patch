+		rmtfs_respond(node, port, txn, msg, ok, 0x10, &caller, 4);
+		break;
+	}
+	case 2:                         /* CLOSE */
+		printf("SWEET IPC: rmtfs close caller %u\n", qmi_u32(t, tl, 1, &ok));
+		rmtfs_respond(node, port, txn, msg, ok, 0, NULL, 0);
+		break;
+	case 3: {                       /* RW_IOVEC: caller (1), direction (2), [u8 n] n x {sector, phys, nsec} (3) */
+		uint32_t caller = qmi_u32(t, tl, 1, &ok);
