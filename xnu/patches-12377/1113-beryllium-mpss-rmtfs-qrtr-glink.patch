+/* ---- QRTR v1 (af_qrtr.c qrtr_node_enqueue): 32-byte header, payload padded to 4 */
+static bool
+ipc_qrtr_send(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *pl, uint32_t size)
+{
+	static uint8_t pkt[32 + 1024];
+	uint32_t h[8] = { 1, type, QRTR_NODE_LOCAL, src_port, 0, size, dst_node, dst_port };
+	uint32_t padded = (size + 3u) & ~3u;
+	if (padded > sizeof(pkt) - 32) {
+		return false;
+	}
+	memcpy(pkt, h, 32);
+	memcpy(pkt + 32, pl, size);
+	bzero(pkt + 32 + size, padded - size);
+	return ipc_send(pkt, 32 + padded);
+}
