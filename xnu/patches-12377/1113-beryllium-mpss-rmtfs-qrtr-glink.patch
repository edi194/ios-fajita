+		}
+		if (ipc.iovec_logged < 64 || !ok) {
+			ipc.iovec_logged++;
+			printf("SWEET IPC: rmtfs %s caller %u: %u entries, %u sectors from %u: %s\n",
+			    dir && dir[0] ? "write" : "read", caller, n, total, first, ok ? "ok" : "FAILED");
+		}
+		rmtfs_respond(node, port, txn, msg, ok, 0, NULL, 0);
+		break;
+	}
+	case 4: {                       /* ALLOC_BUFF: caller (1), size (2) -> address (TLV 0x10, u64) */
+		uint32_t caller = qmi_u32(t, tl, 1, &ok), size = qmi_u32(t, tl, 2, &ok);
+		uint64_t addr = RMTFS_MEM_PA;
+		ok = ok && size <= RMTFS_MEM_SIZE;
+		printf("SWEET IPC: rmtfs alloc caller %u %u bytes -> %#llx%s\n", caller, size, addr, ok ? "" : " REFUSED");
+		rmtfs_respond(node, port, txn, msg, ok, 0x10, &addr, 8);
+		break;
+	}
+	case 5: {                       /* GET_DEV_ERROR -> status 0 */
+		uint8_t status = 0;
+		printf("SWEET IPC: rmtfs dev-error caller %u\n", qmi_u32(t, tl, 1, &ok));
