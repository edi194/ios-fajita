+			uint32_t r[5] = { Q_RESUME_TX, dnode, dport, 0, 0 };
+			(void)ipc_qrtr_send(Q_RESUME_TX, dport, snode, sport, r, sizeof(r));
+		}
+		break;
+	case Q_RESUME_TX:
+		break;
+	default:
+		printf("SWEET IPC: qrtr: control %u from %u:%#x (%u bytes)\n", type, snode, sport, size);
