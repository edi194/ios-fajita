+static void
+svc_echo(void)
+{
+	uint8_t c[16];
+	uint32_t id = 0x1d001, v = ++svc.echo_val;
+	uint16_t len = 4, tag = 149;
+	memcpy(c, &id, 4);
+	memcpy(c + 4, &len, 2);
+	memcpy(c + 6, &tag, 2);
+	memcpy(c + 8, &v, 4);
+	if (wce.rings && wce.wmi_eid && wce_send(1, wce.wmi_eid, c, 12)) {
+		svc.echo_sent++;
+		svc.echo_sent_ms = ms_now_ms();
+	} else {
+		svc.echo_skipped++;             /* no WMI credit (or no rings): shown in the status line */
+	}
+}
+
+/* WMI ECHO event: tag 54 {u32 value} */
+static void
+svc_echo_event(const uint8_t *t, uint32_t len)
+{
+	uint16_t tl, tag;
+	uint32_t v;
+	if (len < 8) {
+		return;
+	}
+	memcpy(&tl, t, 2);
+	memcpy(&tag, t + 2, 2);
+	memcpy(&v, t + 4, 4);
+	if (tag == 54 && tl >= 4 && v == svc.echo_val) {
+		svc.echo_ok++;
+		svc.echo_rtt_ms = (uint32_t)(ms_now_ms() - svc.echo_sent_ms);
+	}
+}
