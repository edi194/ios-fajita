 	}
 	case IOC_SUPPORTED_CHANNELS: {
 		static const uint8_t ch5[] = {
@@ -324,10 +322,11 @@ s8_set(struct sweet80211_req *req)
 		return 0;
 	}
 	case IOC_COUNTRY_CODE: {
+		/* bare char[3] like the get (len 3); a versioned 7-byte form has the code at offset 4 */
 		uint8_t d[7] = { 0 };
-		if (req->data != 0 && req->len >= 6 &&
