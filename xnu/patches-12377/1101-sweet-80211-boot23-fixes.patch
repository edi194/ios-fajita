@@ -242,12 +242,10 @@ s8_get(struct sweet80211_req *req)
 	case IOC_LOCALE:
 		return s8_reply_u32(req, LOCALE_ETSI);
 	case IOC_COUNTRY_CODE: {
-		struct {
-			uint32_t version;
-			char     cc[3];
