+		/*
+		 * boot 23: after power-on wifid pushes ~15 optional settings (battery powersave,
+		 * system state, BT coexistence, Wi-Fi calling, NAN, ...). Accept and ignore them;
+		 * the log line still records each type once.
+		 */
+		return 0;
 	}
 }
 
