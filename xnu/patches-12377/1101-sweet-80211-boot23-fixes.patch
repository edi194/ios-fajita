 		ifmr->ifm_count = 1;
 		return 0;
 	}
+	case SIOCGIFDEVMTU: {
+		struct ifreq *ifr = (struct ifreq *)data;
+		ifr->ifr_devmtu.ifdm_current = ETHERMTU;
+		ifr->ifr_devmtu.ifdm_min = ETHERMIN;
+		ifr->ifr_devmtu.ifdm_max = ETHERMTU;
+		return 0;
+	}
 	case SIOCSIFADDR:
 	case SIOCAIFADDR:
 		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
