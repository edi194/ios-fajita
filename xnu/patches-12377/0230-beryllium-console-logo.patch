 static uint32_t vc_color_back = 0;
 
 /*
+ * Bergamota: the verbose console draws over a dimmed Bergamota logo. While the
+ * background is the default black (32 bpp only), background pixels come from
+ * the logo centred on the screen instead of vc_color_back; since the console
+ * repaints from its character buffer when it scrolls, the logo stays put.
+ * Decoded once (palette indices, static: clear_screen can run before the VM).
+ */
+#include "console_logo.h"
+/*
+ * Bergamota identity (tools/identity): the portrait is drawn as round halftone dots from a cell map (density per cell,
+ * a 2x cutout mask, a 16x16 spot-threshold matrix), the way Enxerto draws it: the portrait's paper in a dim lime,
+ * its ink black, nothing to decode or keep in memory.
+ */
+#define CONSOLE_LOGO_W          760
+#define CONSOLE_LOGO_H          (CONSOLE_LOGO_W * CONSOLE_LOGO_ROWS / CONSOLE_LOGO_COLS)
+#define CONSOLE_LOGO_PAPER      0x002b301bu     /* lime #d7e98a at ~20 % */
+static boolean_t vc_logo_ready;
+
+static void
+vc_logo_decode(void)
+{
+	vc_logo_ready = TRUE;
+}
+
+/* the logo's top-left corner on screen, or FALSE if the logo is not used now */
+static boolean_t
+vc_logo_origin(int *x0, int *y0)
+{
+	if (!vc_logo_ready || vinfo.v_depth != 32 || vc_color_back != 0) {
+		return FALSE;
+	}
+	*x0 = ((int)vinfo.v_width - CONSOLE_LOGO_W) / 2;
+	*y0 = ((int)vinfo.v_height - CONSOLE_LOGO_H) / 2;
+	return TRUE;
+}
+
+static inline uint32_t
+vc_logo_back(int x0, int y0, unsigned int px, unsigned int py)
+{
+	unsigned int lx = (unsigned int)((int)px - x0), ly = (unsigned int)((int)py - y0);
+	const uint32_t step = ((uint32_t)CONSOLE_LOGO_COLS << 16) / CONSOLE_LOGO_W;     /* cells per pixel, 16.16 */
+
+	if (lx >= CONSOLE_LOGO_W || ly >= CONSOLE_LOGO_H) {
+		return vc_color_back;
+	}
+	uint32_t cx = lx * step, cy = ly * step;
+	unsigned int col = cx >> 16, row = cy >> 16, mcol = cx >> 15, mrow = cy >> 15;
+	if (col >= CONSOLE_LOGO_COLS || row >= CONSOLE_LOGO_ROWS ||
+	    !(console_logo_mask[mrow * ((CONSOLE_LOGO_MCOLS + 7) / 8) + (mcol >> 3)] >> (mcol & 7) & 1)) {
+		return vc_color_back;
+	}
+	return console_logo_spot[((cy >> 12) & 15) * 16 + ((cx >> 12) & 15)] < console_logo_cells[row * CONSOLE_LOGO_COLS + col]
+	       ? 0 : CONSOLE_LOGO_PAPER;
+}
+
+/*
  * New Rendering code from Michel Pollet
  */
 
