 	}
 	uint16_t body = (uint16_t)(n - 7);
@@ -3620,6 +3645,7 @@
 			printf("SWEET IPC: qrtr: %s service %u (%#x) version %u instance %u at %u:%#x\n",
 			    type == Q_NEW_SERVER ? "modem offers" : "modem removes", s[1], s[1], s[2] & 0xff, s[2] >> 8, s[3],
 			    s[4]);
+			ipc_note(" %csvc %#x/%u@%u:%#x;", type == Q_NEW_SERVER ? '+' : '-', s[1], s[2] >> 8, s[3], s[4]);
 			if (s[1] == WLFW_SERVICE && type == Q_NEW_SERVER) {
 				ipc.wlfw_seen = true;
