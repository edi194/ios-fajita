diff --git a/bsd/dev/beryllium_wlan.c b/bsd/dev/beryllium_wlan.c
--- a/bsd/dev/beryllium_wlan.c
+++ b/bsd/dev/beryllium_wlan.c
@@ -2211,6 +2211,8 @@
 	uint32_t node;                  /* the modem's QRTR node, learned from its packets */
 	bool hello_seen, announced, tftp, pdm, wlfw_seen;
 	unsigned pdm_reqs;
+	char notes[1536];               /* the stage's key events, printed again at the end (ipc_note) */
+	uint32_t notes_len;
 	uint64_t open_ms;
 	vm_offset_t win;                /* kernel window over the rmtfs buffer */
 	uint64_t win_base, win_len;
@@ -2220,6 +2222,25 @@
 	unsigned rx_pkts, tx_pkts, reads, writes, iovec_logged;
 	uint64_t read_bytes, write_bytes;
 } ipc;
+
+/*
+ * The USB console drops kernel lines while userspace is busy (boot 42 lost most pd-mapper and service lines), so
+ * the key events are also kept here and printed again by ms_ipc_run when the stage ends.
+ */
+static void ipc_note(const char *fmt, ...) __printflike(1, 2);
+static void
+ipc_note(const char *fmt, ...)
+{
+	va_list ap;
+	uint32_t room = (uint32_t)sizeof(ipc.notes) - ipc.notes_len;
+	if (room < 2) {
+		return;
+	}
+	va_start(ap, fmt);
+	int n = vsnprintf(ipc.notes + ipc.notes_len, room, fmt, ap);
+	va_end(ap);
+	ipc.notes_len += n < 0 ? 0 : MIN((uint32_t)n, room - 1);
+}
 
 /* ---- GLINK SMEM pipes: descriptor words tx tail @0, tx head @4, rx tail @8, rx head @12 */
 static void
@@ -2940,7 +2961,7 @@
