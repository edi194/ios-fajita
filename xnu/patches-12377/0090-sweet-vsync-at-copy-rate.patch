--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -114,6 +114,7 @@ public:
 	uint8_t       fPending[SWEET_FB_SWAP_REC_SIZE];     /* latest swap, not yet shown */
 	bool          fDirty;
 	uint32_t      fFlushTicks;    /* vsync ticks between panel copies */
+	uint32_t      fVsyncUS;       /* vsync period */
 	bool          fPowerOff;      /* RequestPowerChange(0) */
 	uint32_t      fFadeStep;      /* fade-out steps done while off */
 
@@ -195,14 +196,26 @@ AppleCLCD::start(IOService *provider)
 	uint32_t hz = 10;
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
-	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+	fVsyncUS = SWEET_FB_VSYNC_US;
+	/*
+	 * sweetfb_vsync=1: tick vsync at the panel-copy rate instead of 60 Hz.
+	 * CoreAnimation renders (in software, on the CPU) once per vsync; at
+	 * 60 Hz with a 30 Hz copy every second frame was rendered for nothing.
+	 */
+	int vsync_at_copy = 0;
+	PE_parse_boot_argn("sweetfb_vsync", &vsync_at_copy, sizeof(vsync_at_copy));
+	if (vsync_at_copy && hz > 0 && hz < 60) {
+		fVsyncUS = 1000000u / hz;
+		fFlushTicks = 1;
+	}
+	fVsync->setTimeoutUS(fVsyncUS);
 
