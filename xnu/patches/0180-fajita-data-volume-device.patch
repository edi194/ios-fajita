 	bool ready;
 } su;
 
+/*
+ * fajita: a second region of the same partition, exposed as /dev/ufsvar0 - the data volume iOS wants for
+ * /private/var. The controller (registers, DMA, cache, locking) is shared with the root; only the region
+ * and the device node differ, so this keeps the root path untouched.
+ */
+static struct {
+	uint64_t first_block, nblocks;          /* region, in 4 KiB device blocks */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} su_var;
+
+/* The region a device refers to: the root, or the var volume. */
+static bool
+sweet_ufs_volume(dev_t dev, uint64_t *first, uint64_t *nblocks)
+{
+	if (su_var.ready && (dev == su_var.bdev || major(dev) == su_var.bmajor)) {
+		*first = su_var.first_block;
+		*nblocks = su_var.nblocks;
+		return true;
+	}
+	*first = su.first_block;
+	*nblocks = su.nblocks;
+	return su.ready;
+}
+
