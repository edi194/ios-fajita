+	/*
+	 * fajita: sweetvar=<first>:<count> in 4 KiB blocks, counted from the start of this partition, makes
+	 * the region a second block device (/dev/ufsvar0) that iOS can mount as the data volume.
+	 */
+	{
+		char var[64];
+		unsigned long long vfirst = 0, vcount = 0;
+		int fields = 0;
+
+		if (PE_parse_boot_argn("sweetvar", var, sizeof(var))) {
+			/* "first:count", both decimal, parsed here: no sscanf in this path. */
+			unsigned long long *dst = &vfirst;
+			for (const char *c = var; *c != '\0'; c++) {
+				if (*c >= '0' && *c <= '9') {
+					*dst = *dst * 10 + (unsigned long long)(*c - '0');
+				} else if (*c == ':' && fields == 0) {
+					fields = 1;
+					dst = &vcount;
+				} else {
+					break;
+				}
+			}
+		}
+		if (fields == 1 && vcount > 0) {
