+/* stage 8e: the device node and its ABI (selector numbers as in Linux msm) */
+#define SWEET_GPU_IOCTL_INFO       0x70u
+#define SWEET_GPU_IOCTL_GEM_NEW    0x42u
+#define SWEET_GPU_IOCTL_GEM_INFO   0x43u
+#define SWEET_GPU_IOCTL_GEM_SUBMIT 0x46u
+#define SWEET_GPU_IOCTL_WAIT_FENCE 0x47u
+#define SWEET_GPU_IOCTL_GEM_CLOSE  0x09u
+
+#define SWEET_GPU_INFO_GET_IOVA    1u
+#define SWEET_GPU_INFO_GET_SIZE    2u
+#define SWEET_GPU_INFO_GET_OFFSET  3u
