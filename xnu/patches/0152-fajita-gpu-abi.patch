+
+struct sweet_gpu_gem_submit {
+	uint32_t handle;                /* the command buffer BO */
+	uint32_t offset;
+	uint32_t dwords;
+	uint32_t fence;                 /* out */
+};
+
+struct sweet_gpu_wait {
+	uint32_t fence;
+	uint32_t timeout_ms;
+	uint32_t pad[2];
