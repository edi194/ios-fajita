+#define FJ_GCC_RCG       0x184d8u
+#define FJ_TLMM_NORTH    0x03900000u
+#define FJ_TLMM_SOUTH    0x03d00000u
+#define FJ_SE_PA         0x0a90000u
+#define FJ_TS_ADDR       0x20u
+#define FJ_GPIO_ATTN     125u
+#define FJ_GPIO_RESET    99u
+#define FJ_GPIO_VIO      88u
