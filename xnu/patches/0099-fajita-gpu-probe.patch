diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,107 @@
+/*
+ * Read-only GPU probe for the OnePlus 6T (SDM845 / Adreno 630).
+ *
+ * Stage 1 of the ladder used by oosexgang/hackios-xnu-kernel
+ * (bsd/dev/redwood_adreno.c): nothing here writes a register, so the only
+ * risk is reading a block whose clock is off. Every block is announced before
+ * it is touched, so a hang names the block. Boot-arg adreno=1.
+ *
+ * Addresses come from the vendor device tree (dtb/fajita2.dts):
+ *   qcom,kgsl-3d0@5000000  reg = <0x5000000 0x40000 0x5061000 0x800 0x509e000 0x1000>
+ *                          qcom,chipid = <0x6030001>
+ *   qcom,kgsl-smmu-v2      reg = <0x5040000 0x10000>
+ *   qcom,gpu-gmu           reg = <0x506a000 0x30000 0xb200000 0x300000>
+ *   qcom,gpucc@5090000     reg = <0x5090000 0x9000>
+ *   gpu_region@0x8c415000  zap memory, 0x2000
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_gpu_probe(void);
+
+#define GPU_PA          0x05000000u
+#define GPU_CX_DBGC     0x05061000u
+#define GPU_CX_MISC     0x0509e000u
+#define GPU_GMU         0x0506a000u
+#define GPU_SMMU        0x05040000u
+#define GPU_CC          0x05090000u
+#define GPU_GCC         0x00100000u
+#define GPU_QFPROM      0x00784000u
+#define GPU_CMD_DB      0x85fe0000u
+
+static uint32_t
+gpu_rd(vm_offset_t base, uint32_t off)
+{
+	if (base == 0) {
+		return 0;
+	}
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+sweet_gpu_probe(void)
+{
+	int level = 0;
+	vm_offset_t gcc, cc, dbgc, misc, gmu, smmu, gpu, qf, db;
+
+	(void)PE_parse_boot_argn("adreno", &level, sizeof(level));
+	if (level < 1) {
+		printf("SWEET GPU: probe off (adreno=1 enables it)\n");
+		return;
+	}
+	gcc = ml_io_map(GPU_GCC, 0x20000);
+	cc = ml_io_map(GPU_CC, 0x9000);
+	dbgc = ml_io_map(GPU_CX_DBGC, 0x800);
+	misc = ml_io_map(GPU_CX_MISC, 0x1000);
+	gmu = ml_io_map(GPU_GMU, 0x30000);
+	smmu = ml_io_map(GPU_SMMU, 0x10000);
+	gpu = ml_io_map(GPU_PA, 0x40000);
+	qf = ml_io_map(GPU_QFPROM, 0x1000);
+	db = ml_io_map(GPU_CMD_DB, 0x1000);
+	printf("SWEET GPU: level %d, maps gcc=%p cc=%p dbgc=%p misc=%p gmu=%p smmu=%p gpu=%p qf=%p db=%p\n",
+	    level, (void *)gcc, (void *)cc, (void *)dbgc, (void *)misc, (void *)gmu,
+	    (void *)smmu, (void *)gpu, (void *)qf, (void *)db);
+
+	printf("SWEET GPU: reading gcc\n");
+	printf("SWEET GPU: gcc pll-vote=%#x\n", gpu_rd(gcc, 0x52000));
+
+	printf("SWEET GPU: reading qfprom\n");
+	printf("SWEET GPU: qfprom 0x1e0=%#x 0x1e4=%#x 0x1e8=%#x 0x1ec=%#x 0x1f0=%#x 0x1f4=%#x 0x1f8=%#x\n",
+	    gpu_rd(qf, 0x1e0), gpu_rd(qf, 0x1e4), gpu_rd(qf, 0x1e8), gpu_rd(qf, 0x1ec),
+	    gpu_rd(qf, 0x1f0), gpu_rd(qf, 0x1f4), gpu_rd(qf, 0x1f8));
+
+	printf("SWEET GPU: reading cmd-db\n");
+	printf("SWEET GPU: cmd-db version=%#x magic=%#x\n", gpu_rd(db, 0x00), gpu_rd(db, 0x04));
+
+	printf("SWEET GPU: reading gpucc\n");
+	printf("SWEET GPU: gpucc gx-sw-reset=%#x gx-gdscr=%#x gx-gmu-cbcr=%#x cx-gdscr=%#x ahb=%#x\n",
+	    gpu_rd(cc, 0x1008), gpu_rd(cc, 0x100c), gpu_rd(cc, 0x1064), gpu_rd(cc, 0x106c),
+	    gpu_rd(cc, 0x1078));
+	printf("SWEET GPU: gpucc cx-gmu=%#x cxo=%#x gmu-rcgr=%#x cb=%#x hub=%#x/%#x/%#x cx-hw-ctrl=%#x\n",
+	    gpu_rd(cc, 0x1098), gpu_rd(cc, 0x109c), gpu_rd(cc, 0x1120), gpu_rd(cc, 0x1170),
+	    gpu_rd(cc, 0x1178), gpu_rd(cc, 0x117c), gpu_rd(cc, 0x1204), gpu_rd(cc, 0x1540));
+
+	printf("SWEET GPU: reading smmu\n");
+	printf("SWEET GPU: smmu idr0=%#x idr1=%#x idr2=%#x scr0=%#x sacr=%#x\n",
+	    gpu_rd(smmu, 0x00), gpu_rd(smmu, 0x04), gpu_rd(smmu, 0x08),
+	    gpu_rd(smmu, 0x30), gpu_rd(smmu, 0x40));
+
+	printf("SWEET GPU: reading gmu\n");
+	printf("SWEET GPU: gmu fw-init=%#x cm3-sysreset=%#x itcm=%#x\n",
+	    gpu_rd(gmu, 0x501c), gpu_rd(gmu, 0x5000), gpu_rd(gmu, 0x0c00));
+
+	printf("SWEET GPU: reading gpu core\n");
+	printf("SWEET GPU: gpu 0x0000=%#x 0x0004=%#x 0x0010=%#x\n",
+	    gpu_rd(gpu, 0x0000), gpu_rd(gpu, 0x0004), gpu_rd(gpu, 0x0010));
+
+	printf("SWEET GPU: reading cx dbgc/misc\n");
+	printf("SWEET GPU: dbgc=%#x misc=%#x\n", gpu_rd(dbgc, 0x00), gpu_rd(misc, 0x00));
+	printf("SWEET GPU: probe done (nothing written)\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -111,6 +111,7 @@
 bsd/dev/sweet_rpmh.c			standard
 bsd/dev/sweet_spmi.c			standard
 bsd/dev/sweet_usb.c			standard
+bsd/dev/sweet_gpu.c			standard
 bsd/dev/mem.c				standard
 bsd/dev/munge.c 			optional config_requires_u32_munging
 bsd/dev/unix_startup.c			standard
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -52,6 +52,7 @@
 extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
 extern void sweet_touch_init(void);
+extern void sweet_gpu_probe(void);
 extern void sweet_usb_probe(void);
 
 #define REG_CAP         0x00
@@ -659,6 +660,7 @@
 	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
 	sweet_keys_init();
 	sweet_touch_init();
+	sweet_gpu_probe();
 	sweet_usb_probe();
 	return 0;
 }
