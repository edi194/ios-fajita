+/* ---- stage 8g: memory for the IOKit client ------------------------------------------ */
+
+/*
+ * The client cannot use the VM's pages: this port keeps pages below gPhysBase on its free
+ * lists and pmap panics on them (phys_to_kv_range). Hand out the arena instead - contiguous,
+ * above the base, write-combined, the memory the CP already writes through.
+ */
+static uint32_t gpu_page_used;
+
+bool
+sweet_gpu_alloc_pages(uint64_t size, uint64_t *pa, void **kva)
+{
+	uint64_t sz = (size + 0xfff) & ~0xfffull;
+	uint32_t off;
+
+	if (!gpu_live || sz == 0 || sz > gpu_arena_size || gpu_arena == 0) {
+		return false;
+	}
+	off = gpu_page_used;
+	if ((uint64_t)off + sz > gpu_arena_size) {
+		printf("SWEET GPU: no arena for %llu bytes (%u of %u used)\n",
+		    (unsigned long long)sz, gpu_page_used, gpu_arena_size);
+		return false;
+	}
+	gpu_page_used += (uint32_t)sz;
+	*pa = gpu_arena_pa + off;
+	*kva = (void *)(gpu_arena + off);
+	for (uint32_t i = 0; i < sz; i += 4) {
+		*(volatile uint32_t *)(gpu_arena + off + i) = 0;
+	}
+	printf("SWEET GPU: arena pages %llu bytes at pa %#llx (arena+%#x)\n",
+	    (unsigned long long)sz, (unsigned long long)*pa, off);
+	return true;
+}
+
+/* Bump allocator: the client frees only at teardown, so this is bookkeeping for now. */
+void
+sweet_gpu_free_pages(uint64_t pa, uint64_t size)
+{
+	(void)pa;
+	(void)size;
+}
+
