 #define EARLY_FB early_fb
@@ -141,4 +142,40 @@
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }
+
+/*
+ * Route console output to this lock-free panel console (boot-arg
+ * sweetecon=1). Used when the normal console path stops draining after
+ * AppleCLCD takes the panel: this one needs no locks, no allocation, no
+ * interrupt and no IOSurface, so it cannot be starved by a stopped
+ * kernel thread.
+ *
+ * The value is latched lazily: the first calls happen before the boot
+ * arguments exist, so -1 means "not parsed yet, try again later".
+ *
+ * @return 1 when the characters were drawn here, 0 to use the normal path.
+ */
+int
+sweet_early_console_route(const char *c, int size)
+{
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		int value = 0;
+		if (PE_state.bootArgs == NULL) {
+			return 0;
+		}
+		if (!PE_parse_boot_argn("sweetecon", &value, sizeof(value))) {
+			return 0;
+		}
+		enabled = value;
+	}
+	if (enabled <= 0) {
+		return 0;
+	}
+	while (size-- > 0) {
+		sweet_early_putc(*c++);
+	}
+	return 1;
+}
 #endif /* SWEET */
