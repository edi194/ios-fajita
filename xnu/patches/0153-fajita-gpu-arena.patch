-/* ---- the GMU's own memory ------------------------------------------------- */
-
-/*
- * The HFI table and the log the firmware uses. HFI_QTBL_ADDR is a 32-bit
- * register and all of the kernel's memory is above 4 GB (the ADT starts at
- * 0x100000000), so they go into the low bank: Linux reports
- * 0x97d00000-0x27c89ffff as one System RAM range across the 4 GB boundary, and
- * console50 read 0xb0000000 from XNU without trouble.
- *
- * It is all prepared here, before the GPU is powered: console49 read the same
- * address after the power-on, the clock writes and the firmware load, and died
- * on it.
- */
-struct hfi_queue_header {
-	uint32_t status, iova, type, size, msg_size, dropped;
-	uint32_t rx_watermark, tx_watermark, rx_request, tx_request, read_index, write_index;
-};
-struct hfi_table_header {
-	uint32_t version, size, qhdr0_offset, qhdr_size, num_queues, active_queues;
-};
-
-static vm_offset_t gpu_log_va;
-static uint32_t gpu_hfi_pa, gpu_log_pa;
-static bool gpu_scratch_ready;
-static bool gpu_kept_up;        /* stage 8: leave the GPU powered and the ring live */
-
-static void
-gpu_scratch_prepare(void)
-{
-	vm_offset_t hfi = ml_io_map(GPU_SCRATCH_PA + GPU_SCRATCH_HFI, 0x4000);
-	vm_offset_t log = hfi == 0 ? 0 : hfi + GPU_SCRATCH_LOG;   /* inside the same mapping */
-
-	printf("SWEET GPU: scratch: hfi at %#x -> %#llx, log at %#x -> %#llx\n",
-	    GPU_SCRATCH_PA + GPU_SCRATCH_HFI, (uint64_t)hfi,
-	    GPU_SCRATCH_PA + GPU_SCRATCH_LOG, (uint64_t)log);
-	if (hfi == 0 || log == 0) {
-		printf("SWEET GPU: cannot map the GMU's scratch memory\n");
-		return;
-	}
-	printf("SWEET GPU: hfi scratch reads %#x\n", *(volatile uint32_t *)hfi);
-	printf("SWEET GPU: log scratch reads %#x\n", *(volatile uint32_t *)log);
-
-	for (uint32_t off = 0; off < 0x4000; off += 4) {
-		*(volatile uint32_t *)(hfi + off) = 0;
-	}
-	__asm__ volatile("dmb oshst" ::: "memory");
-
-	volatile struct hfi_table_header *const table = (volatile struct hfi_table_header *)hfi;
-	volatile struct hfi_queue_header *const queue =
-	    (volatile struct hfi_queue_header *)(hfi + sizeof(*table));
-
-	table->version = 0;
-	table->size = sizeof(*table) + 2 * sizeof(*queue);
-	table->qhdr0_offset = sizeof(*table) / 4;
-	table->qhdr_size = sizeof(*queue) / 4;
-	table->num_queues = 2;
-	table->active_queues = 2;
-	for (uint32_t i = 0; i < 2; i++) {
-		queue[i].status = 1;
-		queue[i].iova = GPU_SCRATCH_PA + GPU_SCRATCH_HFI + 0x1000 * (i + 1);
-		queue[i].type = (10u << 8) | (i == 0 ? 0u : 4u);   /* 4: a630's legacy response queue */
-		queue[i].size = 0x1000 / 4;
-		queue[i].rx_watermark = 1;
-		queue[i].tx_watermark = 1;
-		queue[i].rx_request = 1;
-	}
-	__asm__ volatile("dmb oshst" ::: "memory");
-	printf("SWEET GPU: hfi table at %#x: %#x %#x %#x %#x %#x %#x, queue0 %#x %#x %#x\n",
-	    GPU_SCRATCH_PA + GPU_SCRATCH_HFI, table->version, table->size, table->qhdr0_offset,
-	    table->qhdr_size, table->num_queues, table->active_queues, queue[0].status,
-	    queue[0].iova, queue[0].type);
-
-	gpu_log_va = log;
-	gpu_hfi_pa = GPU_SCRATCH_PA + GPU_SCRATCH_HFI;
-	gpu_log_pa = GPU_SCRATCH_PA + GPU_SCRATCH_LOG;
-	gpu_scratch_ready = true;
-}
