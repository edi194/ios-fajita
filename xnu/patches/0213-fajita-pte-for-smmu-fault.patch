+/*
+ * fajita: what the page table says about one address. The SMMU reports the address it could not translate
+ * (CBFAR), and that address alone does not say whether the PTE is missing, was cleared, or points somewhere
+ * unexpected - which is exactly the difference between an unmapped BO and a BO that was unmapped while the CP
+ * still held it. It reads through gpu_l3_for(), so an address in a region that was never touched reports a
+ * fresh, empty table instead of failing.
+ */
+uint64_t
+sweet_gpu_pte_read(uint64_t iova)
+{
+	volatile uint64_t *l3 = gpu_l3_for(iova & ~0xfffull);
+
+	return l3 != NULL ? l3[(iova >> 12) & 0x1ff] : 0;
+}
