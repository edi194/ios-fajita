+		if (w <= 0 || h <= 0 || (!wide && (s->elementWidth != 1 || s->elementHeight != 1)) ||
 		    s->memory == NULL || last > s->memory->getLength()) {
 			src = 0;
 		}
 		if (src != 0 && bpe == 4) {
 			for (int32_t y = 0; y < h; y++) {
-				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
-				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
-				    (size_t)w * 4);
+				const uint8_t *row = (const uint8_t *)(src + s->offset +
+				    (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4);
+				uint8_t *out = (uint8_t *)(fPixels + (uint64_t)(dy + y) * fRowBytes +
+				    (uint64_t)dx * 4);
+				if (!wide) {
+					memcpy(out, row, (size_t)w * 4);
+					continue;
+				}
+				for (int32_t x = 0; x < w; x++) {
+					uint32_t v;
+					memcpy(&v, row + (uint64_t)x * 4, sizeof(v));
+					uint32_t b = v & 0x3ff;
+					uint32_t g = (v >> 10) & 0x3ff;
+					uint32_t r = (v >> 20) & 0x3ff;
+					out[x * 4 + 0] = (uint8_t)(b >> 2);
+					out[x * 4 + 1] = (uint8_t)(g >> 2);
+					out[x * 4 + 2] = (uint8_t)(r >> 2);
