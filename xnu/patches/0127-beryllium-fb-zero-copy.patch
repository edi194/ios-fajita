+/* A block of np pages, or 0. Pages 0 and pages-1 are never handed out (guards). */
+static uint64_t
+sweet_lowpool_alloc(uint32_t bytes)
+{
+	uint32_t np = (bytes + PAGE_SIZE - 1) / PAGE_SIZE, run = 0;
+	uint64_t pa = 0, now = mach_absolute_time();
