+	for (uint32_t i = 1; i + 1 < sweet_lowpool.pages; i++) {
+		uint64_t u = sweet_lowpool.until[i];
+		if (u == 0 || (u != ~0ull && u <= now)) {
+			if (++run == np) {
+				uint32_t first = i + 1 - np;
+				for (uint32_t j = first; j <= i; j++) {
+					sweet_lowpool.until[j] = ~0ull;
+				}
