+/*
+ * Poco F1: QUP firmware runs SE14 in GSI-only mode (GENI_IF_DISABLE_RO
+ * FIFO_IF_DISABLE; Linux drives it through GPI DMA). Without a GPI driver
+ * the bus is bit-banged on its own pins as plain GPIOs: open drain by
+ * switching output enable (the board pulls SDA/SCL up), ~100 kHz.
+ */
+#define BB_HALF_US 5u
+static void
+bb_line(unsigned pin, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	if (high) {
+		touch_wr(st.gpio, off, touch_rd(st.gpio, off) & ~0x200u);    /* release */
+	} else {
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin), touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u);
+		touch_wr(st.gpio, off, touch_rd(st.gpio, off) | 0x200u);     /* drive low */
+	}
+}
+
+static bool
+bb_get(unsigned pin)
+{
+	return touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & 1u;
+}
+
+static bool
+bb_scl_high(void)
+{
+	bb_line(tb->scl, true);
+	for (unsigned i = 0; i < 1000; ++i) {      /* clock stretching, <= 1 ms */
+		if (bb_get(tb->scl)) {
+			delay(BB_HALF_US);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+bb_start(void)
+{
+	bb_line(tb->sda, true);
+	if (!bb_scl_high()) {
+		return false;
+	}
+	bb_line(tb->sda, false);
+	delay(BB_HALF_US);
+	bb_line(tb->scl, false);
+	delay(BB_HALF_US);
+	return true;
+}
+
+static void
+bb_stop(void)
+{
+	bb_line(tb->sda, false);
+	delay(BB_HALF_US);
+	(void)bb_scl_high();
+	bb_line(tb->sda, true);
+	delay(BB_HALF_US);
+}
+
+/* Returns 0 on ACK, ENXIO on NACK, ETIMEDOUT if SCL is held low. */
+static int
+bb_write(uint8_t v)
+{
+	for (int b = 7; b >= 0; --b) {
+		bb_line(tb->sda, (v >> b) & 1u);
+		delay(BB_HALF_US);
+		if (!bb_scl_high()) {
+			return ETIMEDOUT;
+		}
+		bb_line(tb->scl, false);
+	}
+	bb_line(tb->sda, true);
+	delay(BB_HALF_US);
+	if (!bb_scl_high()) {
+		return ETIMEDOUT;
+	}
+	bool nack = bb_get(tb->sda);
+	bb_line(tb->scl, false);
+	delay(BB_HALF_US);
+	return nack ? ENXIO : 0;
+}
+
+static int
+bb_read(uint8_t *v, bool ack)
+{
+	uint8_t x = 0;
+	bb_line(tb->sda, true);
+	for (int b = 7; b >= 0; --b) {
+		delay(BB_HALF_US);
+		if (!bb_scl_high()) {
+			return ETIMEDOUT;
+		}
+		x |= (uint8_t)(bb_get(tb->sda) << b);
+		bb_line(tb->scl, false);
+	}
+	bb_line(tb->sda, !ack);
+	delay(BB_HALF_US);
+	if (!bb_scl_high()) {
+		return ETIMEDOUT;
+	}
+	bb_line(tb->scl, false);
+	bb_line(tb->sda, true);
+	*v = x;
+	return 0;
+}
+
+static int
+bb_xfer(uint8_t addr, const uint8_t *reg, unsigned nreg, uint8_t *buf, unsigned len)
+{
+	int err = bb_start() ? 0 : ETIMEDOUT;
+	if (!err) {
+		err = bb_write((uint8_t)(addr << 1));
+	}
+	for (unsigned i = 0; !err && i < nreg; ++i) {
+		err = bb_write(reg[i]);
+	}
+	if (!err && len) {
+		err = bb_start() ? 0 : ETIMEDOUT;         /* repeated START */
+		if (!err) {
+			err = bb_write((uint8_t)(addr << 1) | 1u);
+		}
+		for (unsigned i = 0; !err && i < len; ++i) {
+			err = bb_read(&buf[i], i + 1 < len);
+		}
+	}
+	bb_stop();
+	if (st.probing) {
+		printf("SWEET TOUCH: bb addr=%#x reg=%#x len=%u err=%d sda=%d scl=%d\n",
+		    addr, nreg ? reg[0] : 0, len, err, bb_get(tb->sda), bb_get(tb->scl));
 	}
 	return err;
 }
