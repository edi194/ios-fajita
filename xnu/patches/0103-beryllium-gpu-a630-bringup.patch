+static uint32_t
+gpu_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gpu_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Poll until (reg & mask) == want; true on success. */
+static bool
+gpu_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned i = 0; i <= us; i++) {
+		if ((gpu_rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* GPU core register N (dword index). Only valid with GX on and OOB_GPU held. */
+static uint32_t
+gpu_r(uint32_t reg)
+{
+	return gpu_rd(gpu_regs, R(reg));
+}
+
+static void
+gpu_w(uint32_t reg, uint32_t value)
+{
+	gpu_wr(gpu_regs, R(reg), value);
+}
+
+static void
+gpu_w64(uint32_t reg, uint64_t value)
+{
+	gpu_w(reg, (uint32_t)value);
+	gpu_w(reg + 1, (uint32_t)(value >> 32));
+}
+
+static void
+sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	static int chan;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
