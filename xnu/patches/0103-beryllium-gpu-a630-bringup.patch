+	return fw_from_adt(adt_prop, buf, len) || fw_from_file(file, buf, len);
+}
+
+void
+sweet_a630_fw_put(void *buf, size_t len)
+{
+	if (buf) {
+		kfree_data(buf, (vm_size_t)len);
+	}
+}
