+/* ------------------------------------------------------------------ */
+/* Firmware: /usr/standalone/firmware/sweet/ in the root, or the ADT   */
+/* ------------------------------------------------------------------ */
+
+#define FW_DIR          "/usr/standalone/firmware/sweet/"
+#define FW_MAX          0x40000u
+
+static bool
+fw_from_adt(const char *prop, void **buf, size_t *len)
+{
+	DTEntry node;
+	const void *data = NULL;
+	unsigned int size = 0;
+
+	if (!prop || SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, prop, &data, &size) != kSuccess || size == 0 || size > FW_MAX) {
+		return false;
+	}
+	void *copy = kalloc_data(size, Z_WAITOK | Z_ZERO);
+	if (!copy) {
+		return false;
+	}
+	memcpy(copy, data, size);       /* unaligned ADT property: byte-copy into an aligned buffer */
+	*buf = copy;
+	*len = size;
+	return true;
+}
+
+static bool
+fw_from_file(const char *file, void **buf, size_t *len)
+{
+	char path[128];
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int error;
+
+	if (!file || rootvnode == NULLVP) {
+		return false;
+	}
+	snprintf(path, sizeof(path), "%s%s", FW_DIR, file);
+	vfs_context_t ctx = vfs_context_kernel();
+	if (vnode_lookup(path, 0, &vp, ctx) != 0 || vp == NULLVP) {
+		return false;
+	}
+	error = vnode_size(vp, &size, ctx);
+	if (error || size <= 0 || size > FW_MAX) {
+		vnode_put(vp);
+		return false;
+	}
+	void *copy = kalloc_data((vm_size_t)size, Z_WAITOK | Z_ZERO);
+	if (!copy) {
+		vnode_put(vp);
+		return false;
+	}
+	int resid = 0;
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)copy, (int)size, 0, UIO_SYSSPACE,
+	    IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (error || resid) {
+		kfree_data(copy, (vm_size_t)size);
+		return false;
+	}
+	*buf = copy;
+	*len = (size_t)size;
+	return true;
+}
