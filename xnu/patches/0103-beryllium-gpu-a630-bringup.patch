+/*
+ * One physically contiguous block switched to normal non-cacheable
+ * (VM_WIMG_WCOMB) so the SMMU walker, GMU, CP and CPU all see the same
+ * bytes (device memory types on managed RAM are refused by the pmap).
+ * __ARM_COHERENT_IO__ builds make flush_dcache* no-ops, so the lines dirtied
+ * by the zeroing are cleaned and invalidated explicitly (sweet_dma_sync_va,
+ * dc civac) before and after the attribute change. pmap_set_cache_attributes
+ * on kernel RAM above 4 GiB needs the 64-bit fix of this patch
+ * (pmap_sync_page_attributes_phys).
+ */
+static bool
+dma_alloc(vm_size_t size, vm_offset_t *va, uint64_t *pa)
+{
+	vm_offset_t kva;
+
+	if (kmem_alloc_contig(kernel_map, &kva, size, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPU: no contiguous DMA memory (%lu bytes)\n", (unsigned long)size);
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (!pn) {
+		return false;
+	}
+	for (unsigned i = 1; i < size / PAGE_SIZE; i++) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(kva + i * PAGE_SIZE)) != pn + i) {
+			printf("SWEET GPU: DMA block not physically contiguous\n");
+			return false;
+		}
+	}
+	sweet_dma_sync_va((const void *)kva, size);
+	for (unsigned i = 0; i < size / PAGE_SIZE; i++) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	sweet_dma_sync_va((const void *)kva, size);
+	*va = kva;
+	*pa = ptoa_64(pn);
+	return true;
+}
