 #define GPU_VA_CP_RING        0x40000000u
 #define GPU_VA_CP_SQE         0x40010000u
 #define GPU_VA_CP_SCRATCH     0x40020000u
+/* stage 7: the CP's registers (dword indexes, byte = 4 * N), from a6xx.xml */
+#define A6XX_RBBM_VBIF_CLIENT_QOS_CNTL 0x0010u
+#define A6XX_RBBM_INTERFACE_HANG_INT_CNTL 0x001fu
+#define A6XX_RBBM_PERFCTR_GPU_BUSY_MASKED 0x050bu
+#define A6XX_CP_RB_BASE        0x0800u
+#define A6XX_CP_RB_CNTL        0x0802u
+#define A6XX_CP_RB_RPTR_ADDR   0x0804u
+#define A6XX_CP_RB_RPTR        0x0806u
+#define A6XX_CP_RB_WPTR        0x0807u
+#define A6XX_CP_SQE_CNTL       0x0808u
+#define A6XX_CP_HW_FAULT       0x0821u
+#define A6XX_CP_INTERRUPT_STATUS 0x0823u
+#define A6XX_CP_STATUS_1       0x0825u
+#define A6XX_CP_SQE_INSTR_BASE 0x0830u
+#define A6XX_CP_ADDR_MODE_CNTL 0x0842u
+#define A6XX_CP_ROQ_THRESHOLDS_1 0x08c1u
+#define A6XX_CP_ROQ_THRESHOLDS_2 0x08c2u
+#define A6XX_CP_MEM_POOL_SIZE  0x08c3u
+#define A6XX_CP_AHB_CNTL       0x098du
+#define A6XX_UCHE_ADDR_MODE_CNTL 0x0e00u
+#define A6XX_UCHE_WRITE_RANGE_MAX 0x0e05u
+#define A6XX_UCHE_WRITE_THRU_BASE 0x0e07u
+#define A6XX_UCHE_TRAP_BASE    0x0e09u
+#define A6XX_UCHE_GMEM_RANGE_MIN 0x0e0bu
+#define A6XX_UCHE_GMEM_RANGE_MAX 0x0e0du
+#define A6XX_UCHE_CACHE_WAYS   0x0e17u
+#define A6XX_UCHE_FILTER_CNTL  0x0e18u
+#define A6XX_UCHE_CLIENT_PF    0x0e19u
+#define A6XX_VSC_ADDR_MODE_CNTL 0x0c01u
+#define A6XX_GRAS_ADDR_MODE_CNTL 0x8601u
+#define A6XX_RB_ADDR_MODE_CNTL 0x8e05u
+#define A6XX_PC_DBG_ECO_CNTL   0x9e00u
+#define A6XX_PC_ADDR_MODE_CNTL 0x9e01u
+#define A6XX_VPC_ADDR_MODE_CNTL 0x9601u
+#define A6XX_VFD_ADDR_MODE_CNTL 0xa601u
+#define A6XX_SP_ADDR_MODE_CNTL 0xae01u
+#define A6XX_TPL1_ADDR_MODE_CNTL 0xb601u
+#define A6XX_HLSQ_ADDR_MODE_CNTL 0xbe05u
+#define A6XX_VBIF_GATE_OFF_WRREQ_EN 0x302au
+#define CP_RB_CNTL_VALUE       ((1u << 27) | (2u << 8) | 12u)
 #define GPU_GMU_SPTPRAC_STATUS 0x14340u  /* 0x50d0 */
 #define GPU_GMU_BOOT_SLUMBER  0x8fe0u   /* 0x23f8 */
