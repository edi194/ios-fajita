+/*
+ * fajita: a client fence that never came back. If RPTR is still behind WPTR the CP stopped inside a command
+ * buffer; if RPTR caught up, the CP read everything and only the fence write is missing - which would be our
+ * scratch mapping, not the GPU. The fault registers say which packet or access it died on.
+ */
+void
+sweet_gpu_dump_cp_state(const char *why)
+{
+	vm_offset_t core = gpu_core;
+
+	if (core == 0) {
+		printf("SWEET GPU: %s: no core mapping\n", why);
+		return;
+	}
+	printf("SWEET GPU: %s: rptr %u wptr %u rbbm_status %#x cp_status1 %#x hw_fault %#x "
+	    "irq %#x protect %#x rbbm_irq %#x sqe_cntl %#x\n", why,
+	    gpu_cp_rd(core, A6XX_CP_RB_RPTR), gpu_cp_wptr,
+	    gpu_cp_rd(core, A6XX_RBBM_STATUS), gpu_cp_rd(core, A6XX_CP_STATUS_1),
+	    gpu_cp_rd(core, A6XX_CP_HW_FAULT), gpu_cp_rd(core, A6XX_CP_INTERRUPT_STATUS),
+	    gpu_cp_rd(core, A6XX_CP_PROTECT_STATUS), gpu_cp_rd(core, A6XX_RBBM_INT_0_STATUS),
+	    gpu_cp_rd(core, A6XX_CP_SQE_CNTL));
+}
+
 /* a6xx_cp_init: enable the SQE (this starts the engine) and let it configure the
  * ME. Completion is polled because RBBM_INT_0_MASK stays 0 - no interrupts. */
 static bool
