+/* the controller woke up on its own (0xfd): acknowledge it with 0xfc, between packets only */
+static void
+wl_ibs_service(void)
+{
+	if (wl.ibs_ack_pending) {
+		uint8_t b = IBS_WAKE_ACK;
+		wl.ibs_ack_pending = false;
+		(void)wl_tx(&b, 1, wl.baud ? wl.baud : 115200);
+		if (wl.ibs_logged < 16) {
+			wl.ibs_logged++;
+			printf("SWEET WLAN: BT IBS: TX WAKE_ACK (0xfc)\n");
+		}
+	}
+}
+
+/* host side: before a packet, wake a sleeping controller with 0xfd and wait (bounded) for 0xfc */
+static void
+wl_ibs_wake(void)
+{
+	if (!wl.ibs_asleep) {
+		return;
+	}
+	uint8_t b = IBS_WAKE_IND;
+	(void)wl_tx(&b, 1, wl.baud ? wl.baud : 115200);
+	for (unsigned t = 0; t < 500 && wl.ibs_asleep; t++) {
+		wl_rx_poll();
+		if (wl.ibs_asleep) {
+			delay(1000);
+		}
+	}
+	if (wl.ibs_logged < 16) {
+		wl.ibs_logged++;
+		printf("SWEET WLAN: BT IBS: TX WAKE_IND (0xfd), %s\n", wl.ibs_asleep ? "no WAKE_ACK within 500 ms, sending anyway" :
+		    "WAKE_ACK (or WAKE_IND) received");
+	}
+	wl.ibs_asleep = false;
+	wl_ibs_service();
+}
