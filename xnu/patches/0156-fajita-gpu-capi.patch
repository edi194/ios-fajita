+/* ---- stage 8f: the surface the user client will call ------------------- */
+
+static bool gpu_lost;
+static struct gpu_extent gpu_free_ext[GPU_EXTENT_MAX];
+
+static bool
+sweet_gpu_ready(void)
+{
+	return gpu_live && !gpu_lost;
+}
+
+static uint32_t
+sweet_gpu_selector(void)
+{
+	return gpu_live ? 1u : 0u;
+}
+
+/* The msm answers a winsys asks for before it does anything else. */
+static bool
+sweet_gpu_param(uint32_t param, uint64_t *value)
+{
+	if (!gpu_live) {
+		return false;
+	}
+	switch (param) {
+	case GPU_PARAM_GPU_ID:
+		*value = 630;
+		break;
+	case GPU_PARAM_CHIP_ID:
+		*value = 0x06030001u;
+		break;
+	case GPU_PARAM_GMEM_SIZE:
+		*value = 0x100000u;
+		break;
+	case GPU_PARAM_MAX_FREQ:
+		*value = 710000000u;
+		break;
+	case GPU_PARAM_TIMESTAMP:
+		/* the CP's last CACHE_FLUSH_TS value: monotonic across submissions */
+		*value = *(volatile uint32_t *)(gpu_blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE);
+		break;
+	case GPU_PARAM_GMEM_BASE:
+		*value = 0x100000u;
+		break;
+	case GPU_PARAM_VA_START:
+		*value = GPU_VA_BASE;
+		break;
+	case GPU_PARAM_VA_SIZE:
+		*value = gpu_arena_size;
+		break;
+	default:
+		return false;
+	}
+	return true;
+}
+
+static bool
+sweet_gpu_fence_done(uint32_t fence)
+{
+	if (!gpu_live || fence == 0) {
+		return false;
+	}
+	return *(volatile uint32_t *)(gpu_blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE) >= fence;
+}
+
+static uint32_t
+sweet_gpu_fence_last(void)
+{
+	return gpu_last_fence;
+}
+
+/* Arena space comes back so a client can allocate all day. */
+static uint32_t
+gpu_extent_alloc(uint32_t size)
+{
+	for (unsigned i = 0; i < GPU_EXTENT_MAX; i++) {
+		if (gpu_free_ext[i].size >= size) {
+			uint32_t off = gpu_free_ext[i].off;
+			gpu_free_ext[i].off += size;
+			gpu_free_ext[i].size -= size;
+			if (gpu_free_ext[i].size == 0) {
+				gpu_free_ext[i].size = 0;
+			}
+			return off;
+		}
+	}
+	return gpu_arena_used;   /* fresh space, or past the end and refused by the caller */
+}
+
+static void
+gpu_extent_free(uint32_t off, uint32_t size)
+{
+	for (unsigned i = 0; i < GPU_EXTENT_MAX; i++) {
+		if (gpu_free_ext[i].size == 0) {
+			gpu_free_ext[i].off = off;
+			gpu_free_ext[i].size = size;
+			return;
+		}
+	}
+}
+
+static bool
+sweet_gpu_iova_alloc(uint32_t size, uint32_t *off)
+{
+	if (!gpu_live || size == 0 || (size & 0xfffu) || size > gpu_arena_size) {
+		return false;
+	}
+	uint32_t o = gpu_extent_alloc(size);
+	if (o + size > gpu_arena_size) {
+		return false;
+	}
+	if (o == gpu_arena_used) {
+		gpu_arena_used += size;
+	}
+	*off = o;
+	return true;
+}
+
+static void
+sweet_gpu_iova_free(uint32_t off, uint32_t size)
+{
+	if (size) {
+		gpu_extent_free(off, size);
+	}
+}
+
+static bool
+sweet_gpu_vm_map(uint32_t off, uint32_t size)
+{
+	if (!gpu_live || off + size > gpu_arena_size) {
+		return false;
+	}
+	return gpu_pt_map(GPU_VA_BASE + off, gpu_arena_pa + off, size);
+}
+
+static void
+sweet_gpu_vm_unmap(uint32_t off, uint32_t size)
+{
+	volatile uint64_t *l3 = (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L3);
+	uint32_t va = GPU_VA_BASE + off;
+
+	for (uint32_t o = 0; o < size; o += 0x1000) {
+		l3[((va + o) >> 12) & 0x1ff] = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * The arena is mapped uncached through ml_io_map and the GPU's PTEs are non-cacheable,
+ * so there is nothing to write back here. The call exists because a client must be able
+ * to ask, and because the day a buffer comes from cacheable memory this is where the
+ * flush goes.
+ */
+static void
+sweet_gpu_bo_sync(uint32_t off, uint32_t size)
+{
+	if (!gpu_live || off + size > gpu_arena_size) {
+		return;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sweet_gpu_cache_sync(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sweet_gpu_mark_lost(const char *why)
+{
+	gpu_lost = true;
+	printf("SWEET GPU: marked lost: %s\n", why ? why : "unspecified");
+}
+
+static void
+sweet_gpu_report(void)
+{
+	printf("SWEET GPU: report: live %d lost %d ring wptr %u fence %u\n",
+	    gpu_live ? 1 : 0, gpu_lost ? 1 : 0, gpu_cp_wptr, gpu_last_fence);
+}
+
