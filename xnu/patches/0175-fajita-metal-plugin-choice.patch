--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -227,13 +227,23 @@
 		 * or MetalPluginClassName) to -initWithAcceleratorPort:. Until this
 		 * patch the service had no name, so Metal found it and passed it over.
 		 */
-		bool named = accel->setProperty("MetalPluginName", "SweetMetalProbe") &&
-		    accel->setProperty("MetalPluginClassName", "SweetMetalDevice");
+		/*
+		 * Which plugin Metal loads is a boot argument, not a build: metalplugin=1 names the real
+		 * one, SweetBGMTL - Chlorophyll's BGMTLDevice over libbgair, which opens this port's GPU -
+		 * and the default keeps the stub that declines. Both bundles live in
+		 * /System/Library/Extensions, so backing out a misbehaving device is a boot_a flash.
+		 */
+		uint32_t realPlugin = 0;
+		(void)PE_parse_boot_argn("metalplugin", &realPlugin, sizeof(realPlugin));
+		const char *pluginName = realPlugin ? "SweetBGMTL" : "SweetMetalProbe";
+		const char *pluginClass = realPlugin ? "BGMTLDevice" : "SweetMetalDevice";
+		bool named = accel->setProperty("MetalPluginName", pluginName) &&
+		    accel->setProperty("MetalPluginClassName", pluginClass);
 		accel->setName("sgx");
 		if (accel->attach(this)) {
 			accel->registerService();
-			IOLog("SWEET FB: IOAcceleratorES published, MetalPluginName SweetMetalProbe"
-			    " (properties set: %s)\n", named ? "yes" : "NO");
+			IOLog("SWEET FB: IOAcceleratorES published, MetalPluginName %s class %s"
+			    " (properties set: %s)\n", pluginName, pluginClass, named ? "yes" : "NO");
 		}
 	}
 	OSSafeReleaseNULL(accel);
