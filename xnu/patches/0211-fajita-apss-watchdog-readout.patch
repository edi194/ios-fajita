--- a/bsd/dev/sweet_reboot.c
+++ b/bsd/dev/sweet_reboot.c
@@ -140,3 +140,41 @@
 		printf("SWEET REBOOT: armed for %u s (%s)\n", seconds, to ? "bootloader" : "reboot");
 	}
 }
+
+/*
+ * fajita: the APSS watchdog. Two boots have now died with no panic text at all - panic() calls
+ * sweet_early_panic() (which draws on the panel) and sweet_log_panic_flush() (which marks the ring with
+ * seq 0xffffffff), and neither left a trace - so the CPU never reached panic(): something reset the SoC
+ * underneath it. The bootloader arms the APSS watchdog (Linux's qcom-wdt exists for exactly this reason)
+ * and this kernel never pets it, so this reads it out first. sweetwdt=1 clears the enable bit; the default
+ * only reports, because a wrong write here would reboot the phone in a loop.
+ */
+#define SWEET_APSS_WDT_PA   0x17980000UL
+#define SWEET_WDT_EN        0x04u
+#define SWEET_WDT_BITE      0x24u
+
+void
+sweet_wdt_probe(void)
+{
+	int mode = 0;
+	vm_offset_t w;
+	uint32_t en, bite;
+
+	(void)PE_parse_boot_argn("sweetwdt", &mode, sizeof(mode));
+	w = ml_io_map(SWEET_APSS_WDT_PA, 0x1000);
+	if (w == 0) {
+		printf("SWEET WDT: map failed\n");
+		return;
+	}
+	en = *(volatile uint32_t *)(w + SWEET_WDT_EN);
+	bite = *(volatile uint32_t *)(w + SWEET_WDT_BITE);
+	printf("SWEET WDT: apss en %#x bite %#x (%s), mode %d\n", en, bite,
+	    (en & 1u) ? "ARMED" : "off", mode);
+
+	if (mode == 1 && (en & 1u)) {
+		*(volatile uint32_t *)(w + SWEET_WDT_EN) = 0;
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("SWEET WDT: enable cleared, reads back %#x\n",
+		    *(volatile uint32_t *)(w + SWEET_WDT_EN));
+	}
+}
