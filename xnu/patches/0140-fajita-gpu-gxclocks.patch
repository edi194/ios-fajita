+				/* The five clocks still off here (Bergamota's gpucc table). */
+				{
+					static const struct { const char *what; uint32_t off; } clk[] = {
+						{ "gpucc cx_apb",      0x1088u },
+						{ "gpucc cx_snoc_dvm", 0x108cu },
