 static int
+ufs_find_partition(const char *want)
+{
+	uint64_t first = 0, nblocks = 0;
+	int error = ufs_partition_extent(want, &first, &nblocks);
+
+	if (error == 0) {
+		su.first_block = first;
+		su.nblocks = nblocks;
+	}
+	return error;
+}
+
+/*
+ * Write a small blob into a named partition: read the covering blocks, merge, write back, synchronise. Used
+ * for the "boot-fastboot" command in `misc`, which every AOSP bootloader reads before deciding what to start.
+ */
+int
+sweet_ufs_write_named(const char *name, uint64_t offset, const void *data, size_t len)
+{
+	uint64_t first = 0, nblocks = 0;
+	uint8_t *bounce = (uint8_t *)(su.dma + DMA_BOUNCE);
+	int error;
+
+	if (!su.ready || name == NULL || data == NULL || len == 0 || len > BOUNCE_SIZE) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_partition_extent(name, &first, &nblocks);
+	if (error == 0 && (offset + len) > nblocks * UFS_BLOCK) {
+		error = EINVAL;
+	}
+	if (error == 0) {
+		uint64_t lba = offset / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(offset % UFS_BLOCK);
+		uint32_t blocks = (uint32_t)((skip + len + UFS_BLOCK - 1) / UFS_BLOCK);
+
+		error = ufs_read_blocks(first + lba, blocks);
+		if (error == 0) {
+			memcpy(bounce + skip, data, len);
+			error = ufs_write_blocks(first + lba, blocks, first, nblocks);
+		}
+		if (error == 0) {
+			error = ufs_sync_cache();
+		}
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		printf("SWEET UFS: write to \"%s\" at %llu failed (%d)\n", name,
+		    (unsigned long long)offset, error);
+	}
+	return error;
+}
