--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -153,6 +153,27 @@
 #define GPU_SMMU_CB_TTBR0     0x020u
 #define GPU_SMMU_CB_TCR       0x030u
 #define GPU_SMMU_CB_FSR       0x058u
+#define GPU_SMMU_S2CR_BYPASS   (1u << 16)   /* [17:16]: 0 translate, 1 bypass, 2 fault */
+
+/* stage 3d: what the GMU firmware needs (all GMU_WORD(n) = 4n from the GMU base) */
+#define GPU_GMU_HFI_SFR       0x14608u      /* 0x5182: which GPU this is */
+#define GPU_GMU_HFI_QTBL_INFO 0x14610u      /* 0x5184 */
+#define GPU_GMU_HFI_QTBL_ADDR 0x14614u      /* 0x5185: the HFI table, 32 bits */
+#define GPU_GMU_PWR_COL_CP_MSG 0x14400u     /* 0x5100: where the log is, and its pages - 1 */
+#define GPU_GMU_PWR_COL_CP_RESP 0x14404u    /* 0x5101 */
+#define GPU_GMU_AHB_FENCE_RANGE 0x24c44u    /* 0x9311 */
+#define GPU_GMU_SYS_BUS_CONFIG 0x1303cu     /* 0x4c0f */
+#define GPU_GMU_ICACHE_CONFIG  0x13000u     /* 0x4c00 */
+#define GPU_GMU_DCACHE_CONFIG  0x13004u     /* 0x4c01 */
+#define GPU_GMU_RPMH_CTRL      0x143a0u     /* 0x50e8 */
+#define GPU_GMU_FW_RUNNING     0xbabefaceu  /* FW_INIT_RESULT once a630's firmware runs */
+#define GPU_GMU_CHIPID         0x06030100u  /* 0x06030001 massaged the way the GMU wants it */
+
+/* The low bank: DRAM the ADT does not declare (it starts at 0x100000000) and
+ * whose reserved-memory carve-outs all end below 0xac800000. */
+#define GPU_SCRATCH_PA         0x0b000000u
+#define GPU_SCRATCH_HFI        0x0000u      /* table and two queues, 12 KB */
+#define GPU_SCRATCH_LOG        0x8000u      /* four pages of firmware log */
 
 static void
 gpu_probe_wr(const char *what, vm_offset_t base, uint32_t off, uint32_t val)
@@ -456,5 +477,103 @@
 	    gpu_rd_quiet(smmu, GPU_SMMU_PAGE + GPU_SMMU_CB_TCR),
 	    gpu_rd_quiet(smmu, GPU_SMMU_PAGE + GPU_SMMU_CB_FSR));
 	printf("SWEET GPU: stage 3b done\n");
+	if (level < 7) {
+		return;
+	}
+
+	/* ---- stage 3c: bypass for the GPU's streams -------------------------- */
+	printf("SWEET GPU: --- stage 3c: smmu bypass\n");
+	for (uint32_t i = 0; i < 5; i++) {
+		uint32_t v = gpu_rd_quiet(smmu, GPU_SMMU_S2CR(i));
+		if (((v >> 16) & 3u) != 1u) {
+			gpu_probe_wr("smmu s2cr", smmu, GPU_SMMU_S2CR(i), (v & ~(3u << 16)) | GPU_SMMU_S2CR_BYPASS);
+			v = gpu_rd_quiet(smmu, GPU_SMMU_S2CR(i));
+		}
+		printf("SWEET GPU: smmu s2cr[%u] %#x (%s)\n", i, v, ((v >> 16) & 3u) == 1u ? "bypass" : "not bypassed");
+	}
+	printf("SWEET GPU: stage 3c done\n");
+
+	/* ---- stage 3d: the HFI table, the log, and the reset ------------------ */
+	printf("SWEET GPU: --- stage 3d: hfi and reset\n");
+	vm_offset_t hfi = ml_io_map(GPU_SCRATCH_PA + GPU_SCRATCH_HFI, 0x4000);
+	vm_offset_t log = ml_io_map(GPU_SCRATCH_PA + GPU_SCRATCH_LOG, 0x4000);
+	if (hfi == 0 || log == 0) {
+		printf("SWEET GPU: cannot map the GMU's scratch memory\n");
+		return;
+	}
+	uint32_t hfi_pa = GPU_SCRATCH_PA + GPU_SCRATCH_HFI;
+	uint32_t log_pa = GPU_SCRATCH_PA + GPU_SCRATCH_LOG;
+
+	struct hfi_queue_header {
+		uint32_t status, iova, type, size, msg_size, dropped;
+		uint32_t rx_watermark, tx_watermark, rx_request, tx_request, read_index, write_index;
+	};
+	struct hfi_table_header {
+		uint32_t version, size, qhdr0_offset, qhdr_size, num_queues, active_queues;
+	};
+
+	for (uint32_t off = 0; off < 0x4000; off += 4) {
+		*(volatile uint32_t *)(hfi + off) = 0;
+		*(volatile uint32_t *)(log + off) = 0;
+	}
+	volatile struct hfi_table_header *const table = (volatile struct hfi_table_header *)hfi;
+	volatile struct hfi_queue_header *const queue = (volatile struct hfi_queue_header *)(hfi + sizeof(*table));
+
+	table->version = 0;
+	table->size = sizeof(*table) + 2 * sizeof(*queue);
+	table->qhdr0_offset = sizeof(*table) / 4;
+	table->qhdr_size = sizeof(*queue) / 4;
+	table->num_queues = 2;
+	table->active_queues = 2;
+	for (uint32_t i = 0; i < 2; i++) {
+		queue[i].status = 1;
+		queue[i].iova = hfi_pa + 0x1000 * (i + 1);
+		queue[i].type = (10u << 8) | (i == 0 ? 0u : 4u);   /* 4: a630's legacy response queue */
+		queue[i].size = 0x1000 / 4;
+		queue[i].rx_watermark = 1;
+		queue[i].tx_watermark = 1;
+		queue[i].rx_request = 1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	printf("SWEET GPU: hfi table at %#x: %#x %#x %#x %#x %#x %#x, queue0 %#x %#x %#x\n", hfi_pa,
+	    table->version, table->size, table->qhdr0_offset, table->qhdr_size, table->num_queues,
+	    table->active_queues, queue[0].status, queue[0].iova, queue[0].type);
+
+	gpu_probe_wr("gmu hfi sfr", gmu, GPU_GMU_HFI_SFR, GPU_GMU_CHIPID);
+	gpu_probe_wr("gmu hfi qtbl info", gmu, GPU_GMU_HFI_QTBL_INFO, 1);
+	gpu_probe_wr("gmu hfi qtbl addr", gmu, GPU_GMU_HFI_QTBL_ADDR, hfi_pa);
+	gpu_probe_wr("gmu log address", gmu, GPU_GMU_PWR_COL_CP_MSG, log_pa | 3u);
+	gpu_probe_wr("gmu sys bus", gmu, GPU_GMU_SYS_BUS_CONFIG, 0x1);
+	gpu_probe_wr("gmu icache", gmu, GPU_GMU_ICACHE_CONFIG, 0x1);
+	gpu_probe_wr("gmu dcache", gmu, GPU_GMU_DCACHE_CONFIG, 0x1);
+	/* The RPMh interface is left alone: enabling it without the PDC/RSCC
+	 * handshake first could leave the firmware waiting for votes nobody
+	 * answers. Its mask (0xf11) is the next thing to try if it will not run. */
+	gpu_probe_wr("gmu boot config", gmu, GPU_GMU_BOOT_CONFIG, 0x02);
+	gpu_probe_wr("gmu fence range", gmu, GPU_GMU_AHB_FENCE_RANGE, 0x80000000u | (0xau << 18) | 0xa0u);
+	gpu_probe_wr("gmu cm3 cfg", gmu, GPU_GMU_CM3_CFG, 0x4052);
+
+	/* out of reset */
+	gpu_probe_wr("gmu fw_init", gmu, GPU_GMU_FW_INIT, 0);
+	gpu_probe_wr("gmu sysreset", gmu, GPU_GMU_SYSRESET, 1);
+	gpu_probe_wr("gmu log write ptr", gmu, GPU_GMU_PWR_COL_CP_RESP, 0);
+	gpu_probe_wr("gmu sysreset", gmu, GPU_GMU_SYSRESET, 0);
+
+	uint32_t init = 0;
+	for (int i = 0; i < 200; i++) {
+		init = gpu_rd_quiet(gmu, GPU_GMU_FW_INIT);
+		if (init == GPU_GMU_FW_RUNNING) {
+			break;
+		}
+		gpu_wait_ms(1);
+	}
+	printf("SWEET GPU: fw_init %#x %s, hfi status %#x, sptprac %#x, itcm[0] %#x\n", init,
+	    init == GPU_GMU_FW_RUNNING ? "(THE GMU FIRMWARE RUNS)" : "(the firmware did not start)",
+	    gpu_rd_quiet(gmu, GPU_GMU_HFI_STATUS), gpu_rd_quiet(gmu, GPU_GMU_SPTPRAC),
+	    gpu_rd_quiet(gmu, GPU_GMU_ITCM));
+	printf("SWEET GPU: log first words %#x %#x %#x %#x\n",
+	    *(volatile uint32_t *)(log + 0), *(volatile uint32_t *)(log + 4),
+	    *(volatile uint32_t *)(log + 8), *(volatile uint32_t *)(log + 12));
+	printf("SWEET GPU: stage 3d done\n");
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
