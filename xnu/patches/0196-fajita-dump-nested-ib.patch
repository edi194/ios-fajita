+				for (uint32_t at = 0; at < words;) {
+					uint32_t h = q[at];
+
+					if ((h & 0xf0000000u) == 0x40000000u) {
+						at += 1 + (h & 0x7fu);
+						continue;
+					}
+					if ((h & 0xf0000000u) != 0x70000000u) {
+						break;
+					}
