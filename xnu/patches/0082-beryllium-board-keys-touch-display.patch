+static unsigned nvt_max = TOUCH_MAX;
+
+/* One frame lists every active contact; slots missing from it are released. */
+static int
+touch_novatek(void)
+{
+	uint8_t buf[NVT_RECORD * TOUCH_MAX];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(NVT_ADDR, 0, false, buf, NVT_RECORD * nvt_max);
+	if (err) {
+		return err;
+	}
+	for (unsigned i = 0; i < nvt_max; ++i) {
+		const uint8_t *p = buf + NVT_RECORD * i;
+		if (p[0] == 0xffu) {
+			continue;
+		}
+		unsigned slot = p[0] >> 3, type = p[0] & 7u;
+		if (slot < 1 || slot > nvt_max) {
+			continue;
+		}
+		if (type == 3u) {
+			continue; /* release */
+		}
+		if (type != 1u && type != 2u) {
+			continue;
+		}
+		unsigned px = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		unsigned py = ((unsigned)p[2] << 4) | (p[3] & 15u);
+		if (px >= tb->w || py >= tb->h) {
+			return EIO;
+		}
+		mask |= 1u << (slot - 1);
+		x[slot - 1] = (int)px;
+		y[slot - 1] = (int)py;
 	}
 	touch_report(mask, x, y);
 	return 0;
 }
 
+static int
+touch_nvt_params(void)
+{
+	uint8_t p[NVT_PARAMS_LEN];
+	memset(p, 0xa5, sizeof(p));
+	int err = touch_read(NVT_ADDR, NVT_PARAMS_REG, false, p, sizeof(p));
+	printf("SWEET TOUCH: nvt params err=%d: %02x %02x %02x %02x w=%u h=%u max=%u buttons=%u irq-type=%u chip=%#x\n",
+	    err, p[0], p[1], p[2], p[3], touch_be16(p + 4), touch_be16(p + 6),
+	    p[9], p[10], p[11], p[14]);
+	if (err) {
+		return err;
+	}
+	if (p[9] == 0 || p[9] > TOUCH_MAX) {
+		return EIO;
+	}
+	if (p[14] != NVT_CHIP_ID) {
+		printf("SWEET TOUCH: nvt chip id %#x is not NT36672A (%#x); continuing\n",
+		    p[14], NVT_CHIP_ID);
+	}
+	nvt_max = p[9];
+	return 0;
+}
