+/*
+ * SWEET: emulate FJCVTZS Wd, Dn (ARMv8.3-JSCVT, absent on SDM845's Kryo 385) for
+ * 64-bit EL0 threads; used by the iOS 18 JavaScriptCore/WebCore (docs/IOS18_PORT.md).
+ * Dn is read from the thread's saved NEON state, Wd is written zero-extended,
+ * PSTATE.{N,Z,C,V} = {0, exact, 0, 0}, FPSR cumulative bits are updated and the
+ * PC moves past the instruction. Returns false (nothing changed) if the thread
+ * has no usable NEON state, in which case the caller raises the usual SIGILL.
+ */
+static bool
+sweet_emulate_fjcvtzs(arm_saved_state_t *state, uint32_t instr)
+{
+	static uint32_t sweet_fjcvtzs_logged = 0;
+	thread_t thread = current_thread();
+	arm_neon_saved_state_t *ns = thread->machine.uNeon;
+
+	if (ns == NULL || !is_neon_saved_state64(ns)) {
+		return false;
+	}
+
+	arm_neon_saved_state64_t *ns64 = neon_state64(ns);
+	const uint32_t rd = SWEET_FJCVTZS_RD(instr);
+	const uint32_t rn = SWEET_FJCVTZS_RN(instr);
+	uint32_t result = 0, fpsr_or = 0;
+	bool z = sweet_fjcvtzs_convert((uint64_t)ns64->v.q[rn], ns64->fpcr, &result, &fpsr_or);
+
+	if (rd != 31) {
+		set_saved_state_reg(state, rd, (register_t)result);     /* Wd: upper 32 bits zero */
+	}
+	ns64->fpsr |= fpsr_or;
+	set_saved_state_cpsr(state, (get_saved_state_cpsr(state) & ~(PSR64_N | PSR64_Z | PSR64_C | PSR64_V)) |
+	    (z ? PSR64_Z : 0));
+	set_saved_state_pc(state, get_saved_state_pc(state) + 4);
+
+	if (os_atomic_inc_orig(&sweet_fjcvtzs_logged, relaxed) == 0) {
+		printf("SWEET: emulating FJCVTZS (first at pc=0x%llx, w%u <- d%u)\n",
+		    (unsigned long long)(get_saved_state_pc(state) - 4), rd, rn);
+	}
+	return true;
 }
 
