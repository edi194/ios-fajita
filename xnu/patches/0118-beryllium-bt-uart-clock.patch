+static void
+wl_rcg_restore(void)
+{
+	if (!wl.rcg_saved) {
+		return;
+	}
+	printf("SWEET WLAN: restoring the original S6 RCG config\n");
+	/* the saved CFG is written verbatim (HW_CLK_CTRL included): mask = all bits */
+	bool ok = wl_wrv(wl.gcc, "GCC(restore)", RCG_S6 + RCG_M, wl.rcg_orig[1], RCG_MND_MASK);
+	ok &= wl_wrv(wl.gcc, "GCC(restore)", RCG_S6 + RCG_N, wl.rcg_orig[2], RCG_MND_MASK);
+	ok &= wl_wrv(wl.gcc, "GCC(restore)", RCG_S6 + RCG_D, wl.rcg_orig[3], RCG_MND_MASK);
+	ok &= wl_wrv(wl.gcc, "GCC(restore)", RCG_S6 + RCG_CFG, wl.rcg_orig[0], RCG_CFG_MASK);
+	ok &= wl_rcg_update();
+	printf("SWEET WLAN: S6 RCG restore %s (cbcr s6 %#x)\n", ok ? "ok" : "FAILED", wl_rd(wl.gcc, CBCR_S6));
+	wl.rcg_saved = false;
+	wl.rcg_row = -1;
+}
