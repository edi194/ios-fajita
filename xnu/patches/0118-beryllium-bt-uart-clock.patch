+/* clk-rcg2.c update_config(): set CMD_UPDATE, wait for the hardware to clear it */
+static bool
+wl_rcg_update(void)
+{
+	uint32_t cmd = wl_rd(wl.gcc, RCG_S6 + RCG_CMD);
+	wl_wr(wl.gcc, RCG_S6 + RCG_CMD, cmd | CMD_UPDATE);
+	for (unsigned i = 0; i < 2000; i++) {
+		if (!(wl_rd(wl.gcc, RCG_S6 + RCG_CMD) & CMD_UPDATE)) {
+			printf("SWEET WLAN: RCG CMD %#x -> UPDATE set (wrote %#x), cleared after %u polls, cmd now %#x\n",
+			    cmd, cmd | CMD_UPDATE, i, wl_rd(wl.gcc, RCG_S6 + RCG_CMD));
+			return true;
+		}
+		delay(10);
+	}
+	printf("SWEET WLAN: RCG UPDATE did not clear: cmd %#x\n", wl_rd(wl.gcc, RCG_S6 + RCG_CMD));
+	return false;
+}
+
+/* clk-rcg2.c __clk_rcg2_configure(): M, N, D, then CFG, then UPDATE */
+static bool
+wl_rcg_write(uint32_t m, uint32_t n, uint32_t d, uint32_t cfg_bits, bool with_mnd)
+{
+	uint32_t cfg;
+	bool ok = true;
+	if (with_mnd) {
+		ok &= wl_wrv(wl.gcc, "GCC", RCG_S6 + RCG_M, m & RCG_MND_MASK, RCG_MND_MASK);
+		ok &= wl_wrv(wl.gcc, "GCC", RCG_S6 + RCG_N, n & RCG_MND_MASK, RCG_MND_MASK);
+		ok &= wl_wrv(wl.gcc, "GCC", RCG_S6 + RCG_D, d & RCG_MND_MASK, RCG_MND_MASK);
+	}
+	cfg = (wl_rd(wl.gcc, RCG_S6 + RCG_CFG) & ~RCG_CFG_MASK) | (cfg_bits & RCG_CFG_MASK);
+	ok &= wl_wrv(wl.gcc, "GCC", RCG_S6 + RCG_CFG, cfg, RCG_CFG_MASK);
+	if (!ok) {
+		return false;
+	}
+	return wl_rcg_update();
+}
+
+static bool
+wl_rcg_save(void)
+{
+	if (wl.rcg_saved) {
+		return true;
+	}
+	if (wl_rd(wl.gcc, RCG_S6 + RCG_DFS_ENABLE) & 1) {
+		printf("SWEET WLAN: S6 RCG is in DFS mode (dfs-cmd %#x): the non-DFS path does not apply, stop\n",
+		    wl_rd(wl.gcc, RCG_S6 + RCG_DFS_ENABLE));
+		return false;
+	}
+	wl.rcg_orig[0] = wl_rd(wl.gcc, RCG_S6 + RCG_CFG);
+	wl.rcg_orig[1] = wl_rd(wl.gcc, RCG_S6 + RCG_M);
+	wl.rcg_orig[2] = wl_rd(wl.gcc, RCG_S6 + RCG_N);
+	wl.rcg_orig[3] = wl_rd(wl.gcc, RCG_S6 + RCG_D);
+	wl.rcg_saved = true;
+	printf("SWEET WLAN: S6 RCG saved: cmd %#x cfg %#x m %#x n %#x d %#x\n", wl_rd(wl.gcc, RCG_S6),
+	    wl.rcg_orig[0], wl.rcg_orig[1], wl.rcg_orig[2], wl.rcg_orig[3]);
+	return true;
+}
