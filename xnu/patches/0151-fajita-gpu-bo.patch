 #define GPU_CP_INDIRECT_BUFFER_PFE 0x3fu
 #define GPU_CP_SCRATCH_FENCE   0x200u   /* CACHE_FLUSH_TS puts the sequence here */
 #define GPU_VA_CLIENT_IB       (GPU_VA_CLIENT_TEST + 0x1000u)
+/* stage 8d: buffers (BOs) in the client address range */
+#define GPU_BO_MAX             8u
+#define GPU_VA_BASE            0x80020000u   /* after the 0149/0150 test pages */
+#define GPU_BO_MAX_BYTES       0x100000u
+
+struct gpu_bo {
+	vm_offset_t kva;        /* the kernel alias, write-combined */
+	uint64_t pa;
+	vm_size_t size;
+	uint32_t va;            /* the GPU address */
+	bool used;
+};
+
+static struct gpu_bo gpu_bos[GPU_BO_MAX];
+static uint32_t gpu_va_next;         /* bump allocator, one guard page, no reuse */
+static vm_offset_t gpu_pt_blob;      /* where the page tables live */
+
+static void
+gpu_bo_init(vm_offset_t blob)
+{
+	gpu_pt_blob = blob;
+	gpu_va_next = GPU_VA_BASE;
+	for (unsigned i = 0; i < GPU_BO_MAX; i++) {
+		gpu_bos[i].used = false;
+	}
+}
+
+/*
+ * Map [va, va+size) to [pa, pa+size) in the client range. Only the first 2 MiB are
+ * covered: that is the single L3 the payload provides (0149), and a pool comes
+ * with the ABI patch.
+ */
+static bool
+gpu_pt_map(uint32_t va, uint64_t pa, vm_size_t size)
+{
+	volatile uint64_t *l1 = (volatile uint64_t *)(gpu_pt_blob + GPU_GMEM_L1);
+	volatile uint64_t *l2 = (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L2);
+	volatile uint64_t *l3 = (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L3);
+	uint32_t l1i = (va >> 30) & 0x1ff;
+	uint32_t l2i = (va >> 21) & 0x1ff;
+
+	if (l2i != 0) {
+		printf("SWEET GPU: bo va %#x is past the first 2 MiB of the client range\n", va);
+		return false;
+	}
+	if ((l1[l1i] & 3) != GPU_PTE_TABLE) {
+		printf("SWEET GPU: bo va %#x: L1[%u] is not a table\n", va, l1i);
+		return false;
+	}
+	if ((l2[l2i] & 3) != GPU_PTE_TABLE) {
+		printf("SWEET GPU: bo va %#x: L2[%u] is not a table\n", va, l2i);
+		return false;
+	}
+	for (vm_size_t o = 0; o < size; o += 0x1000) {
+		l3[((va + o) >> 12) & 0x1ff] = (pa + o) | GPU_PTE_PAGE;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return true;
+}
+
+static struct gpu_bo *
+gpu_bo_alloc(vm_size_t size)
+{
+	struct gpu_bo *bo = NULL;
+
+	size = round_page(size);
+	if (size == 0 || size > GPU_BO_MAX_BYTES) {
+		return NULL;
+	}
+	for (unsigned i = 0; i < GPU_BO_MAX; i++) {
+		if (!gpu_bos[i].used) {
+			bo = &gpu_bos[i];
+			break;
+		}
+	}
+	if (bo == NULL) {
+		printf("SWEET GPU: bo: out of descriptors\n");
+		return NULL;
+	}
+
+	vm_offset_t kva = 0;
+	if (kmem_alloc_contig(kernel_map, &kva, size, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET GPU: bo: %lu bytes, contiguous allocation failed\n",
+		    (unsigned long)size);
+		return NULL;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (pn == 0) {
+		kmem_free(kernel_map, kva, size);
+		return NULL;
+	}
+	for (vm_size_t o = 0; o < size; o += 0x1000) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(kva + o)) != pn + o / 0x1000) {
+			printf("SWEET GPU: bo: %lu bytes not physically contiguous\n",
+			    (unsigned long)size);
+			kmem_free(kernel_map, kva, size);
+			return NULL;
+		}
+		/* The GPU's PTEs are non-cacheable: a cacheable alias would go
+		 * invisible to the CP and stale lines would overwrite its writes. */
+		pmap_set_cache_attributes(pn + o / 0x1000, VM_WIMG_WCOMB);
+	}
+
+	bo->kva = kva;
+	bo->pa = (uint64_t)pn << PAGE_SHIFT;
+	bo->size = size;
+	bo->va = gpu_va_next;
+	bo->used = true;
+	gpu_va_next += size + 0x1000;   /* one unmapped guard page between buffers */
+
+	if (!gpu_pt_map(bo->va, bo->pa, size)) {
+		bo->used = false;
+		kmem_free(kernel_map, kva, size);
+		return NULL;
+	}
+	printf("SWEET GPU: bo: %lu bytes pa %#llx va %#x kva %#lx\n", (unsigned long)size,
+	    (unsigned long long)bo->pa, bo->va, (unsigned long)kva);
+	return bo;
+}
+
+static void
+gpu_bo_free(struct gpu_bo *bo)
+{
+	if (bo == NULL || !bo->used) {
+		return;
+	}
+	volatile uint64_t *l3 = (volatile uint64_t *)(gpu_pt_blob + GPU_ARENA_L3);
+
+	for (vm_size_t o = 0; o < bo->size; o += 0x1000) {
+		l3[((bo->va + o) >> 12) & 0x1ff] = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	kmem_free(kernel_map, bo->kva, bo->size);
+	printf("SWEET GPU: bo: freed va %#x (%lu bytes)\n", bo->va, (unsigned long)bo->size);
+	bo->used = false;
+}
