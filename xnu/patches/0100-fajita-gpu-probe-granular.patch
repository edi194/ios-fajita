-	    gpu_rd(cc, 0x1178), gpu_rd(cc, 0x117c), gpu_rd(cc, 0x1204), gpu_rd(cc, 0x1540));
-
-	printf("SWEET GPU: reading smmu\n");
-	printf("SWEET GPU: smmu idr0=%#x idr1=%#x idr2=%#x scr0=%#x sacr=%#x\n",
-	    gpu_rd(smmu, 0x00), gpu_rd(smmu, 0x04), gpu_rd(smmu, 0x08),
-	    gpu_rd(smmu, 0x30), gpu_rd(smmu, 0x40));
-
-	printf("SWEET GPU: reading gmu\n");
