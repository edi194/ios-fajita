@@ -34,13 +34,18 @@
 #define GPU_CMD_DB      0x85fe0000u
 
 static uint32_t
-gpu_rd(vm_offset_t base, uint32_t off)
+gpu_probe_rd(const char *what, vm_offset_t base, uint32_t off)
 {
+	uint32_t v;
+
 	if (base == 0) {
+		printf("SWEET GPU: %s +%#x: no mapping\n", what, off);
 		return 0;
 	}
-	uint32_t v = *(volatile uint32_t *)(base + off);
+	printf("SWEET GPU: read %s +%#x\n", what, off);
+	v = *(volatile uint32_t *)(base + off);
 	__asm__ volatile("dmb oshld" ::: "memory");
+	printf("SWEET GPU: %s +%#x = %#x\n", what, off, v);
 	return v;
 }
 
@@ -67,41 +72,29 @@
 	printf("SWEET GPU: level %d, maps gcc=%p cc=%p dbgc=%p misc=%p gmu=%p smmu=%p gpu=%p qf=%p db=%p\n",
 	    level, (void *)gcc, (void *)cc, (void *)dbgc, (void *)misc, (void *)gmu,
 	    (void *)smmu, (void *)gpu, (void *)qf, (void *)db);
-
-	printf("SWEET GPU: reading gcc\n");
-	printf("SWEET GPU: gcc pll-vote=%#x\n", gpu_rd(gcc, 0x52000));
-
-	printf("SWEET GPU: reading qfprom\n");
