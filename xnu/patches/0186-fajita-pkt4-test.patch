-/* ---- stage 7b: the ring, CP_ME_INIT and the first PM4 packets ---------- */
+/* PM4 type 4: a plain register write, the form every client command buffer uses. */
+static uint32_t
+gpu_parity(uint32_t v)
+{
+	v ^= v >> 16;
+	v ^= v >> 8;
+	v ^= v >> 4;
+	return (~0x6996u >> (v & 0xfu)) & 1u;
+}
+
+static uint32_t
+gpu_pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000u | (cnt & 0x7fu) | (gpu_parity(cnt) << 7) |
+	    ((reg & 0x3ffffu) << 8) | (gpu_parity(reg) << 27);
+}
+
+/* stage 7b: the ring, CP_ME_INIT and the first PM4 packets ---------- */
 
 static unsigned gpu_cp_wptr;            /* dwords written into the ring */
 
