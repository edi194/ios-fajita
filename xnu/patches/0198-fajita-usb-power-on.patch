+static void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+}
+
+/*
+ * fajita: bring the controller up instead of assuming ABL left it up. GDSC usb30_prim first (clear
+ * SW_COLLAPSE, wait for PWR_ON), then the branch clocks (clear CLK_OFF), then the block reset, which must be
+ * released after the clocks run. Every step is logged, because "which one is still off" is the only question
+ * that matters when the controller refuses to appear.
+ */
+static bool
+sweet_usb_power_on(vm_offset_t gcc)
+{
+	uint32_t v;
+	int i;
+
+	v = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	printf("SWEET USB: power-up: GDSCR 0x%08x (%s)\n", v, (v & GDSC_PWR_ON) ? "on" : "off");
+	usb_wr(gcc, GCC_USB30_PRIM_GDSCR, v & ~GDSC_SW_COLLAPSE);
+	for (i = 0; i < 100; i++) {
+		if (usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & GDSC_PWR_ON) {
+			break;
+		}
+		delay(1000);
+	}
+	v = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	printf("SWEET USB: power-up: GDSC %s after %d ms (0x%08x)\n",
+	    (v & GDSC_PWR_ON) ? "ON" : "STILL OFF", i, v);
+
+	for (unsigned k = 0; k < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); k++) {
+		uint32_t before = usb_rd(gcc, usb_cbcr[k].off);
+
+		usb_wr(gcc, usb_cbcr[k].off, before & ~CBCR_CLK_OFF);
+		for (i = 0; i < 20; i++) {
+			if (!(usb_rd(gcc, usb_cbcr[k].off) & CBCR_CLK_OFF)) {
+				break;
+			}
+			delay(1000);
+		}
+		v = usb_rd(gcc, usb_cbcr[k].off);
+		printf("SWEET USB: power-up: clk %-12s 0x%08x -> 0x%08x (%s, %d ms)\n",
+		    usb_cbcr[k].name, before, v, (v & CBCR_CLK_OFF) ? "OFF" : "on", i);
+	}
+
+	usb_wr(gcc, GCC_USB30_PRIM_BCR, BCR_BLK_ARES);
+	delay(1000);
+	usb_wr(gcc, GCC_USB30_PRIM_BCR, 0);
+	delay(1000);
+	printf("SWEET USB: power-up: block reset released\n");
+	return (usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & GDSC_PWR_ON) != 0;
+}
