+	if ((fe || fid1 != FT_ID_HI) && touch_ft_rst) {
+		printf("SWEET TOUCH: FT8719 silent (%d); pulsing reset (sweettouchrst=1)\n", fe);
+		touch_gpio(tb->rst, 0, 0, 0, true, false);
+		touch_wait(10);
+		touch_gpio(tb->rst, 0, 0, 0, true, true);
+		touch_wait(300);
+		fe = touch_read(FT_ADDR, FT_ID_REG, false, &fid1, 1);
+	}
+	if (!fe) {
