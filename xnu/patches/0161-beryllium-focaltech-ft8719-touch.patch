+/* boot-arg sweettouchrst=1: pulse the reset pin if the FT8719 is silent (may blink the display) */
+static unsigned touch_ft_rst;
+
+/*
+ * FT8719 frame (vendor ftxxxx layout): reg 0 device mode (0 = working),
+ * reg 1 gesture id, reg 2 low nibble = point count, then 6-byte records:
+ *   [0] event(7:6) 0 down / 1 up / 2 contact | X high (3:0)
+ *   [1] X low   [2] track id (7:4, 0xf = unused) | Y high (3:0)   [3] Y low
+ *   [4] pressure   [5] area
+ * Only as many records as can be in use are read (the bus is bit-banged);
+ * torn frames are dropped, and a contact that disappears without an UP
+ * record is held for FT_HOLD_FRAMES frames, as for the NT36672A.
+ */
+static int
+touch_ft8719(void)
+{
+	static unsigned hold_frames, bad_run;
+	uint8_t buf[FT_HEAD + FT_RECORD * TOUCH_MAX];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0, released = 0, seen = 0;
+	unsigned n = 0, cnt = (unsigned)__builtin_popcount(st.active) + 1u;
+	bool bad = false;
+	cnt = cnt < 2u ? 2u : (cnt > TOUCH_MAX ? TOUCH_MAX : cnt);
+	for (;;) {
+		memset(buf, 0xff, sizeof(buf));
+		int err = touch_read(FT_ADDR, 0, false, buf, FT_HEAD + FT_RECORD * cnt);
+		if (err) {
+			return err;
+		}
+		n = buf[2] & 15u;
+		if ((buf[0] & 0x70u) || n > TOUCH_MAX) {
+			bad = true;
+			break;
+		}
+		if (n <= cnt) {
+			break;
+		}
+		cnt = n; /* more contacts than we asked for: read again, longer */
+	}
+	for (unsigned i = 0; !bad && i < cnt; ++i) {
+		const uint8_t *p = buf + FT_HEAD + FT_RECORD * i;
+		unsigned id = p[2] >> 4, event = p[0] >> 6;
+		if (id >= TOUCH_MAX) {
+			break; /* unused-record sentinel */
+		}
+		if ((seen & (1u << id)) || event == 3u) {
+			bad = true;
+			break;
+		}
+		seen |= 1u << id;
+		if (event == 1u) {
+			released |= 1u << id;
+			continue;
+		}
+		unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
+		if (px >= tb->w || py >= tb->h) {
+			bad = true;
+			break;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	if (touch_trace) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		printf("FT %llu %c%c n=%u m=%x %d,%d | %02x %02x %02x | %02x %02x %02x %02x %02x %02x\n",
+		    ns / 1000000ull, touch_trace_why, bad ? 'b' : 'r', n, mask, x[0], y[0],
+		    buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6], buf[7], buf[8]);
+	}
+	if (bad) {
+		if (st.active && ++bad_run >= FT_BAD_RELEASE) {
+			printf("SWEET TOUCH: %u torn FT8719 frames while touched; releasing\n", bad_run);
+			bad_run = 0;
+			hold_frames = 0;
+			touch_report(0, x, y);
+		}
+		return 0;
+	}
+	bad_run = 0;
+	uint32_t keep = st.active & ~mask & ~released;
+	if (keep && ++hold_frames < FT_HOLD_FRAMES) {
+		for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+			if (keep & (1u << id)) {
+				x[id] = st.x[id];
+				y[id] = st.y[id];
+			}
+		}
+		mask |= keep;
+	} else {
+		hold_frames = 0;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
 static int
