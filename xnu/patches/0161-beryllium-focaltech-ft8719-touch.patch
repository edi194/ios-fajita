+	 * reset (TDDI: the reset pin is shared with the display); the NT36672A
+	 * probe below pulses reset when silent. */
+	uint8_t fid1 = 0, fid2 = 0;
+	int fe = touch_read(FT_ADDR, FT_ID_REG, false, &fid1, 1);
