--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -154,6 +154,10 @@
 
 /* stage 3d: what the GMU firmware needs (all GMU_WORD(n) = 4n from the GMU base) */
 #define GPU_GMU_GENERAL_7     0x14730u      /* 0x51cc: 1 turns on the TCM's retention */
+#define GPU_GMU_WFI_CONFIG    0x14008u      /* 0x5002: downstream a6xx_gmu_start writes 0 */
+#define GPU_GMU_PWR_COL_INTER_FRAME 0x14300u /* 0x50c0: 0x9c40400 in a6xx_gmu_power_config */
+#define GPU_GMU_VA_HFI        0x60100000u   /* KGSL's GPU address for the HFI table */
+#define GPU_GMU_VA_LOG        0x60300000u   /* ... and for the log */
 #define GPU_GMU_HFI_SFR       0x14608u      /* 0x5182: which GPU this is */
 #define GPU_GMU_HFI_QTBL_INFO 0x14610u      /* 0x5184 */
 #define GPU_GMU_HFI_QTBL_ADDR 0x14614u      /* 0x5185: the HFI table, 32 bits */
@@ -314,9 +318,6 @@
 	(void)gpu_probe_rd("dbgc", dbgc, 0x00);
 	(void)gpu_probe_rd("misc", misc, 0x00);
 	printf("SWEET GPU: probe done\n");
-	if (level >= 5) {
-		gpu_scratch_prepare();
-	}
 	if (level < 2) {
 		return;
 	}
@@ -515,24 +516,27 @@
 
 	/* ---- stage 3d: the HFI table, the log, and the reset ------------------ */
 	printf("SWEET GPU: --- stage 3d: hfi and reset\n");
-	if (!gpu_scratch_ready) {
-		printf("SWEET GPU: the GMU's scratch was not prepared\n");
-		return;
-	}
-	uint32_t hfi_pa = gpu_hfi_pa, log_pa = gpu_log_pa;
-	printf("SWEET GPU: hfi at %#x, log at %#x (prepared before the power-on)\n", hfi_pa, log_pa);
+	/*
+	 * The firmware does not touch RAM while it boots, so these are the GPU
+	 * addresses KGSL's allocator gives the buffers (Bergamota, a630 stage 3),
+	 * not physical ones: nothing maps them yet and FW_INIT_RESULT still comes.
+	 */
+	uint32_t hfi_pa = GPU_GMU_VA_HFI, log_pa = GPU_GMU_VA_LOG;
+	printf("SWEET GPU: hfi address %#x, log address %#x (unmapped until the SMMU stage)\n", hfi_pa, log_pa);
 
 	gpu_probe_wr("gmu tcm retention", gmu, GPU_GMU_GENERAL_7, 1);
 	gpu_probe_wr("gmu hfi sfr", gmu, GPU_GMU_HFI_SFR, GPU_GMU_CHIPID);
 	gpu_probe_wr("gmu hfi qtbl info", gmu, GPU_GMU_HFI_QTBL_INFO, 1);
 	gpu_probe_wr("gmu hfi qtbl addr", gmu, GPU_GMU_HFI_QTBL_ADDR, hfi_pa);
-	gpu_probe_wr("gmu log address", gmu, GPU_GMU_PWR_COL_CP_MSG, log_pa);   /* one page: size - 1 = 0 */
+	gpu_probe_wr("gmu log address", gmu, GPU_GMU_PWR_COL_CP_MSG, log_pa);   /* one 4 KiB unit: size - 1 = 0 */
 	gpu_probe_wr("gmu sys bus", gmu, GPU_GMU_SYS_BUS_CONFIG, 0x1);
 	gpu_probe_wr("gmu icache", gmu, GPU_GMU_ICACHE_CONFIG, 0x1);
 	gpu_probe_wr("gmu dcache", gmu, GPU_GMU_DCACHE_CONFIG, 0x1);
 	/* The RPMh interface is left alone: enabling it without the PDC/RSCC
 	 * handshake first could leave the firmware waiting for votes nobody
 	 * answers. Its mask (0xf11) is the next thing to try if it will not run. */
+	gpu_probe_wr("gmu inter-frame ctrl", gmu, GPU_GMU_PWR_COL_INTER_FRAME, 0x9c40400);
+	gpu_probe_wr("gmu rpmh ctrl", gmu, GPU_GMU_RPMH_CTRL, 0xf11);   /* interface + LLC/DDR/MX/CX/GFX votes */
 	gpu_probe_wr("gmu boot config", gmu, GPU_GMU_BOOT_CONFIG, 0x02);
 	gpu_probe_wr("gmu fence range", gmu, GPU_GMU_AHB_FENCE_RANGE, 0x80000000u | (0xau << 18) | 0xa0u);
 	gpu_probe_wr("gmu cm3 cfg", gmu, GPU_GMU_CM3_CFG, 0x4052);
@@ -543,6 +547,7 @@
 		sweet_log_panic_flush();
 	}
 	gpu_probe_wr("gmu fw_init", gmu, GPU_GMU_FW_INIT, 0);
+	gpu_probe_wr("gmu wfi config", gmu, GPU_GMU_WFI_CONFIG, 0);
 	gpu_probe_wr("gmu sysreset", gmu, GPU_GMU_SYSRESET, 1);
 	gpu_probe_wr("gmu log write ptr", gmu, GPU_GMU_PWR_COL_CP_RESP, 0);
 	gpu_probe_wr("gmu sysreset", gmu, GPU_GMU_SYSRESET, 0);
