@@ -137,6 +141,42 @@
 
 OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
 
+/*
+ * fajita: publish the accelerator service with the plugin properties. Pulled out of start() so the
+ * same code can run now or from the metalplugindelay timer.
+ */
+static void
+sweet_publish_accel(AppleCLCD *fb, IOAcceleratorES *accel)
+{
+	uint32_t realPlugin = 0;
+	(void)PE_parse_boot_argn("metalplugin", &realPlugin, sizeof(realPlugin));
+	const char *pluginName = realPlugin ? "SweetBGMTL" : "SweetMetalProbe";
+	const char *pluginClass = realPlugin ? "BGMTLDevice" : "SweetMetalDevice";
+	bool named = accel->setProperty("MetalPluginName", pluginName) &&
+	    accel->setProperty("MetalPluginClassName", pluginClass);
+
+	accel->setName("sgx");
+	if (accel->attach(fb)) {
+		accel->registerService();
+		IOLog("SWEET FB: IOAcceleratorES published, MetalPluginName %s class %s"
+		    " (properties set: %s)\n", pluginName, pluginClass, named ? "yes" : "NO");
+	}
+}
+
+void
+AppleCLCD::accelTimerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	IOAcceleratorES *accel = fb->fAccelPending;
+
+	fb->fAccelPending = NULL;
+	if (accel != NULL) {
+		sweet_publish_accel(fb, accel);
+		accel->release();
+	}
+	IOLog("SWEET FB: accelerator published after the metalplugindelay window\n");
+}
+
 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
 class IOMobileFramebufferUserClient : public IOUserClient {
