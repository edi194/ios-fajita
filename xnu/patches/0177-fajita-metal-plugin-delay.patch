+		/*
+		 * fajita: when this service exists from boot, lsd's first-boot LaunchServices seeding
+		 * stalls in libMobileGestalt and SpringBoard never reaches its run loop; without the
+		 * service the UI comes up. metalplugindelay=N keeps the service away for N seconds so
+		 * the seeding can finish, and publishes it after - clients that ask later still get it.
+		 */
+		uint32_t accelDelay = 0;
+		(void)PE_parse_boot_argn("metalplugindelay", &accelDelay, sizeof(accelDelay));
+		if (accelDelay == 0) {
+			sweet_publish_accel(this, accel);
+		} else {
+			fAccelTimer = IOTimerEventSource::timerEventSource(this,
+			    &AppleCLCD::accelTimerFired);
+			if (fAccelTimer != NULL && fWorkLoop != NULL &&
+			    fWorkLoop->addEventSource(fAccelTimer) == kIOReturnSuccess) {
+				fAccelPending = accel;
+				fAccelTimer->setTimeoutMS(accelDelay * 1000);
+				IOLog("SWEET FB: accelerator publication delayed by %u s\n", accelDelay);
+			} else {
+				sweet_publish_accel(this, accel);
+			}
 		}
 	}
-	OSSafeReleaseNULL(accel);
