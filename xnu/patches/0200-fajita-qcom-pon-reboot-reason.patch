+/*
+ * fajita: qcom-pon's reboot reason. ABL decides where to boot from the PMIC's PON spare register, not from
+ * the IMEM word this port's shim writes (a reset after that word landed still started Android), so
+ * "reboot to fastboot" has to be asked for the way Linux's drivers/power/reset/qcom-pon.c does it:
+ * PON_SOFT_RB_SPARE (0x8f) set to the reason shifted left by two bits, pm8998's shift.
+ *
+ * SPMI encoding from Linux's spmi-pmic-arb.c: PMIC_ARB_OP_EXT_WRITEL is 0, so the command is
+ * (sid << 20) | (addr << 4) | byte-count-minus-one, and the byte itself goes to WDATA0 (offset 0x10).
+ */
+int
+sweet_pon_reboot_reason(unsigned reason)
+{
+	if (!sp_ready && sweet_spmi_init() != 0) {
+		return -1;
+	}
+
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid(0x008);            /* SID 0, peripheral 0x08: the PON block */
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	*(volatile uint32_t *)(sp_obs + off + 0x10u) = (reason & 0x3fu) << 2;   /* PON_SOFT_RB_SPARE */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = (unsigned)(0x8fu << 4);          /* EXT_WRITEL, addr 0x8f, 1 byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+
+		if (status & 1u) {
+			int failed = (status & 0x0eu) != 0;
+
+			IOLockUnlock(sp_lock);
+			return failed ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	IOLockUnlock(sp_lock);
+	return -1;
+}
