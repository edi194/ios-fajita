+		printf("SWEET GPU: --- stage 5: gx rail\n");
+		{
+			bool rail = gpu_gx_rail_on(gmu);
+			printf("SWEET GPU: gx rail %s\n", rail ? "on" : "NOT on");
+			if (rail) {
+				(void)gpu_sptprac_on(gmu);
+			}
+		}
 	}
