+/*
+ * launchd on this port is stock and scans /System/Library/LaunchDaemons, while the plists
+ * ship in /Library/LaunchDaemons, so the tools never ran. Write them where launchd looks,
+ * once the root is up and writable - this is called from sweet_gpu_probe(), which the UFS
+ * attach path runs before launchd starts.
+ */
+static const char gpu_plist[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>Label</key><string>org.sweet.gputest</string>\n"
+	"\t<key>ProgramArguments</key><array>"
+	"<string>/usr/local/bin/sweetgputest</string></array>\n"
+	"\t<key>RunAtLoad</key><true/>\n"
+	"\t<key>StandardOutPath</key><string>/dev/console</string>\n"
+	"\t<key>StandardErrorPath</key><string>/dev/console</string>\n"
+	"\t<key>KeepAlive</key><false/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char iokit_plist[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>Label</key><string>org.sweet.iokittest</string>\n"
+	"\t<key>ProgramArguments</key><array>"
+	"<string>/usr/local/bin/sweet-iokit-test</string></array>\n"
+	"\t<key>RunAtLoad</key><true/>\n"
+	"\t<key>StandardOutPath</key><string>/dev/console</string>\n"
+	"\t<key>StandardErrorPath</key><string>/dev/console</string>\n"
+	"\t<key>KeepAlive</key><false/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static bool
+gpu_write_file(const char *path, const char *data, size_t len)
+{
+	struct nameidata nd;
+	vfs_context_t ctx = vfs_context_current();
+	int err;
+
+	NDINIT(&nd, LOOKUP, OP_OPEN, NOFOLLOW, UIO_SYSSPACE, path, ctx);
+	err = vn_open(&nd, FWRITE | O_CREAT | O_TRUNC, 0644);
+	if (err != 0) {
+		printf("SWEET GPU: cannot create %s: %d\n", path, err);
+		return false;
+	}
+	err = vn_rdwr(UIO_WRITE, nd.ni_vp, (caddr_t)data, (int)len, 0, UIO_SYSSPACE,
+	    IO_NODELOCKED, vfs_context_ucred(ctx), NULL, NULL);
+	vn_close(nd.ni_vp, FWRITE, ctx);
+	if (err != 0) {
+		printf("SWEET GPU: cannot write %s: %d\n", path, err);
+		return false;
+	}
+	return true;
+}
+
+static void
+gpu_install_daemons(void)
+{
+	bool a = gpu_write_file("/System/Library/LaunchDaemons/org.sweet.gputest.plist",
+	    gpu_plist, sizeof(gpu_plist) - 1);
+	bool b = gpu_write_file("/System/Library/LaunchDaemons/org.sweet.iokittest.plist",
+	    iokit_plist, sizeof(iokit_plist) - 1);
+
+	printf("SWEET GPU: daemon plists installed: gputest %d iokittest %d\n", a ? 1 : 0, b ? 1 : 0);
+}
+
 void
 sweet_gpu_probe(void)
 {
+	gpu_install_daemons();
+
 	int level = 0;
