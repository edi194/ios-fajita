+/*
+ * READ ONLY. What does apps_smmu do with stream id sid right now? Logs every
+ * stream match register that matches it (SMR under its mask), the S2CR it
+ * selects and, for a translating one, the context bank's CBAR/CBA2R
+ * (level >= 1) and the bank registers SCTLR/TTBR0/TCR/MAIR0/FSR (level >= 2;
+ * those banks belong to ABL/the hypervisor and are only read when asked).
+ * Nothing is written and no bank is created. Used for the MDP streams
+ * (0x880, 0xc80) before any zero-copy scanout.
+ *
+ * Returns: 0 no SMR matches (the S2CR default decides), 1 bypass, 2 translate,
+ * 3 fault entry, 4 mixed/several matches, -1 SMMU not readable.
+ */
+int
+sweet_smmu_probe_sid(unsigned sid, unsigned level)
+{
+	int result = 0, nmatch = 0;
+
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return -1;
+	}
+	if (smmu_base == 0) {
+		smmu_base = ml_io_map(SMMU_PA, SMMU_SIZE);
+	}
+	if (smmu_base == 0) {
+		printf("SWEET SMMU: probe: map failed\n");
+		result = -1;
+		goto out;
+	}
+	uint32_t id0 = smmu_rd(0x20), id1 = smmu_rd(0x24);
+	unsigned pgshift = (id1 >> 31) ? 16 : 12;
+	unsigned nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	uint32_t gr1 = 1u << pgshift;
+	uint32_t cb0 = (1u << (((id1 >> 28) & 7) + 1)) << pgshift;
+	uint32_t scr0 = smmu_rd(0x0);
+	printf("SWEET SMMU: probe sid 0x%x: sCR0 0x%x (USFCFG %u GFIE %u CLIENTPD %u) ID0 0x%x ID1 0x%x, %u SMRs %u CBs\n",
+	    sid, scr0, (scr0 >> 10) & 1, (scr0 >> 2) & 1, scr0 & 1, id0, id1, nsmr, ncb);
+	for (unsigned i = 0; i < nsmr && i < 128; i++) {
+		uint32_t smr = smmu_rd(0x800 + 4 * i);
+		if (!(smr & (1u << 31))) {
+			continue;
+		}
+		uint32_t mask = (smr >> 16) & 0x7fff;
+		if (((smr ^ sid) & ~mask & 0x7fff) != 0) {
+			continue;
+		}
+		uint32_t s2cr = smmu_rd(0xc00 + 4 * i);
+		unsigned type = (s2cr >> 16) & 3, cbndx = s2cr & 0xff;
+		int kind = type == 0 ? 2 : (type == 1 ? 1 : 3);
+		nmatch++;
+		result = nmatch == 1 ? kind : (result == kind ? kind : 4);
+		printf("SWEET SMMU: probe sid 0x%x: smr %u 0x%x (id 0x%x mask 0x%x) s2cr 0x%x type %s cb %u\n",
+		    sid, i, smr, smr & 0x7fff, mask, s2cr,
+		    type == 0 ? "TRANSLATE" : (type == 1 ? "BYPASS" : "FAULT"), cbndx);
+		if (type == 0 && level >= 1 && cbndx < ncb) {
+			printf("SWEET SMMU: probe cb %u: CBAR 0x%x CBA2R 0x%x\n", cbndx,
+			    smmu_rd(gr1 + 4 * cbndx), smmu_rd(gr1 + 0x800 + 4 * cbndx));
+			if (level >= 2) {
+				uint32_t cb = cb0 + (cbndx << pgshift);
+				uint64_t ttbr0 = smmu_rd(cb + 0x20) | (uint64_t)smmu_rd(cb + 0x24) << 32;
+				printf("SWEET SMMU: probe cb %u: SCTLR 0x%x TTBR0 0x%llx TCR 0x%x TCR2 0x%x MAIR0 0x%x FSR 0x%x\n",
+				    cbndx, smmu_rd(cb + 0x0), ttbr0, smmu_rd(cb + 0x30), smmu_rd(cb + 0x10),
+				    smmu_rd(cb + 0x38), smmu_rd(cb + 0x58));
+			}
+		}
+	}
+	if (nmatch == 0) {
+		printf("SWEET SMMU: probe sid 0x%x: no SMR matches\n", sid);
+	}
+out:
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+	return result;
 }
