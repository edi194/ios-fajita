+
+/* Mapped read/write channel registers of an APID, or 0. Called with sp_lock held. */
+static vm_offset_t
+sp_wch_map(uint16_t apid)
+{
+	for (unsigned i = 0; i < sp_nwch; ++i) {
+		if (sp_wch[i].apid == apid) {
+			return sp_wch[i].va;
+		}
+	}
+	if (sp_nwch >= SP_WCH_MAX) {
+		return 0;
+	}
+	vm_offset_t va = ml_io_map(SP_CHNL_PA + 0x10000u * apid, 0x1000);
+	if (!va) {
+		return 0;
+	}
+	sp_wch[sp_nwch].apid = apid;
+	sp_wch[sp_nwch].va = va;
+	return sp_wch[sp_nwch++].va;
+}
+
+/*
+ * EXT_WRITEL of 1..2 bytes through the APID's write channel (pmic-arb v5:
+ * CMD +0x00 = opcode 0 << 27 | (addr & 0xff) << 4 | (len - 1), STATUS +0x08,
+ * WDATA0 +0x10; Linux spmi-pmic-arb.c). The APID must be owned by EE 0
+ * (qcom,ee = <0>), else the arbiter denies it; refused here without a try.
+ * Thread context only. 0 success, -1 failure.
+ */
+int
+sweet_spmi_write(unsigned sid, unsigned addr, const uint8_t *data, unsigned len)
+{
+	static bool told_owner;
+
+	if (!sp_ready || !data || addr > 0xffffu || !sp_write_allowed(sid, addr, len)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u;
+	if (owner != 0) {
+		if (!told_owner) {
+			told_owner = true;
+			printf("SWEET SPMI: APID %u (sid %u peripheral 0x%x) is owned by EE %u: write refused\n",
+			    apid, sid, addr >> 8, owner);
+		}
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	vm_offset_t ch = sp_wch_map(apid);
+	if (!ch) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	uint32_t wdata = data[0] | (len > 1 ? (uint32_t)data[1] << 8 : 0);
+	uint32_t cmd = (0u << 27) | ((addr & 0xffu) << 4) | ((len - 1) & 7u); /* EXT_WRITEL */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = wdata;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			if (status & 0x0eu) {
+				printf("SWEET SPMI: write sid=%u addr=%#x status %#x (failed/denied)\n", sid, addr, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET SPMI: write timeout sid=%u addr=%#x APID=%u disabled\n", sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
