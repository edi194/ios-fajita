+	if (s == NULL || s == fSurface) {
+		why = "no such surface";
+		sticky = false;
+	} else if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	if (why == NULL) {
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
+			dx = dy = 0;
+		}
+		if (!fZcOK) {
+			why = "MDP SMMU streams not verified as bypass";
+		} else if (s->elementWidth != 1 || s->elementHeight != 1 || (s->bytesPerElement && s->bytesPerElement != 4) ||
+		    s->wrapped || s->memory == NULL) {
+			why = "not a plain 32-bit surface";
+		} else if (s->width != fLogicalW || s->height != fLogicalH) {
+			why = "not canvas sized";
+		} else if (sx != 0 || sy != 0 || dx != 0 || dy != 0 || w != (int32_t)fLogicalW || h != (int32_t)fLogicalH) {
+			why = "layer is not the whole canvas";
+			sticky = false;
+		} else if ((s->bytesPerRow & 15) != 0 || s->bytesPerRow > 0xffff || (s->offset & 63) != 0) {
+			why = "stride/offset not aligned for the MDP";
