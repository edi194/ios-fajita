+/*
+ * Zero-copy scanout. A lone layer that is the whole canvas, in a surface
+ * whose memory is contiguous and below 4 GiB (SRC0_ADDR is 32 bit), is
+ * scanned where CoreAnimation drew it. Needs the MDP's SMMU streams verified in
+ * bypass (fZcOK), else every frame is declined and copied. The surface stays
+ * held (IOSurfaceClientIsInUse, state page +0x18 as 0099) until the MDP has
+ * latched a later frame: fZcHeld[0..fZcCount-1], the last one is the newest.
+ */
+void
+AppleCLCD::zcPoll(void)
+{
+	if (fZcCount < 2) {
+		return;
+	}
+	volatile uint32_t *flush = (volatile uint32_t *)(fMdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_FLUSH);
+	if (*flush & fLastFlush) {
+		return;         /* the newest frame is not on the panel yet */
+	}
+	SweetSurface *newest = fZcHeld[fZcCount - 1];
+	for (uint32_t i = 0; i + 1 < fZcCount; i++) {
+		sweet_hold(fZcHeld[i], false);
+		fZcHeld[i]->release();
+		fZcHeld[i] = NULL;
+	}
+	fZcHeld[0] = newest;
+	fZcHeld[1] = fZcHeld[2] = fZcHeld[3] = NULL;
+	fZcCount = 1;
+}
+
+void
+AppleCLCD::zcReleaseAll(void)
+{
+	for (uint32_t i = 0; i < fZcCount; i++) {
+		sweet_hold(fZcHeld[i], false);
+		fZcHeld[i]->release();
+		fZcHeld[i] = NULL;
+	}
+	fZcCount = 0;
+}
