+/*
+ * Write whitelist (Poco F1): PMI8998 WLED sink, SID 3, peripheral 0xd9
+ * (reg = <0xd800>, <0xd900> in pmi8998.dtsi; qcom-wled.c WLED4 offsets):
+ *   0x47        WLED3_SINK_REG_SYNC (one byte)
+ *   0x57 0x67   WLED4_SINK_REG_BRIGHT(0/1), 16-bit little endian (1 or 2 bytes)
+ *   0x58 0x68   their high bytes (one byte)
+ * Nothing in the control module (0xd8: MOD_EN, OVP, boost) is writable.
+ */
+static bool
+sp_write_allowed(unsigned sid, unsigned addr, unsigned len)
+{
+	if (!sweet_board_beryllium() || sid != 3 || len < 1 || len > 2) {
+		return false;
+	}
+	switch (addr) {
+	case 0xd947u:
+	case 0xd958u:
+	case 0xd968u:
+		return len == 1;
+	case 0xd957u:
+	case 0xd967u:
+		return true;
+	default:
+		return false;
+	}
