+/*
+ * PMI8998 WLED backlight (SID 3; reg = <0xd800>, <0xd900> in pmi8998.dtsi;
+ * Linux drivers/video/backlight/qcom-wled.c, WLED4): sink base 0xd900,
+ * WLED4_SINK_REG_BRIGHT(n) = +0x57 + 0x10 * n (16 bit little endian, max
+ * 0xfff), WLED3_SINK_REG_SYNC +0x47 (clear, then set the string mask to
+ * latch a new brightness). Poco F1 has two strings (qcom,num-strings = 2).
+ * The control module (0xd846 MOD_EN bit 7) is never written: the fade only
+ * moves the brightness and leaves the driver stage as ABL set it up.
+ */
+#define SWEET_WLED_SID          3
+#define SWEET_WLED_SINK         0xd900u
+#define SWEET_WLED_MOD_EN       0xd846u
+#define SWEET_WLED_SYNC         (SWEET_WLED_SINK + 0x47u)
+#define SWEET_WLED_BRIGHT(n)    (SWEET_WLED_SINK + 0x57u + 0x10u * (n))
+#define SWEET_WLED_STRINGS      2
+#define SWEET_WLED_SYNC_MASK    0x0fu   /* GENMASK(max_string_count - 1, 0), WLED4: 4 */
+
+static int
+sweet_wled_read16(unsigned string, uint16_t *out)
+{
+	uint8_t lo, hi;
+	if (sweet_spmi_read(SWEET_WLED_SID, SWEET_WLED_BRIGHT(string), &lo) != 0 ||
+	    sweet_spmi_read(SWEET_WLED_SID, SWEET_WLED_BRIGHT(string) + 1, &hi) != 0) {
+		return -1;
+	}
+	*out = (uint16_t)(lo | (hi << 8));
+	return 0;
+}
+
+void
+AppleCLCD::blInit(void)
+{
+	uint8_t mod = 0, sync = 0;
+	uint16_t raw[SWEET_WLED_STRINGS];
+
+	if (sweet_spmi_init() != 0) {
+		IOLog("SWEET FB: backlight fade: SPMI not available; pixel fallback\n");
+		return;
+	}
+	for (unsigned n = 0; n < SWEET_WLED_STRINGS; n++) {
+		if (sweet_wled_read16(n, &raw[n]) != 0) {
+			IOLog("SWEET FB: backlight fade: cannot read WLED string %u brightness; pixel fallback\n", n);
+			return;
+		}
+	}
+	(void)sweet_spmi_read(SWEET_WLED_SID, SWEET_WLED_MOD_EN, &mod);
+	(void)sweet_spmi_read(SWEET_WLED_SID, SWEET_WLED_SYNC, &sync);
+	IOLog("SWEET FB: WLED brightness string0 0x%04x string1 0x%04x, MOD_EN 0x%02x, SYNC 0x%02x\n",
+	    raw[0], raw[1], mod, sync);
+	if (((raw[0] | raw[1]) & 0xfff) == 0 || !(mod & 0x80)) {
+		IOLog("SWEET FB: backlight fade: WLED is off or at 0 right now; pixel fallback\n");
+		return;
+	}
+	fBlRaw[0] = raw[0];
+	fBlRaw[1] = raw[1];
+	fBlPos = SWEET_FB_BL_STEPS;
+	fBlOK = true;
+	IOLog("SWEET FB: backlight fade armed: %u steps, power off ramps WLED down, on restores 0x%04x/0x%04x exactly\n",
+	    SWEET_FB_BL_STEPS, raw[0], raw[1]);
+}
+
+/*
+ * One ramp step (dir -1 down, +1 up) on the timer thread. level(pos) =
+ * as_found * pos^2 / steps^2, and exactly the bytes found at the top. False
+ * (fBlOK cleared, the original value written back as well as possible) when
+ * a write fails or does not read back: the caller blacks the screen out instead.
+ */
+bool
+AppleCLCD::blStep(int dir)
+{
+	const uint32_t N = SWEET_FB_BL_STEPS;
+	static uint32_t logged;
+
+	if (dir < 0) {
+		if (fBlPos == 0) {
+			return true;
+		}
+		if (fBlPos == N) {
+			/* a ramp starts from what the panel shows now: read, do not assume */
+			uint16_t now[SWEET_WLED_STRINGS];
+			if (sweet_wled_read16(0, &now[0]) == 0 && sweet_wled_read16(1, &now[1]) == 0 &&
+			    ((now[0] | now[1]) & 0xfff) != 0) {
+				fBlRaw[0] = now[0];
+				fBlRaw[1] = now[1];
+			}
+			if (logged++ < 8) {
+				IOLog("SWEET FB: backlight ramp down from 0x%04x/0x%04x\n", fBlRaw[0], fBlRaw[1]);
+			}
+		}
+		fBlPos--;
+	} else {
+		if (fBlPos >= N) {
+			return true;
+		}
+		fBlPos++;
+	}
+	bool ok = true;
+	uint16_t want[SWEET_WLED_STRINGS];
+	for (unsigned n = 0; n < SWEET_WLED_STRINGS && ok; n++) {
+		uint32_t level = fBlPos == N ? fBlRaw[n] :
+		    (uint32_t)(((uint64_t)(fBlRaw[n] & 0xfff) * fBlPos * fBlPos) / (N * N));
+		uint8_t d[2] = { (uint8_t)level, (uint8_t)(level >> 8) };
+		want[n] = (uint16_t)level;
+		ok = sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_BRIGHT(n), d, 2) == 0;
+	}
+	if (ok) {
+		uint8_t clr = 0, set = SWEET_WLED_SYNC_MASK;
+		ok = sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_SYNC, &clr, 1) == 0 &&
+		    sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_SYNC, &set, 1) == 0;
+	}
+	if (ok && (fBlPos == N - 1 || fBlPos == 1 || fBlPos == 0 || fBlPos == N)) {
+		/* read back at both ends of a ramp: a write the PMIC (or the hypervisor) ignores must not go unnoticed */
+		for (unsigned n = 0; n < SWEET_WLED_STRINGS; n++) {
+			uint16_t got = 0xffff;
+			if (sweet_wled_read16(n, &got) != 0 || got != want[n]) {
+				IOLog("SWEET FB: WLED string %u wrote 0x%04x, reads 0x%04x (step %u)\n", n, want[n], got, fBlPos);
+				ok = false;
+			}
+		}
+	}
+	if (!ok) {
+		uint8_t clr = 0, set = SWEET_WLED_SYNC_MASK;
+		for (unsigned n = 0; n < SWEET_WLED_STRINGS; n++) {
+			uint8_t d[2] = { (uint8_t)fBlRaw[n], (uint8_t)(fBlRaw[n] >> 8) };
+			(void)sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_BRIGHT(n), d, 2);
+		}
+		(void)sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_SYNC, &clr, 1);
+		(void)sweet_spmi_write(SWEET_WLED_SID, SWEET_WLED_SYNC, &set, 1);
+		fBlOK = false;
+		fBlPos = N;
+		IOLog("SWEET FB: backlight fade failed at a step; brightness written back to 0x%04x/0x%04x, pixel fallback from now on\n",
+		    fBlRaw[0], fBlRaw[1]);
+		return false;
+	}
+	if (fBlPos == 0 || fBlPos == N) {
+		IOLog("SWEET FB: backlight %s (0x%04x/0x%04x)\n", fBlPos == 0 ? "off" : "restored", want[0], want[1]);
+	}
+	return true;
+}
