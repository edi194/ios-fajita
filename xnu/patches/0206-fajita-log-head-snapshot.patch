+			/*
+			 * Two areas, both fixed and both written on every flush: the tail (what just happened) and the
+			 * head (what happened at boot). The tail alone is not enough for that second question - a GPU
+			 * that logs every buffer object pushes the boot's own lines out of 64 KiB within seconds, and
+			 * the boot is exactly when the interesting answers are printed. The head stops changing once
+			 * the log is longer than the area, so it is only written while it is still filling.
+			 */
+			for (int part = 0; part < 2; part++) {
+				bool head = (part == 0);
+				uint64_t from_end = SWEET_STATUS_FROM_END + (head ? SWEET_STATUS_BLOCKS : 0);
+				uint64_t from = 0;
+
+				if (head) {
+					if (total > area) {
+						continue;
+					}
+				} else {
+					from = total > room ? total - room : 0;
+				}
+				if (su.nblocks <= from_end || blocks + SWEET_LOG_BLOCKS > from_end) {
+					continue;
+				}
+				memcpy(sh.magic, head ? SWEET_STATUS_HEAD_MAGIC : SWEET_STATUS_MAGIC, 8);
+				sh.version = 1;
+				sh.size = area;
+				sh.total = total;
