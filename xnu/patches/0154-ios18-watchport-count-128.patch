@@ -71,7 +71,12 @@
 #define TASK_PORT_REGISTER_MAX  3
 
 /* Number of watchport for task */
-#define TASK_MAX_WATCHPORT_COUNT 32
+/*
+ * xnu-11215 (iOS 18) allows 128: iOS 18 launchd passes every MachService of a job as an
+ * importance watchport, and SpringBoard has more than 32, so posix_spawn failed with EINVAL
