 	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
 }
 
+/*
+ * CONNECTION_SPEED_CHANGE, sent when NETWORK_CONNECTION completed (Linux
+ * f_ecm.c ecm_notify_complete does the same; some hosts wait for it).
+ * Up/down bit rate as Linux gether_bitrate() reports at high speed.
+ */
+static void
+ud_notify_speed(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	const uint32_t rate = 13u * 512u * 8u * 1000u * 8u;
+	n[0] = 0xa1; n[1] = 0x2a;       /* CONNECTION_SPEED_CHANGE */
+	n[2] = 0; n[3] = 0;
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 8; n[7] = 0;
+	for (int i = 0; i < 4; i++) {
+		n[8 + i] = (uint8_t)(rate >> (8 * i));
+		n[12 + i] = (uint8_t)(rate >> (8 * i));
+	}
+	ud.notify_stage = 2;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 16, TRBCTL_NORMAL);
+}
+
