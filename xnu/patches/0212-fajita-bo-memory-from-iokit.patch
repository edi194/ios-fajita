+/*
+ * fajita: cache maintenance on the CPU's own mapping of a buffer. The client maps its buffers cacheable and
+ * the GPU is not coherent (DT qcom,gsi-disable-io-coherency), so a buffer the CPU wrote has to be cleaned to
+ * the point of coherency before the CP reads it, and one the GPU wrote has to be invalidated before the CPU
+ * reads it. Doing it by kernel virtual address avoids phystokv() altogether: the old path took a physical
+ * address and panicked for anything below gPhysBase (patch 0194), which is why buffers down there were simply
+ * never cleaned.
+ */
+void
+sweet_gpu_flush_kva(void *kva, uint64_t size)
+{
+	uintptr_t p = (uintptr_t)kva & ~(uintptr_t)63;
+	uintptr_t end = (uintptr_t)kva + size;
+
+	if (kva == NULL || size == 0) {
+		return;
+	}
+	for (; p < end; p += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_gpu_invalidate_kva(void *kva, uint64_t size)
+{
+	uintptr_t p = (uintptr_t)kva & ~(uintptr_t)63;
+	uintptr_t end = (uintptr_t)kva + size;
+
+	if (kva == NULL || size == 0) {
+		return;
+	}
+	for (; p < end; p += 64) {
+		__asm__ volatile("dc ivac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
