{
  "name": "bergamota-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
