    "build:wasm": "sh scripts/build-wasm.sh"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/w3c-web-usb": "1.0.14",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
