    {
      "name": "State Rail",
      "kind": "custom",
      "refersTo": "state-rail",
      "description": "The lime stage with the state word, ink progress and the ink console at its foot; the system's signature.",
      "html": "<div class=\"ds-rail\"><div class=\"ds-rail-top\"><span class=\"ds-pill\">ABL FASTBOOT</span><div class=\"ds-rail-word\">Waiting for a boot</div><div class=\"ds-rail-detail\">since 14:37 . 1a2b3c4d</div></div><div class=\"ds-rail-console\"><div class=\"ds-rail-label\">QUEUE <span class=\"ds-pill ds-pill-armed\">ARMED</span></div><div class=\"ds-rail-item\">ios26-boot.img</div><button class=\"ds-btn-send\">Send now</button></div></div>",
      "css": ".ds-rail{width:300px;background-color:#d7e98a;background-image:radial-gradient(#c6dc72 1.6px,transparent 1.7px);background-size:14px 14px;color:#161616;display:flex;flex-direction:column;min-height:360px}.ds-rail-top{padding:18px 22px 8px;flex:1}.ds-rail-word{font-family:'Archivo','Arial Black',system-ui,sans-serif;font-weight:900;font-stretch:112%;font-size:44px;line-height:1;margin:10px 0}.ds-rail-detail{font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;font-size:11.5px;font-weight:500}.ds-pill{font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;background:#161616;color:#d7e98a;font-size:10.5px;font-weight:800;letter-spacing:.6px;padding:3px 9px;border-radius:999px}.ds-rail-console{background:#161616;color:#f4f3ec;padding:16px 20px;display:flex;flex-direction:column;gap:10px}.ds-rail-label{font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;font-size:11px;font-weight:800;letter-spacing:1.3px;color:#9a9992}.ds-pill-armed{background:#e8a33a;color:#161616;font-size:9.5px}.ds-rail-item{font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;font-size:11.5px;font-weight:600}.ds-btn-send{background:#e8a33a;color:#161616;border:0;border-radius:9px;padding:8px 14px;font:600 14px system-ui}.ds-btn-send:hover{opacity:.8}.ds-btn-send:focus-visible{outline:2px solid #f4f3ec;outline-offset:2px}"
