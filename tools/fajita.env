# OnePlus 6T (fajita), Qualcomm SDM845. Source this from bash.
# Values verified against mainline sdm845-oneplus-common.dtsi / fajita.dts
# and the downstream LineageOS sdm845.dtsi / fajita.dtsi.

SOC=sdm845
FB_BASE=0x9d400000
FB_SIZE=0x02400000
FB_BLOCK=0x9c000000          # 32 MiB block that contains FB_BASE
FB_OFFSET=0x1400000          # FB_BASE - FB_BLOCK
FB_W=1080
FB_H=2340
FB_STRIDE=4320

GICD=0x17a00000
GICR=0x17a60000
GICR_STRIDE=0x20000
VTIMER_INTID=19

UFS=0x1d84000
UFS_PHY=0x1d87000
PSHOLD=0x0c264000
IMEM_RESTART_REASON=0x146bf65c

RAM_HIGH_BASE=0x100000000
# Measured on the live FDT of this unit (SDM845 v2.1, 8 GB): memory nodes are
# 0x80000000+0x100000000 and 0x180000000+0xfc8a0000, i.e. the range above 4G is
# 0x100000000..0x27c8a0000 with no reserved-memory carve-outs in it (all of
# those sit below 0xac800000). 0x17c8a0000 = 5.946 GiB of clean RAM for XNU.
RAM_HIGH_SIZE=0x17c8a0000
# The unit is SDM845 v2.1 (qcom,msm-id 0x141/0x20001), so the matching board DTB
# is fajita2.dtb (fajita0 is v2, fajita1 is v1).
DTB_DEFAULT=dtb/boot_unpacked/fajita2.dtb

# A55 MPIDR 0x000 0x100 0x200 0x300
# A75 MPIDR 0x400 0x500 0x600 0x700
CPU_A55_FREQ=1766400000
CPU_A75_FREQ=2803200000

# Touch: Synaptics RMI4 on QUPv3 SE12 (i2c12 @ 0xa90000)
TOUCH_I2C_BASE=0xa90000
TOUCH_I2C_ADDR=0x20
TOUCH_IRQ_GPIO=125
TOUCH_RESET_GPIO=99
TOUCH_VIO_GPIO=88
TOUCH_VDD_LDO=28

# Keys
VOL_DOWN_PMIC_GPIO=5
VOL_UP_PMIC_GPIO=6
