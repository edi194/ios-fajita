+
+/* ---- Bergamota: GPU blit of a GL renderbuffer/texture into an IOSurface (targets/osmesa/sweet_hw.c) ---- */
+extern struct pipe_resource *sweet_hw_surface_resource(uint32_t surface_id, int opaque, unsigned *w, unsigned *h);
+extern void sweet_hw_surface_sync(uint32_t surface_id);
+extern int sweet_hw_active(void);
+extern struct pipe_resource *sweet_hw_wrapped_resource(uint32_t surface_id, enum pipe_format fmt, unsigned w, unsigned h);
+extern void sweet_hw_wrapped_sync(uint32_t surface_id);
+extern void sweet_hw_surface_forget(uint32_t surface_id);
+int sweet_hw_surface_alias(uint32_t surface_id, void **base, unsigned *bpr, unsigned *w, unsigned *h);
+void sweet_hw_surface_alias_sync(uint32_t surface_id);
+
+GLAPI int GLAPIENTRY OSMesaSweetActive(void);
+GLAPI void GLAPIENTRY OSMesaSweetForgetSurface(uint32_t surface_id);
+GLAPI int GLAPIENTRY OSMesaSweetBlit(GLuint name, int is_texture, uint32_t surface_id, int flip, int opaque);
+GLAPI void GLAPIENTRY OSMesaSweetStats(double *out, int n);
+GLAPI int GLAPIENTRY OSMesaSweetAttachDirect(GLuint name, uint32_t surface_id);
+GLAPI void GLAPIENTRY OSMesaSweetDirectSync(uint32_t surface_id);
+GLAPI void GLAPIENTRY OSMesaSweetZeroTexture(void);
+GLAPI int GLAPIENTRY OSMesaSweetWrapTexture(GLuint name, uint32_t surface_id, int kind, unsigned w, unsigned h);
+GLAPI void GLAPIENTRY OSMesaSweetWrapSync(uint32_t surface_id);
+GLAPI int GLAPIENTRY OSMesaSweetSurfaceAlias(uint32_t surface_id, void **base, unsigned *bpr, unsigned *w, unsigned *h);
+GLAPI void GLAPIENTRY OSMesaSweetAliasSync(uint32_t surface_id);
+
+/* Frame pipeline statistics (EAGL_SHIM_DEBUG / SWEET_GPU_STATS set): cumulative milliseconds per phase of OSMesaSweetBlit.
+ * 0 blits, 1 render-wait (st_finish before the blit: GPU time of everything the client drew), 2 blit enqueue (CPU),
+ * 3 blit wait (st_finish after it: GPU time of the copy), 4 BO_SYNC (cache clean+invalidate), 5 surface lookup / first-use setup, 6 refused blits */
+static double g_sweet_stats[8];
+static int
+sweet_stats_on(void)
+{
+   static int v = -1;
+   if (v < 0)
+      v = getenv("EAGL_SHIM_DEBUG") != NULL || getenv("SWEET_GPU_STATS") != NULL;
+   return v;
+}
+static double
+sweet_ms(void)
+{
+   return (double)os_time_get_nano() / 1e6;
+}
+
+GLAPI void GLAPIENTRY
+OSMesaSweetStats(double *out, int n)
+{
+   for (int i = 0; i < n && i < 8; i++)
+      out[i] = g_sweet_stats[i];
+}
+
+/** 1 when the contexts run on the GPU (freedreno), 0 for softpipe. */
+GLAPI int GLAPIENTRY
+OSMesaSweetActive(void)
+{
+   return sweet_hw_active();
+}
+
+GLAPI void GLAPIENTRY
+OSMesaSweetForgetSurface(uint32_t surface_id)
+{
+   sweet_hw_surface_forget(surface_id);
+}
+
+/**
+ * Copy a renderbuffer (is_texture = 0) or level 0 of a texture of the current context into the memory of
+ * IOSurface `surface_id` with the GPU: no CPU readback. `flip` mirrors vertically (GL rows are bottom-up),
+ * `opaque` writes alpha = 1. Returns 1 on success, 0 when the caller must use the CPU path.
+ */
+GLAPI int GLAPIENTRY
+OSMesaSweetBlit(GLuint name, int is_texture, uint32_t surface_id, int flip, int opaque)
+{
+   OSMesaContext osmesa = OSMesaGetCurrentContext();
+   struct pipe_resource *src = NULL, *dst;
+   unsigned dw = 0, dh = 0;
+
+   if (!osmesa || !sweet_hw_active())
+      return 0;
+   struct st_context *st = osmesa->st;
+   struct gl_context *ctx = st->ctx;
+   struct pipe_context *pipe = st->pipe;
+
+   const int stats = sweet_stats_on();
+   double t0 = stats ? sweet_ms() : 0, t1 = 0, t2 = 0, t3 = 0, t4 = 0, t5 = 0;
+   FLUSH_VERTICES(ctx, 0, 0);
+   if (stats) {
+      st_finish(st);   /* debug only: separates the GPU time of the client's drawing from the time of the copy */
+      t1 = sweet_ms();
+   }
+   if (is_texture) {
+      struct gl_texture_object *t = _mesa_lookup_texture(ctx, name);
+      if (t)
+         src = t->pt;
+   } else {
+      struct gl_renderbuffer *rb = _mesa_lookup_renderbuffer(ctx, name);
+      if (rb)
+         src = rb->texture;
+   }
+   if (!src)
+      return 0;
+   if (stats)
+      t2 = sweet_ms();
+   dst = sweet_hw_surface_resource(surface_id, opaque, &dw, &dh);
+   if (!dst) {
+      if (stats)
+         g_sweet_stats[6] += 1;
+      return 0;
+   }
+   if (stats)
+      t3 = sweet_ms();
+
+   unsigned w = MIN2(src->width0, dw), h = MIN2(src->height0, dh);
+   struct pipe_blit_info b;
+   memset(&b, 0, sizeof(b));
+   b.src.resource = src;
+   b.src.level = 0;
+   b.src.format = src->format;
+   u_box_2d(0, 0, w, h, &b.src.box);
+   b.dst.resource = dst;
+   b.dst.level = 0;
+   b.dst.format = dst->format;
+   u_box_2d(0, flip ? (int)h : 0, w, flip ? -(int)h : (int)h, &b.dst.box);
+   b.mask = PIPE_MASK_RGBA;
+   b.filter = PIPE_TEX_FILTER_NEAREST;
+   pipe->blit(pipe, &b);
+   if (stats)
+      t4 = sweet_ms();
+   st_finish(st);
+   if (stats)
+      t5 = sweet_ms();
+   sweet_hw_surface_sync(surface_id);
+   if (stats) {
+      double t6 = sweet_ms();
+      g_sweet_stats[0] += 1;
+      g_sweet_stats[1] += t1 - t0;
+      g_sweet_stats[2] += t4 - t3;
+      g_sweet_stats[3] += t5 - t4;
+      g_sweet_stats[4] += t6 - t5;
+      g_sweet_stats[5] += t3 - t2;
+   }
+   return 1;
+}
+
+/**
+ * Zero-copy display buffer: make level 0 of texture `name` of the current context BE the memory of IOSurface `surface_id` (a linear BGRA kernel-allocated
+ * surface, via SURFACE_BO and resource_from_handle), like glEGLImageTargetTexture2DOES. CoreAnimation then renders into the surface directly: no blit,
+ * and the damage-only redraw keeps the pixels already in it. Wrapped (client-memory) surfaces are GPU read-only and are refused here (returns 0).
+ */
+GLAPI int GLAPIENTRY
+OSMesaSweetAttachDirect(GLuint name, uint32_t surface_id)
+{
+   OSMesaContext osmesa = OSMesaGetCurrentContext();
+   unsigned dw = 0, dh = 0;
+
+   if (!osmesa || !sweet_hw_active())
+      return 0;
+   struct st_context *st = osmesa->st;
+   struct gl_context *ctx = st->ctx;
+   struct gl_texture_object *t = _mesa_lookup_texture(ctx, name);
+   const int dbg = getenv("EAGL_SHIM_DEBUG") != NULL;
+   if (!t || t->Target != GL_TEXTURE_2D) {
+      if (dbg) fprintf(stderr, "OSMesa/sweet: direct attach of surface %u: texture %u missing or not 2D\n", surface_id, name);
+      return 0;
+   }
+   struct pipe_resource *res = sweet_hw_surface_resource(surface_id, 0, &dw, &dh);
+   if (!res) {
+      if (dbg) fprintf(stderr, "OSMesa/sweet: direct attach of surface %u: no writable GPU resource (refused: wrapped/read-only, bad geometry or SURFACE_BO failed)\n", surface_id);
+      return 0;
+   }
+   struct gl_texture_image *img = _mesa_get_tex_image(ctx, t, GL_TEXTURE_2D, 0);
+   if (!img) {
+      if (dbg) fprintf(stderr, "OSMesa/sweet: direct attach of surface %u: texture %u has no level 0 image\n", surface_id, name);
+      return 0;
+   }
+   struct st_egl_image stimg;
+   memset(&stimg, 0, sizeof(stimg));
+   stimg.texture = res;
+   stimg.format = res->format;
+   stimg.internalformat = GL_RGBA;
+   st_bind_egl_image(ctx, t, img, &stimg, false, true);
+   int ok = t->surface_based && t->pt == res;
+   if (dbg)
+      fprintf(stderr, "OSMesa/sweet: direct attach of surface %u (%ux%u) to texture %u: %s\n", surface_id, dw, dh, name, ok ? "ok" : "st_bind_egl_image did not take the resource");
+   return ok;
+}
+
+/** Finish the GPU work and make it visible to the CPU / display (clean+invalidate the surface alias). */
+GLAPI void GLAPIENTRY
+OSMesaSweetDirectSync(uint32_t surface_id)
+{
+   OSMesaContext osmesa = OSMesaGetCurrentContext();
+
+   if (!osmesa || !sweet_hw_active())
+      return;
+   FLUSH_VERTICES(osmesa->st->ctx, 0, 0);
+   st_finish(osmesa->st);
+   sweet_hw_surface_sync(surface_id);
+}
+
+/** Writable CPU pixels of a client-memory IOSurface through the kernel alias (abi_minor 2); 0 when unavailable. */
+GLAPI int GLAPIENTRY
+OSMesaSweetSurfaceAlias(uint32_t surface_id, void **base, unsigned *bpr, unsigned *w, unsigned *h)
+{
+   return sweet_hw_surface_alias(surface_id, base, bpr, w, h);
+}
+
+GLAPI void GLAPIENTRY
+OSMesaSweetAliasSync(uint32_t surface_id)
+{
+   sweet_hw_surface_alias_sync(surface_id);
+}
+
+/**
+ * glTexImage2D(NULL) leaves the texture undefined; on iOS the GPU memory behind such a texture is cleared, here the recycled memory still holds
+ * pixels of earlier textures (noisy blocks in Control Center). Zero level 0 of the texture bound to the current unit's GL_TEXTURE_2D.
+ */
+GLAPI void GLAPIENTRY
+OSMesaSweetZeroTexture(void)
+{
+   OSMesaContext osmesa = OSMesaGetCurrentContext();
+
+   if (!osmesa || !sweet_hw_active())
+      return;
+   struct st_context *st = osmesa->st;
+   struct gl_context *ctx = st->ctx;
+   struct gl_texture_object *t = ctx->Texture.Unit[ctx->Texture.CurrentUnit].CurrentTex[TEXTURE_2D_INDEX];
+   if (!t || t->Target != GL_TEXTURE_2D || t->surface_based)
+      return;
+   if (!st_finalize_texture(ctx, st->pipe, t, 0) || !t->pt)
+      return;
+   struct pipe_box box;
+   u_box_2d(0, 0, t->pt->width0, t->pt->height0, &box);
+   if (st->pipe->clear_texture)
+      st->pipe->clear_texture(st->pipe, t->pt, 0, &box, NULL);
+}
+
+/**
+ * Make level 0 of texture `name` of the current context sample the memory of IOSurface `surface_id` directly (read-only GPU import, no copy). `kind`:
+ * 1 A8, 2 L8, 3 L8A8, 4 R8G8B8A8, 5 B8G8R8A8, 6 R16G16B16A16F. Returns 1 when the texture now IS the surface, 0 (nothing changed) when the caller must copy.
+ * The texture must never become a render target or the target of glTexSubImage2D (the shim detaches it on such calls).
+ */
+GLAPI int GLAPIENTRY
+OSMesaSweetWrapTexture(GLuint name, uint32_t surface_id, int kind, unsigned w, unsigned h)
+{
+   static const enum pipe_format map[] = { PIPE_FORMAT_NONE, PIPE_FORMAT_A8_UNORM, PIPE_FORMAT_L8_UNORM, PIPE_FORMAT_L8A8_UNORM,
+                                           PIPE_FORMAT_R8G8B8A8_UNORM, PIPE_FORMAT_B8G8R8A8_UNORM, PIPE_FORMAT_R16G16B16A16_FLOAT };
+   OSMesaContext osmesa = OSMesaGetCurrentContext();
+
+   if (!osmesa || !sweet_hw_active() || kind < 1 || kind > 6)
+      return 0;
+   struct st_context *st = osmesa->st;
+   struct gl_context *ctx = st->ctx;
+   struct gl_texture_object *t = _mesa_lookup_texture(ctx, name);
+   if (!t || t->Target != GL_TEXTURE_2D)
+      return 0;
+   struct pipe_resource *res = sweet_hw_wrapped_resource(surface_id, map[kind], w, h);
+   if (!res)
+      return 0;
+   struct gl_texture_image *img = _mesa_get_tex_image(ctx, t, GL_TEXTURE_2D, 0);
+   if (!img)
+      return 0;
+   struct st_egl_image stimg;
+   memset(&stimg, 0, sizeof(stimg));
+   stimg.texture = res;
+   stimg.format = res->format;
+   stimg.internalformat = kind == 1 ? GL_ALPHA : kind == 2 ? GL_LUMINANCE : kind == 3 ? GL_LUMINANCE_ALPHA : GL_RGBA;
+   st_bind_egl_image(ctx, t, img, &stimg, false, true);
+   return t->surface_based && t->pt == res;
+}
+
+/** The producer changed a wrapped surface: make its CPU writes visible to the GPU. */
+GLAPI void GLAPIENTRY
+OSMesaSweetWrapSync(uint32_t surface_id)
+{
+   sweet_hw_wrapped_sync(surface_id);
+}
