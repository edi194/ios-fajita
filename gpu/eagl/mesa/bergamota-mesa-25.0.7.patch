diff --git a/src/gallium/targets/osmesa/sweet_hw.c b/src/gallium/targets/osmesa/sweet_hw.c
new file mode 100644
index 0000000..276b496
--- /dev/null
+++ b/src/gallium/targets/osmesa/sweet_hw.c
@@ -0,0 +1,440 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Bergamota: hardware (freedreno / Adreno 630) pipe_screen for the OSMesa target, over the libdrm stand-in
+ * (gpu/freedreno-sweet) and the SweetAdreno630 IOKit service, plus IOSurface-backed render targets.
+ *
+ *   SWEET_GPU=0       force softpipe          SWEET_GPU=1 (default)  freedreno when SweetAdreno630 is there, else softpipe
+ */
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <pthread.h>
+
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "frontend/winsys_handle.h"
+#include "util/u_inlines.h"
+#include "util/xmlconfig.h"
+#include "util/driconf.h"
+#include "freedreno/drm/freedreno_drm_public.h"
+
+/* libdrm stand-in extras (gpu/freedreno-sweet/sweet_drm.c) */
+extern int drmOpenWithType(const char *name, const char *busid, int type);
+struct sweet_gpu_surface_plane { uint32_t offset, stride, width, height; };
+struct sweet_gpu_surface_bo {   /* xnu/gpu-abi/sweet_adreno_abi.h; the stand-in sends only the first 48 bytes to a minor-0 kernel */
+   uint32_t surface_id, handle;
+   uint64_t size, iova;
+   uint32_t offset, bytes_per_row, width, height, pixel_format, planes;
+   uint32_t flags, tiling, ubwc, reserved;      /* minor 1 */
+   struct sweet_gpu_surface_plane plane[3];
+   uint64_t alias_addr, alias_size;             /* minor 2 (abi_minor >= 2, INFO.flags & CAP_SBO_ALIAS): writable CPU alias of byte 0 of the BO */
+};
+#define SWEET_SBO_READONLY 0x1   /* out flags (minor 1): GPU mapping is read-only (client-memory surface): usable as a texture source ONLY */
+#define SWEET_SBO_WRAPPED  0x4
+#define SWEET_SBO_IN_SYNC  0x1
+#define SWEET_SBO_IN_WRITABLE_ALIAS 0x2
+#define SWEET_SBO_ALIAS    0x10   /* out: alias_addr/alias_size valid */
+#define SWEET_INFO_CAP_SBO_ALIAS 0x10   /* INFO.flags */
+extern int sweet_drm_surface_bo(int fd, struct sweet_gpu_surface_bo *io);
+extern int sweet_drm_gem_close(int fd, uint32_t handle);
+extern int sweet_drm_bo_sync(int fd, uint32_t handle, uint64_t offset, uint64_t size);
+struct sweet_gpu_info_abi {   /* xnu/gpu-abi/sweet_adreno_abi.h struct sweet_gpu_info */
+   uint32_t abi_version, flags, gpu_id, chip_id;
+   uint64_t va_start, va_size;
+   uint32_t last_fence, abi_minor;
+};
+extern int sweet_drm_info(int fd, struct sweet_gpu_info_abi *out);
+
+struct pipe_screen *sweet_hw_create_screen(void);
+int sweet_hw_active(void);
+struct pipe_resource *sweet_hw_surface_resource(uint32_t surface_id, int opaque, unsigned *w, unsigned *h);
+void sweet_hw_surface_sync(uint32_t surface_id);
+void sweet_hw_surface_forget(uint32_t surface_id);
+struct pipe_resource *sweet_hw_wrapped_resource(uint32_t surface_id, enum pipe_format fmt, unsigned w, unsigned h);
+void sweet_hw_wrapped_sync(uint32_t surface_id);
+int sweet_hw_surface_alias(uint32_t surface_id, void **base, unsigned *bpr, unsigned *w, unsigned *h);
+void sweet_hw_surface_alias_sync(uint32_t surface_id);
+
+static const driOptionDescription sweet_driconf[] = {
+#include "pipe-loader/driinfo_gallium.h"
+#include "freedreno/driinfo_freedreno.h"
+};
+
+static int g_fd = -1;
+static struct pipe_screen *g_hw_screen;
+static int g_alias_cap;    /* INFO.flags CAP_SBO_ALIAS: SURFACE_BO can give a writable CPU alias of client-memory surfaces (BGL_ALIAS=0 disables) */
+static int g_zc_wrapped;   /* INFO.abi_minor >= 1: SURFACE_BO imports wrapped (client-memory) IOSurfaces, READ-ONLY for the GPU. SURFACE_BO is always tried first for every surface, so such surfaces are used
+                              zero-copy automatically (no CPU fallback) once the kernel accepts them; this only drives the log line. BGL_ZEROCOPY overrides it. */
+
+static struct pipe_screen *
+sweet_hw_try_create(void)
+{
+   static struct driOptionCache cache;
+   static struct driOptionCache info;
+   static struct pipe_screen_config config;
+   struct pipe_screen *screen;
+   const char *e = getenv("SWEET_GPU");
+
+   if (e && e[0] == '0')
+      return NULL;
+   g_fd = drmOpenWithType("msm", NULL, 0);
+   if (g_fd < 0) {
+      fprintf(stderr, "OSMesa/sweet: no SweetAdreno630 (drmOpen failed), using softpipe\n");
+      return NULL;
+   }
+   driParseOptionInfo(&info, sweet_driconf, ARRAY_SIZE(sweet_driconf));
+   driParseConfigFiles(&cache, &info, 0, "msm", NULL, NULL, NULL, 0, NULL, 0);
+   config.options = &cache;
+   config.options_info = &info;
+   screen = fd_drm_screen_create_renderonly(g_fd, NULL, &config);
+   if (!screen) {
+      fprintf(stderr, "OSMesa/sweet: freedreno screen creation failed, using softpipe\n");
+      return NULL;
+   }
+   {
+      struct sweet_gpu_info_abi inf;
+      memset(&inf, 0, sizeof(inf));
+      const char *z = getenv("BGL_ZEROCOPY");
+      if (sweet_drm_info(g_fd, &inf) == 0)
+         g_zc_wrapped = inf.abi_minor >= 1;
+      g_alias_cap = inf.abi_minor >= 2 && (inf.flags & SWEET_INFO_CAP_SBO_ALIAS) != 0;
+      if (getenv("BGL_ALIAS") && getenv("BGL_ALIAS")[0] == '0')
+         g_alias_cap = 0;
+      if (z)
+         g_zc_wrapped = z[0] != '0';
+      if (getenv("SWEET_GPU_DEBUG") || getenv("EAGL_SHIM_DEBUG"))
+         fprintf(stderr, "OSMesa/sweet: kernel info abi %u.%u flags 0x%x, zero-copy of wrapped IOSurfaces: %s, writable CPU alias: %s\n", inf.abi_version, inf.abi_minor, inf.flags, g_zc_wrapped ? "yes" : "no (CPU copy for those)", g_alias_cap ? "yes" : "no");
+   }
+   if (getenv("SWEET_GPU_DEBUG"))
+      fprintf(stderr, "OSMesa/sweet: freedreno screen: %s / %s\n", screen->get_name(screen), screen->get_vendor(screen));
+   g_hw_screen = screen;
+   return screen;
+}
+
+struct pipe_screen *
+sweet_hw_create_screen(void)
+{
+   return sweet_hw_try_create();
+}
+
+int
+sweet_hw_active(void)
+{
+   return g_hw_screen != NULL;
+}
+
+/* ---- IOSurface as a render target ---- */
+
+#define MAX_SURF 64
+static struct {
+   uint32_t id;
+   int opaque;
+   uint32_t handle;
+   unsigned w, h;
+   struct pipe_resource *res;
+} g_surf[MAX_SURF];
+static pthread_mutex_t g_surf_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* Surfaces the kernel/GPU path refused (wrapped client memory on an older kernel, odd geometry): remembered so the blit does not repeat the
+ * SURFACE_BO call on every flush; the caller takes the CPU copy. Cleared when the surface is forgotten. */
+#define MAX_REFUSED 256
+static uint32_t g_refused[MAX_REFUSED];
+static int g_nrefused;
+static int
+refused_has(uint32_t id)
+{
+   for (int i = 0; i < g_nrefused; i++)
+      if (g_refused[i] == id)
+         return 1;
+   return 0;
+}
+static void
+refused_add(uint32_t id)
+{
+   if (g_nrefused < MAX_REFUSED)
+      g_refused[g_nrefused++] = id;
+}
+
+/* Resource for the memory of IOSurface `surface_id` (BGRA, linear), or NULL (geometry the GPU path cannot use). */
+struct pipe_resource *
+sweet_hw_surface_resource(uint32_t surface_id, int opaque, unsigned *w, unsigned *h)
+{
+   struct pipe_resource *res = NULL;
+   int free_slot = -1;
+
+   if (!g_hw_screen)
+      return NULL;
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_SURF; i++) {
+      if (g_surf[i].res && g_surf[i].id == surface_id && g_surf[i].opaque == opaque) {
+         res = g_surf[i].res;
+         *w = g_surf[i].w; *h = g_surf[i].h;
+         goto out;
+      }
+      if (!g_surf[i].res && free_slot < 0)
+         free_slot = i;
+   }
+   if (free_slot < 0 || refused_has(surface_id))
+      goto out;
+   {
+      struct sweet_gpu_surface_bo sb = { .surface_id = surface_id, .handle = 0 };
+      int src;
+      if (g_zc_wrapped) {
+         /* minor-1 kernel imports ANY surface, client-memory ones READ-ONLY and pinned until GEM_CLOSE: describe first (no BO is made) and keep
+          * those on the CPU copy path (a GPU write into them is an SMMU fault + GPU recovery). They are texture sources only. */
+         sb.handle = 0xffffffffu;
+         src = sweet_drm_surface_bo(g_fd, &sb);
+         if (src == 0 && (sb.flags & (SWEET_SBO_READONLY | SWEET_SBO_WRAPPED))) {
+            refused_add(surface_id);
+            goto out;
+         }
+         sb.handle = 0;
+      }
+      /* BGRA, or no pixel format at all (CoreAnimation's offscreen/backdrop surfaces are created without one) with 4 bytes per pixel */
+      src = sweet_drm_surface_bo(g_fd, &sb);
+      if (src != 0 && getenv("SWEET_GPU_DEBUG"))
+         fprintf(stderr, "OSMesa/sweet: SURFACE_BO(%u) failed: %d\n", surface_id, src);
+      if (src != 0 || sb.planes > 1 ||
+          !((sb.pixel_format == 0x42475241 /* BGRA */) || (sb.pixel_format == 0 && sb.bytes_per_row >= sb.width * 4 && sb.bytes_per_row < sb.width * 8))) {
+         refused_add(surface_id);
+         if (getenv("SWEET_GPU_DEBUG"))
+            fprintf(stderr, "OSMesa/sweet: surface %u not usable (planes %u fmt %08x, %ux%u bpr %u)\n", surface_id, sb.planes, sb.pixel_format, sb.width, sb.height, sb.bytes_per_row);
+         goto out;
+      }
+      struct pipe_resource templ;
+      memset(&templ, 0, sizeof(templ));
+      templ.target = PIPE_TEXTURE_2D;
+      templ.format = opaque ? PIPE_FORMAT_B8G8R8X8_UNORM : PIPE_FORMAT_B8G8R8A8_UNORM;
+      templ.width0 = sb.width;
+      templ.height0 = sb.height;
+      templ.depth0 = 1;
+      templ.array_size = 1;
+      templ.usage = PIPE_USAGE_DEFAULT;
+      templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+      struct winsys_handle wh;
+      memset(&wh, 0, sizeof(wh));
+      wh.type = WINSYS_HANDLE_TYPE_KMS;
+      wh.handle = sb.handle;
+      wh.stride = sb.bytes_per_row;
+      wh.offset = sb.offset;
+      wh.size = sb.size;
+      wh.modifier = 0;   /* DRM_FORMAT_MOD_LINEAR: no UBWC */
+      res = g_hw_screen->resource_from_handle(g_hw_screen, &templ, &wh, PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE);
+      if (!res) {
+         if (getenv("SWEET_GPU_DEBUG"))
+            fprintf(stderr, "OSMesa/sweet: resource_from_handle failed for surface %u (%ux%u stride %u)\n", surface_id, sb.width, sb.height, sb.bytes_per_row);
+         refused_add(surface_id);
+         goto out;
+      }
+      /* Clean dirty CPU cache lines of the surface BEFORE the GPU first writes it (the CPU zeroed/painted it): the post-blit BO_SYNC is a
+       * clean+invalidate, which would otherwise write those stale lines back over the GPU's pixels (rows/blocks of black seen in a test). */
+      sweet_drm_bo_sync(g_fd, sb.handle, 0, 0);
+      g_surf[free_slot].id = surface_id; g_surf[free_slot].opaque = opaque; g_surf[free_slot].handle = sb.handle;
+      g_surf[free_slot].w = sb.width; g_surf[free_slot].h = sb.height; g_surf[free_slot].res = res;
+      *w = sb.width; *h = sb.height;
+   }
+out:
+   pthread_mutex_unlock(&g_surf_lock);
+   return res;
+}
+
+/* Make GPU writes into the surface visible to the CPU (and to the display): clean+invalidate the kernel alias. */
+void
+sweet_hw_surface_sync(uint32_t surface_id)
+{
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_SURF; i++)
+      if (g_surf[i].res && g_surf[i].id == surface_id) {
+         sweet_drm_bo_sync(g_fd, g_surf[i].handle, 0, 0);
+         break;
+      }
+   pthread_mutex_unlock(&g_surf_lock);
+}
+
+/* ---- writable CPU alias of client-memory (read-only for the GPU) surfaces: the Control Center platters, live icons ... ---- */
+#define MAX_ALIAS 128
+static struct { uint32_t id, handle, bpr, w, h; uint8_t *base; } g_alias[MAX_ALIAS];
+
+/* CPU-writable pixels of IOSurface `surface_id` through the kernel alias (SURFACE_BO + SBO_IN_WRITABLE_ALIAS), or 0 (no cap, refused, table full). */
+int
+sweet_hw_surface_alias(uint32_t surface_id, void **base, unsigned *bpr, unsigned *w, unsigned *h)
+{
+   int ok = 0, free_slot = -1;
+
+   if (!g_hw_screen || !g_alias_cap)
+      return 0;
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_ALIAS; i++) {
+      if (g_alias[i].base && g_alias[i].id == surface_id) {
+         *base = g_alias[i].base; *bpr = g_alias[i].bpr; *w = g_alias[i].w; *h = g_alias[i].h;
+         ok = 1;
+         goto out;
+      }
+      if (!g_alias[i].base && free_slot < 0)
+         free_slot = i;
+   }
+   if (free_slot < 0 || refused_has(surface_id | 0x80000000u))
+      goto out;
+   {
+      struct sweet_gpu_surface_bo sb;
+      memset(&sb, 0, sizeof(sb));
+      sb.surface_id = surface_id;
+      sb.flags = SWEET_SBO_IN_WRITABLE_ALIAS | SWEET_SBO_IN_SYNC;
+      struct sweet_gpu_surface_bo dsc;   /* describe first, only to log the geometry the kernel refuses */
+      memset(&dsc, 0, sizeof(dsc));
+      dsc.surface_id = surface_id; dsc.handle = 0xffffffffu;
+      int dr = sweet_drm_surface_bo(g_fd, &dsc);
+      int r = sweet_drm_surface_bo(g_fd, &sb);
+      if (r != 0 && getenv("SWEET_GPU_DEBUG"))
+         fprintf(stderr, "OSMesa/sweet: alias request for surface %u failed %d; describe %d: %ux%u bpr %u size %llu offset %u fmt %08x flags %x\n", surface_id, r, dr, dsc.width, dsc.height, dsc.bytes_per_row, (unsigned long long)dsc.size, dsc.offset, dsc.pixel_format, dsc.flags);
+      if (r != 0 || !(sb.flags & SWEET_SBO_ALIAS) || !sb.alias_addr || sb.planes > 1 || sb.bytes_per_row < sb.width * 4) {
+         if (getenv("SWEET_GPU_DEBUG"))
+            fprintf(stderr, "OSMesa/sweet: no writable alias for surface %u (r %d flags %x planes %u bpr %u w %u)\n", surface_id, r, sb.flags, sb.planes, sb.bytes_per_row, sb.width);
+         if (r == 0 && sb.handle)
+            sweet_drm_gem_close(g_fd, sb.handle);
+         refused_add(surface_id | 0x80000000u);   /* alias refusals are kept apart from blit refusals (same table, high bit) */
+         goto out;
+      }
+      g_alias[free_slot].id = surface_id; g_alias[free_slot].handle = sb.handle; g_alias[free_slot].bpr = sb.bytes_per_row;
+      g_alias[free_slot].w = sb.width; g_alias[free_slot].h = sb.height; g_alias[free_slot].base = (uint8_t *)(uintptr_t)sb.alias_addr + sb.offset;
+      *base = g_alias[free_slot].base; *bpr = sb.bytes_per_row; *w = sb.width; *h = sb.height;
+      ok = 1;
+      if (getenv("SWEET_GPU_DEBUG"))
+         fprintf(stderr, "OSMesa/sweet: writable alias for surface %u: %ux%u bpr %u at %p\n", surface_id, sb.width, sb.height, sb.bytes_per_row, (void *)g_alias[free_slot].base);
+   }
+out:
+   pthread_mutex_unlock(&g_surf_lock);
+   return ok;
+}
+
+/* After CPU writes through the alias: clean the caches so the GPU / the display see the pixels. */
+void
+sweet_hw_surface_alias_sync(uint32_t surface_id)
+{
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_ALIAS; i++)
+      if (g_alias[i].base && g_alias[i].id == surface_id) {
+         sweet_drm_bo_sync(g_fd, g_alias[i].handle, 0, 0);
+         break;
+      }
+   pthread_mutex_unlock(&g_surf_lock);
+}
+
+/* ---- GPU SAMPLING of client-memory surfaces (read-only import, never a render target) ---- */
+#define MAX_WRAP 192
+static struct { uint32_t id, handle; enum pipe_format fmt; unsigned w, h; struct pipe_resource *res; } g_wrap[MAX_WRAP];
+
+/* Texture-only resource of the memory of IOSurface `surface_id` in format `fmt` (w x h pixels from pixel (0,0), the surface's own row pitch), or NULL
+ * (kernel refused, format or pitch not supported by the GPU: the caller copies instead). The GPU only READS it: the kernel maps client memory read-only. */
+struct pipe_resource *
+sweet_hw_wrapped_resource(uint32_t surface_id, enum pipe_format fmt, unsigned w, unsigned h)
+{
+   struct pipe_resource *res = NULL;
+   int free_slot = -1;
+
+   if (!g_hw_screen || !g_zc_wrapped)
+      return NULL;
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_WRAP; i++) {
+      if (g_wrap[i].res && g_wrap[i].id == surface_id && g_wrap[i].fmt == fmt && g_wrap[i].w == w && g_wrap[i].h == h) {
+         res = g_wrap[i].res;
+         goto out;
+      }
+      if (!g_wrap[i].res && free_slot < 0)
+         free_slot = i;
+   }
+   if (free_slot < 0 || refused_has(surface_id | 0x40000000u))
+      goto out;
+   if (!g_hw_screen->is_format_supported(g_hw_screen, fmt, PIPE_TEXTURE_2D, 0, 0, PIPE_BIND_SAMPLER_VIEW)) {
+      refused_add(surface_id | 0x40000000u);
+      goto out;
+   }
+   {
+      struct sweet_gpu_surface_bo sb;
+      memset(&sb, 0, sizeof(sb));
+      sb.surface_id = surface_id;
+      sb.flags = SWEET_SBO_IN_SYNC;   /* clean the producer's CPU writes before the GPU reads */
+      int r = sweet_drm_surface_bo(g_fd, &sb);
+      unsigned bpp = util_format_get_blocksize(fmt);
+      if (r != 0 || sb.planes > 1 || sb.bytes_per_row < w * bpp || (sb.bytes_per_row & 63) || !(w && h)) {
+         if (getenv("SWEET_GPU_DEBUG"))
+            fprintf(stderr, "OSMesa/sweet: no GPU sampling of surface %u (r %d planes %u bpr %u need %u, 64-byte pitch)\n", surface_id, r, sb.planes, sb.bytes_per_row, w * bpp);
+         if (r == 0 && sb.handle)
+            sweet_drm_gem_close(g_fd, sb.handle);
+         refused_add(surface_id | 0x40000000u);
+         goto out;
+      }
+      struct pipe_resource templ;
+      memset(&templ, 0, sizeof(templ));
+      templ.target = PIPE_TEXTURE_2D;
+      templ.format = fmt;
+      templ.width0 = w;
+      templ.height0 = h;
+      templ.depth0 = 1;
+      templ.array_size = 1;
+      templ.usage = PIPE_USAGE_DEFAULT;
+      templ.bind = PIPE_BIND_SAMPLER_VIEW;   /* never a render target: wrapped memory is read-only for the GPU */
+      struct winsys_handle wh;
+      memset(&wh, 0, sizeof(wh));
+      wh.type = WINSYS_HANDLE_TYPE_KMS;
+      wh.handle = sb.handle;
+      wh.stride = sb.bytes_per_row;
+      wh.offset = sb.offset;
+      wh.size = sb.size;
+      wh.modifier = 0;
+      res = g_hw_screen->resource_from_handle(g_hw_screen, &templ, &wh, 0);   /* no write usage: sampling only */
+      if (!res) {
+         if (getenv("SWEET_GPU_DEBUG"))
+            fprintf(stderr, "OSMesa/sweet: resource_from_handle failed for sampling surface %u (%ux%u fmt %d bpr %u)\n", surface_id, w, h, (int)fmt, sb.bytes_per_row);
+         sweet_drm_gem_close(g_fd, sb.handle);
+         refused_add(surface_id | 0x40000000u);
+         goto out;
+      }
+      g_wrap[free_slot].id = surface_id; g_wrap[free_slot].handle = sb.handle; g_wrap[free_slot].fmt = fmt;
+      g_wrap[free_slot].w = w; g_wrap[free_slot].h = h; g_wrap[free_slot].res = res;
+   }
+out:
+   pthread_mutex_unlock(&g_surf_lock);
+   return res;
+}
+
+/* The producer changed the surface (seed): clean its CPU writes so the GPU samples them. */
+void
+sweet_hw_wrapped_sync(uint32_t surface_id)
+{
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < MAX_WRAP; i++)
+      if (g_wrap[i].res && g_wrap[i].id == surface_id)
+         sweet_drm_bo_sync(g_fd, g_wrap[i].handle, 0, 0);
+   pthread_mutex_unlock(&g_surf_lock);
+}
+
+/* Forget a surface (the client released it). */
+void
+sweet_hw_surface_forget(uint32_t surface_id)
+{
+   pthread_mutex_lock(&g_surf_lock);
+   for (int i = 0; i < g_nrefused; i++)
+      if (g_refused[i] == surface_id || g_refused[i] == (surface_id | 0x80000000u) || g_refused[i] == (surface_id | 0x40000000u)) {
+         g_refused[i] = g_refused[--g_nrefused];
+         i--;
+      }
+   for (int i = 0; i < MAX_WRAP; i++)
+      if (g_wrap[i].res && g_wrap[i].id == surface_id) {
+         pipe_resource_reference(&g_wrap[i].res, NULL);   /* textures still bound to it keep their own reference */
+         memset(&g_wrap[i], 0, sizeof(g_wrap[i]));
+      }
+   for (int i = 0; i < MAX_ALIAS; i++)
+      if (g_alias[i].base && g_alias[i].id == surface_id) {
+         sweet_drm_gem_close(g_fd, g_alias[i].handle);   /* the kernel unmaps the alias here */
+         memset(&g_alias[i], 0, sizeof(g_alias[i]));
+      }
+   for (int i = 0; i < MAX_SURF; i++)
+      if (g_surf[i].res && g_surf[i].id == surface_id) {
+         pipe_resource_reference(&g_surf[i].res, NULL);
+         memset(&g_surf[i], 0, sizeof(g_surf[i]));
+      }
+   pthread_mutex_unlock(&g_surf_lock);
+}
